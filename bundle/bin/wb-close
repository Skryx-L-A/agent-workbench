#!/usr/bin/env bash
# wb-close — the ONLY sanctioned way for an orchestrator to close a pane.
#
# Hard guarantees (enforced here, not just by prompt):
#   * REFUSES to close any pane whose @wb_role is "orchestrator".
#   * REFUSES to close the caller's own pane ($TMUX_PANE).
#   * Closes ONLY panes whose @wb_role is exactly "worker".
# => An orchestrator can neither close itself nor any other orchestrator through
#    this tool. Only der Nutzer closes orchestrators (by hand). Raw `tmux kill-pane`
#    / `kill-session` for worker cleanup is forbidden by the orchestrator role.
#
# The old self-kill bug filtered targets by @wb_worker — which is ALSO set on the
# orchestrator pane (claude-worker/orch-launch set it there). Keying on @wb_role
# makes that class of mistake impossible.
#
# Usage:
#   wb-close <pane-id|worker-name> [more...]   close specific worker pane(s)
#   wb-close --all-workers                     close every worker pane (never orchestrators, never self)
#   wb-close --list                            list closable worker panes (read-only)
#
# Exit: 0 ok / nothing to do; 2 a target was refused; 1 usage/error.
set -euo pipefail
# tmux binary: never hardcode a machine-specific path — /usr/bin/tmux on Linux,
# /opt/homebrew/bin/tmux on the Mac. $TMUX_BIN wins, else whatever is on PATH.
T="${TMUX_BIN:-$(command -v tmux 2>/dev/null || true)}"
[ -n "$T" ] || T=tmux
SELF="${TMUX_PANE:-}"

# The caller's own session. --all-workers is scoped to it: V2 runs SEVERAL
# workbench sessions at once, and the routine end-of-session cleanup of one
# session must never close the running workers of another (reproduced: a call in
# session A closed session B's worker). $WB_SESSION is the explicit form for a
# caller with no tmux context at all — same convention as pi-worker.
own_session(){
  if [ -n "${WB_SESSION:-}" ]; then printf '%s' "$WB_SESSION"; return; fi
  [ -n "$SELF" ] && $T display -p -t "$SELF" '#{session_name}' 2>/dev/null || true
}

role_of(){ $T display -p -t "$1" '#{@wb_role}' 2>/dev/null || true; }
worker_of(){ $T display -p -t "$1" '#{@wb_worker}' 2>/dev/null || true; }
exists(){ $T display -p -t "$1" '#{pane_id}' 2>/dev/null || true; }

resolve(){ # arg -> pane_id. accepts %id directly or a @wb_worker name.
  local a="$1"
  if [[ "$a" == %* ]]; then printf '%s' "$a"; return; fi
  $T list-panes -a -F '#{pane_id} #{@wb_worker}' 2>/dev/null \
    | awk -v n="$a" '$2==n{print $1; exit}'
}

close_one(){ # $1 = pane-id or worker-name ; echoes result, returns 0/2
  local arg="$1" pid role wname
  pid="$(resolve "$arg")"
  if [[ -z "$pid" ]]; then echo "wb-close: kein Pane für '$arg' gefunden"; return 2; fi
  pid="$(exists "$pid")"
  if [[ -z "$pid" ]]; then echo "wb-close: Pane '$arg' existiert nicht (schon zu)"; return 0; fi
  if [[ -n "$SELF" && "$pid" == "$SELF" ]]; then
    echo "wb-close: VERWEIGERT — $pid ist DEIN eigener Pane. Ein Orchestrator schließt sich nie selbst."; return 2
  fi
  role="$(role_of "$pid")"
  if [[ "$role" == "orchestrator" ]]; then
    echo "wb-close: VERWEIGERT — $pid ist ein ORCHESTRATOR-Pane. Nur der Nutzer beendet Orchestratoren."; return 2
  fi
  if [[ "$role" != "worker" ]]; then
    echo "wb-close: VERWEIGERT — $pid hat @wb_role='$role' (nicht 'worker'). Nur Worker-Panes werden geschlossen."; return 2
  fi
  # read the name BEFORE the kill — afterwards the pane is gone and the success
  # message would never name the worker it just closed.
  wname="$(worker_of "$pid")"
  $T kill-pane -t "$pid" && echo "wb-close: geschlossen $pid (worker=$wname arg=$arg)"
  return 0
}

list_workers(){
  printf '%-6s %-16s %-20s %s\n' PANE WORKER SESSION STATE
  $T list-panes -a -F '#{pane_id}|#{@wb_role}|#{@wb_worker}|#{session_name}|#{pane_dead}' 2>/dev/null \
    | awk -F'|' '$2=="worker"{printf "%-6s %-16s %-20s %s\n",$1,$3,$4,($5=="1"?"dead":"live")}'
}

[[ $# -eq 0 ]] && { sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'; exit 1; }

case "${1:-}" in
  --list|-l) list_workers; exit 0 ;;
  --all-workers|-a)
    rc=0
    sess="$(own_session)"
    if [[ -z "$sess" ]]; then
      echo "wb-close: --all-workers braucht die eigene Session, sie ist hier nicht bestimmbar (kein tmux-Kontext)." >&2
      echo "  Entweder aus dem Orchestrator-Pane aufrufen, oder WB_SESSION=<session> setzen, oder die Panes einzeln nennen." >&2
      exit 1
    fi
    # snapshot worker pane-ids first (kill mutates the list); never include SELF,
    # and never a pane of a FOREIGN session (see own_session above).
    # read-loop instead of `mapfile`: macOS ships bash 3.2, which has no mapfile —
    # there the builtin is simply missing and --all-workers aborts with 127. This
    # form behaves identically and works on both machines.
    panes=()
    while IFS= read -r p; do
      [ -n "$p" ] && panes[${#panes[@]}]="$p"
    done < <($T list-panes -a -F '#{session_name}|#{pane_id}|#{@wb_role}' 2>/dev/null \
                          | awk -F'|' -v self="$SELF" -v s="$sess" '$1==s && $3=="worker" && $2!=self{print $2}')
    if [[ ${#panes[@]} -eq 0 ]]; then echo "wb-close: keine Worker-Panes offen (Session $sess)"; exit 0; fi
    for p in "${panes[@]}"; do close_one "$p" || rc=2; done
    exit $rc ;;
  -*) echo "wb-close: unbekannte Option '$1'" >&2; exit 1 ;;
esac

rc=0
for a in "$@"; do close_one "$a" || rc=2; done
exit $rc
