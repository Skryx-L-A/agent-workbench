#!/bin/bash
# wb-workers-window <session> — make sure the `workers` window of a workbench
# session exists, with a placeholder pane while no worker runs yet.
#
# Why this exists (measured 2026-07-25, isolated socket): the worker tab attaches
# to the GROUPED session `<sess>-view`, and sessions of a group share their
# windows — including their destruction. Killing the last shared window destroys
# BOTH sessions and, with the last session, the tmux server. Before the first
# worker is spawned there is no `workers` window, so the group consists of the
# ONE orchestrator window: the worker tab then shows the orchestrator's Claude
# pane, and closing "its" window takes the orchestrator down with it.
#
# A permanent `workers` window fixes both halves: the group never has just one
# window, and the tab shows what it promises instead of a second copy of the
# orchestrator.
#
# The placeholder pane is marked @wb_role placeholder. wb-grid never treats it as
# a worker and removes it as soon as a real worker joins the window; wb-close only
# ever closes @wb_role=worker panes, so it cannot hit it either.
set -euo pipefail

S="${1:?usage: wb-workers-window <tmux-session>}"

# '=' anchors the target: tmux would otherwise prefix-match a foreign session.
tmux has-session -t "=$S" 2>/dev/null || exit 0

# Die GRUPPIERTE View-Session (der Worker-Tab) hat ihr EIGENES aktuelles Fenster.
# Nach einem tmux-Neustart steht sie auf dem Orchestrator-Fenster, und jeder Client,
# der sich neu anhaengt, uebernimmt das — der Worker-Tab zeigt dann den Orchestrator,
# obwohl das workers-Fenster existiert. Am 2026-07-28/29 ist der Nutzer genau darueber
# dreimal gestolpert. Deshalb wird die View-Session hier immer mitgezogen; das ist
# idempotent und beruehrt seinen ORCHESTRATOR-Tab nicht (andere Session, anderes
# aktuelles Fenster).
point_view_at_workers() {
  tmux has-session -t "=$S-view" 2>/dev/null || return 0
  tmux list-windows -t "=$S" -F '#{window_name}' 2>/dev/null | grep -qx workers || return 0
  tmux select-window -t "=$S-view:workers" 2>/dev/null || true
}

if tmux list-windows -t "=$S" -F '#{window_name}' 2>/dev/null | grep -qx workers; then
  point_view_at_workers
  exit 0
fi

# -d: do not steal the focus of whoever runs this. The pane idles instead of
# exiting, because an exiting pane would close the window again — and an
# immediately closing window is exactly the state this script exists to prevent.
# tmux runs the command through /bin/sh: no bashisms here. `printf %q` would
# produce $'…' for the multi-line hint, which sh does not understand — the pane
# died instantly and the window vanished (seen while writing this).
HINT='\n  Noch kein Worker in dieser Session.\n\n'
HINT="$HINT"'  Der Orchestrator startet sie mit claude-worker / pi-worker,\n'
HINT="$HINT"'  sie erscheinen dann hier und dieser Hinweis verschwindet.\n\n'
tmux new-window -d -t "=$S:" -n workers \
  "printf '$HINT'; while :; do sleep 3600; done"

pane="$(tmux list-panes -t "=$S:workers" -F '#{pane_id}' 2>/dev/null | head -1)"
[ -n "$pane" ] || exit 0
tmux set -p -t "$pane" @wb_role placeholder
tmux select-pane -t "$pane" -T 'noch keine Worker'
# global automatic-rename is on; the window must keep the contract name.
tmux set-option -w -t "=$S:workers" automatic-rename off 2>/dev/null || true
point_view_at_workers
