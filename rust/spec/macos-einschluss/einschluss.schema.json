{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://werkbank.invalid/spec/macos-einschluss/einschluss.schema.json",
 "title": "Einschluss unter macOS, Fassung 1",
 "$defs": {
  "kennung": {
   "type": "string",
   "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
  },
  "posixpfad": {
   "type": "string",
   "minLength": 2,
   "maxLength": 1024,
   "pattern": "^(?:/(?!\\.\\.?(?:/|$))[^/\\x00-\\x1f\\x7f-\\x9f\"\\\\]+)+$"
  },
  "pfadliste": {
   "type": "array",
   "minItems": 1,
   "maxItems": 16,
   "uniqueItems": true,
   "items": {
    "$ref": "#/$defs/posixpfad"
   }
  },
  "port": {
   "type": "integer",
   "minimum": 1,
   "maximum": 65535
  },
  "konfig": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "fassung",
    "projektwurzeln",
    "programmordner"
   ],
   "properties": {
    "fassung": {
     "const": 1
    },
    "projektwurzeln": {
     "$ref": "#/$defs/pfadliste"
    },
    "programmordner": {
     "$ref": "#/$defs/pfadliste"
    }
   }
  },
  "bereit": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "bereit",
    "port"
   ],
   "properties": {
    "bereit": {
     "const": true
    },
    "port": {
     "$ref": "#/$defs/port"
    }
   }
  },
  "beschreibung": {
   "description": "Die Einschlussbeschreibung unter macOS als JSON, nur für die Fälle der Form profil. Im Crate ist sie ein Typ.",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "harness",
    "arbeitsordner",
    "programmordner",
    "zustand",
    "heim",
    "such_socket",
    "merkmal",
    "sitzungsports",
    "umgebung",
    "geschuetzt",
    "argv"
   ],
   "properties": {
    "harness": {
     "$ref": "#/$defs/kennung"
    },
    "arbeitsordner": {
     "$ref": "#/$defs/posixpfad"
    },
    "programmordner": {
     "type": "array",
     "maxItems": 16,
     "items": {
      "$ref": "#/$defs/posixpfad"
     }
    },
    "zustand": {
     "$ref": "#/$defs/posixpfad"
    },
    "heim": {
     "$ref": "#/$defs/posixpfad"
    },
    "such_socket": {
     "$ref": "#/$defs/posixpfad"
    },
    "merkmal": {
     "$ref": "#/$defs/posixpfad"
    },
    "sitzungsports": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "modellweg"
     ],
     "properties": {
      "modellweg": {
       "$ref": "#/$defs/port"
      },
      "ausgang": {
       "$ref": "#/$defs/port"
      }
     }
    },
    "umgebung": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "home",
      "path",
      "term",
      "lang",
      "tmpdir"
     ],
     "properties": {
      "home": {
       "type": "string",
       "minLength": 1
      },
      "path": {
       "type": "string",
       "minLength": 1
      },
      "term": {
       "type": "string",
       "minLength": 1
      },
      "lang": {
       "type": "string",
       "minLength": 1
      },
      "tmpdir": {
       "type": "string",
       "minLength": 1
      }
     }
    },
    "geschuetzt": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/posixpfad"
     }
    },
    "argv": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string",
      "minLength": 1
     }
    }
   }
  }
 }
}
