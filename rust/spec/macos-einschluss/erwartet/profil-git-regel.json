{
 "gueltig": true,
 "enthaelt": [
  "(version 1)",
  "(deny default)",
  "(import \"system.sb\")",
  "(allow process-fork)",
  "(allow process-exec)",
  "(allow signal (target same-sandbox))",
  "(allow process-info* (target same-sandbox))",
  "(subpath \"/Library/Developer/CommandLineTools\")"
 ],
 "enthaelt_nicht": [
  "(allow default)",
  "(allow network*",
  "(allow network-outbound)",
  "(allow network-bind",
  "(allow network-inbound",
  "(allow file-read*)",
  "(allow file-write*)",
  "(allow signal)",
  "(allow process-info*)",
  "(allow mach-lookup",
  "(allow mach-priv",
  "(remote ip \"*:",
  "(remote tcp",
  "(remote udp",
  "(subpath \"/Applications/Xcode.app",
  "xcode_select_link",
  "(allow file-write* (subpath \"/Library"
 ]
}
