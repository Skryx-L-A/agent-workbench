{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "werkbank:start/fassung-1-und-2",
 "title": "Start-Struktur, Fassung 1 und 2",
 "description": "Zwei Formen: $defs/anfrage (Ansicht an Kern-Dienst, ohne sitzung) und $defs/datei (Kern-Dienst an 'Lauf starten', mit sitzung und optional marker). Fassung 2 trägt dazu effort und name, die Datei auch fortsetzung_von; in Fassung 1 sind die drei unbekannte Schlüssel. Nicht im Schema: Größe in Byte, BOM, doppelte JSON-Schlüssel, Pfadlänge in Byte, Harness-Tabelle, Effort-Werte je Harness und Grenze (Stufen 13a und 18), fortsetzung_von gleich sitzung (Stufe 9a), Querverweise auf die Einstellungsdatei und der Fehlercode. Siehe README.md.",
 "$ref": "#/$defs/datei",
 "$defs": {
  "kennung": {
   "type": "string",
   "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
  },
  "felder": {
   "fassung": {
    "enum": [
     1,
     2
    ]
   },
   "harness": {
    "$ref": "#/$defs/kennung"
   },
   "modell": {
    "type": "string",
    "pattern": "^[A-Za-z0-9._:/@+-]{1,128}$"
   },
   "route": {
    "$ref": "#/$defs/kennung"
   },
   "kunde": {
    "anyOf": [
     {
      "type": "null"
     },
     {
      "$ref": "#/$defs/kennung"
     }
    ]
   },
   "arbeitsordner": {
    "type": "string",
    "maxLength": 1024,
    "pattern": "^(/[^/\\u0000-\\u001f\\u007f-\\u009f]+)+$",
    "not": {
     "pattern": "(^|/)\\.\\.?(/|$)"
    }
   },
   "marker": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "liste",
     "ordner"
    ],
    "properties": {
     "liste": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
       "type": "string",
       "pattern": "^[A-Z0-9-]{1,32}$"
      }
     },
     "ordner": {
      "$ref": "#/$defs/felder/arbeitsordner"
     }
    }
   },
   "effort": {
    "description": "Fassung 2, Pflicht: Effort der Sitzung oder null (Vorgabe des Harness).",
    "anyOf": [
     {
      "type": "null"
     },
     {
      "type": "string",
      "pattern": "^[a-z]{1,16}$"
     }
    ]
   },
   "name": {
    "description": "Fassung 2, Pflicht: Anzeigename oder null. 1 bis 64 Zeichen, kein Steuer-, Trenn-, Richtungs- oder breitenloses Zeichen, kein Leerraum am Rand.",
    "anyOf": [
     {
      "type": "null"
     },
     {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[^\\s\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\u200b-\\u200f\\u202a-\\u202e\\u2066-\\u2069\\ufeff](?:[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\u200b-\\u200f\\u202a-\\u202e\\u2066-\\u2069\\ufeff]*[^\\s\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\u200b-\\u200f\\u202a-\\u202e\\u2066-\\u2069\\ufeff])?$"
     }
    ]
   },
   "fortsetzung_von": {
    "description": "Nur Datei der Fassung 2, Pflicht: Kennung der fortgesetzten Sitzung oder null (neuer Start).",
    "anyOf": [
     {
      "type": "null"
     },
     {
      "$ref": "#/$defs/kennung"
     }
    ]
   }
  },
  "anfrage": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "fassung",
    "harness",
    "modell",
    "route",
    "kunde",
    "arbeitsordner"
   ],
   "properties": {
    "fassung": {
     "$ref": "#/$defs/felder/fassung"
    },
    "harness": {
     "$ref": "#/$defs/felder/harness"
    },
    "modell": {
     "$ref": "#/$defs/felder/modell"
    },
    "route": {
     "$ref": "#/$defs/felder/route"
    },
    "kunde": {
     "$ref": "#/$defs/felder/kunde"
    },
    "arbeitsordner": {
     "$ref": "#/$defs/felder/arbeitsordner"
    },
    "effort": {
     "$ref": "#/$defs/felder/effort"
    },
    "name": {
     "$ref": "#/$defs/felder/name"
    }
   },
   "if": {
    "required": [
     "fassung"
    ],
    "properties": {
     "fassung": {
      "const": 2
     }
    }
   },
   "then": {
    "required": [
     "effort",
     "name"
    ]
   },
   "else": {
    "properties": {
     "effort": false,
     "name": false
    }
   }
  },
  "datei": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "fassung",
    "sitzung",
    "harness",
    "modell",
    "route",
    "kunde",
    "arbeitsordner"
   ],
   "properties": {
    "fassung": {
     "$ref": "#/$defs/felder/fassung"
    },
    "sitzung": {
     "$ref": "#/$defs/kennung"
    },
    "harness": {
     "$ref": "#/$defs/felder/harness"
    },
    "modell": {
     "$ref": "#/$defs/felder/modell"
    },
    "route": {
     "$ref": "#/$defs/felder/route"
    },
    "kunde": {
     "$ref": "#/$defs/felder/kunde"
    },
    "arbeitsordner": {
     "$ref": "#/$defs/felder/arbeitsordner"
    },
    "marker": {
     "$ref": "#/$defs/felder/marker"
    },
    "effort": {
     "$ref": "#/$defs/felder/effort"
    },
    "name": {
     "$ref": "#/$defs/felder/name"
    },
    "fortsetzung_von": {
     "$ref": "#/$defs/felder/fortsetzung_von"
    }
   },
   "if": {
    "required": [
     "fassung"
    ],
    "properties": {
     "fassung": {
      "const": 2
     }
    }
   },
   "then": {
    "required": [
     "effort",
     "name",
     "fortsetzung_von"
    ]
   },
   "else": {
    "properties": {
     "effort": false,
     "name": false,
     "fortsetzung_von": false
    }
   }
  }
 }
}
