{
 "beschreibung": "pi auf lokaler Route: Modellweg openai-lokal bereit, Anbieter-Definition im Heim, dann exec",
 "form": "aufruf",
 "lage": {
  "argv": [
   "<programm>",
   "<start>"
  ],
  "datei_modus": "0600",
  "datei_art": "datei",
  "einstellungen": {
   "fassung": 2,
   "klassen": [
    "oeffentlich",
    "intern",
    "kundendaten"
   ],
   "vorgabestufe": "kundendaten",
   "routen": [
    {
     "schluessel": "cloud-beispiel",
     "art": "cloud",
     "klasse": "intern",
     "netzziele": [
      {
       "host": "api.cloud.example",
       "port": 443,
       "zugriff": "kopf-einsetzen",
       "schluessel": true,
       "pfade": [
        {
         "methode": "GET",
         "pfad": "/copilot_internal/*"
        }
       ]
      }
     ]
    },
    {
     "schluessel": "lokal-beispiel",
     "art": "lokal",
     "klasse": "kundendaten",
     "ziel": "http://127.0.0.1:11434/v1",
     "modell": "qwen3:8b",
     "netzziele": []
    }
   ],
   "kunden": [
    {
     "schluessel": "k-beispiel",
     "erlaubt": [
      "lokal-beispiel"
     ],
     "verboten": []
    }
   ],
   "kundendaten_an_cloud": {
    "vorgabe": "nie",
    "freigaben": []
   }
  },
  "ordner_vorhanden": true,
  "einschluss": true,
  "suche": "bereit",
  "harness_vorhanden": true,
  "start": {
   "fassung": 1,
   "sitzung": "s-2",
   "harness": "pi",
   "modell": "qwen3:8b",
   "route": "lokal-beispiel",
   "kunde": "k-beispiel",
   "arbeitsordner": "/home/beispiel/projekt"
  }
 }
}
