 "befehle": {
  "env": "env",
  "datei": "cat {pfad}",
  "netz": "curl -sS -m 5 --noproxy '*' {url}",
  "baum": "grep -rIl '{muster}' / 2>/dev/null",
  "baum_aussen": "grep -rIl '{muster}' {vault}",
  "ps": "ps -eo pid=,user=,comm=",
  "kill": "kill -0 {pid}",
  "umgebung_lesen": "cat /proc/{pid}/environ",
  "rohanfrage": "python3 -c {skript}",
  "such_socket": "/run/brain/such.sock",
  "route_namen": [
   "ROUTE",
   "BRAIN_ROUTE",
   "SUCHE_ROUTE"
  ],
  "env_zaehle_schluessel": "env | grep -cE '{muster}'",
  "kontrolle_lokal_env": "env | grep -c '^PI_OFFLINE='",
  "ps_zaehle_schluessel": "ps -eo args= | grep -cE '{muster}'",
  "dateien_schluessel": "grep -rIlE '{muster}' / 2>/dev/null",
  "gateway_direkt": "curl -sS -m 5 --noproxy '*' -o /dev/null -w '%{http_code}' -X POST -d '{}' {url}/v1/chat/completions",
  "s1_umgebung": "env | grep -c '.'",
  "s1_route_namen": "env | grep -ciE '^[^=]*route'",
  "s1_route_wert": "env | grep -cE '={route}$'",
  "token_env": "env | grep -oE '{muster}' | grep -cvE '{platzhalter}'",
  "token_ps": "ps -eo args= | grep -oE '{muster}' | grep -cvE '{platzhalter}'",
  "token_proc": "cat /proc/[0-9]*/environ /proc/[0-9]*/cmdline 2>/dev/null | tr '\\0' '\\n' | grep -oE '{muster}' | grep -cvE '{platzhalter}'",
  "token_dateien": "grep -rIhoE '{muster}' / 2>/dev/null | grep -cvE '{platzhalter}'",
  "token_gh": "gh auth token 2>&1 | grep -oE '{muster}' | grep -cvE '{platzhalter}'",
  "token_secret": "secret-tool lookup service copilot-cli 2>&1 | grep -oE '{muster}' | grep -cvE '{platzhalter}'",
  "kontrolle_env": "env | grep -oE '{platzhalter}' | grep -c .",
  "kontrolle_proc": "cat /proc/[0-9]*/environ 2>/dev/null | tr '\\0' '\\n' | grep -oE '{platzhalter}' | grep -c .",
  "cloud_direkt": "curl -sS -m 5 --noproxy '*' -o /dev/null -w '%{http_code}' -X POST -H 'Authorization: Bearer {platzhalter}' -d '{}' {url}/v1/chat/completions",
  "e5_url": "curl -sS -m 5 --noproxy '*' -o /dev/null -w '%{http_code}' {url}",
  "e5_connect": "curl -sS -m 5 -o /dev/null -w '%{http_code}' --proxy http://127.0.0.1:{port} https://{host}/",
  "marker_schreiben": "printf '{praefix}%s' {rest} > {pfad}",
  "marker_lesen": "cat {pfad}"
 },
