  "token_proc": "cat /proc/[0-9]*/environ /proc/[0-9]*/cmdline 2>/dev/null | tr '\\0' '\\n' | grep -oE '{muster}' | grep -cvE '{platzhalter}'",
  "token_dateien": "grep -rIhoE '{muster}' / 2>/dev/null | grep -cvE '{platzhalter}'",
  "token_gh": "gh auth token 2>&1 | grep -oE '{muster}' | grep -cvE '{platzhalter}'",
  "token_secret": "secret-tool lookup service copilot-cli 2>&1 | grep -oE '{muster}' | grep -cvE '{platzhalter}'",
  "kontrolle_env": "env | grep -oE '{platzhalter}' | grep -c .",
