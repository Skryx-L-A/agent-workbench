# Exclusions of the mutation gate for the crate dienst (gates.sh, gate mutants, reads every mutants/*.liste).
# Format and rules: mutants/README.md. One entry per line: <list> <kind> <pattern>.

# dienst: the module `kindprogramm` (the fixed child programs `--kind`) is declared behind the feature.
erster datei crates/dienst/src/kindprogramm.rs

# dienst, `programm`: the branch `--kind` (comparison and mask of the exit code) stands behind the feature.
erster re crates/dienst/src/lib.rs:112:39: replace == with != in programm

erster re crates/dienst/src/lib.rs:117:42: replace & with [|^] in programm

# meldung, `modus_setzen`, and rechte, `socket_modus_setzen`: `|` -> `^` of separate `OFlags` bits gives the same flags.
gleichwertig re crates/dienst/src/meldung.rs:61:26: replace [|] with [|^] in modus_setzen

gleichwertig re crates/dienst/src/meldung.rs:61:45: replace [|] with [|^] in modus_setzen

gleichwertig re crates/dienst/src/rechte.rs:192:26: replace [|] with [|^] in socket_modus_setzen

gleichwertig re crates/dienst/src/rechte.rs:192:45: replace [|] with [|^] in socket_modus_setzen

# rechte, `socket_modus_setzen`: `RUSR` and `WUSR` are separate bits, so `|` -> `^` gives the same mode.
gleichwertig re crates/dienst/src/rechte.rs:218:58: replace [|] with [|^] in socket_modus_setzen

# meldung and rechte, the check after setting the mode: under Linux the descriptor is already checked as a socket and the
# mode is set through it, so `&&` -> `||` differs only in a race between setting and checking. Caught on the Mac.
gleichwertig re crates/dienst/src/meldung.rs:87:37: replace && with [|][|] in modus_setzen

gleichwertig re crates/dienst/src/rechte.rs:218:9: replace && with [|][|] in socket_modus_setzen

# rechte, `socket_modus_setzen`: the branch outside Linux is not compiled under Linux. Caught on the Mac (`&`);
# `^` is equivalent there (separate bits).
gleichwertig re crates/dienst/src/rechte.rs:211:24: replace [|] with & in socket_modus_setzen

gleichwertig re crates/dienst/src/rechte.rs:211:24: replace [|] with [|^] in socket_modus_setzen

# meldung, `gegenseite_gut`: the peer check of macOS is not compiled under Linux. Caught on the Mac.
gleichwertig re crates/dienst/src/meldung.rs:247:27: replace != with == in Meldung::gegenseite_gut

gleichwertig re crates/dienst/src/meldung.rs:251:63: replace == with != in Meldung::gegenseite_gut

# dienst, `entfernte_wegnehmen`: its only call stands at the end of the round, where `arbeit` is always empty, and with
# an empty `entfernt` the rest takes nothing away; `||` -> `&&` gives the same result.
gleichwertig re crates/dienst/src/dienst.rs:953:36: replace [|][|] with && in Dienst::entfernte_wegnehmen

# dienst, `starten`: `rahmen_waehlen(n, ...)` is only checked for `None`, which does not depend on `n`.
gleichwertig re crates/dienst/src/dienst.rs:1851:43: replace [+] with [*] in Dienst::starten

# dienst, `sys/macos.rs` (local way, DI-L11 point 5): `sandkasten` and the hook `einschluss` of macOS are compiled only under macOS, so no
# test under Linux can fail for their mutants. Caught on the Mac by hand mutants on 27.11.2026, 9 of 9 (the three returns of
# `sandkasten`, its two arms, three returns of `einschluss` and its `!=`), with the tests of `sys::macos` and `lokal`.
gleichwertig datei crates/dienst/src/sys/macos.rs
