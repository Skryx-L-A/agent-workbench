{
 "beschreibung": "Startdatei mit lauf und ohne kind: der Dienst startet mit null Sitzungen; der Betrachter bekommt die Nachrichten des Verbindens mit leerer Sitzungsliste",
 "datensatz": "A",
 "name": "di12_lauf_ohne_kind",
 "ordner_pruefen": true,
 "regeln": [
  "DI12",
  "DI1"
 ],
 "schritte": [
  {
   "art": "Verbinden",
   "betrachter": "c1"
  },
  {
   "art": "Zustand",
   "betrachter": "c1",
   "voll": true
  }
 ],
 "start": {
  "anfang": {
   "personen": {
    "anna": {
     "art": "mensch",
     "rolle": "nutzer"
    }
   }
  },
  "betrachter": {
   "ansicht": "fenster",
   "person": "anna",
   "raum": "raum-nord"
  },
  "deflate": false,
  "lauf": {
   "einstellungen": "@einstellungen",
   "env": {
    "KIND_PLAN": "{\"*\": {\"modus\": \"marke\", \"text\": \"EINS\"}}",
    "LC_ALL": "C.UTF-8",
    "PATH": "/usr/bin:/bin",
    "TERM": "xterm-256color"
   },
   "groesse": [
    120,
    14
   ],
   "programm": "@laufkind"
  },
  "pruefmodus": true,
  "socket": {
   "ordner": "@ordner"
  }
 }
}
