#!/bin/sh
# postrm of the package werkbank (contract rust/spec/paket, part A, "Skripte des Pakets", "Entfernen").
# remove: unload every profile of the product (`prerm` did it by file; here the rest by file or by label) and delete its compiled cache file under /var/cache/apparmor, switch the units off globally; /var/lib/werkbank stays (configuration).
# purge: additionally delete the answer of the debconf question werkbank/ca_zulassung, the copy of bwrap (form B), /etc/werkbank/lauf.json, kern.json, bruecke.json and halter.json (and /etc/werkbank when empty), /var/lib/werkbank with the key file (overwrite, then remove) and, as the user, the store of the holder in the home; remove leaves the four files and the store.
# Never stops the removal: no `set -e`; exit 0 for every action.

# purge: the answer of the question of the package leaves debconf, so a new installation starts again with `offen`.
if [ "$1" = purge ] && [ -e /usr/share/debconf/confmodule ]; then
    . /usr/share/debconf/confmodule
    db_purge || true
fi

PROFILE="/etc/apparmor.d/usr.lib.werkbank.werkbank-einschluss /etc/apparmor.d/usr.lib.werkbank.bwrap"
# werkbank-modellweg.service is the unit of an earlier package; its trace is removed here as well.
EINHEITEN="werkbank-kern.service werkbank-bruecke.service wb-halter.service werkbank-modellweg.service"

entladen() {
    command -v apparmor_parser >/dev/null 2>&1 || return 0
    for profil in $PROFILE; do
        [ -f "$profil" ] && apparmor_parser -R "$profil" 2>/dev/null
    done
    # What the parser could not unload by file (the file is already gone at purge): remove by label.
    verwaltung=/sys/kernel/security/apparmor
    if [ -r "$verwaltung/profiles" ] && [ -w "$verwaltung/.remove" ]; then
        while IFS= read -r zeile; do
            name=${zeile% (*}
            case "$name" in
                werkbank-* | /usr/lib/werkbank/*) printf '%s' "$name" >"$verwaltung/.remove" 2>/dev/null ;;
            esac
        done <"$verwaltung/profiles"
    fi
    # The compiled copy of the profile (written by `apparmor_parser -W` in postinst) stays after `-R`; measured on 26.04.1.
    find /var/cache/apparmor -maxdepth 2 -type f -name 'usr.lib.werkbank.*' -delete 2>/dev/null
    return 0
}

abschalten() {
    command -v systemctl >/dev/null 2>&1 || return 0
    for e in $EINHEITEN; do
        systemctl --global disable "$e" >/dev/null 2>&1
    done
    return 0
}

# purge (addendum holder): the user, its ids and its home, from lauf.json (the user is the last part of `zustand`, the home is `heim`), else from
# SUDO_USER and passwd. Only a plain user name and an absolute home without a quote or a backslash pass.
ablage_nutzer() {
    an_nutzer="" an_heim=""
    if [ -f /etc/werkbank/lauf.json ] && [ ! -L /etc/werkbank/lauf.json ]; then
        text=$(head -c 65536 /etc/werkbank/lauf.json 2>/dev/null)
        z=$(printf '%s' "$text" | sed -n 's/.*"zustand":"\([^"\\]*\)".*/\1/p')
        an_heim=$(printf '%s' "$text" | sed -n 's/.*"heim":"\([^"\\]*\)".*/\1/p')
        an_nutzer=${z##*/}
    fi
    if [ -z "$an_nutzer" ]; then
        case "${SUDO_USER:-}" in
            "" | root) ;;
            *) an_nutzer=$SUDO_USER ;;
        esac
    fi
    case "$an_nutzer" in
        "" | *[!a-z0-9_-]* | [!a-z_]*) an_nutzer="" ;;
    esac
    [ -n "$an_nutzer" ] || return 1
    [ -n "$an_heim" ] || an_heim=$(getent passwd "$an_nutzer" 2>/dev/null | cut -d: -f6)
    case "$an_heim" in
        /*) ;;
        *) return 1 ;;
    esac
    an_uid=$(id -u "$an_nutzer" 2>/dev/null) && an_gid=$(id -g "$an_nutzer" 2>/dev/null) || return 1
    [ -n "$an_uid" ] && [ "$an_uid" != 0 ] || return 1
    return 0
}

# The store of the holder, cleared as the user (never as root): each level .local, state, agent-workbench, halter, geheim is entered only
# when it is a folder of the user and no link (the walk stops at the first that is not); in geheim every regular file is overwritten and
# removed, a link is removed and never followed, anything else stays; the same in halter/protokoll (the chain of the holder, finding F16)
# when it is a folder of the user and no link; then geheim, protokoll, halter and agent-workbench go with rmdir, only when empty.
ABLAGE_RAEUMEN='cd -P -- "$1" 2>/dev/null || exit 0
for e in .local state agent-workbench halter geheim; do
    [ -d "$e" ] && [ ! -L "$e" ] && [ -O "$e" ] || exit 0
    cd -P -- "$e" 2>/dev/null || exit 0
done
raeumen() {
    for f in * .[!.]* ..?*; do
        if [ -L "$f" ]; then
            rm -f -- "$f"
        elif [ -f "$f" ]; then
            shred -u -- "$f" 2>/dev/null || rm -f -- "$f"
        fi
    done
}
raeumen
cd .. || exit 0
rmdir geheim 2>/dev/null
if [ -d protokoll ] && [ ! -L protokoll ] && [ -O protokoll ] && cd -P -- protokoll 2>/dev/null; then
    raeumen
    cd .. && rmdir protokoll 2>/dev/null
fi
cd .. && rmdir halter 2>/dev/null && cd .. && rmdir agent-workbench 2>/dev/null
exit 0'

ablage_raeumen() {
    if ! ablage_nutzer || ! command -v setpriv >/dev/null 2>&1; then
        logger -t werkbank-paket "werkbank: Ablage des Halters nicht geraeumt" 2>/dev/null
        return 0
    fi
    setpriv --reuid="$an_uid" --regid="$an_gid" --init-groups -- /bin/sh -c "$ABLAGE_RAEUMEN" sh "$an_heim" >/dev/null 2>&1 \
        || logger -t werkbank-paket "werkbank: Ablage des Halters nicht geraeumt" 2>/dev/null
    return 0
}

# purge (addendum "Rolle aus der Gruppe"): the entry of dpkg-statoverride of the role program, only when it is exactly the one of postinst, and
# the group wb-bruecke, only when postinst made it (the mark under /var/lib/werkbank) and only when it has no member; else the group stays
# and the journal gets code 27.
DATEN=/var/lib/werkbank
# --- rolle begin
rolle_entfernen() {
    if command -v dpkg-statoverride >/dev/null 2>&1; then
        re_eintrag=$(dpkg-statoverride --list /usr/lib/werkbank/werkbank-modellweg 2>/dev/null)
        if [ "$re_eintrag" = "root wb-bruecke 2755 /usr/lib/werkbank/werkbank-modellweg" ]; then
            dpkg-statoverride --remove /usr/lib/werkbank/werkbank-modellweg >/dev/null 2>&1
        fi
    fi
    re_marke=$DATEN/rollengruppe-angelegt
    if [ -f "$re_marke" ] && [ ! -L "$re_marke" ] && [ "$(head -c 64 "$re_marke" 2>/dev/null)" = wb-bruecke ]; then
        if getent group wb-bruecke >/dev/null 2>&1; then
            delgroup --system --only-if-empty wb-bruecke >/dev/null 2>&1 \
                || logger -t werkbank-paket "werkbank: Rollengruppe wb-bruecke bleibt, Code 27" 2>/dev/null
        fi
    fi
    return 0
}
# --- rolle end

case "$1" in
    remove)
        entladen
        abschalten
        ;;
    purge)
        entladen
        abschalten
        rm -f /etc/systemd/user/default.target.wants/werkbank-kern.service \
            /etc/systemd/user/default.target.wants/werkbank-bruecke.service \
            /etc/systemd/user/default.target.wants/wb-halter.service \
            /etc/systemd/user/default.target.wants/werkbank-modellweg.service 2>/dev/null
        rm -f /usr/lib/werkbank/bwrap 2>/dev/null
        # Before lauf.json goes: it names the user and the home of the store.
        ablage_raeumen
        # Before /var/lib/werkbank goes: it holds the mark of the group.
        rolle_entfernen
        if [ -d /var/lib/werkbank ]; then
            find /var/lib/werkbank -type f \( -name 'modellweg.schluessel' -o -name 'copilot.schluessel' \) -exec shred -u {} + 2>/dev/null
            rm -rf /var/lib/werkbank 2>/dev/null
        fi
        rm -f /etc/werkbank/lauf.json /etc/werkbank/kern.json /etc/werkbank/bruecke.json /etc/werkbank/halter.json 2>/dev/null
        rmdir /etc/werkbank 2>/dev/null
        rmdir /usr/lib/werkbank /usr/share/werkbank 2>/dev/null
        ;;
esac
exit 0
