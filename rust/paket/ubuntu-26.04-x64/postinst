#!/bin/sh
# postinst of the package werkbank (contract rust/spec/paket, part A, "Skripte des Pakets").
# Every step can be repeated and asks nothing. Steps 1, 2, 4 and 5 never stop the installation: no `set -e`, every step ends
# with `|| true` or inside a function that returns 0, and a failed step writes one fixed line to the journal (no path, no
# content). Three steps are the exception: step 1a (the session folders) ends with the fixed code 17 or 18, step 2 (the folders `dienst` and `gespraeche` of the user) with the
# fixed code 29 or 30 and step 3 (the enclosure) with the fixed code 11 to 16, because a package without safe session folders, a safe folder for the list of the
# sessions, a safe folder for the conversations or a carrying enclosure must not run. A program folder that the enclosure would
# refuse (step 2a) is the code 19 as a journal line only: that harness is not entered and the installation goes on.
# The exit code is 0 for every other case.

# The answer of the question werkbank/ca_zulassung comes from debconf (file `config`, contract "Zulassung der CA"). The confmodule is sourced first:
# it restarts the script once under the frontend, and it moves stdout of the script to stderr (the messages below stay visible).
[ -e /usr/share/debconf/confmodule ] && . /usr/share/debconf/confmodule

log() {
    logger -t werkbank-installation "$1" 2>/dev/null || true
    return 0
}

fail() {
    echo "werkbank-einschluss: $2 (Code $1)" >&2
    logger -t werkbank-installation "werkbank: Einschluss, Code $1" 2>/dev/null || true
    exit "$1"
}

[ "$1" = "configure" ] || exit 0

DATEN=/var/lib/werkbank
VORLAGE=/usr/share/werkbank/probelauf
# The holder (addendum holder) comes after the bridge; step 4b restarts the units in this order.
EINHEITEN="werkbank-kern.service werkbank-bruecke.service wb-halter.service"

# Step 1: the user is the one who called sudo.
nutzer=""
case "${SUDO_USER:-}" in
    "" | root) ;;
    *[!a-z0-9_-]*) ;;
    [a-z_]*) nutzer="$SUDO_USER" ;;
esac
if [ -n "$nutzer" ] && ! getent passwd "$nutzer" >/dev/null 2>&1; then
    nutzer=""
fi
gruppe=""
[ -n "$nutzer" ] && gruppe=$(id -gn "$nutzer" 2>/dev/null)
[ -n "$nutzer" ] && [ -z "$gruppe" ] && nutzer=""

# Step 1a (before step 2): the folders /var/lib/werkbank/s (root:root 0755) and s/<uid> (user, 0700) for the state of the sessions and
# /var/lib/werkbank/l (root:root 0755) and l/<uid> (user, 0700) for the sockets. A folder that exists with a foreign owner, a wrong mode or as a symlink
# (also /var/lib/werkbank, s and l themselves) stops the installation with the fixed code 17 (s, s/<uid>, /var/lib/werkbank) or 18 (l, l/<uid>); no
# symlink is followed (fail closed). A missing folder is created and checked again.
# /var/lib/werkbank/z (root:root 0755) and z/<uid> (user, 0700) is the count folder of a trial run (`lauf.marker_ordner` of kern.json); the same checks, the code 17.
# --- sitzungsordner begin
so_stat() {
    stat -c '%u:%g:%a' "$1" 2>/dev/null
}

# so_sicher <path> <uid> <gid> <mode without leading 0> <code>; its variables carry the prefix sp_ (sh has no `local`: a shared name
# would overwrite the uid of the caller)
so_sicher() {
    sp_pfad=$1 sp_uid=$2 sp_gid=$3 sp_modus=$4 sp_code=$5
    if [ -L "$sp_pfad" ]; then
        fail "$sp_code" "ein Ordner unter /var/lib/werkbank ist ein Symlink; nichts geaendert"
    fi
    if [ ! -e "$sp_pfad" ]; then
        install -d -m "0$sp_modus" -o "$sp_uid" -g "$sp_gid" "$sp_pfad" 2>/dev/null \
            || fail "$sp_code" "ein Ordner unter /var/lib/werkbank konnte nicht angelegt werden"
    fi
    if [ -L "$sp_pfad" ] || [ ! -d "$sp_pfad" ] || [ "$(so_stat "$sp_pfad")" != "$sp_uid:$sp_gid:$sp_modus" ]; then
        fail "$sp_code" "ein Ordner unter /var/lib/werkbank hat einen falschen Eigentuemer oder Modus; nichts geaendert"
    fi
    return 0
}

sitzungsordner() {
    [ -L "$DATEN" ] && fail 17 "/var/lib/werkbank ist ein Symlink; nichts geaendert"
    install -d -m 0755 -o root -g root "$DATEN" 2>/dev/null || fail 17 "/var/lib/werkbank konnte nicht angelegt werden"
    so_uid=$(id -u "$nutzer" 2>/dev/null) || return 0
    case "$so_uid" in "" | *[!0-9]*) return 0 ;; esac
    so_gid=$(id -g "$nutzer" 2>/dev/null) || return 0
    case "$so_gid" in "" | *[!0-9]*) return 0 ;; esac
    so_sicher "$DATEN/s" 0 0 755 17
    so_sicher "$DATEN/s/$so_uid" "$so_uid" "$so_gid" 700 17
    so_sicher "$DATEN/l" 0 0 755 18
    so_sicher "$DATEN/l/$so_uid" "$so_uid" "$so_gid" 700 18
    so_sicher "$DATEN/z" 0 0 755 17
    so_sicher "$DATEN/z/$so_uid" "$so_uid" "$so_gid" 700 17
    return 0
}
# --- sitzungsordner end
if [ -n "$nutzer" ]; then
    sitzungsordner
fi

# Step 1b (addendum "Rolle aus der Gruppe"): the system group wb-bruecke and the setgid role program of the bridge. The holder takes the
# role of a peer from its effective gid (contract rust/spec/halter, 2.3 and 2.3a). A missing group is made with `addgroup --system`, and the
# mark $DATEN/rollengruppe-angelegt (root:root 0644) says that purge may remove it again. An existing group is taken only in this form: one
# entry, gid 100 to 999, no member, password field x, !, * or empty, and the primary group of no account; else nothing changes and the
# journal gets code 25. Then dpkg-statoverride sets /usr/lib/werkbank/werkbank-modellweg to root:wb-bruecke 2755 (the archive stays
# root:root 0755); a failure is code 26. Neither stops the installation, and no account ever becomes a member of the group.
# --- rollengruppe begin
ROLLENGRUPPE=wb-bruecke
ROLLENPROGRAMM=/usr/lib/werkbank/werkbank-modellweg
GROUP_DATEI=/etc/group
PASSWD_DATEI=/etc/passwd

# rg_form: succeeds when the group has exactly the form above
rg_form() {
    [ "$(grep -c "^$ROLLENGRUPPE:" "$GROUP_DATEI" 2>/dev/null)" = 1 ] || return 1
    rg_zeile=$(grep "^$ROLLENGRUPPE:" "$GROUP_DATEI")
    rg_pw=$(printf '%s' "$rg_zeile" | cut -d: -f2)
    rg_gid=$(printf '%s' "$rg_zeile" | cut -d: -f3)
    rg_mitglieder=$(printf '%s' "$rg_zeile" | cut -d: -f4-)
    case "$rg_gid" in "" | *[!0-9]* | 0*) return 1 ;; esac
    [ "$rg_gid" -ge 100 ] && [ "$rg_gid" -le 999 ] || return 1
    [ -z "$rg_mitglieder" ] || return 1
    case "$rg_pw" in x | "!" | "*" | "") ;; *) return 1 ;; esac
    # the primary group of an account (field 4 of passwd)
    ! cut -d: -f4 "$PASSWD_DATEI" 2>/dev/null | grep -qx "$rg_gid"
}

rg_statoverride() {
    command -v dpkg-statoverride >/dev/null 2>&1 || return 1
    rg_eintrag=$(dpkg-statoverride --list "$ROLLENPROGRAMM" 2>/dev/null)
    case "$rg_eintrag" in
        "root $ROLLENGRUPPE 2755 $ROLLENPROGRAMM") return 0 ;;
        "") ;;
        *) dpkg-statoverride --remove "$ROLLENPROGRAMM" >/dev/null 2>&1 || return 1 ;;
    esac
    dpkg-statoverride --update --add root "$ROLLENGRUPPE" 2755 "$ROLLENPROGRAMM" >/dev/null 2>&1
}

rollengruppe() {
    if ! grep -q "^$ROLLENGRUPPE:" "$GROUP_DATEI" 2>/dev/null; then
        addgroup --system "$ROLLENGRUPPE" >/dev/null 2>&1 || { log "werkbank: Rollengruppe wb-bruecke abgelehnt, Code 25"; return 0; }
        if install -d -m 0755 -o root -g root "$DATEN"; then
            printf '%s\n' "$ROLLENGRUPPE" >"$DATEN/rollengruppe-angelegt" && chmod 0644 "$DATEN/rollengruppe-angelegt"
        fi
    fi
    if ! rg_form; then
        log "werkbank: Rollengruppe wb-bruecke abgelehnt, Code 25"
        return 0
    fi
    rg_statoverride || log "werkbank: Rollenprogramm nicht gesetzt, Code 26"
    return 0
}
# --- rollengruppe end
rollengruppe

# Step 2: the folder of the user with its sub folders; copy the templates once (never over an existing file).
nutzerordner() {
    install -d -m 0755 -o root -g root "$DATEN" || return 0
    o="$DATEN/$nutzer"
    install -d -m 0700 -o "$nutzer" -g "$gruppe" "$o" || return 0
    install -d -m 0700 -o "$nutzer" -g "$gruppe" "$o/protokoll" || true
    install -d -m 0700 -o "$nutzer" -g "$gruppe" "$o/sitzungen" || true
    # Step I: the working copy comes from the first-start profile, the same template as halter.json (step 2c), so route, model and paths agree.
    if [ -f "$VORLAGE/erststart.json" ] && [ ! -e "$o/einstellungen.json" ]; then
        install -m 0600 -o "$nutzer" -g "$gruppe" "$VORLAGE/erststart.json" "$o/einstellungen.json" || true
    fi
    if [ -d "$VORLAGE/vorfuehr-vault" ] && [ ! -e "$o/vorfuehr-vault" ]; then
        cp -R "$VORLAGE/vorfuehr-vault" "$o/vorfuehr-vault" || true
        find "$o/vorfuehr-vault" -type d -exec chmod 0700 {} + 2>/dev/null || true
        find "$o/vorfuehr-vault" -type f -exec chmod 0600 {} + 2>/dev/null || true
        chown -R "$nutzer:$gruppe" "$o/vorfuehr-vault" 2>/dev/null || true
    fi
    return 0
}
if [ -n "$nutzer" ]; then
    nutzerordner || log "werkbank: Nutzerordner konnte nicht angelegt werden"
else
    log "werkbank: kein sudo-Nutzer, Nutzerordner nicht angelegt"
fi

# Step 2 (end): $DATEN/<user>/dienst (the user, 0700) holds the list of the sessions of the core service (`lauf.bestand` of kern.json is $DATEN/<user>/dienst/bestand.json;
# contract dienst DI-L5). The same checks as the folders of step 1a, with the fixed code 29: a folder that exists with a foreign owner, a wrong mode or as a symlink, or that is no
# folder, stops the installation (nothing is changed, no symlink is followed; else the core service would start with exit 3). A missing folder is created and checked again.
# The file bestand.json is made only by the core service: postinst never creates, reads or changes it (an update leaves it byte for byte as it is); purge removes it with $DATEN.
# --- dienstordner begin
dienstordner() {
    do_uid=$(id -u "$nutzer" 2>/dev/null) || fail 29 "die uid des Nutzers ist nicht lesbar"
    case "$do_uid" in "" | *[!0-9]*) fail 29 "die uid des Nutzers ist nicht lesbar" ;; esac
    do_gid=$(id -g "$nutzer" 2>/dev/null) || fail 29 "die gid des Nutzers ist nicht lesbar"
    case "$do_gid" in "" | *[!0-9]*) fail 29 "die gid des Nutzers ist nicht lesbar" ;; esac
    so_sicher "$DATEN/$nutzer/dienst" "$do_uid" "$do_gid" 700 29
    return 0
}
# --- dienstordner end
if [ -n "$nutzer" ]; then
    dienstordner
fi

# Step 2 (end, second part): $DATEN/<user>/gespraeche (the user, 0700) holds the conversations of the sessions, one folder `<session>/` each (`gespraeche` of lauf.json and `lauf.gespraeche`
# of kern.json have exactly this value; contract start, "Ablage des Gesprächs"). The same checks as the folders of step 1a, with the fixed code 30: a folder that exists with a foreign
# owner, a wrong mode or as a symlink, or that is no folder, stops the installation (nothing is changed, no symlink is followed; else every start of a session ends in werkbank-lauf).
# A missing folder is created and checked again. What lies in it is made only by werkbank-lauf: postinst never creates, reads or changes an entry (an update leaves it byte for byte
# as it is); purge removes it with $DATEN.
# --- gespraecheordner begin
gespraecheordner() {
    go_uid=$(id -u "$nutzer" 2>/dev/null) || fail 30 "die uid des Nutzers ist nicht lesbar"
    case "$go_uid" in "" | *[!0-9]*) fail 30 "die uid des Nutzers ist nicht lesbar" ;; esac
    go_gid=$(id -g "$nutzer" 2>/dev/null) || fail 30 "die gid des Nutzers ist nicht lesbar"
    case "$go_gid" in "" | *[!0-9]*) fail 30 "die gid des Nutzers ist nicht lesbar" ;; esac
    so_sicher "$DATEN/$nutzer/gespraeche" "$go_uid" "$go_gid" 700 30
    return 0
}
# --- gespraecheordner end
if [ -n "$nutzer" ]; then
    gespraecheordner
fi

# Step 2a: /etc/werkbank/lauf.json, the own configuration of werkbank-lauf (contract rust/spec/paket, "lauf.json"; form in
# rust/crates/lauf/src/konfig.rs). Written for the user of step 1, root:root 0644, atomically. Every value comes from this
# script, from passwd or from a search of fixed folders, never from the environment of the caller. A value that is no clean
# folder form (rust/spec/paket/referenz.py `lauf_ordner_form`) stops the file: no file is better than a broken one.
# The search runs again with `sudo dpkg-reconfigure werkbank` (SUDO_USER stays the user).
# --- lauf.json begin
ETCW=/etc/werkbank
LK_WURZEL=""

# `ca_zulassung` (contract "Zulassung der CA"): the default is `offen` (fail closed). The value changes only by an explicit step of an
# administrator: the answer of the question of `dpkg-reconfigure` (or of `debconf-set-selections`) or the command `werkbank-ca-zulassung`.
# An answer counts when its flag `seen` is true; after the value is written, postinst sets the flag back to false and the answer to the
# written value, so that an upgrade or a `dpkg-reconfigure` without an answer never changes it. Without debconf (a test, a script) the value of
# the file stays, as before.
# ca_datei_wert: prints the value of `ca_zulassung` of lauf.json, read as JSON text: any white space (space, tab, CR, LF) around ":" and in front of the
# value is fine, so a file that an administrator rewrote with another tool is read as before. Only the three valid values count; the key must stand
# exactly once (a second `"ca_zulassung"` or a value of another form gives nothing, which means `ungueltig` to the callers). POSIX tools only.
ca_roh() {
    tr '\n\r\t' '   ' <"$ETCW/lauf.json" 2>/dev/null
}

ca_datei_wert() {
    [ -f "$ETCW/lauf.json" ] || return 0
    cz_n=$(ca_roh | grep -o '"ca_zulassung"' | wc -l)
    [ $((cz_n + 0)) -eq 1 ] || return 0
    cz_w=$(ca_roh | grep -o -E '"ca_zulassung" *: *"[^"]*"' | sed -E 's/^"ca_zulassung" *: *"([^"]*)"$/\1/')
    case "$cz_w" in
        zugelassen | offen | abgelehnt) printf '%s' "$cz_w" ;;
    esac
    return 0
}

# ca_antwort: sets CA_ANTWORT to the answer that waits (flag seen true, one of the three values), else to "".
ca_antwort() {
    CA_ANTWORT=""
    command -v db_fget >/dev/null 2>&1 || return 0
    db_fget werkbank/ca_zulassung seen || return 0
    [ "$RET" = true ] || return 0
    db_get werkbank/ca_zulassung || return 0
    case "$RET" in zugelassen | offen | abgelehnt) CA_ANTWORT=$RET ;; esac
    return 0
}

# ca_protokoll <new> <old> <way>: one line to the journal, like the command: new value, old value, way, uid, time; no secret.
ca_protokoll() {
    cz_zeit=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null) || cz_zeit=unbekannt
    cz_wer=$(id -u 2>/dev/null)
    case "$cz_wer" in "" | *[!0-9]*) cz_wer=unbekannt ;; esac
    cz_zeile="werkbank: ca_zulassung $1 (vorher $2), Weg $3, uid $cz_wer"
    case "${SUDO_UID:-}" in "" | *[!0-9]*) ;; *) cz_zeile="$cz_zeile, sudo_uid $SUDO_UID" ;; esac
    log "$cz_zeile, Zeit $cz_zeit"
}

# ca_nachher <new> <old text> <way>: after the file is written.
ca_nachher() {
    [ "$1" = "$2" ] || ca_protokoll "$1" "$2" "$3"
    if command -v db_set >/dev/null 2>&1; then
        db_set werkbank/ca_zulassung "$1" || true
        db_fset werkbank/ca_zulassung seen false || true
    fi
    return 0
}

lk_form() {
    case "$1" in
        "" | */ | *//* | */./* | */../* | */. | */.. | *[!A-Za-z0-9._/+@-]*) return 1 ;;
        /*) [ "${#1}" -gt 1 ] && [ "${#1}" -le 1024 ] && return 0 ;;
    esac
    return 1
}

# lk_nvm_ordner: the bin folders of the nvm versions of the user, the highest version first (numeric compare of major, minor, patch;
# only names of the form v<a>.<b>.<c>; "v9.0.0" is lower than "v22.1.0").
lk_nvm_ordner() {
    ls -1 "$LK_WURZEL$heim/.nvm/versions/node" 2>/dev/null | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' \
        | sort -t. -k1.2,1nr -k2,2nr -k3,3nr | while read -r v; do
        printf '%s\n' "$LK_WURZEL$heim/.nvm/versions/node/$v/bin"
    done
}

# The fixed version of the harness opencode (decision of the operator, 27.11.2026): the program of the npm package opencode-ai 1.19.5.
# The package links one of two files to `bin/opencode.exe`, chosen by its postinstall from the CPU flag avx2 of /proc/cpuinfo:
# `package/bin/opencode` of `opencode-linux-x64-1.19.5.tgz` (CPU with avx2) or the file of the same name of
# `opencode-linux-x64-baseline-1.19.5.tgz` (CPU without avx2). Both sums are fixed and come from the maker; only the file that fits the CPU
# is entered, any other version or build of opencode is not. (Measured 27.11.2026: in 1.19.5 the two files are byte-identical, so the
# two sums are equal; they stay two constants, because a later version may differ.)
LK_OPENCODE_SHA256=7df4e4136301f16589b0f30bf91a61380fca5f8ef22dd36570f5ebe1d4ec802c
LK_OPENCODE_BASELINE_SHA256=7df4e4136301f16589b0f30bf91a61380fca5f8ef22dd36570f5ebe1d4ec802c

# lk_summe <file>: the sha256 of the file as 64 hex digits, nothing on a fault.
lk_summe() {
    sha256sum "$1" 2>/dev/null | cut -c1-64
}

# lk_avx2: succeeds when the CPU lists the flag avx2 (the same test as the postinstall of opencode-ai: the word avx2, any case, in
# /proc/cpuinfo); a missing or unreadable file means no avx2.
lk_avx2() {
    [ -r "$LK_WURZEL/proc/cpuinfo" ] && grep -E -i -q '(^|[[:space:]])avx2([[:space:]]|$)' "$LK_WURZEL/proc/cpuinfo"
}

# lk_suche <name>: sets LK_<NAME> (real program) and LK_<NAME>_NODE (real node) when the harness is found for the user.
# The search order: the nvm versions of the user (the highest version first), then the fixed folders; the first hit wins.
# opencode is a program of its own without node: its real program must be the fixed version for the CPU (LK_OPENCODE_SHA256 with
# avx2, LK_OPENCODE_BASELINE_SHA256 without), else it is not entered and one fixed journal line says so (no path).
lk_suche() {
    name=$1
    treffer=""
    for ordner in $(lk_nvm_ordner) "$LK_WURZEL$heim/.local/bin" "$LK_WURZEL$heim/.npm-global/bin" \
        "$LK_WURZEL$heim/.volta/bin" "$LK_WURZEL/usr/local/bin" "$LK_WURZEL/usr/bin"; do
        if [ -x "$ordner/$name" ] && [ -z "$treffer" ]; then
            treffer="$ordner/$name"
        fi
    done
    [ -n "$treffer" ] || return 0
    echt=$(readlink -f "$treffer" 2>/dev/null) || return 0
    echt=${echt#"$LK_WURZEL"}
    case "$echt" in
        /usr/* | /opt/* | "$heim"/.nvm/* | "$heim"/.local/* | "$heim"/.npm-global/* | "$heim"/.volta/*) ;;
        *) return 0 ;;
    esac
    knoten=""
    for kandidat in "$(dirname "$treffer")/node" "$LK_WURZEL/usr/local/bin/node" "$LK_WURZEL/usr/bin/node"; do
        if [ -x "$kandidat" ]; then
            knoten=$(readlink -f "$kandidat" 2>/dev/null) && knoten=${knoten#"$LK_WURZEL"}
            break
        fi
    done
    case "$name" in
        pi)
            LK_PI=$echt
            LK_PI_NODE=$knoten
            ;;
        copilot)
            LK_COPILOT=$echt
            LK_COPILOT_NODE=$knoten
            ;;
        opencode)
            if lk_avx2; then soll=$LK_OPENCODE_SHA256; else soll=$LK_OPENCODE_BASELINE_SHA256; fi
            if [ "$(lk_summe "$LK_WURZEL$echt")" = "$soll" ]; then
                LK_OPENCODE=$echt
            else
                log "werkbank: opencode nicht in der festen Fassung, nicht eingetragen"
            fi
            ;;
    esac
}

# lk_ordner <real program> <real node>: prints the program folders of one harness (reference: referenz.lauf_programmordner).
# The folder of a harness is the ROOT OF ITS PACKAGE, `<prefix>/lib/node_modules/<package>` (two levels for `@scope/package`), never the npm
# prefix: a prefix such as `<home>/.local` holds the login store `.local/share/keyrings`, which the enclosure refuses. A program that is
# no file of an npm package has the folder it lies in. `node` has the folder it lies in (its `bin` folder), never two levels above it.
lk_ordner() {
    case "$1" in
        */lib/node_modules/*)
            lo_prefix=${1%%/lib/node_modules/*}
            lo_rest=${1#*/lib/node_modules/}
            lo_p1=${lo_rest%%/*}
            lo_rest2=${lo_rest#*/}
            case "$lo_p1" in
                @*)
                    lo_p2=${lo_rest2%%/*}
                    if [ "$lo_rest2" != "$lo_p2" ]; then
                        printf '%s\n' "$lo_prefix/lib/node_modules/$lo_p1/$lo_p2"
                    else
                        printf '%s\n' "${1%/*}"
                    fi
                    ;;
                *)
                    if [ "$lo_rest" != "$lo_p1" ]; then
                        printf '%s\n' "$lo_prefix/lib/node_modules/$lo_p1"
                    else
                        printf '%s\n' "${1%/*}"
                    fi
                    ;;
            esac
            ;;
        *) printf '%s\n' "${1%/*}" ;;
    esac
    if [ -n "$2" ]; then
        printf '%s\n' "${2%/*}"
    fi
}

# lk_programmordner: sets LK_ORDNER to the program folders of both harnesses, separated by blanks: nothing at or below /usr (the enclosure
# binds /usr whole), no double, no folder inside another folder of the list (the enclosure refuses overlapping folders).
lk_programmordner() {
    ordner=""
    for h in "$LK_COPILOT|$LK_COPILOT_NODE" "$LK_PI|$LK_PI_NODE" "$LK_OPENCODE|"; do
        [ "${h%%|*}" = "" ] && continue
        for d in $(lk_ordner "${h%%|*}" "${h#*|}"); do
            case "$d" in /usr | /usr/*) continue ;; esac
            case " $ordner " in *" $d "*) continue ;; esac
            ordner="$ordner $d"
        done
    done
    LK_ORDNER=""
    for d in $ordner; do
        eingebettet=0
        for e in $ordner; do
            if [ "$e" != "$d" ]; then
                case "$d" in "$e"/*) eingebettet=1 ;; esac
            fi
        done
        [ "$eingebettet" = 0 ] && LK_ORDNER="$LK_ORDNER $d"
    done
    return 0
}

# lk_ordner_pruefen: every program folder of a harness passes the rule of the enclosure BEFORE it is written. The rule is not repeated here:
# `werkbank-pruefen --programmordner <home> <folder>` calls the same functions as the enclosure (crate einschluss, verbote.rs): exit 0 allowed,
# 1 refused, anything else (the call failed) counts as refused (fail closed). A harness with a refused folder is NOT entered (neither `harness.<name>`
# nor its folders reach lauf.json, so no session of it starts), one fixed journal line names the code 19 and the harness (no path, no content), the
# folder goes to the state file of the package, and the installation goes on with exit 0 (services, the other harness and step 4b run).
# A skeleton build without the command skips the check with a journal line and leaves the state file as it is; a delivered package always has
# the command (mandatory file of the manifest).
PRUEFEN=/usr/bin/werkbank-pruefen
ABGELEHNT=$DATEN/programmordner-abgelehnt
LK_ABGELEHNT_TEXT=""
# lk_harness_pruefen <name>: checks the folders of the harness (package root, folder of node; nothing at or below /usr); the first refused folder
# ends the check of that harness: the harness is cleared and one line `<name> <folder>` is added to LK_ABGELEHNT_TEXT.
lk_harness_pruefen() {
    hn=$1
    case "$hn" in
        pi) hp=$LK_PI hk=$LK_PI_NODE ;;
        copilot) hp=$LK_COPILOT hk=$LK_COPILOT_NODE ;;
        opencode) hp=$LK_OPENCODE hk="" ;;
        *) return 0 ;;
    esac
    [ -n "$hp" ] || return 0
    for d in $(lk_ordner "$hp" "$hk"); do
        case "$d" in /usr | /usr/*) continue ;; esac
        "$PRUEFEN" --programmordner "$heim" "$d" >/dev/null 2>&1 && continue
        LK_ABGELEHNT_TEXT="$LK_ABGELEHNT_TEXT$hn $d
"
        log "werkbank: Programmordner abgelehnt, Code 19, Harness $hn"
        echo "werkbank: ein Programmordner des Harness $hn beruehrt den Anmeldespeicher oder ein Geheimnis; das Harness ist nicht eingetragen (Code 19)" >&2
        case "$hn" in
            pi) LK_PI="" LK_PI_NODE="" ;;
            copilot) LK_COPILOT="" LK_COPILOT_NODE="" ;;
            opencode) LK_OPENCODE="" ;;
        esac
        return 0
    done
    return 0
}

lk_ordner_pruefen() {
    LK_ABGELEHNT_TEXT=""
    if [ ! -x "$PRUEFEN" ]; then
        log "werkbank: Programmordner nicht geprueft, werkbank-pruefen fehlt"
        return 0
    fi
    lk_harness_pruefen copilot
    lk_harness_pruefen pi
    lk_harness_pruefen opencode
    # The state file (root:root 0644, only lines `<harness> <folder>`) is what `werkbank-pruefen` reads; it goes away with the next configuration
    # that finds no refused folder.
    if [ -z "$LK_ABGELEHNT_TEXT" ]; then
        rm -f "$ABGELEHNT" 2>/dev/null
        return 0
    fi
    atmp=$(mktemp "$DATEN/.abgelehnt.XXXXXX" 2>/dev/null) || {
        log "werkbank: Ablehnung der Programmordner nicht festgehalten"
        return 0
    }
    if printf '%s' "$LK_ABGELEHNT_TEXT" >"$atmp" && chmod 0644 "$atmp" && chown root:root "$atmp" && mv -f "$atmp" "$ABGELEHNT"; then
        return 0
    fi
    rm -f "$atmp"
    log "werkbank: Ablehnung der Programmordner nicht festgehalten"
    return 0
}

lk_text() {
    o=$DATEN/$nutzer
    p=/usr/local/bin:/usr/bin:/bin
    for k in "$LK_COPILOT_NODE" "$LK_PI_NODE"; do
        case "$k" in
            "" | /usr/*) ;;
            *)
                p=${k%/*}:$p
                break
                ;;
        esac
    done
    liste=""
    for d in $LK_ORDNER; do liste="$liste${liste:+,}\"$d\""; done
    harness=""
    [ -n "$LK_COPILOT" ] && harness="\"copilot\":\"$LK_COPILOT\""
    [ -n "$LK_PI" ] && harness="$harness${harness:+,}\"pi\":\"$LK_PI\""
    [ -n "$LK_OPENCODE" ] && harness="$harness${harness:+,}\"opencode\":\"$LK_OPENCODE\""
    printf '{"fassung":1,"einstellungen":"%s/einstellungen.json","vault":"%s/vorfuehr-vault","protokoll":"%s/protokoll","zustand":"%s",' "$o" "$o" "$o" "$o"
    printf '"laufzeit":"%s/l/%s","sitzungen":"%s/s/%s","gespraeche":"%s/gespraeche","heim":"%s","path":"%s",' "$DATEN" "$uid" "$DATEN" "$uid" "$o" "$heim" "$p"
    printf '"programme":{"rangkern":"/usr/lib/werkbank/rangkern","modellweg":"/usr/lib/werkbank/werkbank-modellweg","kind":"/usr/lib/werkbank/werkbank-lauf-kind","such_mcp":"/usr/lib/werkbank/such-mcp","weiter":"/usr/lib/werkbank/einschluss-weiter"},'
    printf '"harness":{%s},"programmordner":[%s],' "$harness" "$liste"
    printf '"schluessel":{"copilot":"%s/copilot.schluessel","lokal":"%s/modellweg.schluessel"},"ca_zulassung":"%s"}\n' "$o" "$o" "$ca"
}

lauf_json() {
    uid=$(id -u "$nutzer" 2>/dev/null) || return 0
    heim=$(getent passwd "$nutzer" | cut -d: -f6)
    LK_PI="" LK_PI_NODE="" LK_COPILOT="" LK_COPILOT_NODE="" LK_OPENCODE=""
    lk_suche copilot
    lk_suche pi
    lk_suche opencode
    lauf_schreiben
}

lauf_schreiben() {
    lk_form "$heim" || return 0
    for w in "$LK_PI" "$LK_PI_NODE" "$LK_COPILOT" "$LK_COPILOT_NODE" "${LK_OPENCODE:-}"; do
        [ -z "$w" ] || lk_form "$w" || return 0
    done
    lk_ordner_pruefen
    lk_programmordner
    # The value of the file stays (also one that the operator wrote by hand; nothing else is taken over), unless an answer waits in debconf.
    ca_alt=$(ca_datei_wert)
    ca=${ca_alt:-offen}
    if [ -n "$ca_alt" ]; then
        ca_alt_text=$ca_alt
    elif [ -f "$ETCW/lauf.json" ]; then
        ca_alt_text=ungueltig
    else
        ca_alt_text=keiner
    fi
    ca_antwort
    [ -n "$CA_ANTWORT" ] && ca=$CA_ANTWORT
    install -d -m 0755 -o root -g root "$ETCW" || return 0
    tmp=$(mktemp "$ETCW/.lauf.json.XXXXXX") || return 0
    if lk_text >"$tmp" && chmod 0644 "$tmp" && chown root:root "$tmp" && mv -f "$tmp" "$ETCW/lauf.json"; then
        if [ -n "$CA_ANTWORT" ]; then ca_nachher "$ca" "$ca_alt_text" debconf; else ca_nachher "$ca" "$ca_alt_text" paket; fi
        return 0
    fi
    rm -f "$tmp"
    return 1
}
# --- lauf.json end
if [ -n "$nutzer" ]; then
    lauf_json || log "werkbank: lauf.json nicht geschrieben"
fi

# Step 2b: /etc/werkbank/kern.json and /etc/werkbank/bruecke.json, the start files of the core service (wb-dienst, crate dienst, DI1 and DI12) and
# of the bridge (wb-bruecke, crate bruecke). Written for the user of step 1, root:root 0644, atomically, like lauf.json. <run> is /run/user/<uid>,
# the uid comes from `id -u <user>` (never from the environment). The environment of the sessions is exactly TERM (contract 1, "Aufruf Lauf starten":
# the service environment is empty but TERM; `werkbank-lauf` sets the rest itself and reads no secret from it).
# `lauf.sitzungen` of kern.json has exactly the value of `sitzungen` of lauf.json ($DATEN/s/<uid>): the core service hands out no session id whose folder exists there.
# `lauf.ziellisten` is the folder in which werkbank-lauf writes the target list of a session (<zustand>/sitzungen, $DATEN/<user>/sitzungen): the core service also skips every
# session number whose <ziellisten>/s-<n>.zielliste.json exists (only lstat). Reference: rust/spec/paket/referenz.py `dienstkonfig`.
# `lauf.marker_datei` is /run/user/<uid>/werkbank-probelauf/marker.json (the file of the trial run; the runner creates it and removes it at the end), `lauf.marker_ordner` is $DATEN/z/<uid> (the count folder of step 1a), both for the same uid as `lauf.sitzungen`.
# `lauf.bestand` is $DATEN/<user>/dienst/bestand.json (by the name like `lauf.einstellungen`, not by the uid): the file of the list of the sessions of the core service (contract dienst DI-L5);
# its folder `dienst` is made and checked in step 2 (code 29), the file only by the core service.
# `lauf.gespraeche` is $DATEN/<user>/gespraeche (by the name like `lauf.ziellisten`, not by the uid) and exactly the value of `gespraeche` of lauf.json: the core service counts
# `<gespraeche>/s-<n>` as taken (contract dienst, DI12 point 15); the folder is made and checked in step 2 (code 30), what lies in it only by werkbank-lauf.
# Admin fields (contract "Welche Felder der Admin setzt"): `lauf.groesse` of kern.json and `port` of bruecke.json keep the value that an administrator set,
# like `ca_zulassung` of lauf.json: the old file is read as JSON text with POSIX tools (`tr`, `grep`, `sed`): any white space around ":" and inside the pair is fine; the key
# must stand exactly once and the value must have the valid form, else the default and one fixed journal line (no path, no content). Every other field is made again.
# --- dienst.json begin
dk_roh() {
    tr '\n\r\t' '   ' <"$ETCW/$1" 2>/dev/null
}

# dk_alt <file> <key>: succeeds when the old file is an ordinary file that holds the key; DK_N is the number of its appearances
dk_alt() {
    DK_N=0
    [ -f "$ETCW/$1" ] && [ ! -L "$ETCW/$1" ] || return 1
    DK_N=$(dk_roh "$1" | grep -o "\"$2\"" | wc -l)
    DK_N=$((DK_N + 0))
    [ "$DK_N" -ge 1 ]
}

# dk_zahl <text> <min> <max>: succeeds for a decimal number of at most 5 digits without a leading zero in the range
dk_zahl() {
    case "$1" in "" | 0[0-9]* | ??????* | *[!0-9]*) return 1 ;; esac
    [ "$1" -ge "$2" ] && [ "$1" -le "$3" ]
}

# dk_port_lesen: sets DK_PORT, the port of the bridge (0 to 65535; 0 lets the system choose, the default)
dk_port_lesen() {
    DK_PORT=0
    dk_alt bruecke.json port || return 0
    dp_w=""
    if [ "$DK_N" -eq 1 ]; then
        dp_w=$(dk_roh bruecke.json | grep -o -E '"port" *: *[0-9]+ *[,}]' | sed -E 's/^"port" *: *([0-9]+) *[,}]$/\1/')
    fi
    if dk_zahl "$dp_w" 0 65535; then DK_PORT=$dp_w; else log "werkbank: bruecke.json: port ungueltig, die Vorgabe gilt"; fi
    return 0
}

# dk_groesse_lesen: sets DK_SPALTEN and DK_ZEILEN, the size of the terminal of a session (columns 20 to 1000, rows 5 to 1000; default 120 and 40)
dk_groesse_lesen() {
    DK_SPALTEN=120
    DK_ZEILEN=40
    dk_alt kern.json groesse || return 0
    dg_p=""
    if [ "$DK_N" -eq 1 ]; then
        dg_p=$(dk_roh kern.json | grep -o -E '"groesse" *: *\[ *[0-9]+ *, *[0-9]+ *\]' | sed -E 's/^"groesse" *: *\[ *([0-9]+) *, *([0-9]+) *\]$/\1 \2/')
    fi
    dg_s=${dg_p% *}
    dg_z=${dg_p#* }
    if [ -n "$dg_p" ] && dk_zahl "$dg_s" 20 1000 && dk_zahl "$dg_z" 5 1000; then
        DK_SPALTEN=$dg_s
        DK_ZEILEN=$dg_z
    else
        log "werkbank: kern.json: groesse ungueltig, die Vorgabe gilt"
    fi
    return 0
}

dk_kern_text() {
    run=/run/user/$uid
    dk_groesse_lesen
    printf '{"socket":{"ordner":"%s/werkbank","name":"dienst.sock"},"betrachter":{"person":"%s","raum":"werkbank","ansicht":"browser"},"deflate":true,' "$run" "$nutzer"
    printf '"lauf":{"programm":"/usr/lib/werkbank/werkbank-lauf","env":{"TERM":"xterm-256color"},"groesse":[%s,%s],"einstellungen":"%s/%s/einstellungen.json","sitzungen":"%s/s/%s",' "$DK_SPALTEN" "$DK_ZEILEN" "$DATEN" "$nutzer" "$DATEN" "$uid"
    printf '"marker_datei":"%s/werkbank-probelauf/marker.json","marker_ordner":"%s/z/%s","ziellisten":"%s/%s/sitzungen","laufzeit":"%s/l/%s","bestand":"%s/%s/dienst/bestand.json","gespraeche":"%s/%s/gespraeche"},' "$run" "$DATEN" "$uid" "$DATEN" "$nutzer" "$DATEN" "$uid" "$DATEN" "$nutzer" "$DATEN" "$nutzer"
    printf '"anfang":{"personen":{"%s":{"art":"mensch","rolle":"nutzer"}},"sitzungen":[]}}\n' "$nutzer"
}

dk_bruecke_text() {
    run=/run/user/$uid
    dk_port_lesen
    printf '{"dienst":{"socket":"%s/werkbank/dienst.sock"},"port":%s,"token_datei":"%s/werkbank/bruecke.token","port_datei":"%s/werkbank/bruecke.port","deflate":true}\n' "$run" "$DK_PORT" "$run" "$run"
}

dk_schreiben() {
    name=$1
    install -d -m 0755 -o root -g root "$ETCW" || return 1
    tmp=$(mktemp "$ETCW/.$name.XXXXXX") || return 1
    if "dk_${name%.json}_text" >"$tmp" && chmod 0644 "$tmp" && chown root:root "$tmp" && mv -f "$tmp" "$ETCW/$name"; then
        return 0
    fi
    rm -f "$tmp"
    return 1
}

dienst_json() {
    uid=$(id -u "$nutzer" 2>/dev/null) || return 0
    case "$uid" in "" | *[!0-9]*) return 0 ;; esac
    dk_schreiben kern.json || return 1
    dk_schreiben bruecke.json || return 1
}
# --- dienst.json end
if [ -n "$nutzer" ]; then
    dienst_json || log "werkbank: kern.json oder bruecke.json nicht geschrieben"
fi

# Step 2c (addendum holder, form since the addendum "Rolle aus der Gruppe"): /etc/werkbank/halter.json for the user of step 1, root:root 0644,
# atomically, canonical JSON (RFC 8785) and LF, in the form $defs/konfig of rust/spec/halter: the uid of `id -u` with person null, the role
# bruecke at the group wb-bruecke, one target per network target with "schluessel": true of a route of the kind cloud in the template (never the
# working copy of the user): name and host are the host (a host that is no identifier is skipped, one journal line), port, tls true, praefix "",
# kopf authorization, vorsatz "Bearer ", schluessel anmeldung.<route> (with the admin switch eingeschraenktes_token true of the route
# anmeldung.<route>.eingeschraenkt, the restricted token; a switch that is no boolean drops the targets of the route, one count each,
# never the device token in its place), the rules "<METHOD> <path>" of the methods GET and POST as the template has them; no server, no
# kid. The template is the first-start profile erststart.json (addendum first start), never the demo settings einstellungen.json; at the
# model hosts api.individual.githubcopilot.com and api.business.githubcopilot.com the target carries the switch erststart_antwortform
# with the rules "GET /models" and "POST /chat/completions" that its pfade hold. Reference: rust/spec/paket/referenz.py `halter_konfig`.
# --- halter.json begin
HALTER_PY='import json, re, sys
vorlage = json.load(open(sys.argv[1], encoding="utf-8"))
kennung = re.compile(r"^[a-z0-9][a-z0-9._-]{0,63}$")
ziele, weg = {}, 0
for route in vorlage.get("routen", []):
    if route.get("art") != "cloud":
        continue
    for nz in route.get("netzziele", []):
        if nz.get("schluessel") is not True:
            continue
        regeln = [r["methode"] + " " + r["pfad"] for r in nz.get("pfade", []) if r.get("methode") in ("GET", "POST")]
        host = nz.get("host", "")
        token = route.get("eingeschraenktes_token", False)
        if not kennung.match(host) or not regeln or host in ziele or type(token) is not bool:
            weg += 1
            continue
        ziele[host] = {"host": host, "port": nz["port"], "tls": True, "praefix": "", "kopf": "authorization", "vorsatz": "Bearer ",
                       "schluessel": "anmeldung." + route["schluessel"] + (".eingeschraenkt" if token else ""), "pfade": regeln}
        modell_hosts = ("api.individual.githubcopilot.com", "api.business.githubcopilot.com")
        schalter = [r for r in ("GET /models", "POST /chat/completions") if r in regeln] if host in modell_hosts else []
        if schalter:
            ziele[host]["erststart_antwortform"] = schalter
wert = {"fassung": 1, "konten": {sys.argv[2]: {"person": None}}, "rollen": {"bruecke": "wb-bruecke"}, "ziele": ziele, "server": {}, "kids": {}}
sys.stdout.write(json.dumps(wert, sort_keys=True, separators=(",", ":"), ensure_ascii=False) + "\n")
sys.stderr.write(str(weg))'

halter_json() {
    hj_uid=$(id -u "$nutzer" 2>/dev/null) || return 1
    case "$hj_uid" in "" | *[!0-9]*) return 1 ;; esac
    [ -f "$VORLAGE/erststart.json" ] || return 1
    install -d -m 0755 -o root -g root "$ETCW" || return 1
    hj_tmp=$(mktemp "$ETCW/.halter.json.XXXXXX") || return 1
    hj_weg=$(python3 -I -c "$HALTER_PY" "$VORLAGE/erststart.json" "$hj_uid" 2>&1 >"$hj_tmp") || { rm -f "$hj_tmp"; return 1; }
    case "$hj_weg" in
        0) ;;
        *[!0-9]*) rm -f "$hj_tmp"; return 1 ;;
        *) log "werkbank: halter.json: Netzziele ausgelassen: $hj_weg" ;;
    esac
    if chmod 0644 "$hj_tmp" && chown root:root "$hj_tmp" && mv -f "$hj_tmp" "$ETCW/halter.json"; then
        return 0
    fi
    rm -f "$hj_tmp"
    return 1
}
# --- halter.json end
if [ -n "$nutzer" ]; then
    halter_json || log "werkbank: halter.json nicht geschrieben"
else
    log "werkbank: kein sudo-Nutzer, halter.json nicht geschrieben"
fi

# Step 2d (addendum "Vorgabe der Firma"): /etc/werkbank/vorgabe.json, the default of the firm for the network targets of the
# cloud routes (A45), read by werkbank-lauf at step 4b. A copy of the first-start profile erststart.json (contract 2), root:root
# 0644, atomically, in /etc/werkbank (root:root 0755); never from the working copy of the user. The settings of the user may then
# only strike targets of it. Without the profile no file: werkbank-lauf ends every cloud start with lauf.vorgabe_fehlt (fail closed).
# --- vorgabe.json begin
vorgabe_json() {
    [ -f "$VORLAGE/erststart.json" ] || return 1
    install -d -m 0755 -o root -g root "$ETCW" || return 1
    vj_tmp=$(mktemp "$ETCW/.vorgabe.json.XXXXXX") || return 1
    if cat "$VORLAGE/erststart.json" >"$vj_tmp" && chmod 0644 "$vj_tmp" && chown root:root "$vj_tmp" && mv -f "$vj_tmp" "$ETCW/vorgabe.json"; then
        return 0
    fi
    rm -f "$vj_tmp"
    return 1
}
# --- vorgabe.json end
vorgabe_json || log "werkbank: vorgabe.json nicht geschrieben"

# Step 2e (part A3, "Erstausstattung" and "Erster Admin"): the folder of the write helper and the company default with the first admin,
# then its socket. Never stops the installation; a deviation is one fixed journal line without path and without name.
#   1. /etc/werkbank/vorgabe: made with mode 0700, owner werkbank-vorgabe, then 0755; an existing one must be a folder (no link) of
#      werkbank-vorgabe with 0755, else nothing changes and the journal gets code 26.
#   2. firmenvorgabe.json only when lstat says ENOENT: the installing account (SUDO_USER, uid from `id -u`, name from `getent passwd
#      <uid>`; never uid 0, only the account form of H4) as the only admin. No account: no file, code 28. An existing entry in any form
#      stays byte for byte; its content is never read. The file comes atomically relative to the open folder (O_EXCL|O_NOFOLLOW, fsync,
#      fchown, fchmod 0644, compare) and reaches its name without overwriting (link, then unlink of the temporary name); an error leaves
#      no temporary file and gives code 26.
#   3. daemon-reload and `enable --now werkbank-vorgabe.socket`; the helper starts with the first connection.
# Reference: rust/spec/paket/referenz.py `vorgabe_erstausstattung`.
# --- firmenvorgabe begin
VG_ORDNER=/etc/werkbank/vorgabe
VG_ELTERN=/etc/werkbank
VG_VORLAGE=/usr/share/werkbank/vorgabe/firmenvorgabe.json
VG_NAME=werkbank-vorgabe
# the form of step 1 by lstat: a folder, no link, owner werkbank-vorgabe, mode 0755
VG_FORM_PY='import os, stat, sys
st = os.lstat(sys.argv[1])
sys.exit(0 if stat.S_ISDIR(st.st_mode) and st.st_uid == int(sys.argv[2]) and stat.S_IMODE(st.st_mode) == 0o755 else 26)'
VG_PY='import json, os, secrets, stat, sys
ordner, vorlage, konto, uid, gid = sys.argv[1], sys.argv[2], sys.argv[3], int(sys.argv[4]), int(sys.argv[5])
name = "firmenvorgabe.json"
try:
    fd = os.open(ordner, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
except OSError:
    sys.exit(26)
st = os.fstat(fd)
if not stat.S_ISDIR(st.st_mode) or st.st_uid != uid or stat.S_IMODE(st.st_mode) != 0o755:
    sys.exit(26)
try:
    os.stat(name, dir_fd=fd, follow_symlinks=False)
    sys.exit(3)
except FileNotFoundError:
    pass
except OSError:
    sys.exit(26)
try:
    with open(vorlage, encoding="utf-8") as f:
        v = json.load(f)
except (OSError, ValueError):
    sys.exit(26)
if v != {"admins": [], "leseklassen": []}:
    sys.exit(26)
daten = (json.dumps(dict(v, admins=[konto]), ensure_ascii=False, indent=1, sort_keys=True) + "\n").encode("utf-8")
temp = ".firmenvorgabe.json." + secrets.token_hex(8) + ".neu"
try:
    t = os.open(temp, os.O_RDWR | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600, dir_fd=fd)
except OSError:
    sys.exit(26)
try:
    rest = daten
    while rest:
        rest = rest[os.write(t, rest):]
    os.fsync(t)
    os.fchown(t, uid, gid)
    os.fchmod(t, 0o644)
    if os.pread(t, len(daten) + 1, 0) != daten:
        raise OSError("compare")
    os.close(t)
    t = -1
    os.link(temp, name, src_dir_fd=fd, dst_dir_fd=fd, follow_symlinks=False)
    os.unlink(temp, dir_fd=fd)
    os.fsync(fd)
except OSError:
    if t >= 0:
        os.close(t)
    try:
        os.unlink(temp, dir_fd=fd)
    except OSError:
        pass
    sys.exit(26)
sys.exit(0)'

vg_konto() {
    vg_k=""
    case "${SUDO_USER:-}" in "") return 1 ;; esac
    vg_kuid=$(id -u "$SUDO_USER" 2>/dev/null) || return 1
    case "$vg_kuid" in "" | *[!0-9]* | 0) return 1 ;; esac
    vg_k=$(getent passwd "$vg_kuid" 2>/dev/null | head -n 1 | cut -d: -f1)
    case "$vg_k" in
        "" | *[!a-z0-9_-]* | [!a-z_]*) vg_k=""; return 1 ;;
    esac
    return 0
}

firmenvorgabe() {
    vg_uid=$(getent passwd "$VG_NAME" 2>/dev/null | cut -d: -f3)
    vg_gid=$(getent group "$VG_NAME" 2>/dev/null | cut -d: -f3)
    case "$vg_uid$vg_gid" in "" | *[!0-9]*) log "werkbank: Ordner der Firmenvorgabe in fremder Form, Code 26"; return 0 ;; esac
    if [ ! -e "$VG_ORDNER" ] && [ ! -L "$VG_ORDNER" ]; then
        [ -d "$VG_ELTERN" ] || install -d -m 0755 -o root -g root "$VG_ELTERN" 2>/dev/null
        if ! { mkdir -m 0700 "$VG_ORDNER" && chown "$vg_uid:$vg_gid" "$VG_ORDNER" && chmod 0755 "$VG_ORDNER"; } 2>/dev/null; then
            log "werkbank: Ordner der Firmenvorgabe in fremder Form, Code 26"
            return 0
        fi
    fi
    if ! python3 -I -c "$VG_FORM_PY" "$VG_ORDNER" "$vg_uid" 2>/dev/null; then
        log "werkbank: Ordner der Firmenvorgabe in fremder Form, Code 26"
        return 0
    fi
    # an entry of any form under the name stays; the content is never read
    if [ -e "$VG_ORDNER/firmenvorgabe.json" ] || [ -L "$VG_ORDNER/firmenvorgabe.json" ]; then
        return 0
    fi
    if ! vg_konto; then
        log "werkbank: Firmenvorgabe nicht angelegt, kein Konto aus sudo, Code 28"
        return 0
    fi
    python3 -I -c "$VG_PY" "$VG_ORDNER" "$VG_VORLAGE" "$vg_k" "$vg_uid" "$vg_gid" 2>/dev/null
    case $? in
        0 | 3) ;;
        *) log "werkbank: Ordner der Firmenvorgabe in fremder Form, Code 26" ;;
    esac
    return 0
}

vorgabe_einheiten() {
    command -v systemctl >/dev/null 2>&1 || return 0
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl enable --now werkbank-vorgabe.socket >/dev/null 2>&1 || log "werkbank: Einheit nicht aktiviert"
    return 0
}
# --- firmenvorgabe end
firmenvorgabe
vorgabe_einheiten

# Step 3: the AppArmor profile of the fixed starter and the trial run of the enclosure (decision V1: only the starter
# `werkbank-einschluss` carries the profile; never a profile with the attachment /usr/bin/bwrap, never `unconfined`).
# Form B only: the own copy of bwrap first. This is the one step that stops the installation, with a fixed code:
#   11 bwrap is missing           12 apparmor_parser is missing   13 the profile file is missing or not readable
#   14 the parser rejects it      15 a foreign profile hangs at the path of the starter
#   16 the trial run fails after loading (as a user without privileges: root passes the lock without any profile)
STARTER=/usr/lib/werkbank/werkbank-einschluss
PROFIL=/etc/apparmor.d/usr.lib.werkbank.werkbank-einschluss
SYSCTL=/proc/sys/kernel/apparmor_restrict_unprivileged_userns

einschluss() {
    if [ -f /etc/apparmor.d/usr.lib.werkbank.bwrap ] && [ -x /usr/bin/bwrap ]; then
        install -m 0755 -o root -g root /usr/bin/bwrap /usr/lib/werkbank/bwrap 2>/dev/null || log "werkbank: bwrap-Kopie nicht angelegt"
    fi
    [ -x /usr/bin/bwrap ] || fail 11 "/usr/bin/bwrap fehlt (Paket bubblewrap)"
    if [ "$(cat "$SYSCTL" 2>/dev/null)" = 1 ]; then
        command -v apparmor_parser >/dev/null 2>&1 || fail 12 "apparmor_parser fehlt (Paket apparmor)"
        [ -f "$PROFIL" ] && [ -r "$PROFIL" ] || fail 13 "$PROFIL fehlt oder ist nicht lesbar"
        fremd=$(grep -rlE '/usr/lib/werkbank/werkbank-einschluss' /etc/apparmor.d 2>/dev/null | grep -v "^$PROFIL\$" || true)
        [ -z "$fremd" ] || fail 15 "$fremd haengt schon am Pfad $STARTER; nichts geaendert"
        m=$(apparmor_parser -r -W "$PROFIL" 2>&1) || fail 14 "$(printf '%s' "$m" | tr '\n' ' ')"
    fi
    if [ ! -x "$STARTER" ]; then
        # A skeleton build has no starter: the profile is loaded, but there is nothing to run. The check command reports the missing file.
        log "werkbank: Starter fehlt (Geruest), Probelauf uebersprungen"
        return 0
    fi
    command -v setpriv >/dev/null 2>&1 || fail 16 "setpriv fehlt, der Probelauf ist nicht moeglich"
    m=$(setpriv --reuid=65534 --regid=65534 --clear-groups "$STARTER" selbsttest 2>&1) || fail 16 "Probelauf scheitert: $m"
    echo "werkbank-einschluss: Probelauf gruen"
    return 0
}
einschluss

# Step 4: the user units, enabled for every user. A unit that is not in the package is skipped.
if command -v systemctl >/dev/null 2>&1; then
    for e in $EINHEITEN; do
        [ -f "/usr/lib/systemd/user/$e" ] || continue
        systemctl --global enable "$e" >/dev/null 2>&1 || log "werkbank: Einheit nicht aktiviert"
    done
fi

# Step 4a: the unit of the model path of an earlier package is no part of this package (the runner starts the model path for each
# session). Switch it off, stop it for the user and remove what is left, so that no trace stays after an upgrade.
if command -v systemctl >/dev/null 2>&1; then
    systemctl --global disable werkbank-modellweg.service >/dev/null 2>&1 || true
    if [ -n "$nutzer" ]; then
        systemctl --user --machine="$nutzer@" stop werkbank-modellweg.service >/dev/null 2>&1 || true
        systemctl --user --machine="$nutzer@" reset-failed werkbank-modellweg.service >/dev/null 2>&1 || true
    fi
fi
rm -f /etc/systemd/user/default.target.wants/werkbank-modellweg.service /usr/lib/systemd/user/werkbank-modellweg.service 2>/dev/null || true

# --- nutzerliste begin
# nutzer_liste: the users with a running user manager (decision of the operator, 28.11.2026; contract "Skripte des Pakets"). The list comes from
# `loginctl list-users` (columns uid and name); a user counts only when `user@<uid>.service` is active, the uid 0 never. Each name gets the check that SUDO_USER
# gets (not root, only a-z, 0-9, `_` and `-`, starts with a-z or `_`, at most 32 bytes) and must be in passwd with that uid. NL_GUT holds the
# names that pass (each once, in the order of loginctl); NL_AUS holds one word per user that fails: the uid (only with a running manager),
# or `-` when the uid is not a number. No name is guessed and no name of NL_AUS is printed. The variables carry the prefix nl_ (sh has no `local`).
nutzer_liste() {
    NL_GUT="" NL_AUS=""
    command -v loginctl >/dev/null 2>&1 || return 0
    command -v systemctl >/dev/null 2>&1 || return 0
    nl_text=$(loginctl list-users --no-legend --no-pager 2>/dev/null) || return 0
    nl_ifs=$IFS
    IFS='
'
    set -f
    for nl_zeile in $nl_text; do
        IFS=$nl_ifs
        # shellcheck disable=SC2086
        set -- $nl_zeile
        nl_uid=${1:-} nl_name=${2:-}
        case "$nl_uid" in
            "" | *[!0-9]*)
                NL_AUS="$NL_AUS -"
                continue
                ;;
            0) continue ;;
        esac
        systemctl is-active --quiet "user@$nl_uid.service" >/dev/null 2>&1 || continue
        nl_gut=""
        case "$nl_name" in
            "" | root) ;;
            *[!a-z0-9_-]*) ;;
            [a-z_]*) [ "${#nl_name}" -le 32 ] && nl_gut=1 ;;
        esac
        if [ -n "$nl_gut" ]; then
            nl_pw=$(getent passwd "$nl_name" 2>/dev/null) || nl_pw=""
            nl_rest=${nl_pw#*:*:}
            [ "${nl_pw%%:*}" = "$nl_name" ] && [ "${nl_rest%%:*}" = "$nl_uid" ] || nl_gut=""
        fi
        if [ -z "$nl_gut" ]; then
            NL_AUS="$NL_AUS $nl_uid"
            continue
        fi
        case " $NL_GUT " in
            *" $nl_name "*) ;;
            *) NL_GUT="$NL_GUT $nl_name" ;;
        esac
    done
    set +f
    IFS=$nl_ifs
    return 0
}
# --- nutzerliste end

# --- neustart begin
# Step 4b: (decision of the operator, 28.11.2026; contract "Skripte des Pakets", "Upgrade und laufende Dienste"): after an upgrade or a
# reinstall the units of the package that run for a user with a running user manager (nutzer_liste) restart with `try-restart`, one call per
# user for the running ones of core, bridge and holder (one start per unit; `try-restart` never starts a stopped unit). The start limit of the
# units stays as it is: a unit that does not run after the call is named in one line, and the installation goes on (exit 0).
# The note /run/werkbank-paket-neustart comes only from the prerm of an earlier package (it stopped the units of SUDO_USER and noted the ones
# that ran): for the user of the note, if that user passes nutzer_liste, exactly the noted units of the three start again; the note is removed in
# every case. `dpkg-reconfigure` (DEBCONF_RECONFIGURE=1) replaces no file and restarts nothing.
NEUSTART=/run/werkbank-paket-neustart
EINHEITEN_ORDNER=/usr/lib/systemd/user
notiz=""
if [ -f "$NEUSTART" ] && [ ! -L "$NEUSTART" ]; then
    notiz=$(head -n 1 "$NEUSTART" 2>/dev/null) || notiz=""
fi
rm -f "$NEUSTART" 2>/dev/null || true
if [ "${DEBCONF_RECONFIGURE:-}" != 1 ] && command -v systemctl >/dev/null 2>&1; then
    nutzer_liste
    for u in $NL_AUS; do
        if [ "$u" = - ]; then
            echo "werkbank: ein Nutzer uebersprungen, seine uid ist keine Zahl; seine Dienste starten nicht neu"
        else
            echo "werkbank: Nutzer mit uid $u uebersprungen, der Name ist nicht gueltig; seine Dienste starten nicht neu"
        fi
        log "werkbank: Nutzer uebersprungen"
    done
    notiz_nutzer=${notiz%% *}
    for n in $NL_GUT; do
        art=try-restart liste=""
        for e in $EINHEITEN; do
            [ -f "$EINHEITEN_ORDNER/$e" ] || continue
            if [ "$n" = "$notiz_nutzer" ]; then
                art=start
                case " $notiz " in
                    *" $e "*) liste="$liste $e" ;;
                esac
            elif systemctl --user --machine="$n@" is-active --quiet "$e" >/dev/null 2>&1; then
                liste="$liste $e"
            fi
        done
        [ -n "$liste" ] || continue
        echo "werkbank: Neustart der Dienste von $n:$liste; laufende Sitzungen enden, wartende und erteilte Freigaben verfallen"
        # shellcheck disable=SC2086
        systemctl --user --machine="$n@" "$art" $liste >/dev/null 2>&1 || true
        for e in $liste; do
            if ! systemctl --user --machine="$n@" is-active --quiet "$e" >/dev/null 2>&1; then
                echo "werkbank: Einheit $e von $n laeuft nach dem Neustart nicht (Startgrenze oder Fehler); systemctl --user status $e"
                log "werkbank: Einheit nicht neu gestartet"
            fi
        done
    done
fi
# --- neustart end

# Step 5: the check command writes its lines to the journal; its exit code does not count. The channel of debconf is closed first, so
# no child process inherits it.
command -v db_stop >/dev/null 2>&1 && db_stop
if [ -x /usr/bin/werkbank-pruefen ]; then
    /usr/bin/werkbank-pruefen 2>&1 | logger -t werkbank-installation 2>/dev/null || true
fi
exit 0
