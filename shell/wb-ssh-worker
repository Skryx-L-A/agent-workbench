#!/bin/bash
# wb-ssh-worker — spawn a worker on the OTHER machine and mirror it into the local grid.
#
#   wb-ssh-worker <mac|peer> <claude|pi> <name> <model>[:effort] <workdir> <task...>
#
# Called by `claude-worker --on <machine> …` and `pi-worker --on <machine> …`;
# not meant to be typed directly. Two halves:
#
#   REMOTE  the target machine spawns the worker with ITS OWN claude-worker/pi-worker
#           (nothing is installed or changed over there) into its visible orchestrator
#           session — `wb-orch` on peer, the attached wb-* session on the Mac — in an
#           OWN window named `ssh-<name>`. TMUX_PANE is set explicitly, exactly like
#           peer's `orch-launch` does, because a machine with several wb-* sessions
#           cannot guess the target.
#           Seit 14.11.2026 laeuft dieser Start drueben in einem dauerhaften STARTER-PANE
#           je gemessenem Absender-Pane hier (Abschnitt STARTER-PANE unten): nur so kommen
#           Erstauftrag und Nachtrag dort gemessen als AUFTRAG an (wb-inbox, HERKUNFT).
#           Folge: Der Aufruf kehrt erst zurueck, wenn der Start drueben fertig ist (Kontingent,
#           Bereitschaft, Zustellung), hoechstens nach STARTER_FRIST = 900 s; dessen stderr
#           erscheint erst am Ende, nicht laufend. Laeuft die Frist ab, meldet dieser Aufruf
#           einen Fehler, der Start drueben laeuft aber weiter.
#   LOCAL`wb-remote-view <machine>` — EIN Spiegel-Pane je Zielmaschine, der die
#           ganze Worker-Session des Ziels zeigt (nicht mehr einer je Worker, siehe
#           Kopf von wb-remote-view). Ein Spiegel je entfernter SESSION, markiert als
#           `@wb_worker REMOTE-<machine>-<session>`, von wb-grid wie jeder Worker
#           eingeordnet; er verschwindet wieder, sobald in seiner Session drueben kein
#           Worker mehr laeuft.
#
# Name contract: the worker is called `SSH-<name>` EVERYWHERE — @wb_worker on both
# machines, pane title, result directory ~/.pi-workers/results/SSH-<name>/ on the
# TARGET machine, and the entry in the workbench state file (with `machine`).
# Result: `wb-result SSH-<name>` (it finds the machine itself).
#
# EIGENTUEMER (2026-08-27): dieses Skript stempelt die Ziel-Session drueben mit
# `@wb_owner <eigene-maschine>:<eigene-lokale-session>` (tmux-SESSION-Option, siehe Kopf
# von wb-remote-view). Nur so kann ein spaeterer automatischer Poll (context-guard) oder
# eine Ansage von drueben diese Session zuverlaessig der richtigen lokalen Session
# zuordnen, statt — wie am 27.08. geschehen — ALLE Sessions der Zielmaschine blind in die
# gerade zufaellig angehaengte lokale Session zu mischen.
set -u

MACHINE="${1:?machine (mac|peer)}"; KIND="${2:?claude|pi}"
NAME="${3:?name}"; MODEL="${4:?model}"; WORKDIR="${5:?workdir}"; shift 5
TASK="$*"

case "$MACHINE" in mac|peer) ;; *) echo "wb-ssh-worker: unbekannte Maschine '$MACHINE' (mac|peer)" >&2; exit 1 ;; esac

# Heimpfad (14.11.2026, Probestart --on peer): Die Maschinen haben verschiedene Heime (/Users/<n> am Mac,
# /home/<n> auf peer). Die aufrufende Shell hat `~` und `$HOME` im Arbeitsordner schon zum EIGENEN Heim
# aufgeloest; drueben gab es den Ordner nicht ("cd: /Users/...: No such file or directory"). Ein Pfad unter
# dem eigenen HOME geht deshalb als `~/<rest>` hinueber, und die Fernseite setzt ihr eigenes HOME ein.
# Ein Pfad ausserhalb des Heims bleibt, wie er ist.
case "$WORKDIR" in
  "$HOME") WORKDIR="~" ;;
  "$HOME"/*) WORKDIR="~/${WORKDIR#"$HOME"/}" ;;
esac
case "$KIND" in claude|pi) ;; *) echo "wb-ssh-worker: unbekannte Worker-Art '$KIND' (claude|pi)" >&2; exit 1 ;; esac

# Eigentuemer-Markierung fuer den Spiegel (2026-08-27, siehe Kopf von wb-remote-view):
# WIR sind die einzige Stelle, die beim Entstehen eines entfernten Workers sowohl die
# eigene Maschine als auch die eigene lokale Session kennt -- die Zielmaschine erfaehrt
# das nur, wenn wir es ihr mitgeben. Ohne diese Markierung bleibt die entfernte Session
# "unmarkiert" und wird nur noch auf ausdruecklichen Zuruf gespiegelt (Entscheidung im
# Kopf von wb-remote-view), nie mehr automatisch -- ein Worker, der trotzdem laeuft,
# ist besser als einer, der der falschen Session zugeordnet wird.
case "$(uname -s)" in Darwin) SELF=mac ;; *) SELF=peer ;; esac
local_owner_session() {
  local s=""
  if [ -n "${TMUX_PANE:-}" ]; then
    s=$(tmux list-panes -a -F '#{pane_id}|#{session_name}' 2>/dev/null \
        | awk -F'|' -v p="$TMUX_PANE" '$1==p{print $2; exit}')
  fi
  if [ -z "$s" ]; then
    s=$(tmux list-sessions -F '#{session_attached} #{session_name}' 2>/dev/null \
        | awk '$1>=1 && $2 ~ /^wb-/{print $2; exit}')
  fi
  while [ "${s%-view}" != "$s" ]; do s="${s%-view}"; done
  printf '%s' "$s"
}
LOCALSESS="$(local_owner_session)"
OWNER=""
[ -n "$LOCALSESS" ] && OWNER="$SELF:$LOCALSESS"

# STARTER-PANE (14.11.2026, task). Drueben zeigt wb-inbox eine Sendung nur dann
# als AUFTRAG, wenn sie aus dem Pane kommt, den pi-worker als @wb_spawner des Workers eingetragen hat
# (Abschnitt HERKUNFT in wb-inbox). Eine ssh-Shell hat keinen Pane-Ahnen (gemessen 14.11. auf peer:
# bash <- sshd-session <- sshd), also blieb dort jeder Auftrag INFORMATION. Deshalb laeuft jeder
# Start, Erstauftrag wie Nachtrag, drueben IN einem dauerhaften Starter-Pane: genau einer je
# ABSENDER-PANE hier. Der Absender-Pane ist gemessen (`wb-inbox absender-pane`, Ahnenkette, festes
# tmux), nie TMUX_PANE. Ohne gemessenen Pane gibt es keinen Starter: drueben laeuft alles wie
# vorher in der ssh-Shell, und jede Sendung bleibt INFORMATION.
# Der Schluessel nennt Maschine, tmux-Server (PID und Startzeit, Pane-Kennungen beginnen nach einem
# Neustart wieder bei %0) und Pane. So landet der Nachtrag eines ANDEREN Panes nie im Starter, der
# den Worker gestartet hat, und bleibt drueben INFORMATION.
# GRENZE: Der Schluessel reist als Argument ueber ssh. Wer den ssh-Schluessel hat oder drueben unter
# derselben Kennung laeuft, kann den Starter-Pane selbst ansprechen (fremden Schluessel nennen,
# `tmux respawn-pane` auf ihn, @wb_ssh_starter an einen anderen Pane schreiben) und erhaelt dann
# AUFTRAG an die Worker dieses Starters. Das ist dieselbe Klasse wie die GRENZE in wb-inbox: Code
# unter derselben Kennung kann @wb_spawner umschreiben. Geschuetzt ist gegen behauptete Herkunft
# im Text und gegen Sendungen aus anderen Panes oder von ausserhalb jedes Panes.
INBOX_BIN=""
for kandidat in "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/wb-inbox" "$HOME/.local/bin/wb-inbox"; do
  [ -x "$kandidat" ] && { INBOX_BIN="$kandidat"; break; }
done
ABS_PANE=""
[ -n "$INBOX_BIN" ] && ABS_PANE="$("$INBOX_BIN" absender-pane 2>/dev/null)" || ABS_PANE=""
[[ "$ABS_PANE" =~ ^%[0-9]+$ ]] || ABS_PANE=""
STARTER_KEY=""
if [ -n "$ABS_PANE" ]; then
  SERVER_ID="$(tmux display -p -t "$ABS_PANE" '#{pid}.#{start_time}' 2>/dev/null)"
  [[ "$SERVER_ID" =~ ^[0-9]+\.[0-9]+$ ]] || SERVER_ID=""
  [ -n "$SERVER_ID" ] && STARTER_KEY="${SELF:-unbekannt}:$SERVER_ID:$ABS_PANE"
fi
[ -n "$STARTER_KEY" ] || echo "wb-ssh-worker: Hinweis — kein Absender-Pane gemessen; der Worker auf $MACHINE bekommt diesen Auftrag nur als INFORMATION." >&2
# Frist fuer einen Start im Starter-Pane (Sekunden): pi-worker wartet auf Kontingent, Bereitschaft
# und Zustellung. Danach meldet die Fernseite einen Fehler; der Start selbst laeuft drueben weiter.
STARTER_FRIST=900

# `SSH-` is added once, never twice — callers may already carry the prefix.
BASE="${NAME#SSH-}"
SSHNAME="SSH-$BASE"
WIN="ssh-$BASE"
# Eine eigene View-Session je Worker gibt es seit 2026-08-13 NICHT mehr (`view-SSH-<name>`).
# Der Spiegel haengt an der Orchestrator-Session des Ziels; `wb-remote-view` legt die eine
# gruppierte Sicht dort an. Begruendung im Kopf jener Datei.

# POSIX-safe single-quoting for everything that crosses the ssh command line.
q() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

# The target's orchestrator session: fixed on peer, auto-detected on the Mac.
[ "$MACHINE" = peer ] && RSESS="wb-orch" || RSESS=""

TASK_B64=$(printf '%s' "$TASK" | base64 | tr -d '\n')

# ---------------------------------------------------------------- remote half
# The script runs on the TARGET with the target's own scripts — nothing of ours is
# installed over there. It is kept in a variable because it may have to run twice
# (see the delivery check below).
# read statt $(cat <<...): bash parst ein 'case ... )' im Rumpf einer Befehlsersetzung falsch.
IFS= read -r -d '' REMOTE_SCRIPT <<'REMOTE' || :
set -u
# Eine nicht-interaktive ssh-Shell traegt nur den Systempfad (gemessen 2026-09-19 auf peer:
# /usr/local/bin:/usr/bin:/bin). Die Harness-Programme liegen aber unter ~/.local/bin bzw. in
# den mise-Shims; ohne sie meldet die Registry "Binary 'codex' ... nicht installiert".
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:/opt/homebrew/bin:$PATH"
SESS="$1"; WIN="$2"; NAME="$3"; MODEL="$4"; WORKDIR="$5"; KIND="$6"; TASK_B64="$7"; OWNER="${8:-}"
STARTER_KEY="${9:-}"; FRIST="${10:-900}"
# `~` im Arbeitsordner meint das Heim DIESER Maschine (siehe Heimpfad im Kopf des aufrufenden Teils).
case "$WORKDIR" in "~") WORKDIR="$HOME" ;; "~/"*) WORKDIR="$HOME/${WORKDIR#"~/"}" ;; esac
case "$FRIST" in ''|*[!0-9]*) FRIST=900 ;; esac

if [ -z "$SESS" ]; then
  SESS=$(tmux list-sessions -F '#{session_attached} #{session_name}' 2>/dev/null | awk '$1>=1 && $2 ~ /^wb-/{print $2; exit}')
  if [ -z "$SESS" ]; then
    n=$(tmux list-sessions -F '#{session_name}' 2>/dev/null | grep -c '^wb-')
    [ "$n" = "1" ] && SESS=$(tmux list-sessions -F '#{session_name}' | grep '^wb-')
  fi
  [ -z "$SESS" ] && { echo "FEHLER: Ziel-Workbench auf der Zielmaschine nicht eindeutig (keine/mehrere wb-* Sessions)." >&2; exit 1; }
fi
# Fenster 'orch' mit einer NICHT-Login-Shell ohne rc-Dateien (task, 19.10.2026). Ohne
# Kommando startet tmux eine Login-Shell, die die rc-Dateien liest und als Waise liegen bleiben
# kann. bash statt eines festen Platzhalters: orch-launch raeumt Basis-Shells mit
# pane_current_command 'bash' nach dem ersten Spawn ab; ein Platzhalter bliebe dort stehen.
tmux has-session -t "=$SESS" 2>/dev/null || tmux new-session -d -s "$SESS" -n orch 'exec /bin/bash --noprofile --norc'
# @wb_owner (siehe Kopf von wb-remote-view): bei JEDEM Aufruf neu gesetzt, nicht nur
# beim ersten -- ueberlebt so einen Neustart dieser Session (der naechste Worker-Spawn
# stempelt sie erneut) und verfaellt sauber, wenn niemand mehr hier hineinspawnt.
[ -n "$OWNER" ] && tmux set-option -t "=$SESS:" @wb_owner "$OWNER" 2>/dev/null

# Der eigentliche Start steht in einer eigenen Datei. Er laeuft im Starter-Pane (STARTER-PANE im
# Kopf von wb-ssh-worker) oder, ohne Schluessel, wie vor dem 14.11.2026 in dieser ssh-Shell.
BASIS="$HOME/.local/state/wb-ssh-starter"
mkdir -p "$BASIS" && chmod 700 "$BASIS" || { echo "FEHLER: $BASIS nicht anlegbar." >&2; exit 1; }
AUFTRAG_DIR=$(mktemp -d "$BASIS/auftrag.XXXXXX") || { echo "FEHLER: Auftragsordner unter $BASIS nicht anlegbar." >&2; exit 1; }
case "$AUFTRAG_DIR" in *[!A-Za-z0-9._/-]*) echo "FEHLER: Auftragsordner '$AUFTRAG_DIR' hat Zeichen ausserhalb [A-Za-z0-9._/-]." >&2; rm -rf "$AUFTRAG_DIR"; exit 1 ;; esac
printf '%s\0' "$SESS" "$WIN" "$NAME" "$MODEL" "$WORKDIR" "$KIND" "$TASK_B64" > "$AUFTRAG_DIR/args"
cat > "$AUFTRAG_DIR/job.sh" <<'JOB'
set -u
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:/opt/homebrew/bin:$PATH"
SESS="$1"; WIN="$2"; NAME="$3"; MODEL="$4"; WORKDIR="$5"; KIND="$6"; TASK_B64="$7"
TASK=$(printf '%s' "$TASK_B64" | base64 -d 2>/dev/null || printf '%s' "$TASK_B64" | base64 -D)

# Own window per ssh worker — only that makes a mirror of exactly ONE worker possible.
wid=$(tmux list-windows -t "=$SESS" -F '#{window_id} #{window_name}' | awk -v n="$WIN" '$2==n{print $1; exit}')
fresh=0
if [ -z "$wid" ]; then
  wid=$(tmux new-window -d -t "=$SESS:" -n "$WIN" -P -F '#{window_id}' 'exec sleep 604800')
  tmux set-option -w -t "$wid" automatic-rename off    # global automatic-rename would eat the contract name
  fresh=1
fi
ph=$(tmux list-panes -t "$wid" -F '#{pane_id} #{pane_active}' | awk '$2==1{print $1; exit}')

# The target spawns with ITS OWN scripts; TMUX_PANE names the pane to split.
if [ "$KIND" = claude ]; then
  env TMUX_PANE="$ph" "$HOME/.local/bin/claude-worker" "$NAME" "$MODEL" "$WORKDIR" "$TASK"; rc=$?
else
  env TMUX_PANE="$ph" "$HOME/.local/bin/pi-worker" "$NAME" "$MODEL" "$WORKDIR" "$TASK"; rc=$?
fi

# Where did the worker really end up? An existing pane of the same name is reused
# (same name = same pane = same context), possibly in a different window.
wp=$(tmux list-panes -a -F '#{pane_id} #{@wb_worker} #{window_id} #{window_name}' | awk -v n="$NAME" '$2==n{print $1"|"$3"|"$4; exit}')
if [ -n "$wp" ]; then
  wpane=${wp%%|*}; rest=${wp#*|}; wwid=${rest%%|*}; wname=${rest#*|}
  if [ "$wwid" = "$wid" ] && [ "$wpane" != "$ph" ]; then
    tmux kill-pane -t "$ph" 2>/dev/null      # placeholder did its job
  elif [ "$wwid" != "$wid" ] && [ "$fresh" = 1 ]; then
    tmux kill-window -t "$wid" 2>/dev/null   # worker was reused elsewhere: drop the empty window
  fi
  # Report the ORCHESTRATOR session. A grouped view session shares the same windows,
  # so `display -p '#{session_name}'` on the pane may name the view instead.
  ws=$(tmux list-panes -a -F '#{session_name} #{pane_id}' | awk -v p="$wpane" -v s="$SESS" '$2==p && $1==s{print $1; exit}')
  [ -z "$ws" ] && ws=$(tmux display -p -t "$wpane" '#{session_name}')
  echo "WBSESS=$ws"
  echo "WBWIN=$wname"
  echo "WBPANE=$wpane"
fi
exit $rc
JOB

if [ -z "$STARTER_KEY" ]; then
  # Kein gemessener Absender-Pane: wie bisher in dieser ssh-Shell. Jede Sendung an den Worker
  # bleibt dann INFORMATION.
  a=(); while IFS= read -r -d '' x; do a+=("$x"); done < "$AUFTRAG_DIR/args"
  bash "$AUFTRAG_DIR/job.sh" "${a[@]}"; rc=$?
  rm -rf "$AUFTRAG_DIR"
  exit $rc
fi
case "$STARTER_KEY" in *[!A-Za-z0-9:%._-]*) echo "FEHLER: Starter-Schluessel '$STARTER_KEY' hat Zeichen ausserhalb [A-Za-z0-9:%._-]." >&2; rm -rf "$AUFTRAG_DIR"; exit 1 ;; esac

# Der Starter-Pane dieses Absenders in dieser Session: gefunden ueber @wb_ssh_starter, sonst neu
# in einem eigenen Fenster. remain-on-exit haelt die Kennung, auch wenn sein Prozess endet.
# ROLLE (Nachtrag 1, 14.11.2026): @wb_role ssh-starter, NICHT orchestrator und NICHT worker.
# context-guard waehlt den ersten lebenden orchestrator-Pane einer Session als Anker und verlaesst
# dann den Modus workers-only (context-guard, --ensure); auf peer hat wb-orch keinen solchen Pane.
# Leer darf die Rolle auch nicht sein: orch-launch raeumt Panes ohne Rolle mit 'bash' ab, und
# waehrend eines Starts laeuft hier bash.
sp=$(tmux list-panes -s -t "=$SESS" -F '#{pane_id}|#{@wb_ssh_starter}' 2>/dev/null | awk -F'|' -v k="$STARTER_KEY" '$2==k{print $1; exit}')
if [ -z "$sp" ]; then
  sp=$(tmux new-window -d -t "=$SESS:" -n ssh-starter -P -F '#{pane_id}' 'exec sleep 2147483647') \
    || { echo "FEHLER: Starter-Pane in '$SESS' nicht anlegbar." >&2; rm -rf "$AUFTRAG_DIR"; exit 1; }
  tmux set-option -w -t "$sp" automatic-rename off
  tmux set-option -p -t "$sp" @wb_ssh_starter "$STARTER_KEY"
fi
tmux set-option -p -t "$sp" remain-on-exit on
tmux set-option -p -t "$sp" @wb_role ssh-starter

# Ein Start zur Zeit je Starter-Pane: respawn-pane -k beendete sonst einen laufenden Start.
# Die Sperre haelt erst diese Shell, dann der Start im Pane. Verwaist ist sie nur, wenn beide
# Prozesse weg sind und sie aelter als eine Minute ist.
SERVER=$(tmux display -p -t "$sp" '#{pid}')
SPERRE="$BASIS/sperre-$SERVER-${sp#%}"
bis=$((SECONDS + FRIST))
until mkdir "$SPERRE" 2>/dev/null; do
  lebt=0
  for p in $(cat "$SPERRE/halter" "$SPERRE/start" 2>/dev/null); do
    case "$p" in ''|*[!0-9]*) continue ;; esac
    kill -0 "$p" 2>/dev/null && lebt=1
  done
  if [ "$lebt" = 0 ] && [ -n "$(find "$SPERRE" -maxdepth 0 -mmin +1 2>/dev/null)" ]; then
    rm -rf "$SPERRE"; continue
  fi
  [ "$SECONDS" -lt "$bis" ] || { echo "FEHLER: Starter-Pane $sp ist seit ${FRIST}s belegt (Sperre $SPERRE)." >&2; rm -rf "$AUFTRAG_DIR"; exit 1; }
  sleep 0.5
done
echo $$ > "$SPERRE/halter"
printf '%s' "$SPERRE" > "$AUFTRAG_DIR/sperre"

# KEIN STEUERNDES TERMINAL (Nachtrag 1): os.setsid() loest den Start vom Pseudoterminal des Panes,
# ohne zu forken (bash ist hier nicht Gruppenfuehrer), die Ahnenkette bis zur pane_pid bleibt also.
# Gemessen 14.11. am Mac auf einem eigenen tmux-Server: tty '??', ppid = pane_pid, wb-mensch
# 'agent'. Mit Terminal zaehlte ein Pane des Werkbank-Servers fuer wb-mensch als Mensch (M1), und
# die Herkunft fiele auf INFORMATION.
cat > "$AUFTRAG_DIR/run" <<'RUN'
d="${0%/*}"
sperre="$(cat "$d/sperre")"
echo $$ > "$sperre/start"
a=(); while IFS= read -r -d '' x; do a+=("$x"); done < "$d/args"
/usr/bin/python3 -I -S -c 'import os, sys
os.setsid()
os.execv("/bin/bash", ["bash"] + sys.argv[1:])' "$d/job.sh" "${a[@]}" < /dev/null > "$d/out" 2> "$d/err"; rc=$?
printf '%s\n' "$rc" > "$d/rc.tmp" && mv "$d/rc.tmp" "$d/rc"
rm -rf "$sperre"
exec sleep 2147483647
RUN
if ! tmux respawn-pane -k -t "$sp" "exec /bin/bash --noprofile --norc '$AUFTRAG_DIR/run'"; then
  echo "FEHLER: respawn-pane im Starter-Pane $sp scheiterte." >&2
  rm -rf "$SPERRE" "$AUFTRAG_DIR"; exit 1
fi
n=0
while [ ! -e "$AUFTRAG_DIR/rc" ]; do
  if [ "$SECONDS" -ge "$bis" ]; then
    echo "FEHLER: Start im Starter-Pane $sp nach ${FRIST}s nicht fertig; er laeuft dort weiter (Ordner $AUFTRAG_DIR)." >&2
    exit 1
  fi
  n=$((n+1))
  if [ $((n % 25)) = 0 ] && ! tmux display -p -t "$sp" '#{pane_id}' >/dev/null 2>&1; then
    echo "FEHLER: Starter-Pane $sp ist waehrend des Starts verschwunden." >&2
    rm -rf "$SPERRE"; exit 1
  fi
  sleep 0.2
done
cat "$AUFTRAG_DIR/err" >&2
cat "$AUFTRAG_DIR/out"
rc=$(cat "$AUFTRAG_DIR/rc")
rm -rf "$AUFTRAG_DIR"
case "$rc" in ''|*[!0-9]*) rc=1 ;; esac
exit "$rc"
REMOTE

remote_spawn() {
  printf '%s\n' "$REMOTE_SCRIPT" | ssh -o BatchMode=yes -o ConnectTimeout=10 "$MACHINE" \
    "bash -s -- $(q "$RSESS") $(q "$WIN") $(q "$SSHNAME") $(q "$MODEL") $(q "$WORKDIR") $(q "$KIND") $(q "$TASK_B64") $(q "$OWNER") $(q "$STARTER_KEY") $(q "$STARTER_FRIST")"
}

REMOTE_OUT=$(remote_spawn) \
  || { echo "$REMOTE_OUT" >&2; echo "wb-ssh-worker: Spawn auf '$MACHINE' fehlgeschlagen." >&2; exit 1; }

parse_remote() {
  RSESS_REAL=$(printf '%s\n' "$REMOTE_OUT" | sed -n 's/^WBSESS=//p' | tail -1)
  RWIN=$(printf '%s\n' "$REMOTE_OUT" | sed -n 's/^WBWIN=//p' | tail -1)
  RPANE=$(printf '%s\n' "$REMOTE_OUT" | sed -n 's/^WBPANE=//p' | tail -1)
  # The result file lives on the TARGET machine; pi-worker printed the timestamped
  # path, the latest.md symlink is the stable one.
  RRES=$(printf '%s\n' "$REMOTE_OUT" | sed -n 's/^Ergebnis-Datei: \([^ ]*\).*/\1/p' | tail -1)
}
parse_remote
[ -n "$RSESS_REAL" ] || { printf '%s\n' "$REMOTE_OUT" >&2; echo "wb-ssh-worker: Zielmaschine hat keinen Worker-Pane gemeldet — Abbruch." >&2; exit 1; }
[ -n "$RWIN" ] || RWIN="$WIN"

# DELIVERY CHECK. A task pasted into a still-booting TUI is swallowed silently, and
# the sender cannot tell: its "input box empty" check also passes when nothing ever
# arrived. peer's readiness pattern matches Claude Code's welcome-box border, which
# renders before the input is live — the first task of a fresh worker is lost there.
# We cannot patch the other machine, so we verify from here: does the pane show our
# task? If not, send it once more — the second call reuses the existing pane and
# pastes immediately (no readiness wait).
if [ -n "$TASK" ] && [ -n "$RPANE" ]; then
  PROBE=$(printf '%s' "$TASK" | head -c 40)

  # PANE FUEHRT VERLAUF? (2026-08-20, derselbe Fund wie in pi-worker heute, hier
  # noch offen.) `capture-pane -S -2000` verspricht 2000 Zeilen Rueckblick, aber
  # im ALTERNATE SCREEN fuehrt tmux GAR KEINEN Verlauf (in pi-worker gemessen:
  # alternate_on=1 ergibt history_size=0) — die Option liefert dort nur das
  # gerade sichtbare Bild, und das ist bei einem frisch startenden TUI schmal
  # und vergaenglich. "Marker nicht gefunden" auf so einem Pane beweist also
  # NICHT, dass der Auftrag fehlt; er kann so gut aus dem sichtbaren Rahmen
  # herausgeschoben worden sein. Erst den Pane selbst fragen (misst die
  # Tatsache direkt), bei fehlender Antwort (Pane weg, ssh-Fehler) auf die
  # Registry zurueckfallen (Feld altScreen des Harness) — dieselbe Kaskade wie
  # pi-worker.
  RHARNESS="$KIND"
  [ "$KIND" = pi ] && RHARNESS="$("$HOME/.local/bin/wb-state" models get "$MODEL" --field harness 2>/dev/null || true)"
  PANE_ALT=$(ssh -o BatchMode=yes -o ConnectTimeout=10 "$MACHINE" \
      "tmux display -p -t $(q "$RPANE") '#{alternate_on}'" 2>/dev/null)
  PANE_FUEHRT_VERLAUF=1
  case "$PANE_ALT" in
    1) PANE_FUEHRT_VERLAUF=0 ;;
    0) PANE_FUEHRT_VERLAUF=1 ;;
    *) if "$HOME/.local/bin/wb-state" models harness-get "${RHARNESS:-$KIND}" 2>/dev/null \
         | /usr/bin/python3 -c 'import json,sys
try: sys.exit(0 if json.load(sys.stdin).get("altScreen") is True else 1)
except Exception: sys.exit(1)'; then
         PANE_FUEHRT_VERLAUF=0
       fi ;;
  esac

  delivered() { ssh -o BatchMode=yes -o ConnectTimeout=10 "$MACHINE" \
      "tmux capture-pane -p -S -2000 -t $(q "$RPANE") | grep -qF $(q "$PROBE")" 2>/dev/null; }
  if ! delivered; then
    sleep 4
    if ! delivered; then
      if [ "$PANE_FUEHRT_VERLAUF" = 0 ]; then
        # Kein Gegenbeleg aus einem leeren Verlauf (2026-08-20): dieser Pane hat
        # gar keine Scrollback, "nicht gefunden" heisst hier "war vielleicht
        # schon aus dem sichtbaren Bild raus", nicht "kam nie an". Ein
        # automatischer Zweitversand wuerde bei echter Zustellung den Auftrag
        # verdoppeln — deshalb hier nur melden, nicht erneut senden.
        echo "Hinweis: Task im Pane von '$SSHNAME' auf $MACHINE nicht gefunden — Pane ist Alternate Screen (kein Verlauf, siehe pi-worker), das ist KEIN Gegenbeleg. Von Hand pruefen statt automatisch erneut senden." >&2
      else
        echo "Hinweis: Task kam im frisch gestarteten Pane nicht an (TUI war noch nicht bereit) — sende erneut." >&2
        REMOTE_OUT=$(remote_spawn) || true
        parse_remote
        [ -n "$RWIN" ] || RWIN="$WIN"
        sleep 2
        delivered || echo "WARNUNG: Task in '$SSHNAME' auf $MACHINE auch nach dem zweiten Versuch nicht sichtbar — Pane pruefen." >&2
      fi
    fi
  fi
fi

printf '%s\n' "$REMOTE_OUT" | grep -v '^WB\(SESS\|WIN\|PANE\)='

# ---------------------------------------------------------------- local half
#
# UMBAU 2026-08-13: der Spiegel haengt jetzt an der ORCHESTRATOR-Session des Ziels
# (`wb-orch` auf peer), nicht mehr an einer eigenen View-Session je Worker. Diese Datei
# baut die lokale Sicht deshalb nicht mehr selbst — sie ruft `wb-remote-view`, das genau
# dasselbe Verfahren fuer ALLE Remote-Worker macht, gleich wer sie gestartet hat.
# Der Grund steht ausfuehrlich im Kopf von `wb-remote-view`; kurz: ein per `orch-launch`
# auf peer gestarteter Worker kommt hier nie vorbei und blieb deshalb unsichtbar, und
# eine View-Session je Worker hat dreimal Streu-Sessions erzeugt.
find_local_pane() {
  tmux list-panes -a -F '#{session_name}|#{pane_id}|#{@wb_worker}|#{pane_dead}' 2>/dev/null \
    | awk -F'|' -v p="REMOTE-$MACHINE-" '$1 ~ /^wb-/ && index($3, p)==1 {print $2" "$4; exit}'
}
# --owned-only (2026-08-27): dieser Aufruf ist automatisch, kein Mensch hat gerade nach
# GENAU dieser entfernten Session gefragt. Ohne die Markierung von oben liefe er sonst
# ALLE Sessions der Zielmaschine ein und mischte fremde hinein (Befund 27.08.) -- mit ihr
# landet nur die Session, die WIR gerade eben selbst markiert haben, sicher am richtigen
# Ort, egal welche lokale Session hier zufaellig angehaengt ist.
if [ -x "$HOME/.local/bin/wb-remote-view" ]; then
  "$HOME/.local/bin/wb-remote-view" "$MACHINE" --owned-only || true
else
  echo "WARNUNG: wb-remote-view fehlt — der Worker laeuft auf $MACHINE, aber ohne Spiegel im Worker-Tab." >&2
fi
info=$(find_local_pane); pane=${info%% *}; dead=${info##* }

# PAUSE CHECK. Pausierte Maschine (2026-09-04): einen Worker DORT zu starten ist eine gueltige
# Entscheidung -- "pausiert ist der Blick, nicht die Maschine" -- der Start oben
# ist deshalb unveraendert durchgelaufen. Fehlt der Spiegel-Pane aus GENAU diesem
# Grund, ist das kein Fehlerfall wie der allgemeine unten: `wb-remote-view
# $MACHINE` von Hand aufzurufen wuerde nichts aendern, solange die Maschine
# pausiert bleibt, und "Selbst herstellen" waere darum falscher Rat.
MASCHINE_PAUSIERT=0
if [ -z "$pane" ]; then
  if "$HOME/.local/bin/wb-state" settings get remoteMachinesPausiert 2>/dev/null \
       | /usr/bin/python3 -c 'import json, sys
try:
    liste = json.load(sys.stdin)
    sys.exit(0 if isinstance(liste, list) and sys.argv[1] in liste else 1)
except Exception:
    sys.exit(1)' "$MACHINE"; then
    MASCHINE_PAUSIERT=1
  fi
fi

# Register in the workbench state file — with the machine, so the sidebar and
# wb-result know where this worker lives. Old entries have no `machine`. Die
# Session wird vom SPIEGEL genommen, wenn es einen gibt; ohne Spiegel bleibt sie
# leer, statt eine Sitzung zu behaupten, in der dieser Worker gar nicht laeuft.
WBSESS=""
[ -n "$pane" ] && WBSESS=$(tmux display -p -t "$pane" '#{session_name}' 2>/dev/null || true)
[ "$KIND" = claude ] && WBMODEL="claude-$MODEL" || WBMODEL="$MODEL"
$HOME/.local/bin/wb-state add-worker "$SSHNAME" "$KIND" "$WBMODEL" "$WORKDIR" "$WBSESS" --machine "$MACHINE" \
  || echo "WARNUNG: wb-state add-worker fehlgeschlagen — '$SSHNAME' fehlt in der Workbench-Sidebar." >&2

echo "Remote-Worker '$SSHNAME' laeuft auf $MACHINE (Session $RSESS_REAL, Fenster $RWIN)."
if [ -n "$pane" ]; then
  echo "Lokaler Spiegel-Pane: $pane — zeigt die Worker-Session '$RSESS_REAL' von $MACHINE."
elif [ "$MASCHINE_PAUSIERT" = 1 ]; then
  echo "Kein lokaler Spiegel-Pane: '$MACHINE' ist pausiert (Einstellungen -> Maschinen) — der Worker laeuft dort, diese Werkbank laedt seine Sitzungen nur nicht. Erst wieder einschalten, dann erscheint der Spiegel von selbst."
  echo "Direkt ansehen: ssh -t $MACHINE 'tmux attach -t =$RSESS_REAL'"
else
  echo "WARNUNG: kein lokaler Spiegel-Pane — der Worker laeuft, ist hier aber NICHT sichtbar." >&2
  echo "         Selbst herstellen: wb-remote-view $MACHINE    (sagt, woran es liegt)" >&2
  echo "         Direkt ansehen:    ssh -t $MACHINE 'tmux attach -t =$RSESS_REAL'" >&2
fi
# PAUSE CHECK ENDE.
[ -n "$RRES" ] && echo "Ergebnis-Datei auf $MACHINE: $RRES"
echo "Ergebnis holen (Deadline-tauglich, 0 = da / 1 = noch nicht): wb-result $SSHNAME"
