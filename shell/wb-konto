    return any(BUSY_RE.search(x) for x in nichtleer)


def _letzter_eintrag(sid):
    """Letzter Unterhaltungseintrag (type user|assistant) des Gespraechsprotokolls -> ("ok", dict) | ("unlesbar", grund)."""
    import glob
    wurzel = os.path.join(os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(os.path.expanduser("~"), ".claude"),
                          "projects")
    pfade = glob.glob(os.path.join(wurzel, "*", sid + ".jsonl"))
    if not pfade:
        return "unlesbar", "kein Transkript %s.jsonl" % sid
    pfad = max(pfade, key=lambda p: os.path.getmtime(p) if os.path.exists(p) else 0)
    try:
        with open(pfad, "rb") as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - 4 * 1024 * 1024))
            roh = f.read().decode("utf-8", "replace").splitlines()
    except OSError as e:
        return "unlesbar", "Transkript nicht lesbar (%s)" % type(e).__name__
    for z in reversed(roh):
        try:
            d = json.loads(z)
        except ValueError:
            continue
        if isinstance(d, dict) and d.get("type") in ("user", "assistant"):
            return "ok", d
    return "unlesbar", "Transkript ohne Unterhaltungseintrag"


def zug_ende(sid):
    """ZUGENDE (gemessen 15.11.2026 an 36 Gespraechsdateien von claude 2.1.3xx): ein fertiger Zug endet mit einem
    assistant-Eintrag, dessen message.stop_reason "end_turn" ist; mitten im Zug steht dort tool_use oder ein
    user-Eintrag (tool_result oder neue Eingabe). Ein API-Fehler (isApiErrorMessage) ist kein normales Zugende,
    den behandelt `wechsel`. -> ("ja"|"nein"|"unlesbar", grund)."""
    befund, d = _letzter_eintrag(sid)
    if befund != "ok":
        return "unlesbar", d
    m = d.get("message") if isinstance(d.get("message"), dict) else {}
    if d.get("type") != "assistant":
        return "nein", "letzter Eintrag ist eine Eingabe (user)"
    if d.get("isApiErrorMessage"):
        return "nein", "letzter Eintrag ist ein API-Fehler (%s)" % d.get("error")
    if m.get("stop_reason") != "end_turn":
        return "nein", "letzte Antwort endet mit %s" % m.get("stop_reason")
    return "ja", "letzte Antwort endet mit end_turn"


def transkript_zahlen(sid):
    """Nur Zahlenfelder aus dem Gespraechsprotokoll (ERST KOMPAKTIEREN): kontext = Token der juengsten Anfrage
    (cache_creation + cache_read + input), nach einer Kompaktierungsgrenze ohne neue Antwort deren postTokens;
    kompakt_ts = Zeit der letzten compact_boundary; frisch_kompaktiert = nach dieser Grenze noch keine Antwort;
    nutzer_nach_kompakt = nach dieser Grenze steht ein Nutzereintrag (Typ "user" mit spaeterem Zeitstempel, nicht die
    Zusammenfassung, kein Werkzeugergebnis; Inhalte werden nie gelesen). Unlesbar: kontext None."""
    import glob
    erg = {"kontext": None, "kompakt_ts": None, "frisch_kompaktiert": False, "nutzer_nach_kompakt": False}
    wurzel = os.path.join(os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(os.path.expanduser("~"), ".claude"),
                          "projects")
    pfade = glob.glob(os.path.join(wurzel, "*", sid + ".jsonl"))
    if not pfade:
        return erg
    pfad = max(pfade, key=lambda p: os.path.getmtime(p) if os.path.exists(p) else 0)
    try:
        with open(pfad, "rb") as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - 4 * 1024 * 1024))
            roh = f.read().decode("utf-8", "replace").splitlines()
    except OSError:
        return erg
    for z in roh:
        try:
            d = json.loads(z)
        except ValueError:
            continue
        if not isinstance(d, dict):
            continue
        if d.get("type") == "system" and d.get("subtype") == "compact_boundary":
            erg["kompakt_ts"] = epoch_aus(d.get("timestamp"))
            erg["frisch_kompaktiert"] = True
            erg["nutzer_nach_kompakt"] = False
            post = (d.get("compactMetadata") or {}).get("postTokens")
            if isinstance(post, (int, float)) and not isinstance(post, bool):
                erg["kontext"] = int(post)
            continue
        if d.get("type") == "user" and erg["kompakt_ts"] is not None and not d.get("isCompactSummary") \
                and "toolUseResult" not in d and "sourceToolUseID" not in d:
            ts = epoch_aus(d.get("timestamp"))
            if ts is not None and ts > erg["kompakt_ts"]:
                erg["nutzer_nach_kompakt"] = True
            continue
        if d.get("type") != "assistant" or d.get("isApiErrorMessage"):
            continue
        u = (d.get("message") or {}).get("usage") if isinstance(d.get("message"), dict) else None
        if not isinstance(u, dict):
            continue
        erg["kontext"] = sum(int(u.get(x) or 0) for x in ("cache_creation_input_tokens", "cache_read_input_tokens",
                                                          "input_tokens"))
        erg["frisch_kompaktiert"] = False
    return erg


def _dauer(s):
    s = max(0, int(s))
    if s >= 86400:
        return "%d T %d h" % (s // 86400, s % 86400 // 3600)
    if s >= 3600:
        return "%d h %d min" % (s // 3600, s % 3600 // 60)
    return "%d min" % (s // 60)


def _messalter(s, t):
    ts = epoch_aus(s.get("gemessen"))
    return None if ts is None else t - ts


def _zahl(x):
    return "?" if x is None else ("%.0f" % x if float(x) == int(x) else "%.1f" % x)


def messwerte_text(staende, t):
    """Messwerte beider Konten fuer das Protokoll: 5h, Woche, Linie, Alter des juengsten Messwerts."""
    teile = []
    for s in staende:
        alter = _messalter(s, t)
        teile.append("%s %s, Woche %s %% / Linie %s (Tag %s), gemessen %s%s" % (
            s["konto"], fuenf_text(s), _zahl(s.get("seven_day_pct")), s.get("linie"),
            s.get("tagesindex"), s.get("gemessen") or "nie",
            "" if alter is None else " (vor %d min)" % int(alter // 60)))
    return "; ".join(teile)


def _remote_control(startzeile):
    return bool(re.search(r"(?<!\S)--remote-control(?!\S)", startzeile or ""))


