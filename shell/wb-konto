    return r.stdout.strip() if r.returncode == 0 else ""


def leitung(text):
    """Eine Zeile an die Gruppe leitung; scheitert die Zustellung (die Kontextwache hat als verwaister Prozess
    keinen messbaren Absender), steht die Zeile mit dem Grund in ~/.claude/workbench/konto-wechsel.log."""
    grund = ""
    gruppe = _werkzeug("wb-gruppe")
    if not gruppe:
        grund = "wb-gruppe fehlt"
    else:
        try:
            r = subprocess.run([gruppe, "schreib", "leitung", "--art", "meldung", text], capture_output=True,
                               text=True, timeout=60, stdin=subprocess.DEVNULL)
            if r.returncode != 0:
                grund = "wb-gruppe Exit %d: %s" % (r.returncode, ((r.stderr or r.stdout).strip().splitlines() or [""])[-1][:160])
        except (OSError, subprocess.SubprocessError) as e:
            grund = "wb-gruppe ohne Antwort (%s)" % type(e).__name__
    try:
        os.makedirs(wbdir(), exist_ok=True)
        with open(os.path.join(wbdir(), "konto-wechsel.log"), "a") as f:
            f.write("%s %s [leitung: %s]\n" % (datetime.datetime.now().strftime("%F %T"), text,
                                                "zugestellt" if not grund else "NICHT zugestellt, " + grund))
    except OSError:
        pass
    return grund


def _warte_auf_register(pane, sock, sid):
    """Nach einem Neustart: Frist in Sekunden, bis der neue Prozess dieselbe Unterhaltung im Register fuehrt.
    Rueckgabe: leer = gefunden, sonst der Grund."""
    frist = float(os.environ.get("WB_KONTO_WARTE_S") or 90)
    ende = time.time() + frist
    while time.time() < ende:
        p = (_tmux(sock, "display", "-p", "-t", pane, "#{pane_pid}") or "").strip()
        if p.isdigit() and sitzung_aus_register(p)[0] == sid:
            return ""
        time.sleep(1)
    return "neuer Prozess fuehrt die Unterhaltung nach %d s nicht im Register" % int(frist)


def _weiter_senden(sid, pane, sock, von, nach, t):
    """Nach dem Neustart: warten, bis der neue Prozess dieselbe Unterhaltung im Register fuehrt, dann EIN
    "weiter" ueber die Sitzungs-Inbox (nie getippt). Rueckgabe: leer = zugestellt, sonst der Grund."""
    grund = _warte_auf_register(pane, sock, sid)
    if grund:
        return grund
    return _inbox_zustellen(pane, sock, "weiter -- setze deine aktuelle Aufgabe fort (automatischer Kontowechsel "
                            "nach Limit: %s -> %s)\n" % (von, nach))


def _inbox_zustellen(pane, sock, text):
    """Ein Text ueber `wb-inbox sende <pane> <datei>` (nie getippt). Rueckgabe: leer = zugestellt, sonst der Grund;
    ein Grund, der mit "unklar" beginnt, heisst: vielleicht zugestellt (Zeitablauf), also nie nochmal senden."""
    inbox = os.environ.get("WB_INBOX") or _werkzeug("wb-inbox")
    if not inbox:
        return "wb-inbox fehlt"
    fd, datei = tempfile.mkstemp(prefix="wb-konto-weiter.", suffix=".txt")
    with os.fdopen(fd, "w") as f:
        f.write(text)
    umg = {k2: v for k2, v in os.environ.items() if k2 not in ("TMUX_PANE",)}
    if sock:
        umg["TMUX"] = sock + ",0,0"
    try:
        r = subprocess.run([inbox, "sende", pane, datei], capture_output=True, text=True, timeout=60,
                           stdin=subprocess.DEVNULL, env=umg)
    except subprocess.TimeoutExpired:
        return "unklar: wb-inbox nach 60 s ohne Antwort"
    except (OSError, subprocess.SubprocessError) as e:
        return "wb-inbox ohne Antwort (%s)" % type(e).__name__
    finally:
        try:
            os.unlink(datei)
        except OSError:
            pass
    if r.returncode in (0, 6):
        return ""
    return "wb-inbox Exit %d" % r.returncode


# Nachtrag task (18.11.2026): ein Vorfall ohne endgueltiges Ergebnis (melden: Konto unbekannt, Messwert
# widerspricht, ohne Beleg; neustart gescheitert) sperrt nur VORFALL_ERNEUT_S lang. Danach darf die Kontextwache, die
# dieselbe Limitzeile nach KONTO_LIMIT_ERNEUT_S (Vorgabe ebenfalls 300 s) erneut meldet, einen neuen Versuch ausloesen.
# Endgueltig bleiben nur gewechselt und halt.
VORFALL_ERNEUT_S = 300
VORFALL_ENDGUELTIG = ("gewechselt", "halt")


def _vorfall_gesperrt(alt, t):
    """True, solange ein gemerkter Vorfall keinen neuen Versuch zulaesst."""
    if not isinstance(alt, dict) or alt.get("ergebnis") in VORFALL_ENDGUELTIG:
        return True
    return t - float(alt.get("t") or 0) < VORFALL_ERNEUT_S


def _gemeldet_merken(neu, alt, text):
    """task (18.11.2026): eine Meldung geht je Vorfall und Wortlaut hoechstens EINMAL an leitung,
    wie bei der Kontextwache; erneute Pruefungen nach VORFALL_ERNEUT_S stehen nur in konto-wechsel.log. Uebernimmt die
    schon gemeldeten Wortlaute (Pruefsummen) des alten Eintrags in den neuen. -> True: an leitung, False: nur Protokoll."""
    import zlib
    gemeldet = [x for x in ((alt or {}).get("gemeldet") or []) if isinstance(x, str)] if isinstance(alt, dict) else []
    laut = True
    if text is not None:
        fp = "%08x" % zlib.crc32(text.encode("utf-8", "replace"))
        laut = fp not in gemeldet
        if laut:
            gemeldet.append(fp)
    if gemeldet:
        neu["gemeldet"] = gemeldet[-20:]
    return laut


def befehl_wechsel(k, rest, t):
    """wb-konto wechsel <pane> [--tmux-socket-pfad <pfad>] [--trocken]
    Eine Zeile auf stdout: nichts|melden|halt|gewechselt TAB Text. Exit 0, ausser bei Bedienfehlern."""
    pane, sock, trocken = None, "", False
    i = 0
    while i < len(rest):
        if rest[i] == "--tmux-socket-pfad" and i + 1 < len(rest):
            sock = rest[i + 1]; i += 2
        elif rest[i] == "--trocken":
            trocken = True; i += 1
        elif pane is None and re.match(r"^%\d+$", rest[i]):
            pane = rest[i]; i += 1
        else:
            fehler("wechsel <%%pane> [--tmux-socket-pfad <pfad>] [--trocken]; unbekannt: '%s'" % rest[i], 2)
    if pane is None:
        fehler("wechsel <%pane> [--tmux-socket-pfad <pfad>] [--trocken]", 2)

    def aus(art, text):
        print("%s\t%s" % (art, text))
        return 0
    system = os.uname().sysname
    if os.environ.get("WB_TESTUMGEBUNG") == "1" and os.environ.get("WB_KONTO_UNAME"):
        system = os.environ["WB_KONTO_UNAME"]
    bild = _tmux(sock, "capture-pane", "-p", "-t", pane, "-S", "-60")
    if bild is None:
        return aus("nichts", "Pane %s nicht lesbar" % pane)
    zeile, art = limit_im_bild(bild)
    if zeile is None:
        return aus("nichts", art)
    if system != "Darwin":
        # Z2b C: ausserhalb des Mac kein Wechsel, aber die Fortsetzung nach dem Reset wird vorgemerkt
        zusatz = _fortsetzung_ausserhalb(k, pane, sock, zeile, art, t, trocken)
        if zusatz is None:
            return aus("nichts", "Limitfehler in %s schon behandelt (ausserhalb des Mac)" % pane)
        text = ("Limitmeldung in %s (\"%s\"), aber kein Kontowechsel ausserhalb des Mac (%s: kein "
                "wb-konto-Schluesselbund)%s" % (pane, zeile[:160], system, zusatz))
        if zusatz:
            protokoll("wb-konto: " + text)
        return aus("melden", text)
    if art not in KONTO_ARTEN:
        return aus("melden", "Limit in %s ist kein Kontolimit (\"%s\"): kein Kontowechsel" % (pane, zeile[:160]))
    info = (_tmux(sock, "display", "-p", "-t", pane, "#{pane_pid}\t#{pane_dead}\t#{pane_start_command}") or "")
    teile = info.rstrip("\n").split("\t", 2)
    if len(teile) < 3 or not teile[0].isdigit() or teile[1] != "0":
        return aus("nichts", "Pane %s ohne lebenden Prozess (Wiederbelebung ist Sache von wb-autorevive)" % pane)
    pid, startzeile = teile[0], teile[2]
    sid, quelle = sitzung_aus_register(pid)
    if sid is None:
        return aus("melden", "Limitmeldung in %s (\"%s\"), aber keine Sitzungskennung (%s): kein Neustart"
                   % (pane, zeile[:160], quelle))
    w = _wechsel_lesen()
    # REGEL KONTO-BELEG (decision 11-14): gebucht und neu gestartet wird nur mit Transkript-Beleg; das Bild ist nur der Anstoss
    beleg, vorfall = limit_aus_transkript(sid)
    if beleg == "kein":
        return aus("nichts", "Limitzeile im Bild von %s, aber die Unterhaltung endet nicht mit einem Limitfehler (%s): "
                   "kein Wechsel" % (pane, vorfall))
    if beleg != "beleg":
        schluessel = "ohne-beleg:%s:%s" % (sid, zeile[:120])
        if schluessel in w["vorfaelle"] and _vorfall_gesperrt(w["vorfaelle"][schluessel], t):
            return aus("nichts", "Limitzeile ohne Beleg in %s schon gemeldet" % pane)
        text = ("Limitzeile in %s (\"%s\"), aber kein Transkript-Beleg (%s): nicht gebucht, kein Neustart"
                % (pane, zeile[:120], vorfall))
        alt = w["vorfaelle"].get(schluessel)
        w["vorfaelle"][schluessel] = {"t": int(t), "pane": pane, "sitzung": sid, "ergebnis": "melden"}
        laut = _gemeldet_merken(w["vorfaelle"][schluessel], alt, text)
        if not trocken:
            _json_schreiben(_wechsel_pfad(), w)
        (leitung if laut else protokoll)("wb-konto: " + text)
        return aus("melden", text)
    if vorfall in w["vorfaelle"]:
        if _vorfall_gesperrt(w["vorfaelle"][vorfall], t):
            return aus("nichts", "Vorfall %s schon behandelt (%s)" % (vorfall[:60], w["vorfaelle"][vorfall].get("ergebnis")))
    aktuell, kquelle = konto_des_prozesses(k, pid, sid, startzeile)

    def merken(ergebnis, text=None):
        """Merkt den Vorfall; mit text: True, wenn dieser Wortlaut fuer den Vorfall neu ist (dann an leitung)."""
        alt = w["vorfaelle"].get(vorfall)
        w["vorfaelle"][vorfall] = {"t": int(t), "pane": pane, "sitzung": sid, "ergebnis": ergebnis}
        laut = _gemeldet_merken(w["vorfaelle"][vorfall], alt, text)
        if not trocken:
            _json_schreiben(_wechsel_pfad(), w)
        return laut
    if aktuell is None:
        text = "Limitmeldung in %s (\"%s\"), Konto unbekannt (%s): kein Wechsel" % (pane, zeile[:160], kquelle)
        (leitung if merken("melden", text) else protokoll)("wb-konto: " + text)
        return aus("melden", text)
    # MODELLLIMIT OHNE 5h-FENSTER (20.11.2026): Prueft ein Konto nur die Woche, darf ein Modell-Wochenlimit
    # ("Opus weekly limit reached", Wochenanteil des Kontos darunter) nicht als Widerspruch zum Konto gelten. Der Text nennt
    # das Modell: kein Kontolimit, nichts gebucht, kein Wechsel.
    if not hat_fuenf(k, aktuell) and art in UNBESTIMMTE_ARTEN + ("weekly",) and MODELL_RE.search(zeile):
        text = ("Limitmeldung in %s auf %s (\"%s\") nennt ein Modell: kein Kontolimit, nicht gebucht, kein Wechsel"
                % (pane, aktuell, zeile[:120]))
        (leitung if merken("melden", text) else protokoll)("wb-konto: " + text)
        return aus("melden", text)
    # REGEL KONTO-MESSWERT (decision 11-14): ein frischer Messwert klar unter dem Limit widerspricht der Meldung
    widerspruch = messwert_widerspricht(k, aktuell, art, t)
    if widerspruch:
        text = ("Limitfehler in %s auf %s (\"%s\"), aber %s: nicht gebucht, kein Wechsel"
                % (pane, aktuell, zeile[:120], widerspruch))
        (leitung if merken("melden", text) else protokoll)("wb-konto: " + text)
        return aus("melden", text)
    art, art_grund = art_aus_messwert(k, aktuell, art, t)
    bis, bis_quelle = reset_aus_zeile(zeile, art, k["konten"][aktuell], t)
    if art_grund:
        bis_quelle += " (unbestimmte Meldung, %s)" % art_grund
    andere = [n for n in k["reihenfolge"] if n != aktuell]
    ziel = andere[0] if andere else None
    halt = ziel_halt(k, ziel, sid, w["verlauf"], t) if ziel else "kein anderes Konto konfiguriert"
    bis_text = datetime.datetime.fromtimestamp(bis).strftime("%d.%m. %H:%M")
    if trocken:
        return aus("halt" if halt else "gewechselt", "TROCKEN: %s erschoepft bis %s (%s); %s" % (
            aktuell, bis_text, bis_quelle, ("Halt: " + halt) if halt else "Neustart auf %s mit --resume %s" % (ziel, sid)))
    b = buchungen()
    b[aktuell] = {"erschoepft_bis": int(bis), "grund": "Limitmeldung in %s: %s" % (pane, zeile[:120]), "gebucht": int(t)}
    _json_schreiben(os.path.join(wbdir(), "konto-buchung.json"), b)
    if (not halt and re.search(r"(?<!\S)--remote-control(?!\S)", startzeile)
            and _einstellung("orchestratorWechselBeiLimit") == "false"):
        # Remote Control braucht die volle Mac-Anmeldung; ein Kontotoken ist "inference-only" (Zeichenketten der
        # CLI 2.1.325). Seit task (15.11.2026, der Nutzer) steuert
        # orchestratorKonto nur den START; ob ein Orchestrator bei echtem Limit wechselt, sagt
        # orchestratorWechselBeiLimit (ungesetzt = ja). Nur mit false bleibt die Sitzung, wie sie ist.
        halt = ("die Sitzung nutzt Remote Control, und orchestratorWechselBeiLimit ist false; ein Wechsel braeche "
                "Remote Control (Entscheidung: wb-state settings set orchestratorWechselBeiLimit true)")
    if halt:
        merken("halt")
        zusatz = fortsetzung_merken(k, sid, vorfall, pane, sock, aktuell, bis, art, t, trocken)
        text = ("Limit in %s auf %s (\"%s\"), %s gebucht erschoepft bis %s. KEIN Wechsel: %s. Die Sitzung wartet%s."
                % (pane, aktuell, zeile[:120], aktuell, bis_text, halt, zusatz))
        leitung("wb-konto: " + text)
        return aus("halt", text)
    revive = os.path.join(os.path.dirname(os.path.realpath(__file__)), "wb-revive")
    if not os.access(revive, os.X_OK):
        revive = _werkzeug("wb-revive") or ""
    umg = {k2: v for k2, v in os.environ.items() if k2 not in ("TMUX_PANE",)}
    if sock:
        umg["TMUX"] = sock + ",0,0"
    else:
        umg.pop("TMUX", None)
    try:
        r = subprocess.run([revive, "--force", "--yes", "--resume-id", sid, "--konto", ziel, pane],
                           capture_output=True, text=True, timeout=120, env=umg, stdin=subprocess.DEVNULL)
        rc, meldung = r.returncode, (r.stderr.strip() + " " + r.stdout.strip()).strip()
        ausgabe = r.stdout
    except (OSError, subprocess.SubprocessError) as e:
        rc, meldung, ausgabe = 127, type(e).__name__, ""
    if rc != 0:
        text = ("Limit in %s auf %s, %s gebucht erschoepft bis %s; Neustart auf %s GESCHEITERT (wb-revive Exit %s: %s)"
                % (pane, aktuell, aktuell, bis_text, ziel, rc, meldung[-200:]))
        (leitung if merken("neustart gescheitert", text) else protokoll)("wb-konto: " + text)
        return aus("melden", text)
    w["verlauf"].append({"t": int(t), "sitzung": sid, "pane": pane, "von": aktuell, "nach": ziel, "bis": int(bis),
                         "grund": "limit",
                         "rc_verloren": bool(re.search(r"(?<!\S)--remote-control(?!\S)", startzeile))})
    w["verlauf"] = [v for v in w["verlauf"] if (epoch_aus(v.get("bis")) or 0) > t - 8 * 86400][-200:]
    merken("gewechselt")
    # KOMPAKTIEREN NACH DEM WECHSEL (task): auf dem erschoepften Konto scheitert /compact; ein grosser
    # Kontext wird deshalb auf dem NEUEN Konto kompaktiert, und das "weiter" folgt erst danach (nachwechsel_*).
    nachk = _nach_wechsel_kontext(k, sid)
    if nachk is None:
        weiter = _weiter_senden(sid, pane, sock, aktuell, ziel, t)
    else:
        weiter = _warte_auf_register(pane, sock, sid)
        nachwechsel_merken(k, sid, pane, sock, aktuell, ziel, nachk, t)
    # Modell und Effort vorher/nachher aus der Meldung von wb-revive (task, 15.11.2026).
    mm = re.search(r"Modell(?:/Effort)? [^;\n]*", ausgabe or "")
    modell = "; " + mm.group(0).rstrip(" .") if mm else ""
    text = ("Kontowechsel %s: %s -> %s (Limit \"%s\", %s erschoepft bis %s), Unterhaltung %s fortgesetzt%s%s%s"
            % (pane, aktuell, ziel, zeile[:100], aktuell, bis_text, sid, modell,
               "" if not weiter else "; 'weiter' NICHT zugestellt: " + weiter,
               "; Claude Remote Control ist AUS (Kontotoken), Fernsteuerung ueber die Werkbank-Handy-App"
               if re.search(r"(?<!\S)--remote-control(?!\S)", startzeile) else ""))
    if nachk is not None:
        text += ("; ERST KOMPAKTIEREN auf %s: Kontext %d Token >= %d, das 'weiter' folgt nach der bestaetigten "
                 "Kompaktierung (spaetestens nach %d min)" % (ziel, nachk, int(kwert(k, "budget_kompakt_ab_tokens")),
                                                             int(kwert(k, "budget_kompakt_frist_min"))))
    leitung("wb-konto: " + text)
    return aus("gewechselt" if nachk is None else "nachkompaktieren", text)


