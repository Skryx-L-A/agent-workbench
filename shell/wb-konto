def kwert(k, schluessel):
    """Zahl aus der Konfiguration; fehlt sie (eigene Testkonfiguration), gilt die Vorgabe oben."""
    return float(k.get(schluessel, VORGABEN_Z2B[schluessel]))

def hat_fuenf(k, name):
    """Hat das Konto ein 5h-Fenster? Vorgabe ja; nur ein ausdrueckliches false in der Konfiguration sagt nein."""
    c = (k.get("konten") or {}).get(name) or {}
    return c.get("fuenf_stunden_fenster", True) is not False


KEIN_FENSTER = "5h: kein Fenster"


def fuenf_text(s, roh=False):
    """Satzteil fuer das 5h-Fenster eines stand()-Ergebnisses; ohne Fenster nie "5h 0 %" (unterscheidbar von
    "Fenster offen, 0 %"). roh: der Wert ungeformt (wie die Messzeile ihn nennt), sonst gerundet."""
    if s.get("fuenf_stunden_fenster") is False:
        return KEIN_FENSTER
    w = s.get("five_hour_pct")
    return "5h %s %%" % (w if roh else _zahl(w))


