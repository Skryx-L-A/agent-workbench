def konten_selbstpruefung(k):
    probleme = []
    for name, c in k["konten"].items():
        anker = datetime.datetime.fromtimestamp(float(c["reset_anker"]))
        lesbar = "%s %02d:%02d" % (WOCHENTAGE[anker.weekday()], anker.hour, anker.minute)
        if c.get("wochenbeginn") != lesbar:
            probleme.append("%s: wochenbeginn '%s' passt nicht zum reset_anker (%s Ortszeit)"
                            % (name, c.get("wochenbeginn"), lesbar))
        if not c.get("dienst"):
            probleme.append("%s: dienst fehlt" % name)
        if "fuenf_stunden_fenster" in c and not isinstance(c["fuenf_stunden_fenster"], bool):
            probleme.append("%s: fuenf_stunden_fenster muss true oder false sein (nicht %r)"
                            % (name, c["fuenf_stunden_fenster"]))
    if sorted(k["reihenfolge"]) != sorted(k["konten"]):
        probleme.append("reihenfolge nennt nicht genau die Konten")
    return probleme


# ── ziel: vor dem Wochenreset gezielt leerfahren (task, decision 2026-11-16) ──────────────────────────
# EINE Zeile fuer die Statusanzeige und fuer den Orchestrator: je Konto der Rest bis zur Zielmarke (Obergrenze der Woche, sonst 100)
# und die Zeit bis zum Wochenreset. Eigener Befehl statt einer Zeile in einer Sammelanzeige: wb-konto hat keine
# Sammelanzeige, und die Statuszeile braucht genau eine billige Zeile ohne Messung und ohne Netz.
def befehl_ziel(k, rest, t):
    eintraege = []
    for n in k["reihenfolge"]:
        s = stand(k, n, t)
        og = obergrenzen(k, n)["woche"][0]
        marke = og if og is not None else 100.0
        woche = s.get("seven_day_pct")
        rest_pct = None if woche is None else max(0.0, marke - float(woche))
        reset = s["fenster_reset"]
        r_dt = datetime.datetime.fromtimestamp(reset)
        eintraege.append({"konto": n, "woche_pct": woche, "ziel_pct": marke, "rest_pct": rest_pct, "reset": reset,
                          "fuenf_stunden_fenster": s["fuenf_stunden_fenster"],
                          "status": s["status"], "text": "%s noch %s %% bis %s %% (Reset %s %s, in %s)" % (
                              n, "?" if rest_pct is None else _zahl(round(rest_pct)), _zahl(marke),
                              WOCHENTAGE[r_dt.weekday()], r_dt.strftime("%H:%M"), _dauer(reset - t))})
    if "--kurz" in rest:
        # Statuszeile (decision 2026-11-16): je Konto nur der Rest bis zur Zielmarke und der Reset-Zeitpunkt, ohne Dauer.
        teile = []
        for e in eintraege:
            r_dt = datetime.datetime.fromtimestamp(e["reset"])
            teile.append("%s noch %s%% bis %s %s" % (
                e["konto"], "?" if e["rest_pct"] is None else _zahl(round(e["rest_pct"])),
                WOCHENTAGE[r_dt.weekday()], r_dt.strftime("%H:%M")))
        print("Ziel " + ", ".join(teile))
    elif "--json" in rest:
        print(json.dumps({"konten": eintraege}, ensure_ascii=False))
    else:
        print(" | ".join(e["text"] for e in eintraege))
    return 0


# ── status: lesende Schnittstelle fuer die App (Z2b, decision 2026-11-15) ────────────────────────────────────
# Die App liest NUR diesen Befehl, nie konto-wechsel.json und nie ein Textmuster. Ausgabe je Unterhaltung der letzte
# Wechsel aus dem Verlauf: zeit (ISO, UTC), von/nach (nur die Etiketten der Konten, z. B. gross/klein), grund
# (limit|budget) und remote_control_verloren (ja|nein; "unbekannt" fuer Eintraege von vor dem 15.11.2026, die das
# Feld nicht tragen). Nie ein Token, nie eine Kontoadresse, nie ein Dienstname des Schluesselbunds.
STATUS_GRUENDE = ("limit", "budget")


def _status_eintrag(v):
    zeit = datetime.datetime.fromtimestamp(int(v.get("t") or 0), datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    grund = v.get("grund") if v.get("grund") in STATUS_GRUENDE else "limit"
    rc = v.get("rc_verloren")
    rc_text = "unbekannt" if rc is None else ("ja" if rc else "nein")
    etikett = re.compile(r"^[a-z][a-z0-9-]{0,31}$")
    von = v.get("von") if isinstance(v.get("von"), str) and etikett.match(v.get("von")) else "unbekannt"
    nach = v.get("nach") if isinstance(v.get("nach"), str) and etikett.match(v.get("nach")) else "unbekannt"
    return {"zeit": zeit, "von": von, "nach": nach, "grund": grund, "remote_control_verloren": rc_text}


def befehl_status(rest):
    w = _wechsel_lesen()
    letzte = {}
    for v in w.get("verlauf") or []:
        if not isinstance(v, dict) or not isinstance(v.get("sitzung"), str) or not v.get("sitzung"):
            continue
        alt = letzte.get(v["sitzung"])
        if alt is None or int(v.get("t") or 0) >= int(alt.get("t") or 0):
            letzte[v["sitzung"]] = v
    aus_d = {sid: _status_eintrag(v) for sid, v in sorted(letzte.items())}
    if "--json" in rest:
        print(json.dumps({"version": 1, "unterhaltungen": aus_d}, ensure_ascii=False, sort_keys=True))
    else:
        if not aus_d:
            print("wb-konto: kein Kontowechsel im Verlauf")
        for sid, e in aus_d.items():
            print("%s\t%s\t%s -> %s\t%s\tRemote Control verloren: %s"
                  % (sid, e["zeit"], e["von"], e["nach"], e["grund"], e["remote_control_verloren"]))
    return 0


def befehl_obergrenze(k, rest):
    if rest[:1] == ["--warnung"]:
        # Statuszeile: nur ein Satz, nie ein Fehler auf dem Schirm (Exit 0 auch bei unlesbaren Zahlen).
        if len(rest) < 3 or rest[1] not in k["konten"]:
            return 0
        og = obergrenzen(k, rest[1])
        teile = []
        for art, wert in (("woche", rest[2]), ("fuenf_stunden", rest[3] if len(rest) > 3 else "")):
            try:
                gemessen = float(wert)
            except ValueError:
                continue
            g = og[art][0]
            if art == "fuenf_stunden" and not hat_fuenf(k, rest[1]):
                continue   # ohne 5h-Fenster gibt es nichts zu warnen
            if g is not None and gemessen >= g:
                teile.append("%s %s%% >= %s%%" % ("Woche" if art == "woche" else "5h", _zahl(gemessen), _zahl(g)))
        if teile:
            print("OBERGRENZE %s: %s" % (rest[1], ", ".join(teile)))
        return 0
    if not rest or rest[0] == "--json":
        zeilen_aus = {n: {art: dict({"wert": w, "quelle": q},
                                    **({"wirkt": False, "grund": "kein 5h-Fenster"}
                                       if art == "fuenf_stunden" and not hat_fuenf(k, n) else {}))
                          for art, (w, q) in obergrenzen(k, n).items()}
                      for n in k["reihenfolge"]}
        if rest[:1] == ["--json"]:
            print(json.dumps(zeilen_aus, ensure_ascii=False))
        else:
            for n, arten in zeilen_aus.items():
                print("%s\t%s" % (n, ", ".join("%s %s (%s%s)" % (art, "aus" if v["wert"] is None else _zahl(v["wert"]),
                                                                  v["quelle"], ", ohne Wirkung: kein 5h-Fenster"
                                                                  if v.get("wirkt") is False and v["wert"] is not None else "")
                                                for art, v in arten.items())))
        return 0
    name = rest[0]
    if name not in k["konten"]:
        fehler("obergrenze: unbekanntes Konto '%s' (%s)" % (name, "|".join(k["reihenfolge"])), 2)
    neu = {}
    i = 1
    while i < len(rest):
        schalter = rest[i]
        if schalter not in ("--woche", "--fuenf-stunden") or i + 1 >= len(rest):
            fehler("obergrenze: erwartet --woche N|aus oder --fuenf-stunden N|aus", 2)
        wert = rest[i + 1]
        if wert == "aus":
            zahl = None
        else:
            if schalter == "--fuenf-stunden" and not hat_fuenf(k, name):
                fehler("obergrenze: %s hat kein 5h-Fenster, --fuenf-stunden %s wirkte nie und wird nicht gesetzt "
                       "(nur 'aus' ist erlaubt)" % (name, wert), 2)
            try:
                zahl = float(wert)
            except ValueError:
                fehler("obergrenze: '%s' ist keine Zahl und nicht 'aus'" % wert, 2)
            if not 0 < zahl <= 100:
                fehler("obergrenze: %s liegt nicht in (0, 100]" % wert, 2)
        neu["woche" if schalter == "--woche" else "fuenf_stunden"] = zahl
        i += 2
    if not neu:
        fehler("obergrenze: nichts zu setzen (--woche oder --fuenf-stunden)", 2)
    alle = obergrenzen_gesetzt()
    eintrag = alle.get(name) if isinstance(alle.get(name), dict) else {}
    eintrag.update(neu)
    alle[name] = eintrag
    _json_schreiben(obergrenze_datei(), alle)
    protokoll("wb-konto: Obergrenze %s gesetzt: %s" % (name, ", ".join(
        "%s %s" % (a, "aus" if v is None else _zahl(v)) for a, v in sorted(neu.items()))))
    print("%s\t%s" % (name, ", ".join("%s %s (%s)" % (a, "aus" if w is None else _zahl(w), q)
                                     for a, (w, q) in obergrenzen(k, name).items())))
    return 0


PLAN_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]{0,39}$")


def befehl_planwechsel(k, rest, t):
    """planwechsel <konto> --zeit <ISO|epoch> [--plan <name>]: schreibt das Ereignis atomar (konto-planwechsel.json),
    ersetzt ein vorhandenes und nennt alten und neuen Wert. Ohne gueltige Angaben Exit 2 und nichts geschrieben."""
    if not rest or rest[0].startswith("-"):
        fehler("planwechsel <%s> --zeit <ISO|epoch> [--plan <name>]" % "|".join(k["reihenfolge"]), 2)
    name = konto_pruefen(k, rest[0])
    zeit = plan = None
    i = 1
    while i < len(rest):
        if rest[i] == "--zeit" and i + 1 < len(rest):
            zeit = zeit_endlich(rest[i + 1]); i += 2
            if zeit is None:
                fehler("planwechsel: --zeit '%s' ist keine Zeit (ISO 8601 oder epoch)" % rest[i - 1], 2)
        elif rest[i] == "--plan" and i + 1 < len(rest):
            plan = rest[i + 1]; i += 2
            if not PLAN_RE.match(plan):
                fehler("planwechsel: --plan '%s' ist kein Planname (Buchstaben, Ziffern, _ . -, hoechstens 40)" % plan, 2)
        else:
            fehler("planwechsel: unbekannte Angabe '%s'" % rest[i], 2)
    if zeit is None:
        fehler("planwechsel: --zeit <ISO|epoch> fehlt", 2)
    if zeit > t + 300:
        fehler("planwechsel: --zeit liegt in der Zukunft (%s); ein Wechsel ist schon geschehen" %
               datetime.datetime.fromtimestamp(zeit).strftime("%Y-%m-%d %H:%M"), 2)
    alt = planwechsel(k, name)
    alle = planwechsel_gesetzt()
    eintrag = {"zeit": int(zeit), "gesetzt": int(t)}
    if plan:
        eintrag["plan"] = plan
    alle[name] = eintrag
    _json_schreiben(planwechsel_datei(), alle)
    neu = planwechsel(k, name)
    protokoll("wb-konto: Planwechsel %s gesetzt: %s" % (name, planwechsel_text(neu)))
    print("%s\tPlanwechsel alt: %s\tneu: %s" % (name, planwechsel_text(alt), planwechsel_text(neu)))
    return 0


