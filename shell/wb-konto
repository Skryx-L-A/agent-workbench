def _pane_prozess(sock, pane):
    """(pid, startzeile) eines lebenden Panes oder (None, grund)."""
    info = _tmux(sock, "display", "-p", "-t", pane, "#{pane_pid}\t#{pane_dead}\t#{pane_start_command}")
    if info is None:
        return None, "Pane %s nicht lesbar" % pane
    teile = info.rstrip("\n").split("\t", 2)
    if len(teile) < 3 or not teile[0].isdigit() or teile[1] != "0":
        return None, "Pane %s ohne lebenden Prozess" % pane
    return teile[0], teile[2]


HINTERGRUND_SHELLS = {"bash", "zsh", "sh", "dash", "fish"}


def _hintergrund(pid):
    """Shells unter dem Harness-Prozess des Panes: ein Werkzeugaufruf, ein Hintergrundjob, ein Monitor. Dieselbe
    Pruefung wie wb-schlaf "untaetig" (Abschnitt WANN UNTAETIG): ist die Pane-Wurzel nur eine Shell-Huelle mit genau
    einem Kind, zaehlt das Kind als Harness. Rueckgabe: Namen der Shells (leer = nichts laeuft), None = ps nicht
    lesbar."""
    try:
        r = subprocess.run(["ps", "-axo", "pid=,ppid=,stat=,comm="], capture_output=True, text=True, timeout=10,
                           env=dict(os.environ, LC_ALL="C"), stdin=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError):
        return None
    if r.returncode != 0:
        return None
    kinder, name = {}, {}
    for zeile in r.stdout.splitlines():
        t = zeile.split(None, 3)
        if len(t) < 4 or not t[0].isdigit() or not t[1].isdigit():
            continue
        # Ein Zombie (Zustand Z) laeuft nicht mehr; er wartet nur darauf, dass sein Vater ihn einsammelt.
        name[int(t[0])] = "" if t[2].startswith("Z") else os.path.basename(t[3].strip()).lstrip("-")
        kinder.setdefault(int(t[1]), []).append(int(t[0]))
    try:
        h = int(pid)
    except (TypeError, ValueError):
        return None
    if name.get(h) in HINTERGRUND_SHELLS and len(kinder.get(h, [])) == 1:
        h = kinder[h][0]
    unter, stapel = [], list(kinder.get(h, []))
    while stapel:
        q = stapel.pop()
        unter.append(q)
        stapel.extend(kinder.get(q, []))
    return [name[q] for q in unter if name.get(q) in HINTERGRUND_SHELLS]


def _pane_arbeitet(bild):
