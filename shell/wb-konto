# ── Familie, Fenster, Linie ─────────────────────────────────────────────────────────────────────────
def epoch_aus(wert):
    if wert is None or wert == "":
        return None
    try:
        return float(wert)
    except (TypeError, ValueError):
        pass
    try:
        s = str(wert).replace("Z", "+00:00")
        return datetime.datetime.fromisoformat(s).timestamp()
    except ValueError:
        return None


def familie(k, resets_at):
    """Konto, zu dessen Familie dieser seven_day_resets_at gehoert, oder None."""
    if resets_at is None:
        return None
    tol = float(k.get("familien_toleranz_s", 300))
    treffer = []
    for name, c in k["konten"].items():
        rest = (resets_at - float(c["reset_anker"])) % WOCHE
        if min(rest, WOCHE - rest) <= tol:
            treffer.append(name)
    return treffer[0] if len(treffer) == 1 else None


def naechster_reset(c, t):
    anker = float(c["reset_anker"])
    k = int((t - anker) // WOCHE) + 1
    return anker + k * WOCHE


def linie(c, t):
    reset = naechster_reset(c, t)
    start = reset - WOCHE
    tag_start = datetime.datetime.fromtimestamp(start).date()
    tag_heute = datetime.datetime.fromtimestamp(t).date()
    idx = max(1, min(7, (tag_heute - tag_start).days + 1))
    return min(100.0, idx * 100.0 / 7.0), idx, reset


