NAECHSTE_SPUR = ("naechste freie Spur laut regeln/vergabe.md: Rang 1 lokal (qwen38 ueber Splash), dann Rang 2 kostenlose "
                 "Kontingente (wb-kontingent pruefen <spur>), dann Rang 4 Cline Pass")


def hartes_ende(s):
    """Grund, wenn das Konto am harten Ende steht (gebucht erschoepft, frisch gemessen Woche oder 5h >= 100), sonst ""."""
    if s.get("gebucht"):
        return s.get("grund") or "gebucht erschoepft"
    if s.get("status") == "unbekannt":
        return ""
    teile = []
    if (s.get("seven_day_pct") or 0) >= 100:
        teile.append("Woche %s %%" % _zahl(s["seven_day_pct"]))
    if (s.get("five_hour_pct") or 0) >= 100:
        teile.append("5h %s %%" % _zahl(s["five_hour_pct"]))
    return ", ".join(teile)


def befehl_budget(k, rest, t):
    """wb-konto budget <pane> [--tmux-socket-pfad <pfad>] [--trocken]
    Eine Zeile auf stdout: nichts|halt|melden|gewechselt TAB Text. Exit 0, ausser bei Bedienfehlern."""
    pane, sock, trocken = _pane_argumente(rest, "budget")

    def aus(art, text):
        print("%s\t%s" % (art, text))
        return 0
    if _system() != "Darwin":
        return aus("nichts", "kein Kontowechsel ausserhalb des Mac")
    pid, startzeile = _pane_prozess(sock, pane)
    if pid is None:
        return aus("nichts", startzeile)
    bild = _tmux(sock, "capture-pane", "-p", "-t", pane, "-S", "-60")
    if bild is None:
        return aus("nichts", "Pane %s nicht lesbar" % pane)
    if _pane_arbeitet(bild):
        return aus("nichts", "Pane arbeitet gerade")
    rsid, rquelle = sitzung_aus_register(pid)
    if rsid is None:
        return aus("nichts", "keine Sitzungskennung (%s)" % rquelle)
    nw = nachwechsel_abschliessen(k, rsid, t, trocken, von_budget=True)
    if nw:
        return aus(*nw)
    ende, egrund = zug_ende(rsid)
    tz = transkript_zahlen(rsid)
    vorwechsel = (_wechsel_lesen().get("vorwechsel") or {}).get(rsid)
    kfrist = kwert(k, "budget_kompakt_frist_min") * 60
    kompakt_bestaetigt = (isinstance(vorwechsel, dict) and tz["kompakt_ts"] is not None
                          and tz["kompakt_ts"] > float(vorwechsel.get("t") or 0))
    if ende != "ja" and not (kompakt_bestaetigt and tz["frisch_kompaktiert"]):
        return aus("nichts", "kein Zugende (%s)" % egrund)
    # Ein freiwilliger Wechsel startet die Sitzung neu (wb-revive --force); ein Hintergrundauftrag unter dem Harness
    # (Gesamtlauf, Push mit Pre-Push-Suiten, Testlauf, Monitor) stuerbe mit (decision 2026-11-16). Bei der Limitmeldung
    # (wechsel) bleibt das hinnehmbar, hier nicht.
    laeuft = _hintergrund(pid)
    if laeuft is None:
        return aus("nichts", "Prozessbaum nicht lesbar (ps); kein Wechsel")
    if laeuft:
        return aus("nichts", "Hintergrundauftrag laeuft (%s)" % ", ".join(laeuft[:3]))
    aktuell, kquelle = konto_des_prozesses(k, pid, rsid, startzeile)
    if aktuell is None:
        return aus("nichts", "Konto unbekannt (%s)" % kquelle)
    s_akt = stand(k, aktuell, t)
    hart = hartes_ende(s_akt)
    if hart:
        # KEIN UMZUG AM HARTEN ENDE (task): eine ruhende Sitzung kostet nichts, ein Umzug einen vollen
        # ungecachten Lesezug; den Wechsel uebernimmt `wechsel`, sobald die Sitzung wieder arbeiten will.
        grund = ("Budget %s (%s, Unterhaltung %s): KEIN Umzug, %s ist am harten Ende (%s); die ruhende Sitzung bleibt, "
                 "den Wechsel uebernimmt der Limit-Weg (wb-konto wechsel), sobald sie wieder arbeiten will"
                 % (pane, aktuell, rsid, aktuell, hart))
        w0 = _wechsel_lesen()
        m0 = w0.setdefault("budget_meldungen", {})
        alt0 = m0.get(rsid + ":hart") or {}
        if not alt0 or t - float(alt0.get("t") or 0) >= kwert(k, "budget_mindestabstand_min") * 60:
            m0[rsid + ":hart"] = {"t": int(t), "grund": hart}
            if not trocken:
                _json_schreiben(_wechsel_pfad(), w0)
                protokoll("wb-konto: " + grund)
        return aus("nichts", grund)
    ueber_og = s_akt["status"] == "erschoepft" and bool(s_akt.get("obergrenze"))
    if (s_akt["status"] in ("erschoepft", "unbekannt") and not ueber_og) or s_akt.get("seven_day_pct") is None:
        return aus("nichts", "%s: %s" % (aktuell, s_akt.get("grund")))
    grenze5 = kwert(k, "fuenf_stunden_grenze")
    ueber5 = bool(s_akt["fuenf_stunden_fenster"]) and (s_akt.get("five_hour_pct") or 0) >= grenze5
    ueberlinie = s_akt["seven_day_pct"] >= s_akt.get("linie_wirksam", s_akt["linie"])
    # RESERVE VOR DER HARTEN MARKE (task): die Kompaktierung vor dem Wechsel braucht noch Token des
    # alten Kontos, also loest budget schon budget_wochen_reserve_punkte vor der Wochen-Obergrenze (ohne sie 100) aus.
    og_woche = obergrenzen(k, aktuell)["woche"][0]
    harte_marke = og_woche if og_woche is not None else 100.0
    in_reserve = s_akt["seven_day_pct"] >= harte_marke - kwert(k, "budget_wochen_reserve_punkte")
    if not (ueber5 or ueberlinie or ueber_og or in_reserve):
        return aus("nichts", "%s unter Linie%s" % (aktuell, " und 5h-Grenze" if s_akt["fuenf_stunden_fenster"]
                                                    else " (%s)" % KEIN_FENSTER))
    ausloeser = "; ".join(x for x in (
        s_akt["grund"] if ueber_og else "",
        "Woche %s %% in der Reserve vor %s %%" % (_zahl(s_akt["seven_day_pct"]), _zahl(harte_marke))
        if in_reserve and not ueber_og else "",
        "5h %s %% >= %s" % (_zahl(s_akt.get("five_hour_pct")), _zahl(grenze5)) if ueber5 else "",
        "Woche %s %% >= Linie %s (Tag %s)" % (_zahl(s_akt["seven_day_pct"]), s_akt.get("linie_wirksam", s_akt["linie"]),
                                               s_akt["tagesindex"])
        if ueberlinie else "") if x)
    frist = kwert(k, "budget_messwert_max_min") * 60
    alter = _messalter(s_akt, t)
    andere = [n for n in k["reihenfolge"] if n != aktuell]
    ziel = andere[0] if andere else None
    w = _wechsel_lesen()
    meldungen = w.setdefault("budget_meldungen", {})
    abstand = kwert(k, "budget_mindestabstand_min") * 60

    def entscheiden(art, grund, s_ziel=None, schluessel=None, laut=False):
        """Jede Entscheidung ab dem Ausloeser: Protokoll mit den Messwerten BEIDER Konten; gleiche Halte- und
        Wartegruende hoechstens einmal je Mindestabstand (schluessel), damit jeder Poll nicht dasselbe schreibt."""
        if schluessel:
            alt = meldungen.get(schluessel) or {}
            if alt and t - float(alt.get("t") or 0) < abstand:
                return aus("nichts", "schon gemeldet: " + grund)
            meldungen[schluessel] = {"t": int(t), "grund": grund}
            for n in [n for n, v in meldungen.items() if t - float((v or {}).get("t") or 0) > 8 * 86400]:
                meldungen.pop(n, None)
            if not trocken:
                _json_schreiben(_wechsel_pfad(), w)
        staende = [s_akt] + ([s_ziel] if s_ziel else ([stand(k, ziel, t)] if ziel else []))
        text = ("Budget %s (%s, Unterhaltung %s): %s -- %s [Messwerte: %s]"
                % (pane, aktuell, rsid, ausloeser, grund, messwerte_text(staende, t)))
        if not trocken:
            if laut:
                leitung("wb-konto: " + text)
            else:
                protokoll("wb-konto: " + text)
        return aus(art, text)

    if alter is None or alter > frist:
        return entscheiden("nichts", "Messwert von %s ist %s alt (Grenze %d min): kein Budgetwechsel"
                           % (aktuell, "unbekannt" if alter is None else "%d min" % int(alter // 60), int(frist // 60)),
                           schluessel=rsid + ":alt")
    r5 = s_akt.get("five_hour_reset")
    warte5 = kwert(k, "budget_fuenf_reset_warte_min") * 60
    if ueber5 and not ueberlinie and not ueber_og and r5 and r5 - t <= warte5:
        return entscheiden("nichts", "5h-Reset um %s in %d min (hoechstens %d min): kein Wechsel, die Sitzung bleibt "
                           "auf %s" % (datetime.datetime.fromtimestamp(r5).strftime("%H:%M"), int((r5 - t) // 60),
                                       int(warte5 // 60), aktuell), schluessel=rsid + ":reset-nah")
    wechselzeiten = [epoch_aus(v.get("t")) or 0 for v in w["verlauf"] if v.get("sitzung") == rsid]
    juengster = max(wechselzeiten) if wechselzeiten else None
    if juengster is not None and t - juengster < abstand:
        return entscheiden("nichts", "Mindestabstand: letzter Wechsel dieser Unterhaltung vor %d min (< %d min)"
                           % (int((t - juengster) // 60), int(abstand // 60)), schluessel=rsid + ":abstand")
    rc_verloren = _remote_control(startzeile)
    if rc_verloren and _einstellung("orchestratorWechselBeiLimit") == "false":
        return entscheiden("halt", "KEIN Wechsel: die Sitzung nutzt Remote Control, und orchestratorWechselBeiLimit "
                           "ist false (Entscheidung: wb-state settings set orchestratorWechselBeiLimit true)",
                           schluessel=rsid + ":orchestrator", laut=True)
    if ziel is None:
        return entscheiden("halt", "KEIN Wechsel: kein anderes Konto konfiguriert", schluessel=rsid + ":ziel")
    s_ziel = stand(k, ziel, t)
    alter_ziel = _messalter(s_ziel, t)
    if s_ziel["status"] != "erschoepft" and (alter_ziel is None or alter_ziel > frist) and not trocken:
        messen(k, ziel, t, erzwingen=False, leise=True)
        s_ziel = stand(k, ziel, t)
        alter_ziel = _messalter(s_ziel, t)
    kreis = ziel_halt(k, ziel, rsid, w["verlauf"], t)
    luft = kwert(k, "budget_ziel_luft_punkte")
    if kreis:
        return entscheiden("halt", "KEIN Wechsel: " + kreis, s_ziel, schluessel=rsid + ":kreis", laut=True)
    if alter_ziel is None or alter_ziel > frist or s_ziel.get("seven_day_pct") is None:
        return entscheiden("halt", "KEIN Wechsel: Zielkonto %s ohne frischen Messwert (Grenze %d min, %s)"
                           % (ziel, int(frist // 60), s_ziel.get("grund")), s_ziel, schluessel="*:ziel-unbekannt",
                           laut=True)
    ziel_fuenf = s_ziel.get("five_hour_pct") or 0
    ziel_abstand = s_ziel.get("linie_wirksam", s_ziel["linie"]) - s_ziel["seven_day_pct"]
    # ZIEL BEI QUELLE IN DER RESERVE (task): steht die Quelle kurz vor ihrer harten Marke, reicht ein Ziel
    # unter seiner Tageslinie und unter der 5h-Grenze; die 10 Punkte Luft gelten sonst.
    if in_reserve:
        zu_knapp = ziel_abstand <= 0 or ziel_fuenf >= grenze5
    else:
        zu_knapp = ziel_abstand < luft or ziel_fuenf > grenze5 - luft
    if zu_knapp:
        werte = "Woche %s %% / Linie %s, %s" % (_zahl(s_ziel["seven_day_pct"]), s_ziel["linie"], fuenf_text(s_ziel))
        if ziel_abstand <= 0 or ziel_fuenf >= grenze5:
            grund, schluessel = "beide Konten ueber der Linie (%s: %s)" % (ziel, werte), "*:beide"
        else:
            grund, schluessel = "Zielkonto %s hat weniger als %d Punkte Luft (%s)" % (ziel, int(luft), werte), "*:luft"
        return entscheiden("halt", "KEIN Wechsel: %s; %s" % (grund, NAECHSTE_SPUR), s_ziel, schluessel=schluessel,
                           laut=True)
    # ERST KOMPAKTIEREN (task): ohne bestaetigte Kompaktierung kein Wechsel eines grossen Kontexts
    schwelle = kwert(k, "budget_kompakt_ab_tokens")
    vw = w.setdefault("vorwechsel", {})
    for n in [n for n, v in vw.items() if t - float((v or {}).get("t") or 0) > 8 * 3600]:
        vw.pop(n, None)
    vorwechsel = vw.get(rsid)
    if schwelle > 0 and not kompakt_bestaetigt and (tz["kontext"] or 0) >= schwelle:
        if not isinstance(vorwechsel, dict):
            vw[rsid] = {"t": int(t), "kontext": tz["kontext"], "pane": pane, "von": aktuell, "nach": ziel}
            if not trocken:
                _json_schreiben(_wechsel_pfad(), w)
            return entscheiden("kompaktieren", "ERST KOMPAKTIEREN: Kontext %d Token >= %d; Wechsel auf %s erst nach "
                               "bestaetigter Kompaktierung" % (tz["kontext"], int(schwelle), ziel), s_ziel)
        seit = t - float(vorwechsel.get("t") or 0)
        if seit > kfrist:
            return entscheiden("halt", "KEIN Wechsel: die Kompaktierung vor dem Wechsel ist seit %d min nicht bestaetigt "
                               "(Frist %d min)" % (int(seit // 60), int(kfrist // 60)), s_ziel,
                               schluessel=rsid + ":kompakt-frist", laut=True)
        return aus("kompaktieren", "wartet auf die Kompaktierung vor dem Wechsel (vorgemerkt vor %d min, Kontext %d Token)"
                   % (int(seit // 60), tz["kontext"] or 0))
    kontext_text = "" if tz["kontext"] is None else "; Kontext beim Wechsel %d Token%s" % (
        tz["kontext"], " (nach Kompaktierung)" if kompakt_bestaetigt else "")
    if trocken:
        return entscheiden("gewechselt", "TROCKEN: Neustart auf %s mit --resume %s%s" % (ziel, rsid, kontext_text), s_ziel)
    revive = os.path.join(os.path.dirname(os.path.realpath(__file__)), "wb-revive")
    if not os.access(revive, os.X_OK):
        revive = _werkzeug("wb-revive") or ""
    umg = {k2: v for k2, v in os.environ.items() if k2 not in ("TMUX_PANE",)}
    if sock:
        umg["TMUX"] = sock + ",0,0"
    else:
        umg.pop("TMUX", None)
    try:
        r = subprocess.run([revive, "--force", "--yes", "--resume-id", rsid, "--konto", ziel, pane],
                           capture_output=True, text=True, timeout=120, env=umg, stdin=subprocess.DEVNULL)
        rcode, meldung = r.returncode, (r.stderr.strip() + " " + r.stdout.strip()).strip()
    except (OSError, subprocess.SubprocessError) as e:
        rcode, meldung = 127, type(e).__name__
    if rcode != 0:
        return entscheiden("melden", "Neustart auf %s GESCHEITERT (wb-revive Exit %s: %s)" % (ziel, rcode, meldung[-200:]),
                           s_ziel, schluessel=rsid + ":neustart", laut=True)
    w = _wechsel_lesen()
    w["verlauf"].append({"t": int(t), "sitzung": rsid, "pane": pane, "von": aktuell, "nach": ziel, "bis": int(t),
                         "grund": "budget", "rc_verloren": rc_verloren, "kontext": tz["kontext"],
                         "kompaktiert": bool(kompakt_bestaetigt)})
    w["verlauf"] = [v for v in w["verlauf"] if (epoch_aus(v.get("bis")) or 0) > t - 8 * 86400][-200:]
    (w.get("vorwechsel") or {}).pop(rsid, None)
    _json_schreiben(_wechsel_pfad(), w)
    register = _warte_auf_register(pane, sock, rsid)
    return entscheiden("gewechselt", "Kontowechsel %s -> %s, Unterhaltung %s mit --resume neu gestartet%s%s%s" % (
        aktuell, ziel, rsid, kontext_text, "" if not register else "; " + register,
        "; Claude Remote Control ist AUS (Kontotoken), Fernsteuerung ueber die Werkbank-Handy-App" if rc_verloren else ""),
        s_ziel, laut=True)


# ── fortsetzen: genau EIN "weiter" nach dem Limit-Reset, wenn kein Wechsel moeglich war (Z2b Teil C) ─────────
def _fs_pfad():
    return os.path.join(wbdir(), "konto-fortsetzung.json")


def _fs_faellig_pfad():
    return os.path.join(wbdir(), "konto-fortsetzung.faellig")


class _Sperre:
    """flock auf konto-fortsetzung.lock: mehrere Kontextwachen (eine je Werkbank-Sitzung) teilen sich die Datei."""

    def __init__(self, warten=True):
        self.warten = warten
        self.fd = None

    def __enter__(self):
        import fcntl
        os.makedirs(wbdir(), exist_ok=True)
        self.fd = os.open(os.path.join(wbdir(), "konto-fortsetzung.lock"), os.O_CREAT | os.O_RDWR, 0o600)
        try:
            fcntl.flock(self.fd, fcntl.LOCK_EX | (0 if self.warten else fcntl.LOCK_NB))
        except BlockingIOError:
            os.close(self.fd)
            self.fd = None
            raise
        return self

    def __exit__(self, *a):
        import fcntl
        if self.fd is not None:
            fcntl.flock(self.fd, fcntl.LOCK_UN)
            os.close(self.fd)
        return False


def _fs_lesen():
    try:
        with open(_fs_pfad()) as f:
            d = json.load(f)
    except (OSError, ValueError):
        d = {}
    if not isinstance(d, dict):
        d = {}
    for feld in ("offen", "erledigt", "gesendet", "nachwechsel", "nachwechsel_fertig"):
        if not isinstance(d.get(feld), dict):
            d[feld] = {}
    return d


def _fs_schreiben(d, t):
    d["erledigt"] = {u: z for u, z in d["erledigt"].items() if t - float(z or 0) < 8 * 86400}
    d["gesendet"] = {s: [x for x in z if t - float(x) < 86400] for s, z in d["gesendet"].items()}
    d["gesendet"] = {s: z for s, z in d["gesendet"].items() if z}
    _json_schreiben(_fs_pfad(), d)
    d["nachwechsel_fertig"] = {s: z for s, z in d["nachwechsel_fertig"].items()
                               if isinstance(z, dict) and t - float(z.get("t") or 0) < 8 * 3600}
    termine = [int(e.get("naechster") or 0) for e in list(d["offen"].values()) + list(d["nachwechsel"].values())
               if isinstance(e, dict)]
    if termine:
        with open(_fs_faellig_pfad() + ".neu", "w") as f:
            f.write("%d\n" % min(termine))
        os.replace(_fs_faellig_pfad() + ".neu", _fs_faellig_pfad())
    else:
        try:
            os.unlink(_fs_faellig_pfad())
        except FileNotFoundError:
            pass


def _fortsetzung_an():
    return _einstellung("kontoFortsetzungNachLimit") != "false"


def fortsetzung_merken(k, sid, vorfall, pane, sock, konto, bis, art, t, trocken):
    """Merkt eine Unterhaltung, die am Limit ohne Wechsel steht. Rueckgabe: Zusatz fuer die Meldung."""
    if trocken:
        return ""
    if not _fortsetzung_an():
        protokoll("wb-konto: Fortsetzung %s (%s) nicht vorgemerkt: kontoFortsetzungNachLimit ist false" % (pane, sid))
        return "; keine Fortsetzung nach dem Reset (kontoFortsetzungNachLimit ist false)"
    vorlauf = kwert(k, "fortsetzung_vorlauf_s")
    with _Sperre():
        d = _fs_lesen()
        if vorfall in d["erledigt"]:
            return ""
        frueher = [x for x in d["gesendet"].get(sid, []) if t - float(x) < 86400]
        if len(frueher) >= kwert(k, "fortsetzung_max_sendungen"):
            text = ("Fortsetzung %s (%s) aufgegeben: schon %d-mal 'weiter' in 24 h, das Limit kam jedes Mal wieder"
                    % (pane, sid, len(frueher)))
            leitung("wb-konto: " + text)
            return "; " + text
        d["offen"][sid] = {"sitzung": sid, "vorfall": vorfall, "pane": pane, "sock": sock, "konto": konto,
                           "reset": int(bis), "art": art, "angelegt": int(t), "versuche": 0,
                           "naechster": int(bis + vorlauf)}
        _fs_schreiben(d, t)
    zeit = datetime.datetime.fromtimestamp(bis + vorlauf).strftime("%d.%m. %H:%M")
    protokoll("wb-konto: Fortsetzung %s (%s, Konto %s) vorgemerkt ab %s" % (pane, sid, konto or "unbekannt", zeit))
    return "; Fortsetzung nach dem Reset vorgemerkt (ab %s ein 'weiter' ueber die Inbox)" % zeit


def _fortsetzung_ausserhalb(k, pane, sock, zeile, art, t, trocken):
    """Ausserhalb des Mac: kein Wechsel, aber dieselbe Fortsetzung. -> Zusatz, oder None = Vorfall schon behandelt."""
    if not (art in KONTO_ARTEN):
        return ""
    pid, startzeile = _pane_prozess(sock, pane)
    if pid is None:
        return "; keine Fortsetzung (%s)" % startzeile
    rsid, rquelle = sitzung_aus_register(pid)
    if rsid is None:
        return "; keine Fortsetzung (keine Sitzungskennung: %s)" % rquelle
    befund, uuid = limit_aus_transkript(rsid)
    if befund != "beleg":
        return "; keine Fortsetzung (kein Transkript-Beleg: %s)" % uuid
    w = _wechsel_lesen()
    if uuid in w["vorfaelle"]:
        return None
    w["vorfaelle"][uuid] = {"t": int(t), "pane": pane, "sitzung": rsid, "ergebnis": "melden ausserhalb des Mac"}
    if not trocken:
        _json_schreiben(_wechsel_pfad(), w)
    bis, _q = reset_aus_zeile(zeile, "", None, t)      # ohne Kontokonfiguration: die Uhrzeit der Meldung
    return fortsetzung_merken(k, rsid, uuid, pane, sock, None, bis, art, t, trocken)


def fenster_frei(k, konto, art, reset, t):
    """Frischer Messwert NACH dem Reset unter der Grenze? -> (True|False|None, grund); None = nicht gemessen."""
    frist = kwert(k, "budget_messwert_max_min") * 60
    grenze = kwert(k, "limit_messwert_min")
    beste = None
    for d in zeilen():
        if zeile_konto(k, d) != konto or not isinstance(d.get("seven_day_pct"), (int, float)):
            continue
        ts = epoch_aus(d.get("ts"))
        if ts is None or ts < reset or t - ts > frist:
            continue
        if beste is None or (ts, d["_nr"]) > (epoch_aus(beste.get("ts")), beste["_nr"]):
            beste = d
    if beste is None:
        return None, "kein Messwert von %s nach dem Reset, der hoechstens %d min alt ist" % (konto, int(frist // 60))
    fenster5 = hat_fuenf(k, konto)
    fuenf = beste.get("five_hour_pct") if (epoch_aus(beste.get("five_hour_resets_at")) or 0) > t else 0
    fuenf = float(fuenf) if isinstance(fuenf, (int, float)) else 0.0
    sieben = float(beste["seven_day_pct"])
    # ohne 5h-Fenster entscheidet fuer jede Art die Woche (ein "0 %" des fehlenden Fensters hiesse sonst immer "frei")
    wert = sieben if art == "weekly" or not fenster5 else fuenf
    text = "%s %s, Woche %s %% (gemessen %s)" % (konto, "5h %s %%" % _zahl(fuenf) if fenster5 else KEIN_FENSTER,
                                                 _zahl(sieben), beste.get("ts"))
    if wert < grenze and sieben < 100:
        return True, text
    return False, text + ", Fenster noch voll (Grenze %s %%)" % _zahl(grenze)


def _fortsetzung_pruefen(k, sid, e, t):
    """-> ("senden"|"spaeter"|"weg", grund)."""
    pane, sock = e.get("pane") or "", e.get("sock") or ""
    pid, startzeile = _pane_prozess(sock, pane)
    if pid is None:
        return "weg", startzeile
    if sitzung_aus_register(pid)[0] != sid:
        return "weg", "im Pane %s laeuft nicht mehr die Unterhaltung %s" % (pane, sid)
    befund, beleg = limit_aus_transkript(sid)
    if befund == "kein":
        return "weg", "jemand hat weitergearbeitet (%s): nichts gesendet" % beleg
    if befund != "beleg":
        return "spaeter", "Gespraechsprotokoll nicht lesbar (%s)" % beleg
    if beleg != e.get("vorfall"):
        return "weg", "neuer Limitfehler %s seit dem Vormerken: eigener Vorfall" % beleg[:60]
    if _pane_arbeitet(_tmux(sock, "capture-pane", "-p", "-t", pane, "-S", "-60")):
        return "spaeter", "Pane arbeitet gerade"
    if not e.get("konto"):
        return "senden", "ohne Messweg (ausserhalb des Mac, Konto unbekannt): Reset-Uhrzeit der Meldung"
    frei, grund = fenster_frei(k, e["konto"], e.get("art"), float(e.get("reset") or 0), t)
    if frei is None:
        messen(k, e["konto"], t, erzwingen=False, leise=True)
        frei, grund = fenster_frei(k, e["konto"], e.get("art"), float(e.get("reset") or 0), t)
    if frei:
        return "senden", grund
    return "spaeter", grund


# ── nachwechsel: Kompaktierung auf dem neuen Konto, dann EIN "weiter" (task) ─────────────────────
def _nach_wechsel_kontext(k, sid):
    """Kontext der juengsten Anfrage, wenn er die Kompaktierschwelle erreicht; sonst None (sofortiges "weiter")."""
    ab_tokens = kwert(k, "budget_kompakt_ab_tokens")
    kontext = transkript_zahlen(sid)["kontext"]
    if ab_tokens > 0 and kontext is not None and kontext >= ab_tokens:
        return kontext
    return None


def nachwechsel_merken(k, sid, pane, sock, von, nach, kontext, t):
    """Merkt die Unterhaltung in konto-fortsetzung.json (nachwechsel). Faellig wird sie fuer `fortsetzen` alle
    fortsetzung_abstand_min, damit das "weiter" auch dann hinausgeht, wenn budget den Pane nie sieht."""
    with _Sperre():
        d = _fs_lesen()
        d["nachwechsel"][sid] = {"sitzung": sid, "t": int(t), "pane": pane, "sock": sock, "von": von, "nach": nach,
                                 "kontext": kontext, "naechster": int(t + kwert(k, "fortsetzung_abstand_min") * 60)}
        d["nachwechsel_fertig"].pop(sid, None)
        _fs_schreiben(d, t)


# Nachtrag task (18.11.2026): Schonfrist fuer den eigenen Resume-Prompt der Wache. Drei Polls (60 s): die Wache
# tippt WEITERARBEITEN bzw. den Anschluss nach COMPACT_SETTLE (120 s nach dem Kompaktierbefehl, der Boundary liegt davor).
NACHWECHSEL_SCHONFRIST_S = 180


def _nachwechsel_pruefen(k, e, t):
    """-> ("senden", grund, laut) | ("warten", grund, False) | ("erledigt", grund, False)."""
    tz = transkript_zahlen(e.get("sitzung") or "")
    seit = t - float(e.get("t") or 0)
    if tz["kompakt_ts"] is not None and tz["kompakt_ts"] > float(e.get("t") or 0):
        kontext = "?" if tz["kontext"] is None else tz["kontext"]
        if tz["nutzer_nach_kompakt"]:
            return "erledigt", ("Kompaktierung auf %s bestaetigt (Kontext danach %s Token); danach steht schon ein "
                                "Nutzereintrag (Resume-Prompt der Wache), kein 'weiter'" % (e.get("nach"), kontext)), False
        nach_k = t - tz["kompakt_ts"]
        if nach_k < NACHWECHSEL_SCHONFRIST_S:
            return "warten", ("Kompaktierung auf %s bestaetigt, Schonfrist fuer den Resume-Prompt der Wache (%d von %d s)"
                              % (e.get("nach"), int(nach_k), NACHWECHSEL_SCHONFRIST_S)), False
        return "senden", ("Kompaktierung auf %s bestaetigt (Kontext danach %s Token), %d s danach kein Resume-Prompt der "
                          "Wache" % (e.get("nach"), kontext, int(nach_k))), False
    frist = kwert(k, "budget_kompakt_frist_min") * 60
    if seit > frist:
        return "senden", ("Kompaktierung auf %s nach %d min NICHT bestaetigt (Frist %d min); 'weiter' trotzdem, damit "
                          "die Sitzung nicht stehen bleibt" % (e.get("nach"), int(seit // 60), int(frist // 60))), True
    return "warten", "wartet auf die Kompaktierung nach dem Wechsel auf %s (seit %d min, Kontext %s Token)" % (
        e.get("nach"), int(seit // 60), e.get("kontext")), False


def nachwechsel_abschliessen(k, sid, t, trocken, von_budget):
    """Fuer `budget` (von_budget, Antwort an die Wache) und `fortsetzen`. -> None (nichts offen) oder (art, text):
    art "fortgesetzt" (das "weiter" ist hinaus; die Wache raeumt ihre Vormerkung und ihren Anschluss ab),
    "nachkompaktieren" (wartet), bei fortsetzen auch "gesendet"/"spaeter"."""
    if trocken:
        d = _fs_lesen()
        e = d["nachwechsel"].get(sid)
        return None if not isinstance(e, dict) else ("nachkompaktieren", "TROCKEN: " + _nachwechsel_pruefen(k, e, t)[1])
    with _Sperre():
        d = _fs_lesen()
        e = d["nachwechsel"].get(sid)
        fertig = d["nachwechsel_fertig"].get(sid)
        if not isinstance(e, dict):
            if von_budget and isinstance(fertig, dict) and not fertig.get("gemeldet"):
                fertig["gemeldet"] = True
                _fs_schreiben(d, t)
                return "fortgesetzt", fertig.get("text") or "nach dem Wechsel fortgesetzt"
            return None
        art, grund, laut = _nachwechsel_pruefen(k, e, t)
        if art == "warten":
            e["naechster"] = int(t + kwert(k, "fortsetzung_abstand_min") * 60)
            _fs_schreiben(d, t)
            return ("nachkompaktieren" if von_budget else "spaeter"), grund
        if art == "erledigt":
            d["nachwechsel"].pop(sid, None)
            text = "Nach dem Kontowechsel %s -> %s (%s, %s): %s" % (e.get("von"), e.get("nach"), sid, e.get("pane"), grund)
            d["nachwechsel_fertig"][sid] = {"t": int(t), "gemeldet": bool(von_budget), "text": text}
            _fs_schreiben(d, t)
            protokoll("wb-konto: " + text)
            return ("fortgesetzt" if von_budget else "weg"), text
        fehlt = _inbox_zustellen(e.get("pane") or "", e.get("sock") or "",
                                 "weiter -- setze deine aktuelle Aufgabe fort (automatischer Kontowechsel nach Limit: %s -> "
                                 "%s; %s)\n" % (e.get("von"), e.get("nach"), grund))
        if fehlt and not fehlt.startswith("unklar"):
            e["naechster"] = int(t + kwert(k, "fortsetzung_abstand_min") * 60)
            _fs_schreiben(d, t)
            text = "Nach dem Kontowechsel %s (%s): 'weiter' NICHT zugestellt (%s), naechster Versuch spaeter" % (
                sid, e.get("pane"), fehlt)
            protokoll("wb-konto: " + text)
            return ("nachkompaktieren" if von_budget else "spaeter"), text
        d["nachwechsel"].pop(sid, None)
        text = "Nach dem Kontowechsel %s -> %s (%s, %s): 'weiter' ueber die Inbox%s; %s" % (
            e.get("von"), e.get("nach"), sid, e.get("pane"), "" if not fehlt else " (" + fehlt + ")", grund)
        d["nachwechsel_fertig"][sid] = {"t": int(t), "gemeldet": bool(von_budget), "text": text}
        _fs_schreiben(d, t)
    if laut:
        leitung("wb-konto: " + text)
    else:
        protokoll("wb-konto: " + text)
    return ("fortgesetzt" if von_budget else "gesendet"), text


def befehl_fortsetzen(k, rest, t):
    """wb-konto fortsetzen [--trocken]: je faelliger Unterhaltung eine Zeile gesendet|spaeter|weg|aufgegeben TAB
    Kennung TAB Text; nichts faellig: keine Ausgabe. Exit 0, ausser bei Bedienfehlern."""
    trocken = "--trocken" in rest
    for a in rest:
        if a != "--trocken":
            fehler("fortsetzen [--trocken]; unbekannt: '%s'" % a, 2)
    try:
        sperre = _Sperre(warten=False).__enter__()
    except BlockingIOError:
        print("nichts\t-\tein anderer Lauf von wb-konto fortsetzen arbeitet gerade")
        return 0
    try:
        d = _fs_lesen()
        an = _fortsetzung_an()
        abstand = kwert(k, "fortsetzung_abstand_min") * 60
        for sid in sorted(d["offen"]):
            e = d["offen"][sid]
            if not isinstance(e, dict):
                d["offen"].pop(sid, None)
                continue
            if not an:
                art, grund = "weg", "kontoFortsetzungNachLimit ist false"
            elif float(e.get("naechster") or 0) > t:
                continue
            else:
                art, grund = _fortsetzung_pruefen(k, sid, e, t)
            pane = e.get("pane")
            if trocken:
                print("%s\t%s\tTROCKEN: %s" % (art, sid, grund))
                continue
            if art == "senden":
                d["offen"].pop(sid, None)
                d["erledigt"][e.get("vorfall") or sid] = int(t)        # vor dem Senden: nie ein zweites "weiter"
                _fs_schreiben(d, t)
                reset = datetime.datetime.fromtimestamp(float(e.get("reset") or t)).strftime("%H:%M")
                fehlt = _inbox_zustellen(pane, e.get("sock") or "", "weiter -- das Limit ist zurueckgesetzt (Reset %s); "
                                         "setze deine aktuelle Aufgabe fort (automatische Fortsetzung nach dem Limit)\n"
                                         % reset)
                if not fehlt:
                    d["gesendet"].setdefault(sid, []).append(int(t))
                    text = "Fortsetzung %s: 'weiter' ueber die Inbox an %s (%s)" % (sid, pane, grund)
                    leitung("wb-konto: " + text)
                    print("gesendet\t%s\t%s" % (sid, text))
                elif fehlt.startswith("unklar"):
                    d["gesendet"].setdefault(sid, []).append(int(t))
                    text = "Fortsetzung %s: Zustellung an %s %s; kein zweiter Versuch" % (sid, pane, fehlt)
                    leitung("wb-konto: " + text)
                    print("aufgegeben\t%s\t%s" % (sid, text))
                else:
                    d["erledigt"].pop(e.get("vorfall") or sid, None)
                    art, grund = "spaeter", "'weiter' nicht zugestellt (%s)" % fehlt
            if art == "weg":
                d["offen"].pop(sid, None)
                text = "Fortsetzung %s (%s) entfaellt: %s" % (sid, pane, grund)
                protokoll("wb-konto: " + text)
                print("weg\t%s\t%s" % (sid, text))
            elif art == "spaeter":
                e["versuche"] = int(e.get("versuche") or 0) + 1
                if e["versuche"] >= kwert(k, "fortsetzung_max_versuche"):
                    d["offen"].pop(sid, None)
                    text = ("Fortsetzung %s (%s) aufgegeben nach %d Pruefungen: %s. Von Hand mit 'weiter' fortsetzen."
                            % (sid, pane, e["versuche"], grund))
                    leitung("wb-konto: " + text)
                    print("aufgegeben\t%s\t%s" % (sid, text))
                else:
                    e["naechster"] = int(t + abstand)
                    d["offen"][sid] = e
                    text = "Fortsetzung %s (%s) wartet, Pruefung %d: %s" % (sid, pane, e["versuche"], grund)
                    protokoll("wb-konto: " + text)
                    print("spaeter\t%s\t%s" % (sid, text))
            _fs_schreiben(d, t)
        if not trocken:
            _fs_schreiben(d, t)
        faellige_nw = [s for s, e in sorted(d["nachwechsel"].items())
                       if isinstance(e, dict) and float(e.get("naechster") or 0) <= t]
    finally:
        sperre.__exit__()
    for sid in faellige_nw:
        erg = nachwechsel_abschliessen(k, sid, t, trocken, von_budget=False)
        if erg:
            print("%s\t%s\t%s" % (erg[0], sid, erg[1]))
    return 0


# ── tokensicht: sieht das Bash-Werkzeug einer Claude-Sitzung den Konto-Token? ────────
def befehl_tokensicht(k, rest):
    """Echte CLI gegen eine Messages-Attrappe auf 127.0.0.1, Wegwerf-Token, eigenes HOME/CLAUDE_CONFIG_DIR; kein
    echter Modellaufruf. Zwei Laeufe: Token als CLAUDE_CODE_OAUTH_TOKEN, dann als ANTHROPIC_AUTH_TOKEN. Die
    Attrappe laesst das Bash-Werkzeug zaehlen (printenv | wc -l), nie den Wert ausgeben. Erwartung je Update:
    Kontrolle 1, CLAUDE_CODE_OAUTH_TOKEN 0. Exit 0 wie erwartet, 1 LAUT (Kontoweg undicht), 2 nicht gemessen.
    Netz-Stummel: Claude Code ruft in manchen Konfigurationen `ssh -T` gegen den Git-Dienst von GitHub
    (gemessen: bei einer GitHub-Marketplace-Quelle in settings.json, auch mit
    CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1; mit leerer Wegwerf-Konfiguration nicht). ssh liest Schluessel aus dem ECHTEN
    Heimordner. Darum liegt in jedem Wegwerfordner ein ssh-Stummel (zaehlt, Exit 255, kein Netz) VOR dem festen Suchpfad;
    SSH_AUTH_SOCK, GIT_SSH und GIT_SSH_COMMAND fehlen in der Umgebung. GRENZE: nur Aufrufe ueber den Suchpfad werden
    abgefangen (die CLI nennt `ssh` ohne Pfad); ein absoluter Pfad ginge daran vorbei."""
    import http.server
    import secrets
    import threading
    prog = os.environ.get("WB_KONTO_TOKENSICHT_CLAUDE") or _claude_bin(False)
    if not prog:
        print("wb-konto tokensicht: claude nicht gefunden -- nicht gemessen", file=sys.stderr)
        return 2
    befehl = ("printf 'kontrolle=%s oauth=%s auth=%s\\n' \"$(printenv WB_SICHT_PROBE | wc -l | tr -d ' ')\" "
              "\"$(printenv CLAUDE_CODE_OAUTH_TOKEN | wc -l | tr -d ' ')\" \"$(printenv ANTHROPIC_AUTH_TOKEN | wc -l | tr -d ' ')\"")

    def lauf(variable):
        token = "wegwerf-" + secrets.token_hex(12)
        zahl = {"anfragen": 0, "ergebnis": None, "wert_gesehen": 0}

        class Attrappe(http.server.BaseHTTPRequestHandler):
            def log_message(self, *a):
                pass

            def do_GET(self):
                self.send_response(404)
                self.end_headers()

            def do_POST(self):
                laenge = int(self.headers.get("Content-Length") or 0)
                roh = self.rfile.read(laenge).decode("utf-8", "replace")
                if self.path.split("?")[0] != "/v1/messages":
                    self.send_response(404)
                    self.end_headers()
                    return
                zahl["anfragen"] += 1
                try:
                    d = json.loads(roh)
                except ValueError:
                    d = {}
                texte = []
                for m in d.get("messages") or []:
                    for c in m.get("content") if isinstance(m.get("content"), list) else []:
                        if isinstance(c, dict) and c.get("type") == "tool_result":
                            texte.append(c.get("content") if isinstance(c.get("content"), str) else json.dumps(c.get("content")))
                hat_bash = any(isinstance(x, dict) and x.get("name") == "Bash" for x in d.get("tools") or [])
                if texte:
                    t = "\n".join(texte)
                    if token in t:
                        zahl["wert_gesehen"] += 1
                    m = re.search(r"kontrolle=(\d+) oauth=(\d+) auth=(\d+)", t)
                    if m:
                        zahl["ergebnis"] = tuple(int(x) for x in m.groups())
                if not texte and hat_bash:
                    inhalt = {"type": "tool_use", "id": "toolu_1", "name": "Bash",
                              "input": {"command": befehl, "description": "probe"}}
                    stop = "tool_use"
                else:
                    inhalt, stop = {"type": "text", "text": "fertig"}, "end_turn"
                msg = {"id": "msg_%d" % zahl["anfragen"], "type": "message", "role": "assistant", "model": "attrappe",
                       "content": [], "stop_reason": None, "usage": {"input_tokens": 1, "output_tokens": 1}}
                if d.get("stream"):
                    self.send_response(200)
                    self.send_header("content-type", "text/event-stream")
                    self.end_headers()
                    start = ({"type": "text", "text": ""} if inhalt["type"] == "text"
                             else {"type": "tool_use", "id": "toolu_1", "name": "Bash", "input": {}})
                    delta = ({"type": "text_delta", "text": inhalt["text"]} if inhalt["type"] == "text"
                             else {"type": "input_json_delta", "partial_json": json.dumps(inhalt["input"])})
                    for typ, daten in (("message_start", {"message": msg}),
                                       ("content_block_start", {"index": 0, "content_block": start}),
                                       ("content_block_delta", {"index": 0, "delta": delta}),
                                       ("content_block_stop", {"index": 0}),
                                       ("message_delta", {"delta": {"stop_reason": stop}, "usage": {"output_tokens": 1}}),
                                       ("message_stop", {})):
                        daten = dict(daten, type=typ)
                        self.wfile.write(("event: %s\ndata: %s\n\n" % (typ, json.dumps(daten))).encode())
                else:
                    msg.update(content=[inhalt], stop_reason=stop)
                    body = json.dumps(msg).encode()
                    self.send_response(200)
                    self.send_header("content-type", "application/json")
                    self.send_header("Content-Length", str(len(body)))
                    self.end_headers()
                    self.wfile.write(body)

        srv = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Attrappe)
        th = threading.Thread(target=srv.serve_forever, daemon=True)
        th.start()
        tmp = tempfile.mkdtemp(prefix="wb-konto-sicht.")
        try:
            for n in ("home", "cfg", "arbeit", "stummel"):
                os.makedirs(os.path.join(tmp, n))
            ssh_log = os.path.join(tmp, "stummel", "ssh-aufrufe.log")
            ssh_stummel = os.path.join(tmp, "stummel", "ssh")
            with open(ssh_stummel, "w") as f:
                f.write("#!/bin/sh\nprintf 'ssh %%s\\n' \"$*\" >>%s\nexit 255\n" % shlex.quote(ssh_log))
            os.chmod(ssh_stummel, 0o755)
            umg = {"PATH": os.path.join(tmp, "stummel") + ":/usr/bin:/bin:/usr/sbin:/sbin", "HOME": os.path.join(tmp, "home"),
                   "CLAUDE_CONFIG_DIR": os.path.join(tmp, "cfg"), "LANG": "C.UTF-8",
                   "ANTHROPIC_BASE_URL": "http://127.0.0.1:%d" % srv.server_address[1],
                   "WB_SICHT_PROBE": "1", "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1", "DISABLE_AUTOUPDATER": "1",
                   variable: token}
            try:
                r = subprocess.run([prog, "-p", "--model", "claude-sonnet-4-6", "--allowedTools", "Bash", "--",
                                    "Run the probe."], env=umg, cwd=os.path.join(tmp, "arbeit"),
                                   stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=180)
                aus_rc = r.returncode
                im_text = (r.stdout + r.stderr).count(token)
            except (OSError, subprocess.SubprocessError) as e:
                aus_rc, im_text = type(e).__name__, 0
            try:
                with open(ssh_log, encoding="utf-8", errors="replace") as f:
                    ssh_aufrufe = sum(1 for z in f if z.startswith("ssh "))
            except OSError:
                ssh_aufrufe = 0
            dateien = 0
            for wurzel, _, namen in os.walk(tmp):
                for n in namen:
                    try:
                        with open(os.path.join(wurzel, n), "rb") as f:
                            if token.encode() in f.read():
                                dateien += 1
                    except OSError:
                        pass
        finally:
            srv.shutdown()
            srv.server_close()
            shutil.rmtree(tmp, ignore_errors=True)
        return {"variable": variable, "claude_rc": aus_rc, "anfragen": zahl["anfragen"], "ergebnis": zahl["ergebnis"],
                "wert_in_werkzeugausgabe": zahl["wert_gesehen"], "wert_in_ausgabe": im_text, "dateien_mit_wert": dateien,
                "ssh_stummel_aufrufe": ssh_aufrufe}

    version = ""
    try:
        version = subprocess.run([prog, "--version"], capture_output=True, text=True, timeout=30,
                                 stdin=subprocess.DEVNULL).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        pass
    laeufe = [lauf("CLAUDE_CODE_OAUTH_TOKEN"), lauf("ANTHROPIC_AUTH_TOKEN")]
    rc = 0
    zeilen_aus = []
    for l in laeufe:
        e = l["ergebnis"]
        if e is None:
            urteil = "NICHT GEMESSEN (keine Zaehlerzeile; Anfragen %d, claude Exit %s)" % (l["anfragen"], l["claude_rc"])
            rc = max(rc, 2)
        else:
            kontrolle, oauth, auth = e
            sicht = oauth if l["variable"] == "CLAUDE_CODE_OAUTH_TOKEN" else auth
            urteil = "Kontrolle %d, %s %d" % (kontrolle, l["variable"], sicht)
            if kontrolle != 1:
                urteil += " -- NICHT GEMESSEN (Positivkontrolle fehlt)"
                rc = max(rc, 2)
            elif l["variable"] == "CLAUDE_CODE_OAUTH_TOKEN" and oauth != 0:
                urteil += " -- LAUT: das Bash-Werkzeug SIEHT den Konto-Token, der Kontoweg der Worker ist undicht"
                rc = 1
        zeilen_aus.append("%s: %s; Wert in Werkzeugausgabe %d, in CLI-Ausgabe %d, in Dateien %d; ssh-Stummel-Aufrufe %d" % (
            l["variable"], urteil, l["wert_in_werkzeugausgabe"], l["wert_in_ausgabe"], l["dateien_mit_wert"],
            l["ssh_stummel_aufrufe"]))
    if "--json" in rest:
        print(json.dumps({"claude": version, "laeufe": laeufe, "rc": rc}, ensure_ascii=False))
    else:
        print("claude %s" % (version or "?"))
        for z in zeilen_aus:
            print(z)
