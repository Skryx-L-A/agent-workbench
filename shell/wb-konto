def protokoll(text):
    """Eine Zeile in ~/.claude/workbench/konto-wechsel.log, ohne Zustellung an leitung."""
    try:
        os.makedirs(wbdir(), exist_ok=True)
        with open(os.path.join(wbdir(), "konto-wechsel.log"), "a") as f:
            f.write("%s %s\n" % (datetime.datetime.now().strftime("%F %T"), text.replace("\n", " ")))
    except OSError as e:
        print("wb-konto: konto-wechsel.log nicht geschrieben (%s)" % type(e).__name__, file=sys.stderr)


def _pane_argumente(rest, befehl):
    pane, sock, trocken = None, "", False
    i = 0
    while i < len(rest):
        if rest[i] == "--tmux-socket-pfad" and i + 1 < len(rest):
            sock = rest[i + 1]; i += 2
        elif rest[i] == "--trocken":
            trocken = True; i += 1
        elif pane is None and re.match(r"^%\d+$", rest[i]):
