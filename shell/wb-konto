        elif isinstance(vorgabe.get(schluessel), (int, float)):
            erg[art] = (float(vorgabe[schluessel]), "vorgabe")
        else:
            erg[art] = (None, "keine")
    return erg


# PLANWECHSEL: Hebt ein Mensch ein Konto mitten im Wochenfenster auf einen anderen Plan,
# setzt der Dienst die Zaehler auf 0, OHNE das Fenster zu wechseln (seven_day_resets_at bleibt
# gleich). Der Hoechstwert des Fensters bliebe sonst stehen. Ein Konto kann deshalb ein Ereignis "planwechsel" tragen:
# Messzeilen mit ts VOR der Zeit zaehlen fuer Woche und 5h nicht mehr (eine Zeile genau zur Zeit zaehlt), danach gilt der
# Hoechstwert wie bisher. Fehlt eine Zeile nach dem Wechsel, ist der Stand "unbekannt", nie 0. Eine Zeile ohne lesbare Zeit
# zaehlt nicht. Das Ereignis steht in konto-planwechsel.json (schlaegt die Vorgabe "planwechsel" der Konfiguration, wie
# konto-obergrenze.json die Obergrenze); `wb-konto planwechsel` schreibt es. Ein unlesbares Ereignis laesst NICHTS zaehlen.
def planwechsel_datei():
    return os.path.join(wbdir(), "konto-planwechsel.json")


def planwechsel_gesetzt():
    try:
        with open(planwechsel_datei()) as f:
            d = json.load(f)
        return d if isinstance(d, dict) else {}
    except (OSError, ValueError):
        return {}


def zeit_endlich(wert):
    """epoch_aus, aber nie nan/inf."""
    z = epoch_aus(wert)
    return z if z is not None and z == z and abs(z) != float("inf") else None


def planwechsel(k, name):
    """-> None (kein Ereignis) oder {"zeit": epoch|None, "plan": str|None, "quelle": "gesetzt"|"vorgabe"}; zeit None heisst
    unlesbar (dann zaehlt keine Messzeile)."""
    gesetzt = planwechsel_gesetzt().get(name)
    vorgabe = ((k.get("konten") or {}).get(name) or {}).get("planwechsel")
    for e, quelle in ((gesetzt, "gesetzt"), (vorgabe, "vorgabe")):
        if isinstance(e, dict):
            plan = e.get("plan") if isinstance(e.get("plan"), str) and e.get("plan") else None
            return {"zeit": zeit_endlich(e.get("zeit")), "plan": plan, "quelle": quelle}
    return None


def zeile_nach_planwechsel(pw, d):
    """Zaehlt die Messzeile d nach dem Planwechsel pw (None = kein Ereignis)?"""
    if pw is None:
        return True
    ts = epoch_aus(d.get("ts"))
    return pw["zeit"] is not None and ts is not None and ts >= pw["zeit"]


def planwechsel_text(pw):
    if pw is None:
        return "keiner"
    zeit = "unlesbar" if pw["zeit"] is None else datetime.datetime.fromtimestamp(pw["zeit"]).strftime("%Y-%m-%d %H:%M")
    return "%s%s" % (zeit, " (Plan %s)" % pw["plan"] if pw["plan"] else "")


