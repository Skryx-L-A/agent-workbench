def zeilen():
    pfad = os.path.join(wbdir(), "limits.jsonl")
    try:
        with open(pfad, errors="replace") as f:
            for nr, roh in enumerate(f):
                try:
                    d = json.loads(roh)
                except ValueError:
                    continue
                if isinstance(d, dict):
                    d["_nr"] = nr
                    yield d
    except FileNotFoundError:
        return


def zeile_konto(k, d):
    """Konto einer Zeile: zuerst die Familie; ohne resets_at nur ein gepruefter neuer Eintrag."""
    fam = familie(k, epoch_aus(d.get("seven_day_resets_at")))
    angabe = d.get("konto")
    if fam is not None:
        if d.get("konto_quelle") and angabe in k["konten"] and angabe != fam:
            return None   # Widerspruch im neuen Feld: nicht raten
        return fam
    if d.get("konto_quelle") and angabe in k["konten"]:
        return angabe
    return None


def buchungen():
    try:
        with open(os.path.join(wbdir(), "konto-buchung.json")) as f:
            d = json.load(f)
