def ziel_halt(k, ziel, sid, verlauf, t):
    """Grund, NICHT auf `ziel` zu wechseln, oder None. Kein Wechsel im Kreis: das Ziel ist gebucht erschoepft,
    gemessen am Ende, oder genau diese Unterhaltung kam von dort, solange dessen Limit gilt."""
    s = stand(k, ziel, t)
    if s["status"] == "erschoepft":
        return "%s ist %s" % (ziel, s.get("grund"))
    if (s.get("seven_day_pct") or 0) >= 100 or (s.get("five_hour_pct") or 0) >= 100:
        return "%s ist gemessen am Ende (Woche %s %%, %s)" % (ziel, s.get("seven_day_pct"), fuenf_text(s, roh=True))
    for v in verlauf:
        if v.get("sitzung") == sid and v.get("von") == ziel and (epoch_aus(v.get("bis")) or 0) > t:
            return "Wechsel im Kreis: diese Unterhaltung kam um %s von %s, dessen Limit bis %s gilt" % (
                datetime.datetime.fromtimestamp(epoch_aus(v.get("t")) or 0).strftime("%H:%M"), ziel,
                datetime.datetime.fromtimestamp(epoch_aus(v["bis"])).strftime("%d.%m. %H:%M"))
    return None


def _werkzeug(name):
    eigen = os.path.join(os.path.expanduser("~"), ".local", "bin", name)
