def linie_aus_bis(k, name):
    """Zeit (epoch), bis zu der die Tageslinie des Kontos nicht bremst, oder None. Eine unlesbare Angabe heisst None:
    die Linie gilt dann (die Lockerung faellt nie von selbst an)."""
    return zeit_endlich(((k.get("konten") or {}).get(name) or {}).get("linie_aus_bis"))


def stand(k, name, t):
    """Bewertung eines Kontos: dict mit status frei|knapp|erschoepft|unbekannt. "linie" ist die Tageslinie des
    Wochenfensters, "linie_wirksam" die, gegen die bewertet wird (gleich, ausser die Linie ist ausgesetzt)."""
    c = k["konten"][name]
    lin, idx, reset = linie(c, t)
    aus_bis = linie_aus_bis(k, name)
    ausgesetzt = aus_bis is not None and t < aus_bis
    if ausgesetzt:
        og_w = obergrenzen(k, name)["woche"][0]
        lin_w = min(100.0, og_w if og_w is not None else 100.0)
    else:
        lin_w = lin
    erg = {"konto": name, "linie": round(lin, 1), "linie_wirksam": round(lin_w, 1), "tagesindex": idx,
           "fenster_reset": int(reset),
           "five_hour_pct": None, "seven_day_pct": None, "gemessen": None, "abstand": None,
           "fuenf_stunden_fenster": hat_fuenf(k, name)}
    b = buchungen().get(name)
    if isinstance(b, dict) and (epoch_aus(b.get("erschoepft_bis")) or 0) > t:
        erg.update(status="erschoepft", gebucht=True, grund="gebucht erschoepft bis %s (%s)"
                   % (datetime.datetime.fromtimestamp(epoch_aus(b["erschoepft_bis"])).strftime("%d.%m. %H:%M"),
                      b.get("grund") or "ohne Grund"))
        return erg
    pw = planwechsel(k, name)
    if pw is not None:
        erg["planwechsel"] = None if pw["zeit"] is None else int(pw["zeit"])
    im_fenster = []
    vor_wechsel = 0
    for d in zeilen():
        if zeile_konto(k, d) != name:
            continue
        r = epoch_aus(d.get("seven_day_resets_at"))
        if r is None or abs(r - reset) > float(k.get("familien_toleranz_s", 300)):
            continue
        if not isinstance(d.get("seven_day_pct"), (int, float)):
            continue
        if not zeile_nach_planwechsel(pw, d):
            vor_wechsel += 1   # Zaehler des alten Plans: gilt nicht mehr (Woche und 5h)
            continue
        im_fenster.append(d)
    if not im_fenster:
        erg.update(status="unbekannt", grund="kein Messwert im laufenden Fenster (Reset %s)"
                   % datetime.datetime.fromtimestamp(reset).strftime("%a %d.%m. %H:%M"))
        if pw is not None:
            erg["grund"] += ", keiner nach dem Planwechsel (%s; %d Zeile(n) des alten Plans zaehlen nicht)" % (
                planwechsel_text(pw), vor_wechsel)
        return erg
    seven = max(float(d["seven_day_pct"]) for d in im_fenster)
    juengste = max(im_fenster, key=lambda d: (epoch_aus(d.get("ts")) or float("-inf"), d["_nr"]))
    ts = epoch_aus(juengste.get("ts"))
    erg["gemessen"] = juengste.get("ts")
    erg["seven_day_pct"] = seven
    max_alter = float(k.get("max_alter_min", 120)) * 60
    if ts is None or t - ts > max_alter:
        erg.update(status="unbekannt", grund="letzter Messwert %s ist aelter als %d min"
                   % (juengste.get("ts") or "ohne Zeit", int(max_alter // 60)))
        return erg
    fenster5 = erg["fuenf_stunden_fenster"]
    fuenf_zeilen = [d for d in im_fenster
                    if fenster5 and isinstance(d.get("five_hour_pct"), (int, float))
                    and (epoch_aus(d.get("five_hour_resets_at")) or 0) > t]
    if not fenster5:
        five = None   # Konto ohne 5h-Fenster: nichts gemessen, nichts zu pruefen (nie 0, das hiesse "Fenster offen, 0 %")
    elif fuenf_zeilen:
        r5 = max(epoch_aus(d["five_hour_resets_at"]) for d in fuenf_zeilen)
        five = max(float(d["five_hour_pct"]) for d in fuenf_zeilen if epoch_aus(d["five_hour_resets_at"]) == r5)
        erg["five_hour_reset"] = int(r5)
    else:
        five = 0.0   # kein 5h-Fenster offen: abgelaufen oder nie begonnen (statusline schreibt dann null)
    erg["five_hour_pct"] = five
    erg["abstand"] = round(lin_w - seven, 1)
    if aus_bis is not None:
        erg["linie_aus_bis"] = int(aus_bis)
    og = obergrenzen(k, name)
    ow, o5 = og["woche"][0], og["fuenf_stunden"][0]
    if ow is not None and seven >= ow:
        erg.update(status="erschoepft", obergrenze="woche", erschoepft_bis=int(reset),
                   grund="Obergrenze Woche %s %% erreicht (gemessen %s %%), erschoepft bis Reset %s"
                   % (_zahl(ow), _zahl(seven), datetime.datetime.fromtimestamp(reset).strftime("%a %d.%m. %H:%M")))
        return erg
    if o5 is not None and fuenf_zeilen and five >= o5:
        erg.update(status="erschoepft", obergrenze="fuenf_stunden", erschoepft_bis=int(r5),
                   grund="Obergrenze 5h %s %% erreicht (gemessen %s %%), erschoepft bis %s"
                   % (_zahl(o5), _zahl(five), datetime.datetime.fromtimestamp(r5).strftime("%H:%M")))
        return erg
    grenze = kwert(k, "fuenf_stunden_grenze")
    if fenster5 and five >= grenze:
        erg.update(status="knapp", grund="5h %.0f %% >= %.0f" % (five, grenze))
    elif seven >= lin_w:
        erg.update(status="knapp", grund="Woche %.0f %% >= Linie %.1f (Tag %d)" % (seven, lin_w, idx))
    elif ausgesetzt and seven >= lin:
        erg.update(status="frei", grund="Woche %.0f %% ueber Linie %.1f (Tag %d), Linie ausgesetzt bis %s, %s"
                   % (seven, lin, idx, datetime.datetime.fromtimestamp(aus_bis).strftime("%d.%m. %H:%M"),
                      "5h %.0f %%" % five if fenster5 else KEIN_FENSTER))
    else:
        erg.update(status="frei", grund="Woche %.0f %% unter Linie %.1f (Tag %d), %s"
                   % (seven, lin, idx, "5h %.0f %%" % five if fenster5 else KEIN_FENSTER))
    return erg


def bewerten(k, t):
    return [stand(k, n, t) for n in k["reihenfolge"]]


def waehlen(k, t, messen_erlaubt=True):
    widerspruch_melden(k, t)
    staende = bewerten(k, t)
    if messen_erlaubt:
        offen = [s["konto"] for s in staende if s["status"] == "unbekannt"]
        if offen:
            for n in offen:
                messen(k, n, t, erzwingen=False, leise=True)
            staende = bewerten(k, t)
    freie = [s for s in staende if s["status"] == "frei"]
    if not freie:
        return None, staende
    for n in k.get("wahl_vorrang") or []:
        for s in freie:
            if s["konto"] == n:
                return s, staende
    reihe = k["reihenfolge"]
    beste = max(freie, key=lambda s: (s["abstand"], -reihe.index(s["konto"])))
    return beste, staende


def widerspruch_melden(k, t):
    """Die Statuszeile schreibt "widerspruch", wenn die Start-Angabe nicht zur Messung passt; ihr
    stderr sieht niemand. Hier wird es laut: bei jeder Wahl, solange solche Zeilen frisch sind."""
    grenze = t - float(k.get("max_alter_min", 120)) * 60
    n = sum(1 for d in zeilen() if d.get("konto") == "widerspruch" and (epoch_aus(d.get("ts")) or 0) >= grenze)
    if n:
        print("wb-konto: WARNUNG -- %d Messzeile(n) mit Kontowiderspruch seit %d min: eine Sitzung laeuft "
              "laut Start auf einem anderen Konto, als ihre Messung zeigt (limits.jsonl, konto=widerspruch). "
              "Eintraege im Schluesselbund pruefen." % (n, int(k.get("max_alter_min", 120))), file=sys.stderr)
    return n


