def _pct(wert):
    """utilization kommt als Prozentzahl (0-100), wie sie auch die Statuszeile zeigt (hergeleitet)."""
    return float(wert) if isinstance(wert, (int, float)) and not isinstance(wert, bool) else None


def _ms_lesen():
    try:
        with open(_messstand_pfad()) as f:
            ms = json.load(f)
        return ms if isinstance(ms, dict) else {}
    except (OSError, ValueError):
        return {}


def _retry_after(kopf):
    """Retry-After in Sekunden (Zahl oder HTTP-Datum); None, wenn nicht lesbar."""
    if not kopf:
        return None
    try:
        return max(0.0, float(kopf))
    except ValueError:
        pass
    try:
        import email.utils
        d = email.utils.parsedate_to_datetime(kopf)
        return max(0.0, d.timestamp() - time.time())
    except (TypeError, ValueError):
        return None


def _sauber(text, n):
    """Steuerzeichen raus, Leerraum zusammengefasst, hoechstens n Zeichen."""
    return " ".join(re.sub(r"[\x00-\x1f\x7f]", " ", str(text)).split())[:n]


def _fehler_rumpf(e, token):
    """Was der Dienst zu einem HTTP-Fehler sagt (Fund L, 17.11.2026): aus einem JSON-Rumpf error.type und
    error.message (hoechstens 200 Zeichen), sonst Inhaltstyp und die ersten 80 Zeichen. Nie Kopfzeilen, nie der
    Token (stuende er im Rumpf, wird er ersetzt)."""
    try:
        roh = e.read(4096).decode("utf-8", "replace")
    except (OSError, ValueError, AttributeError):
        roh = ""
    if token:
        roh = roh.replace(token, "<token>")
    try:
        d = json.loads(roh)
    except ValueError:
        d = None
    if isinstance(d, dict):
        f = d.get("error") if isinstance(d.get("error"), dict) else d
        typ, text = f.get("type"), f.get("message")
        if typ is not None or text is not None:
            return " (%s: %s)" % (_sauber(typ if typ is not None else "-", 60),
                                  _sauber(text if text is not None else "-", 200))
    inhalt = e.headers.get("Content-Type") if getattr(e, "headers", None) else None
    return " (kein JSON-Fehlerrumpf, Inhaltstyp %s: %r)" % (_sauber(inhalt or "fehlt", 60), _sauber(roh, 80))


def _messen_nutzung(url, token):
    """Weg 1, kostenlos: GET api/oauth/usage.
    -> ("ok", daten) | ("429", retry_after_s) | ("verweigert", text) bei 401/403 | ("fehler", text)."""
    anfrage = urllib.request.Request(url, headers={
        "Authorization": "Bearer " + token, "anthropic-beta": "oauth-2025-04-20",
        "Accept": "application/json", "User-Agent": "wb-konto"})
    try:
        with urllib.request.build_opener(_KeineUmleitung).open(anfrage, timeout=10) as antwort:
            daten = json.loads(antwort.read().decode("utf-8", "replace"))
    except urllib.error.HTTPError as e:
        if e.code == 429:
            return "429", _retry_after(e.headers.get("Retry-After") if e.headers else None)
        if e.code in (401, 403):
            return "verweigert", "HTTPError %s%s" % (e.code, _fehler_rumpf(e, token))
        return "fehler", "HTTPError %s%s" % (e.code, _fehler_rumpf(e, token))
    except (urllib.error.URLError, OSError, ValueError) as e:
        return "fehler", type(e).__name__
    if not isinstance(daten, dict) or not isinstance(daten.get("seven_day"), dict):
        return "fehler", "Antwort ohne seven_day"
    fuenf = daten.get("five_hour") if isinstance(daten.get("five_hour"), dict) else {}
    sieben = daten["seven_day"]
    return "ok", {"five": _pct(fuenf.get("utilization")), "five_r": epoch_aus(fuenf.get("resets_at")),
                  "seven": _pct(sieben.get("utilization")), "seven_r": epoch_aus(sieben.get("resets_at")),
                  "kosten": "keine (kein Modellaufruf)"}


def _claude_bin(naht):
    """Unter der Adressnaht nur die Attrappe aus WB_KONTO_CLAUDE_BIN, nie ein echtes claude."""
    if naht:
        return os.environ.get("WB_KONTO_CLAUDE_BIN") or None
    eigen = os.path.join(os.path.expanduser("~"), ".local", "bin", "claude")
    return eigen if os.access(eigen, os.X_OK) else shutil.which("claude")


def _messen_ersatz(token, naht):
    """Weg 2, kostet einen Minimalaufruf: `claude -p --model haiku` mit dem Token NUR in der Umgebung des
    Kindes, in einem Wegwerf-HOME (keine Hooks, keine Einstellungen, keine Sitzungsdatei). Den Stand traegt
    das Stream-Ereignis rate_limit_event (rate_limit_info.unifiedWindows.{five_hour,seven_day}.utilization
    als Anteil 0..1 und resetsAt; gemessen im Stream von claude 2.1.3xx, task). Die Kosten
    kommen aus der result-Zeile desselben Laufs und werden genannt.
    -> ("ok", daten) | ("fehler", text)."""
    prog = _claude_bin(naht)
    if not prog:
        return "fehler", "claude nicht gefunden"
    tmp = tempfile.mkdtemp(prefix="wb-konto-ersatz.")
    try:
        os.makedirs(os.path.join(tmp, "home"))
        os.makedirs(os.path.join(tmp, "cfg"))
        os.makedirs(os.path.join(tmp, "arbeit"))
        umg = {"PATH": "/usr/bin:/bin:/usr/sbin:/sbin", "HOME": os.path.join(tmp, "home"),
               "CLAUDE_CONFIG_DIR": os.path.join(tmp, "cfg"), "LANG": "C.UTF-8",
               "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1", "DISABLE_AUTOUPDATER": "1",
               "CLAUDE_CODE_OAUTH_TOKEN": token}
        if os.environ.get("TZ"):
            umg["TZ"] = os.environ["TZ"]
        argv = [prog, "-p", "--model", "haiku", "--output-format", "stream-json", "--verbose",
                "--max-turns", "1", "--tools", "", "--strict-mcp-config", "--no-session-persistence", "--", "."]
        try:
            r = subprocess.run(argv, env=umg, cwd=os.path.join(tmp, "arbeit"), stdin=subprocess.DEVNULL,
                               capture_output=True, text=True, timeout=180)
        except (OSError, subprocess.SubprocessError) as e:
            return "fehler", "claude-Aufruf gescheitert (%s)" % type(e).__name__
    finally:
        umg = None
        shutil.rmtree(tmp, ignore_errors=True)
    fenster, kosten = None, None
    for roh in r.stdout.splitlines():
        try:
            d = json.loads(roh)
        except ValueError:
            continue
        if not isinstance(d, dict):
            continue
        if d.get("type") == "rate_limit_event":
            w = (d.get("rate_limit_info") or {}).get("unifiedWindows")
            if isinstance(w, dict) and isinstance(w.get("seven_day"), dict):
                fenster = w
        elif d.get("type") == "result":
            u = d.get("usage") or {}
            kosten = "%s USD laut CLI; Tokens: Eingabe %s, Cache-Schreiben %s, Cache-Lesen %s, Ausgabe %s" % (
                d.get("total_cost_usd"), u.get("input_tokens"), u.get("cache_creation_input_tokens"),
                u.get("cache_read_input_tokens"), u.get("output_tokens"))
    if fenster is None:
        return "fehler", "kein rate_limit_event mit seven_day (claude Exit %s)" % r.returncode

    def anteil(w):
        u = (w or {}).get("utilization")
        return round(float(u) * 100.0, 1) if isinstance(u, (int, float)) and not isinstance(u, bool) else None
    fuenf = fenster.get("five_hour") if isinstance(fenster.get("five_hour"), dict) else {}
    return "ok", {"five": anteil(fuenf), "five_r": epoch_aus(fuenf.get("resetsAt")),
                  "seven": anteil(fenster["seven_day"]), "seven_r": epoch_aus(fenster["seven_day"].get("resetsAt")),
                  "kosten": kosten or "nicht gemeldet (keine result-Zeile)"}


def _messzeile(k, name, t, daten, quelle, sag):
    """Schreibt die Messzeile; 0 geschrieben, 2 Widerspruch/unvollstaendig (dann nichts geschrieben)."""
    r7 = daten.get("seven_r")
    fam = familie(k, r7)
    if fam != name:
        sag("messen %s: WIDERSPRUCH -- der Token des Eintrags '%s' misst ein Fenster der Familie %s "
            "(seven_day_resets_at %s); kein Messwert geschrieben" % (name, k["konten"][name]["dienst"], fam or "unbekannt",
                                                                    int(r7) if r7 else "fehlt"))
        return 2
    if daten.get("seven") is None:
        sag("messen %s: Antwort ohne Wochenwert -- nicht gemessen" % name)
        return 2
    fenster5 = hat_fuenf(k, name)
    r5 = daten.get("five_r") if fenster5 else None
    zeile = {"ts": datetime.datetime.fromtimestamp(t, datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
             "session": "wb-konto-messung",
             "five_hour_pct": daten.get("five") if fenster5 else None,
             "seven_day_pct": daten.get("seven"),
             "five_hour_resets_at": str(int(r5)) if r5 else "",
             "seven_day_resets_at": str(int(r7)),
             "konto": name, "konto_quelle": quelle}
    os.makedirs(wbdir(), exist_ok=True)
    with open(os.path.join(wbdir(), "limits.jsonl"), "a") as f:
        f.write(json.dumps(zeile) + "\n")
    sag("messen %s (%s): %s, Woche %s %%; Kosten: %s" % (
        name, quelle, "5h %s %%" % zeile["five_hour_pct"] if fenster5 else KEIN_FENSTER,
        zeile["seven_day_pct"], daten.get("kosten")))
    return 0


def _letzte_messung(name):
    """Die juengste Messzeile (session wb-konto-messung) des Kontos, sonst None. Beide Wege schreiben sie."""
    letzte = None
    for d in zeilen():
        if d.get("session") == "wb-konto-messung" and d.get("konto") == name:
            letzte = d
    return letzte


def messen(k, name, t, erzwingen=False, leise=False):
    """Rueckgabe wie ein Exit-Code: 0 gemessen, 4 gedrosselt, 5 gesperrt/kein Eintrag, 2 Fehler/Widerspruch,
    6 HTTP 429 und kein Ersatz gemessen. Jeder Ausgang ausser 0 heisst "nicht gemessen": es wird KEINE Zeile
    geschrieben, das Konto bleibt fuer `wahl` unbekannt und damit nie frei (decision 11-14: 429 gemessen).

    Zwei Wege, je Konto gedrosselt (Abstand mess_abstand_min, auch mit --erzwingen nie schneller als eine
    429-Sperre erlaubt):
      1. GET api/oauth/usage (kostenlos). Ein 429 sperrt diesen Weg fuer max(Retry-After, Abstand x 2^n),
         n = 429 in Folge, hoechstens 6 h. --erzwingen hebt diese Sperre NICHT auf.
      2. Scheitert Weg 1 oder ist er gesperrt: ein Minimalaufruf `claude -p --model haiku` (Kosten werden
         genannt). WB_KONTO_KEIN_ERSATZ=1 schaltet ihn ab.
    --erzwingen durchbricht den Abstand, aber hoechstens EIN erzwungener Abruf je Konto in ERZWUNGEN_ABSTAND_S,
    Weg 1 und Ersatzweg zusammen (task, 18.11.2026). Kommt ein weiterer, sendet er nichts und nennt den
    letzten Messwert mit seinem Alter ("gemessen vor N s"); Rueckgabe 4."""
    def sag(text):
        if not leise:
            print("wb-konto: " + text, file=sys.stderr)
    if os.environ.get("WB_KONTO_KEIN_NETZ"):
        sag("messen %s: Netzzugriff gesperrt (WB_KONTO_KEIN_NETZ)" % name)
        return 5
    ms = _ms_lesen()
    eintrag = ms.get(name) if isinstance(ms.get(name), dict) else {}
    abstand = float(k.get("mess_abstand_min", 30)) * 60
    letzte = epoch_aus(eintrag.get("versuch"))
    if not erzwingen and letzte is not None and t - letzte < abstand:
        sag("messen %s: letzter Versuch vor %d min, Abstand %d min -- nicht gemessen"
            % (name, int((t - letzte) // 60), int(abstand // 60)))
        return 4
    erzw = epoch_aus(eintrag.get("erzwungen")) if erzwingen else None
    if erzw is not None and 0 <= t - erzw < ERZWUNGEN_ABSTAND_S:
        m = _letzte_messung(name)
        alter = epoch_aus(m.get("ts")) if m else None
        stand_txt = ("letzter Messwert %s, Woche %s %%, gemessen vor %d s"
                     % ("5h %s %%" % _zahl(m.get("five_hour_pct")) if hat_fuenf(k, name) else KEIN_FENSTER,
                        _zahl(m.get("seven_day_pct")), int(t - alter))
                     if alter is not None else "kein Messwert vorhanden")
        sag("messen %s: erzwungener Abruf vor %d s, hoechstens einer je %d min -- keine Anfrage; %s"
            % (name, int(t - erzw), ERZWUNGEN_ABSTAND_S // 60, stand_txt))
        return 4
    eintrag["versuch"] = int(t)
    ms[name] = eintrag
    _json_schreiben(_messstand_pfad(), ms)
    url, naht = _adresse()
    if naht:
        token = SCHEIN_SCHLUESSEL
    else:
        dienst = k["konten"][name]["dienst"]
        token = token_lesen(dienst)
        if not token:
            sag("messen %s: Schluesselbund-Eintrag '%s' fehlt oder ist leer -- nicht gemessen" % (name, dienst))
            return 5
    war_429 = False
    sperre = epoch_aus(eintrag.get("nutzung_sperre_bis"))
    if sperre is not None and sperre > t:
        war_429 = True
        sag("messen %s: Nutzungsabfrage nach HTTP 429 gesperrt bis %s -- nicht abgefragt"
            % (name, datetime.datetime.fromtimestamp(sperre).strftime("%d.%m. %H:%M")))
    elif not erzwingen and (epoch_aus(eintrag.get("nutzung_verweigert_bis")) or 0) > t:
        sag("messen %s: Nutzungsabfrage gesperrt bis %s, der Dienst verweigerte sie (%s) -- nicht abgefragt"
            % (name, datetime.datetime.fromtimestamp(epoch_aus(eintrag["nutzung_verweigert_bis"])).strftime(
                "%d.%m. %H:%M"), eintrag.get("nutzung_verweigert_grund") or "ohne Grund"))
    else:
        if erzwingen:   # der erzwungene Abruf geht jetzt hinaus; er zaehlt fuer den Riegel (task)
            eintrag["erzwungen"] = int(t)
            ms[name] = eintrag
            _json_schreiben(_messstand_pfad(), ms)
        art, wert = _messen_nutzung(url, token)
        if art == "ok":
            eintrag.pop("n429", None)
            eintrag.pop("nutzung_sperre_bis", None)
            eintrag.pop("nutzung_verweigert_bis", None)
            eintrag.pop("nutzung_verweigert_grund", None)
            rc = _messzeile(k, name, t, wert, "messung", sag)
            if rc == 0:
                eintrag["erfolg"] = int(t)
            ms[name] = eintrag
            _json_schreiben(_messstand_pfad(), ms)
            token = None
            return rc      # 0 gemessen; 2 Widerspruch: der Ersatzweg mit demselben Token zeigte dasselbe
        elif art == "429":
            war_429 = True
            n = int(eintrag.get("n429") or 0) + 1
            warte = max(wert or 0.0, min(6 * 3600.0, abstand * (2 ** (n - 1))))
            eintrag["n429"] = n
            eintrag["nutzung_sperre_bis"] = int(t + warte)
            ms[name] = eintrag
            _json_schreiben(_messstand_pfad(), ms)
            sag("messen %s: HTTP 429 (Retry-After %s) -- NICHT gemessen, Nutzungsabfrage gesperrt fuer %d min"
                % (name, "%.0f s" % wert if wert is not None else "fehlt", int(warte // 60)))
        elif art == "verweigert":
            # Fund L (17.11.2026, gemessen): 403 permission_error "OAuth token does not meet scope requirement
            # user:profile" -- der Langzeit-Token aus `claude setup-token` hat den Bereich nicht. Erneutes Fragen
            # aendert daran nichts; der Weg ruht deshalb VERWEIGERT_SPERRE_S, --erzwingen fragt trotzdem.
            eintrag["nutzung_verweigert_bis"] = int(t + VERWEIGERT_SPERRE_S)
            eintrag["nutzung_verweigert_grund"] = wert
            ms[name] = eintrag
            _json_schreiben(_messstand_pfad(), ms)
            text = ("messen %s: Nutzungsabfrage verweigert (%s) -- nicht gemessen; Weg 1 gesperrt fuer %d h "
                    "(--erzwingen fragt erneut)" % (name, wert, VERWEIGERT_SPERRE_S // 3600))
            sag(text)
            protokoll("wb-konto: " + text)
        else:
            sag("messen %s: Nutzungsabfrage gescheitert (%s) -- nicht gemessen" % (name, wert))
    if os.environ.get("WB_KONTO_KEIN_ERSATZ") == "1":
        token = None
        sag("messen %s: Ersatzweg abgeschaltet (WB_KONTO_KEIN_ERSATZ=1)" % name)
        return 6 if war_429 else 2
    letzte_e = epoch_aus(eintrag.get("ersatz_versuch"))
    if not erzwingen and letzte_e is not None and t - letzte_e < abstand:
        token = None
        sag("messen %s: Ersatzweg vor %d min versucht, Abstand %d min -- nicht gemessen"
            % (name, int((t - letzte_e) // 60), int(abstand // 60)))
        return 6 if war_429 else 4
    eintrag["ersatz_versuch"] = int(t)
    if erzwingen:   # die Ersatzmessung ist ein erzwungener Abruf und zaehlt fuer den Riegel mit
        eintrag["erzwungen"] = int(t)
    ms[name] = eintrag
    _json_schreiben(_messstand_pfad(), ms)
    art, wert = _messen_ersatz(token, naht)
    token = None
    if art != "ok":
        sag("messen %s: Ersatzweg (claude -p haiku) gescheitert (%s) -- nicht gemessen" % (name, wert))
        return 6 if war_429 else 2
    rc = _messzeile(k, name, t, wert, "messung-ersatz", sag)
    if rc == 0:
        eintrag["erfolg"] = int(t)
        ms[name] = eintrag
        _json_schreiben(_messstand_pfad(), ms)
    return rc


# ── start: ein Claude-Start ueber die Kontowahl (wb-code, Zug 2) ────────────────────────────────────
def _prozess_start(pid):
    """Startzeit wie Claude sie in ~/.claude/sessions/<pid>.json als procStart eintraegt (LC_ALL=C TZ=UTC)."""
    try:
        r = subprocess.run(["ps", "-o", "lstart=", "-p", str(pid)], capture_output=True, text=True, timeout=5,
                           env=dict(os.environ, LC_ALL="C", TZ="UTC"), stdin=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError):
        return ""
    return " ".join(r.stdout.split()) if r.returncode == 0 else ""


def _prozess_start_epoch(start):
    try:
        return datetime.datetime.strptime(start, "%a %b %d %H:%M:%S %Y").replace(
            tzinfo=datetime.timezone.utc).timestamp()
    except (TypeError, ValueError):
        return None


def _marken_dir():
    return os.path.join(wbdir(), "konto-prozesse")


def _marke_schreiben(pid, name, angabe):
    d = _marken_dir()
    os.makedirs(d, exist_ok=True)
    for n in os.listdir(d):                      # Marken toter Prozesse abraeumen
        if n.endswith(".json") and n[:-5].isdigit() and int(n[:-5]) != pid:
            try:
                os.kill(int(n[:-5]), 0)
            except ProcessLookupError:
                try:
                    os.unlink(os.path.join(d, n))
                except OSError:
                    pass
            except PermissionError:
                pass
    _json_schreiben(os.path.join(d, "%d.json" % pid),
                    {"pid": pid, "konto": name, "angabe": angabe, "start": _prozess_start(pid)})


def _pane_konto_merken(name):
    """Das Konto ist Zustand des Panes (decision 2026-11-16): ein Neustart ohne --konto (wb-schlaf wecken, wb-autorevive,
    prefix + R, die App) uebernimmt @wb_konto in seine startende Zeile (wb-revive). Nur im eigenen Pane (TMUX_PANE
    und TMUX gesetzt, derselbe tmux-Server); ein Fehler haelt den Start nicht auf."""
    pane = os.environ.get("TMUX_PANE", "")
    if not re.fullmatch(r"%\d+", pane) or not os.environ.get("TMUX"):
        return
    try:
        subprocess.run(["tmux", "set", "-p", "-t", pane, "@wb_konto", name], capture_output=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        pass


def _pane_konto_lesen():
    """@wb_konto des eigenen Panes (das Konto des letzten Starts hier) oder ''. Nur im eigenen Pane, nie ein Fehler."""
    pane = os.environ.get("TMUX_PANE", "")
    if not re.fullmatch(r"%\d+", pane) or not os.environ.get("TMUX"):
        return ""
    try:
        r = subprocess.run(["tmux", "show", "-p", "-v", "-t", pane, "@wb_konto"], capture_output=True, text=True,
                           timeout=10, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError):
        return ""
    return r.stdout.strip() if r.returncode == 0 else ""


def _kurz(wert):
    return wert if re.fullmatch(r"[A-Za-z0-9_-]{1,16}", wert or "") else "?"


def _start_angabe(rest):
    """Welche Angabe gilt fuer DIESEN Start? -> (befehl, angabe, grund, hinweis).

    Eine Angabe gilt nur fuer den Start, fuer den sie gemacht wurde (task, Fund decision 2026-11-18):
    - `--konto <k>` vor dem `--`: ausdruecklich, auch innerhalb einer Sitzung;
    - WB_CLAUDE_KONTO in einem frischen Prozess (die Startzeile eines Panes, wb-revive, wb-code): ausdruecklich;
    - WB_CLAUDE_KONTO zusammen mit WB_CLAUDE_KONTO_AKTIV: der Prozess laeuft in einer Sitzung, die schon ueber
      wb-konto, wb-harness-run oder pi-worker gestartet wurde. Die Variable stammt von deren Start und gilt nicht
      als Angabe fuer den neuen; es entscheidet die Wahl;
    - sonst auto = die Wahl."""
    if "--" in rest:
        i = rest.index("--")
        vor, befehl = rest[:i], rest[i + 1:]
    else:
        vor, befehl = [], rest
    flag = None
    n = 0
    while n < len(vor):
        if vor[n] == "--konto" and n + 1 < len(vor):
            flag = vor[n + 1]
            n += 2
        else:
            fehler("start: unbekannte Angabe '%s' vor --" % vor[n], 2)
    if not befehl:
        fehler("start [--konto <k>] -- <programm> [args...]", 2)
    env = os.environ.get("WB_CLAUDE_KONTO") or ""
    aktiv = os.environ.get("WB_CLAUDE_KONTO_AKTIV") or ""
    hinweis = ""
    if flag:
        angabe, grund = flag, "Angabe des Starters"
    elif env and not aktiv:
        angabe, grund = env, "Angabe des Starters"
    else:
        angabe, grund = "auto", "Wahl"
        if env:
            hinweis = ("die geerbte Variable WB_CLAUDE_KONTO=%s dieser Sitzung (laeuft auf Konto %s) gilt nicht als "
                       "Angabe fuer einen neuen Start; ausdruecklich geht --konto" % (_kurz(env), _kurz(aktiv)))
    if angabe == "auto":
        grund = "Wahl"
    return befehl, angabe, grund, hinweis


def befehl_start(k, rest, t):
    """wb-konto start [--konto <k>] -- <programm> [args...]: Konto nach der Angabe DIESES Starts (siehe
    _start_angabe; ohne Angabe die Wahl) waehlen, Token aus dem Schluesselbund NUR in die Umgebung, dann exec
    (dieselbe PID: Register und Wache sehen den Pane-Prozess). Das Kind bekommt WB_CLAUDE_KONTO nicht weiter
    (das laufende Konto steht in WB_CLAUDE_KONTO_AKTIV). Ohne Konto, Eintrag oder Token: Exit != 0, kein stiller
    Rueckfall auf die Browser-Anmeldung."""
    befehl, angabe, grund, hinweis = _start_angabe(rest)
    konto_pruefen(k, angabe, auto_erlaubt=True)
    name = angabe
    if angabe == "auto":
        beste, staende = waehlen(k, t)
        if not beste:
            fehler("start: auto findet kein Konto mit Luft -- %s; kein Start."
                   % "; ".join(zeile_fuer(s) for s in staende), 3)
        name = beste["konto"]
    elif any(a in ("--resume", "-r", "--continue", "-c") or a.startswith("--resume=") for a in befehl[1:]):
        # Dieselbe Unterhaltung wird fortgesetzt: lief der Pane zuletzt auf einem anderen Konto, ist das der Wechsel.
        vorher = _pane_konto_lesen()
        if vorher in k["konten"]:
            grund = ("Neustart nach Wechsel (Pane lief auf %s)" % vorher) if vorher != name \
                else "Neustart, Konto des Panes"
    dienst = k["konten"][name]["dienst"]
    if not dienst_vorhanden(dienst):
        fehler("FEHLER -- kein Schluesselbund-Eintrag '%s' fuer Konto %s; kein stiller Rueckfall auf die "
               "Browser-Anmeldung; kein Start." % (dienst, name))
    token = token_lesen(dienst)
    if not token:
        fehler("FEHLER -- Schluesselbund-Eintrag '%s' leer oder nicht lesbar; kein stiller Rueckfall auf die "
               "Browser-Anmeldung; kein Start." % dienst)
    umg = dict(os.environ)
    umg.pop("ANTHROPIC_API_KEY", None)
    umg.pop("WB_CLAUDE_KONTO", None)             # gilt nur fuer diesen Start; das Kind waehlt selbst (task)
    umg["CLAUDE_CODE_OAUTH_TOKEN"] = token
    umg["WB_CLAUDE_KONTO_AKTIV"] = name
    token = None
    try:
        _marke_schreiben(os.getpid(), name, angabe)
    except OSError as e:
        print("wb-konto: Marke des Prozesses nicht geschrieben (%s); der Wechsel bei Limit liest dann die "
              "Messzeilen" % type(e).__name__, file=sys.stderr)
    _pane_konto_merken(name)
    print("wb-konto: start auf Konto %s (Angabe %s; Grund: %s)" % (name, angabe, grund), file=sys.stderr)
    if hinweis:
        print("wb-konto: HINWEIS -- %s" % hinweis, file=sys.stderr)
    if any(a == "--remote-control" or a.startswith("--remote-control=") for a in befehl[1:]):
        # Sichtbar, nie still: die CLI startet mit Kontotoken
        # und --remote-control ohne jede Meldung (gemessen mit echter CLI, Wegwerf-Token, eigenem tmux-Server),
        # laut ihren Zeichenketten sind Langzeit-Token aber "inference-only". Die Zeile bleibt ueber der Sitzung
        # im Pane stehen.
        print("wb-konto: ACHTUNG -- Orchestrator auf Konto %s: Claude Remote Control ist AUS (Kontotoken nur "
              "Inferenz). Fernsteuerung ueber die Werkbank-Handy-App. Zurueck zur Mac-Anmeldung: "
              "wb-state settings set orchestratorKonto ''" % name, file=sys.stderr)
    try:
        os.execvpe(befehl[0], befehl, umg)
    except OSError as e:
        fehler("start: %s nicht startbar (%s)" % (befehl[0], type(e).__name__), 127)


# ── wechsel: Kontowechsel bei Limit (Soll 3) ────────────────────────────────────────────────────────
# Wortlaut der Limitmeldung in den Gespraechsdateien (~/.claude/projects/*/*.jsonl, Eintraege mit
# isApiErrorMessage und error "rate_limit"): "You've hit your <art> limit · resets <uhrzeit> (<zeitzone>)", mit
# <art> etwa session oder weekly. Die CLI baut den Satz aus "You've hit your " + Art + " limit"
# (Zeichenketten der Programmdatei); dazu kommen "<Modell> limit reached" und Ausgabenlimits. Nur Sitzungs-,
# Wochen- und allgemeine Nutzungslimits erschoepfen ein KONTO; Modell-, Ausgaben- und Teamlimits nicht.
LIMIT_ZEILE = re.compile(r"hit your (?P<art>[A-Za-z0-9'\- ]*?)\s*limit\b|(?P<art2>[A-Za-z0-9\-]+) limit reached", re.I)
KONTO_ARTEN = {"", "session", "weekly", "usage", "5-hour", "five-hour"}
MODELL_RE = re.compile(r"\b(?:opus|sonnet|haiku|fable)\b", re.I)
RESET_RE = re.compile(r"resets?\s+(?:at\s+|on\s+)?(?:(?P<mon>[A-Z][a-z]{2,8})\s+(?P<tag>\d{1,2})(?:st|nd|rd|th)?,?\s+"
                      r"(?:at\s+)?)?(?P<h>\d{1,2})(?::(?P<m>\d{2}))?\s*(?P<ap>am|pm)?\s*(?:\((?P<tz>[^)]+)\))?", re.I)
BUSY_RE = re.compile(r"esc to interrupt|…\s*\(\d+[hms]|Running \d+ (?:shell|tool)|Compacting", re.I)
ASSISTENT_RE = re.compile(r"^\s*[⏺●]")
SITZUNG_RE = re.compile(r"^[A-Za-z0-9._-]{1,128}$")


def _tmux(sock, *args):
    argv = [shutil.which("tmux") or "/opt/homebrew/bin/tmux"] + (["-S", sock] if sock else []) + list(args)
    umg = {k: v for k, v in os.environ.items() if k not in ("TMUX", "TMUX_PANE")}
    try:
        r = subprocess.run(argv, capture_output=True, text=True, timeout=20, env=umg, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError):
        return None
    return r.stdout if r.returncode == 0 else None


def limit_im_bild(text):
    """Letzte Limitzeile am Zugende -> (zeile, art) oder (None, grund)."""
    zeilen = text.splitlines()
    treffer = None
    for i, z in enumerate(zeilen):
        m = LIMIT_ZEILE.search(z)
        if m:
            treffer = (i, z, m)
    if treffer is None:
        return None, "keine Limitmeldung im Bild"
    i, z, m = treffer
    if any(ASSISTENT_RE.match(x) for x in zeilen[i + 1:]):
        return None, "Limitmeldung ist Verlauf (danach neue Ausgabe)"
    nichtleer = [x for x in zeilen if x.strip()][-10:]
    if any(BUSY_RE.search(x) for x in nichtleer):
        return None, "Pane arbeitet gerade"
    art = (m.group("art") if m.group("art") is not None else (m.group("art2") or "")).strip().lower()
    return z.strip(), art


def reset_aus_zeile(zeile, art, c, t):
    """Reset-Zeitpunkt: Woche = Wochenreset des Kontos (Konfiguration, gemessen); sonst die Uhrzeit der Meldung
    (naechster solcher Zeitpunkt, hoechstens 24 h); unlesbar: t + 5 h."""
    if art == "weekly":
        return naechster_reset(c, t), "Wochenreset des Kontos"
    m = RESET_RE.search(zeile)
    if m:
        try:
            from zoneinfo import ZoneInfo
            tz = ZoneInfo(m.group("tz")) if m.group("tz") else None
        except Exception:
            tz = None
        h, mi = int(m.group("h")), int(m.group("m") or 0)
        ap = (m.group("ap") or "").lower()
        if ap == "pm" and h != 12:
            h += 12
        elif ap == "am" and h == 12:
            h = 0
        if 0 <= h <= 23 and 0 <= mi <= 59:
            jetzt_dt = datetime.datetime.fromtimestamp(t, tz) if tz else datetime.datetime.fromtimestamp(t)
            ziel = jetzt_dt.replace(hour=h, minute=mi, second=0, microsecond=0)
            if ziel.timestamp() <= t:
                ziel += datetime.timedelta(days=1)
            return ziel.timestamp(), "Uhrzeit der Meldung"
    return t + 5 * 3600, "Meldung ohne lesbare Uhrzeit, 5 h angenommen"


def sitzung_aus_register(pid):
    """Kennung der Unterhaltung aus ~/.claude/sessions/<pid>.json (nie aus @wb_cmd). Die Datei muss genau diesen
    lebenden Prozess nennen (pid, procStart)."""
    ordner = os.path.join(os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(os.path.expanduser("~"), ".claude"),
                          "sessions")
    try:
        with open(os.path.join(ordner, "%s.json" % pid)) as f:
            d = json.load(f)
    except (OSError, ValueError):
        return None, "kein Register %s/%s.json" % (ordner, pid)
    if str(d.get("pid")) != str(pid):
        return None, "Register %s.json nennt eine andere PID" % pid
    start = d.get("procStart")
    if isinstance(start, str) and start.strip() and " ".join(start.split()) != _prozess_start(pid):
        return None, "Register %s.json gehoert einem frueheren Prozess (procStart)" % pid
    sid = d.get("sessionId") or ""
    if not SITZUNG_RE.match(sid):
        return None, "Register %s.json ohne gueltige sessionId" % pid
    return sid, "Register %s.json" % pid


def limit_aus_transkript(sid):
    """BELEG eines echten Limit-Stopps (decision 11-14): Der LETZTE Unterhaltungseintrag (type user oder assistant)
    ist eine API-Fehlermeldung mit error rate_limit. Bildschirmtext allein reicht nie: ein Assistent kann den Satz
    zitieren (Bericht am Zugende), eine Person kann ihn in den Prompt tippen.
    -> ("beleg", "uuid:<uuid>") | ("kein", grund) | ("unlesbar", grund)."""
    wurzel = os.path.join(os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(os.path.expanduser("~"), ".claude"),
                          "projects")
    import glob
    pfade = glob.glob(os.path.join(wurzel, "*", sid + ".jsonl"))
    if not pfade:
        return "unlesbar", "kein Transkript %s.jsonl" % sid
    pfad = max(pfade, key=lambda p: os.path.getmtime(p) if os.path.exists(p) else 0)
    try:
        with open(pfad, "rb") as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - 4 * 1024 * 1024))
            roh = f.read().decode("utf-8", "replace").splitlines()
    except OSError as e:
        return "unlesbar", "Transkript nicht lesbar (%s)" % type(e).__name__
    for z in reversed(roh):
        try:
            d = json.loads(z)
        except ValueError:
            continue
        if not isinstance(d, dict) or d.get("type") not in ("user", "assistant"):
            continue
        if d.get("isApiErrorMessage") is True and d.get("error") == "rate_limit" and d.get("uuid"):
            return "beleg", "uuid:%s" % d["uuid"]
        return "kein", "letzter Eintrag (%s) ist kein Limitfehler" % d.get("type")
    return "unlesbar", "Transkript ohne Unterhaltungseintrag"


UNBESTIMMTE_ARTEN = ("usage", "")


def _fuenf_frisch(k, konto, t):
    """Juengster frischer five_hour_pct eines OFFENEN 5h-Fensters -> (wert, ts) oder (None, None). stand() setzt
    ohne Fenster 0, das waere kein Messwert. Ein Konto ohne 5h-Fenster hat nie einen Wert."""
    if not hat_fuenf(k, konto):
        return None, None
    max_alter = float(k.get("max_alter_min", 120)) * 60
    pw = planwechsel(k, konto)
    frisch = [d for d in zeilen() if zeile_konto(k, d) == konto and isinstance(d.get("five_hour_pct"), (int, float))
              and (epoch_aus(d.get("five_hour_resets_at")) or 0) > t
              and t - (epoch_aus(d.get("ts")) or float("-inf")) <= max_alter
              and zeile_nach_planwechsel(pw, d)]
    if not frisch:
        return None, None
    juengste = max(frisch, key=lambda d: (epoch_aus(d.get("ts")) or 0, d["_nr"]))
    return float(juengste["five_hour_pct"]), juengste.get("ts")


def _woche_frisch(k, konto, t):
    """Wochenwert des laufenden Fensters aus einem frischen Messwert -> (wert, ts) oder (None, None)."""
    s = stand(k, konto, t)
    if s.get("status") == "unbekannt" or not isinstance(s.get("seven_day_pct"), (int, float)):
        return None, None
    return float(s["seven_day_pct"]), s.get("gemessen")


def messwert_widerspricht(k, konto, art, t):
    """Frischer Messwert des Kontos klar unter dem Limit -> Satz, sonst None (14.11.2026): Woche gegen
    seven_day_pct, Sitzung/5 h gegen five_hour_pct. Ohne frischen Messwert gilt die Meldung.
    UNBESTIMMTE ART (Vorfall 16.11.: "Usage limit reached" ohne Angabe der Art): bei
    "usage" oder "" widerspricht der Messwert nur, wenn five_hour_pct UND seven_day_pct gemessen unter der Grenze
    liegen. Welche Art dann gilt, sagt art_aus_messwert()."""
    grenze = float(k.get("limit_messwert_min", 90))
    if art == "weekly":
        s = stand(k, konto, t)
        if s.get("status") in ("unbekannt", "erschoepft"):
            return None
        wert, wann = s.get("seven_day_pct"), s.get("gemessen")
    elif art in UNBESTIMMTE_ARTEN and not hat_fuenf(k, konto):
        # Ohne 5h-Fenster prueft nur die Woche (decision 2026-11-20, Entscheidung b): liegt sie frisch unter der Grenze, gilt
        # die Meldung nicht; ohne frischen Wochenwert gilt sie wie immer.
        woche, wann7 = _woche_frisch(k, konto, t)
        if woche is None or woche >= grenze:
            return None
        return "seven_day_pct %.0f %% (gemessen %s) liegt unter %.0f %% (%s)" % (woche, wann7 or "?", grenze, KEIN_FENSTER)
    elif art in UNBESTIMMTE_ARTEN:
        fuenf, wann5 = _fuenf_frisch(k, konto, t)
        woche, wann7 = _woche_frisch(k, konto, t)
        if fuenf is None or woche is None or fuenf >= grenze or woche >= grenze:
            return None
        return "five_hour_pct %.0f %% (gemessen %s) und seven_day_pct %.0f %% (gemessen %s) liegen unter %.0f %%" % (
            fuenf, wann5 or "?", woche, wann7 or "?", grenze)
    else:
        wert, wann = _fuenf_frisch(k, konto, t)
        if wert is None:
            return None
    feld = "seven_day_pct" if art == "weekly" else "five_hour_pct"
    if isinstance(wert, (int, float)) and wert < grenze:
        return "%s %.0f %% (gemessen %s) liegt unter %.0f %%" % (feld, wert, wann or "?", grenze)
    return None


def art_aus_messwert(k, konto, art, t):
    """Unbestimmte Art ("usage", ""): liegt nur die Woche ueber limit_messwert_min (5h darunter), gilt "weekly";
    gebucht wird dann bis zum Wochenreset des Kontos. Eine ausdrueckliche Art bleibt. -> (art, grund|None)."""
    if art not in UNBESTIMMTE_ARTEN:
        return art, None
    grenze = float(k.get("limit_messwert_min", 90))
    fuenf, _w5 = _fuenf_frisch(k, konto, t)
    woche, wann7 = _woche_frisch(k, konto, t)
    if woche is not None and woche >= grenze and (fuenf is None or fuenf < grenze):
        return "weekly", "Woche %s %% (gemessen %s), %s: Wochenlimit" % (
            _zahl(woche), wann7 or "?",
            KEIN_FENSTER if not hat_fuenf(k, konto) else "5h ? %" if fuenf is None else "5h %s %%" % _zahl(fuenf))
    return art, None


def ummeldung_von_hand(k, sid, start, konto_marke):
    """UMMELDUNG VON HAND (task): meldet ein Mensch eine laufende Sitzung mit /login um, nennt die Marke
    weiter das alte Konto, die Messzeilen das neue (dort konto=widerspruch). Massgeblich ist die Reset-Familie
    (seven_day_resets_at), nie das Feld konto. Zeigen die zwei juengsten Messzeilen DIESER Unterhaltung, beide juenger
    als der Prozessstart und als der letzte eingetragene Wechsel, uebereinstimmend ein anderes Konto -> (konto, grund),
    sonst (None, "")."""
    if not sid:
        return None, ""
    ab = _prozess_start_epoch(start)
    wechsel_t = [epoch_aus(v.get("t")) or 0 for v in _wechsel_lesen()["verlauf"] if v.get("sitzung") == sid]
    seit = max([x for x in (ab, max(wechsel_t) if wechsel_t else None) if x is not None] or [None])
    if seit is None:
        return None, ""
    passend = []
    for d in zeilen():
        ts = epoch_aus(d.get("ts"))
        if d.get("session") == sid and ts is not None and ts > seit:
            passend.append((ts, d["_nr"], familie(k, epoch_aus(d.get("seven_day_resets_at")))))
    letzte = sorted(passend)[-2:]
    if len(letzte) < 2 or letzte[0][2] is None or letzte[0][2] != letzte[1][2] or letzte[0][2] == konto_marke:
        return None, ""
    return letzte[0][2], "zwei Messzeilen der Unterhaltung seit dem Prozessstart zeigen die Familie %s" % letzte[0][2]


def konto_der_marke(k, pid, sid, start):
    """Marke von `wb-konto start` (PID + Startzeit muessen passen); eine Ummeldung von Hand (E) zieht sie nach.
    Ohne Sitzung kein Nachziehen. -> (konto, grund) | (None, "")."""
    marke = os.path.join(_marken_dir(), "%s.json" % pid)
    try:
        with open(marke) as f:
            m = json.load(f)
        if m.get("konto") in k["konten"] and m.get("start") and m.get("start") == start:
            gemessen, grund = ummeldung_von_hand(k, sid, start, m["konto"])
            if gemessen:
                m.update(konto=gemessen, nachgezogen="%s (vorher %s)" % (grund, m["konto"]))
                try:
                    _json_schreiben(marke, m)
                except OSError:
                    pass
                return gemessen, "Ummeldung von Hand: %s; Marke nachgezogen" % grund
            return m["konto"], "Marke von wb-konto start"
    except (OSError, ValueError):
        pass
    return None, ""


def _elternprozess(pid):
    try:
        r = subprocess.run(["ps", "-o", "ppid=", "-p", str(pid)], capture_output=True, text=True, timeout=5,
                           stdin=subprocess.DEVNULL)
        return int(r.stdout.strip()) if r.returncode == 0 else None
    except (OSError, subprocess.SubprocessError, ValueError):
        return None


def konto_der_ahnenmarke(k, pid, sid):
    """Fund K (17.11.2026): die Statuszeile ist ein Enkel des claude-Prozesses und kennt dessen PID nicht sicher.
    Von pid aufwaerts (hoechstens 8 Ebenen) zaehlt die erste Ahnen-PID mit einer Markendatei. -> (konto, grund)."""
    for _ in range(8):
        if not pid or pid <= 1:
            break
        if os.path.exists(os.path.join(_marken_dir(), "%d.json" % pid)):
            return konto_der_marke(k, pid, sid, _prozess_start(pid))
        pid = _elternprozess(pid)
    return None, ""


def konto_des_prozesses(k, pid, sid, startzeile):
    """Auf welchem Konto laeuft der Prozess? 1. Marke von `wb-konto start` (PID + Startzeit), 2. ein genanntes
    Konto in der laufenden Startzeile, 3. Messzeilen DIESER Unterhaltung seit dem Prozessstart (Familie)."""
    start = _prozess_start(pid)
    konto, grund = konto_der_marke(k, pid, sid, start)
    if konto:
        return konto, grund
    gefunden = re.findall(r"(?<![A-Za-z0-9_])WB_CLAUDE_KONTO=(\w+)", startzeile or "")
    if gefunden and gefunden[-1] in k["konten"]:
        return gefunden[-1], "Startzeile des Panes"
    ab = _prozess_start_epoch(start)
    beste = None
    for d in zeilen():
        if d.get("session") != sid:
            continue
        ts = epoch_aus(d.get("ts"))
        if ab is not None and (ts is None or ts < ab - 5):
            continue
        n = zeile_konto(k, d)
        if n and (beste is None or (ts or 0) >= beste[0]):
            beste = (ts or 0, n)
    if beste:
        return beste[1], "Messzeile der Unterhaltung"
    return None, "weder Marke noch Konto in der Startzeile noch Messzeile seit dem Prozessstart"


