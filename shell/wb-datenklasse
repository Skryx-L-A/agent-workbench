#!/usr/bin/env -S -u DEVELOPER_DIR -u SDKROOT -u TOOLCHAINS /usr/bin/python3 -I -S
"""wb-datenklasse -- Datenklassen-Tor fuer jeden Startweg der Werkbank.

  wb-datenklasse klasse [DIR]
      eine Zeile KLASSE<TAB>KUNDEN<TAB>QUELLE, Exit 0. KUNDEN ist '-' ohne Kunde, sonst die
      Kunden-IDs sortiert mit Komma. QUELLE ist die Markerdatei, die die Klasse bestimmt,
      'vorgabe:<wert>' fuer die Untergrenze aus dem Schalter, 'projekte:<pfad>' fuer einen
      Eintrag der Systemrichtlinie. Diese Ausgabe ist ein Vertrag (andere Werkzeuge lesen sie).
      Steht der Schalter auf kein-start und hat das Projekt keinen Marker: keine Zeile, Exit 3.
  wb-datenklasse klassen DIR [DIR ...]
      dieselbe Regel wie `klasse` fuer viele Ordner in einem Prozess (Richtlinie und Schalter
      einmal gelesen): je DIR, in derselben Reihenfolge, genau eine Zeile wie bei `klasse`, oder
      '-<TAB>-<TAB>-', wenn die Klasse dieses Ordners nicht feststellbar ist (Marker unlesbar oder
      ungueltig, kein Verzeichnis, Schalter kaputt, kein-start ohne Marker). Jeder DIR muss absolut
      sein. Eine unlesbare Richtlinie endet ohne Zeilen mit Exit 2. Der Kern
      liest damit die Klasse je Werkzeugteil (app/src/main/datenklasse-pfad.ts, Auftrag W4).
  wb-datenklasse route MODELL [--harness H]
      eine Zeile MODELL<TAB>KLASSE: die hoechste Klasse, die die Route des Modells tragen darf.
      Diese Ausgabe bleibt bei zwei Spalten (Leser nehmen die letzte als Klasse).
  wb-datenklasse route --registry KENNUNG
      eine Zeile KENNUNG<TAB>KLASSE<TAB>REGEL (Vertrag Tor-Registry): die Route kommt aus dem Registry-Eintrag mit
      genau dieser Kennung (kein Alias, keine modelRef), nie aus dem Namen. Anbieter und Host der baseUrl entscheiden:
      Anbieter kind local mit Loopback-Host -> REGEL 'lokal:<route>'; ein Host im LAN nur mit einer host-Regel der
      Systemrichtlinie oder (nur am Einzelplatz ohne Systemrichtlinie) einem Eintrag des Schalters
      datenklasse.lanEndpunkte -> 'lan:<host>:<quelle>' (quelle system, betreiber oder nutzer; nie fuer einen Anbieter mit
      kind cloud, auch nicht mit Adresse im LAN oder auf Loopback: er bleibt Cloud); Cloud-Anbieter und Abo
      -> der Routenschluessel '<harness>/<anbieter>' (ohne
      Harness '<anbieter>'); alles andere (Anbieter oder Adresse fehlt, Host nicht zuordenbar, LAN-Host ohne Nennung,
      doppelte Kennung) -> 'unbekannt:<grund>' mit der Klasse eines unbekannten Modells. Jede Klasse ist hoechstens
      die von `route KENNUNG` fuer denselben Eintrag. <route> ist der Routenschluessel. Exit 0 eingeordnet (auch streng),
      2 falscher Aufruf, 4 Kennung nicht in der Registry, 5 Eintrag abgeschaltet, 3 jeder andere Fehler (Registry,
      Richtlinie oder Leser unlesbar, Klassenregel fehlt): dann keine Zeile auf stdout. Die Zeile traegt nie eine
      baseUrl oder einen Schluessel.
  wb-datenklasse pruefe --model M [--dir D] [--harness H] [--quiet]
  wb-datenklasse pruefe --model M --klasse K [--kunde ID ...] [--harness H] [--quiet]
      Exit 0 = erlaubt, Exit 3 = abgelehnt, Grund auf stderr. Jeder andere Fehler
      (Richtlinie unlesbar, Marker kaputt, Klasse unbekannt, falscher Aufruf) ist ebenfalls
      Exit 3: das Tor schliesst, es endet nie still mit 0.
      Mit --klasse nennt der Aufrufer Klasse und Kunden selbst (etwa eine Notiz ohne
      Projektordner); das Tor liest dann keine Marker. --klasse und --dir schliessen sich aus.
      Es gelten dieselben Regeln wie fuer einen Marker: --kunde hebt wie eine kunde:-Zeile
      (kunde_hebt_auf_customer), der Schalter ist Untergrenze, jeder Kunde muss die Route
      erlauben (kunde_erlaubt).

  wb-datenklasse pruefe --registry KENNUNG --klasse K [--kunde ID ...] [--quiet]
      Eine Einheit (Klasse und Kunden nennt der Aufrufer) gegen den Registry-Eintrag mit genau dieser Kennung (Vertrag
      Pruefe-Registry). Die Route kommt aus DERSELBEN Einordnung wie bei `route --registry` (registry_einordnung; ein Eintrag
      mit kind cloud wird nie gehoben, ein LAN-Host nur mit Nennung). Es gelten die Regeln von `pruefe --model M --klasse K`:
      --kunde hebt wie eine kunde:-Zeile, der Schalter ist Untergrenze, jeder Kunde muss die Route erlauben (kunde_erlaubt,
      mit Systemrichtlinie nur aus deren Datei), die Nutzerrichtlinie und die Betreiberebene verschaerfen nur, auch die
      Harness-Sperren (Harness ist der des Eintrags). --registry schliesst --model, --dir und --harness aus.
      Exit 0 erlaubt, 3 abgelehnt und jeder andere Fehler (nie still 0), 4 Kennung nicht in der Registry, 5 Eintrag
      abgeschaltet, 2 falscher Aufruf. Der Grund steht auf stderr mit Kennung, Klasse, Kunden, Regel; nie eine baseUrl.
  wb-datenklasse pruefe --registry KENNUNG --stapel [--quiet]
      Dieselbe Pruefung fuer viele Einheiten in einem Prozess: Zeilen KLASSE<TAB>KUNDEN auf stdin (Kunden '-' oder mit Komma
      getrennt, wie die Spalten von `klasse`), je Zeile eine Zeile `0` (erlaubt) oder `3` auf stdout. Route und Richtlinie
      werden einmal gerechnet. Exit 0 nur, wenn jede Zeile 0 ist, sonst 3 (die Zeilen stehen trotzdem auf stdout); 2, 4, 5 und
      jeder andere Fehler vor den Zeilen: keine Zeile. Keine Zeile auf stdin ist ein falscher Aufruf (Exit 2).

Klassen: NONE < PUBLIC < INTERNAL < CONFIDENTIAL < CUSTOMER. NONE heisst: Route gar nicht erlaubt.

Marker: eine Datei `.datenklasse`; das erste Wort ist die Klasse (PUBLIC bis CUSTOMER), jede
Zeile `kunde: <ID>` nennt einen Kunden. Zeilen `kennzeichnung:` und `kennzeichnung-text:` sind
erlaubt und spielen fuer das Tor keine Rolle.

Ported from an operator overlay and hardened (Punkt 0d, 22.10.2026). Was anders ist:
  T1  Der Nutzer ist die Kennung des Prozesses (geteuid -> Benutzerdatenbank). Es gibt kein
      --nutzer und keine Umgebungsvariable dafuer.
  T2  Die Richtlinie kommt nur aus einem geschuetzten Ort, nie aus einer Umgebungsvariablen.
      Zuerst die Systemrichtlinie SYSTEM_ORDNER/datenklasse.json; sie gilt nur, wenn Datei und
      Ordner SYSTEM_EIGENTUEMER (root) gehoeren und weder gruppen- noch weltschreibbar sind,
      sonst gilt mit Warnung STRENGE_RICHTLINIE (Cloud hoechstens PUBLIC; decision 2026-10-23: ein
      Rechtefehler des Admins hebt die Richtlinie nicht auf). Ohne Systemrichtlinie gilt
      PRODUKT_RICHTLINIE (beide in wb_datenklasse_regel.py).
      Danach darf ~/.config/agent-workbench/datenklasse.json (Heimat laut Benutzerdatenbank)
      nur verschaerfen: niedrigere Routenklasse, weniger Kundenrouten,
      mehr gesperrte Harnesses.
  T3  Die Klasse ist das Maximum ueber ALLE Marker vom Verzeichnis bis zur Wurzel, ueber den
      genannten und den aufgeloesten Pfad, und bei einem verknuepften Git-Worktree auch ueber
      den gleichen Ort im Hauptbaum. Ein tieferer Marker kann nie senken. Kunden addieren
      sich; ein Marker ersetzt keinen Kunden, und jeder Kunde muss die Route erlauben.
      Ein Marker mit `kunde:` zaehlt mindestens als CUSTOMER; QUELLE heisst dann
      `<marker>:kunde`.

Schalter (Punkt 0w, Beschluesse E-02 und D-2). Die Vorgabe ohne Marker liest genau eine Stelle:
vorgabe_klasse(), Schluessel datenklasse.unmarkiert (INTERNAL | CUSTOMER | kein-start). Die
Kunden-Regel ebenso: kunde_hebt_auf_customer(), Schluessel datenklasse.kundeHebtAufCustomer.
Beide kommen aus werkbank.json ueber den Leser wb_konfig.py, der neben dem Tor liegt und im
Prozess geladen wird (nie ueber sys.path oder PYTHONPATH). Fehlt er oder seine Schemadatei,
endet das Tor fail closed. Die Umgebung (WB_KONFIG, XDG_CONFIG_HOME) zaehlt nicht.
Der Schalterwert ist eine UNTERGRENZE: ein Marker hebt die Klasse, senkt sie aber nie darunter.
Ein Projekt darunter einzuordnen geht nur ueber die Liste `projekte` der Systemrichtlinie
([{"pfad": "/abs/pfad", "klasse": "PUBLIC"}], Teilbaum gilt, der laengste passende Pfad gewinnt);
eine Projektliste der Nutzerrichtlinie wird mit Warnung ignoriert. Bei kein-start gilt fuer ein
Projekt mit Marker die Untergrenze UNTERGRENZE_KEIN_START (INTERNAL). Ein Feld vorgabeKlasse in
einer Richtlinie gibt es nicht mehr: die Untergrenze steht an einer Stelle, im Schalter.

Schalter datenklasse.lanEndpunkte (Betreiberebene, decision 2026-10-28): {"<host>": "<KLASSE>"}, Vorgabe {} (jeder LAN-Host bleibt
streng). Nur `route --registry` liest ihn, ueber DENSELBEN Leser wie die anderen Schalter (Lage.lan_endpunkte, wb_konfig.py),
und nur fuer einen Host im LAN. Am Einzelplatz ohne Systemrichtlinie nennt der Betreiber damit die Klasse des Hosts (REGEL
'lan:<host>:betreiber'); die Klasse darf dort ueber `route KENNUNG` liegen, die Nutzerrichtlinie senkt weiterhin. Mit
Systemrichtlinie (auch der strengen Ersatzrichtlinie) senkt der Eintrag nur: nie ueber die Klasse der host-Regel, nie fuer
einen Host, den die Systemrichtlinie nicht nennt (er bleibt 'unbekannt:lan-host-ohne-nennung', hoechstens auf die Klasse des
Eintrags gesenkt). Ein Eintrag mit anderer Host-Form (Muster, Grossbuchstaben, kein LAN-Host) oder unbekannter Klasse wird
ignoriert und auf stderr gewarnt. Die Nutzerdatei werkbank.json setzt den Schluessel nie (ohneNutzerebene).

Regelfeld host (W3, 23.10.2026): ein Muster (fnmatch) auf den Host der baseUrl des Anbieters,
fuer 'ollama' der Host aus ollamaEndpoint, wenn gesetzt. Ein Modell ohne Adresse trifft keine
Host-Regel. Ein Endpunkt ausserhalb dieser Maschine hebt sich ueber INTERNAL nur mit einer
host-Regel der Systemrichtlinie: Eine Regel mit provider, aber ohne host hebt einen nicht
lokalen Anbieter hoechstens auf INTERNAL (Warnung), denn der Anbietername steht in der
Nutzerdatei models.json. Die Nutzerrichtlinie senkt weiterhin nur; eine Host-Regel dort hebt nichts.

ollamaEndpoint: zeigt die Einstellung (dieselbe Datei und Pruefung wie wb-state ollama_baseurl)
auf eine fremde Maschine, gilt der Anbieter 'ollama' als fern, also als Cloud-Route. Andere
lokale Anbieter folgen der Einstellung nicht und bleiben lokal.

Registry und Einstellungen liegen ohne Testnaht ausschliesslich unter der Heimat laut
Benutzerdatenbank (.claude/workbench/models.json und settings.json), wie wb-state seit Punkt 0a.
HOME, WB_MODELS_FILE und AWB_SETTINGS_FILE lenken sie nicht um: ein Aufrufer koennte sonst ein
Cloud-Modell zu einem lokalen Anbieter machen. Nur mit WB_TESTUMGEBUNG=1 (die Testnaht von
wb-state, nur fuer diese beiden Dateien) gelten die drei wie frueher.

Klassenregel (23.10.2026, task): klasse, klassen, pruefe --dir und pruefe --klasse
rechnen die Klasse nur noch im Modul wb_datenklasse_regel.py (klasse_fuer, Lage). Das Tor laedt es
neben realpath seiner eigenen Datei, nie ueber sys.path; dasselbe Modul laedt die Entscheidungsstelle
im Prozess. Fehlt es oder ist es unbrauchbar, endet das Tor fail closed (pruefe
Exit 3, sonst Exit 2). Richtlinie, Untergrenze und Marker stehen nur dort; hier bleiben Registry,
Route, Kunden- und Nutzerpruefung und die Testnaht der Umgebung (WB_TESTUMGEBUNG).

Testnaht fuer Richtlinie und Heimat: keine Variable. Die Suite prueft Kopien, in denen nur die Konstanten SYSTEM_ORDNER,
SYSTEM_EIGENTUEMER und NUTZER_HEIM umgeschrieben sind (shell/tests/test-wb-datenklasse.sh); das Tor
reicht sie an R.Lage weiter. Neben jeder Kopie liegt das Modul wb_datenklasse_regel.py.
"""
import fnmatch
import importlib.util
import ipaddress
import json
import os
import pwd
import re
import sys
import urllib.parse

REGEL_MODUL = "wb_datenklasse_regel.py"   # die Klassenregel, neben realpath dieses Tors
# Testnaht: Tests schreiben diese drei Zeilen in einer Kopie um (keine Variable). None/leer heisst:
# Systemordner und Eigentuemer laut Modul, Heimat laut Benutzerdatenbank.
SYSTEM_ORDNER = None
SYSTEM_EIGENTUEMER = None
NUTZER_HEIM = ""   # leer: Heimat laut Benutzerdatenbank, nie $HOME

# Kurznamen der Startwege, die nie durch die Registry gehen (wie pi-worker sie kennt).
EINGEBAUTE_ALIASE = {"claude-*": "claude-subscription", "haiku*": "claude-subscription",
                     "sonnet*": "claude-subscription", "opus*": "claude-subscription",
                     "fable*": "claude-subscription"}
LOOPBACK = {"127.0.0.1", "::1", "localhost"}
MAX_REGISTRY = 16 << 20   # Grenze fuer models.json (R-KL-DATEI): eine echte Registry misst rund 1 MiB
OLLAMA_URL = re.compile(r"^https?://[^\s/]+(/[^\s]*)?$")   # wie wb-state _OLLAMA_URL_RE

R = None      # das Modul wb_datenklasse_regel, geladen in main()
LAGE = None   # R.Lage dieses Aufrufs: Richtlinie und Schalter hoechstens einmal gelesen


class RegelFehlt(Exception):
    """Das Modul der Klassenregel fehlt neben dem Tor oder ist unbrauchbar."""


def warnung(text):
    print("wb-datenklasse: WARNUNG: " + text, file=sys.stderr)


def regel_laden():
    """Laedt wb_datenklasse_regel.py neben realpath dieses Tors (nie ueber sys.path)."""
    pfad = os.path.join(os.path.dirname(os.path.realpath(__file__)), REGEL_MODUL)
    if not os.path.isfile(pfad):
        raise RegelFehlt("Klassenregel fehlt neben dem Tor: %s" % pfad)
    try:
        spec = importlib.util.spec_from_file_location("wb_datenklasse_regel", pfad)
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
    except BaseException as exc:   # auch SystemExit beim Laden: fail closed, nie Exit 0
        raise RegelFehlt("Klassenregel unbrauchbar (%s: %s): %s" % (type(exc).__name__, exc, pfad))
    return mod


# ── Route eines Modells ───────────────────────────────────────────────────────

_NAHT = []


def naht_modul():
    """shell/wb_naht_ziel.py neben diesem Werkzeug, sonst None: dann gilt die Testnaht nicht."""
    if not _NAHT:
        mod = None
        try:
            import importlib.util
            spec = importlib.util.spec_from_file_location(
                "wb_naht_ziel", os.path.join(os.path.dirname(os.path.realpath(__file__)), "wb_naht_ziel.py"))
            mod = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(mod)
        except Exception:
            mod = None
        _NAHT.append(mod)
    return _NAHT[0]


def testnaht():
    """Wie wb-state: nur die wirksame Testnaht erlaubt, Ort der Registry und der Einstellungen ueber die
    Umgebung zu lenken: WB_TESTUMGEBUNG=1 UND die Schalterzeile des Moduls (Stufe 2c, R3). Ohne sie gilt allein die
    Heimat laut Benutzerdatenbank (Lage.heimat()); HOME, WB_MODELS_FILE und AWB_SETTINGS_FILE zaehlen dann nicht."""
    m = naht_modul() if os.environ.get("WB_TESTUMGEBUNG") == "1" else None
    return bool(m and m.naht_aktiv())


def registry():
    """Dieselbe Registry, die der Startweg liest, ueber DIESELBE Aufloesung wie wb-state: Konfig.registry in
    wb_konfig.py (`wb-konfig registry`). pfade.registry ist ein Betreiberschluessel ohne Nutzerebene: System, Betreiber,
    Vorgabe unter der Heimat laut Benutzerdatenbank. Nur mit der Testnaht lenkt WB_MODELS_FILE um (nie gegen die
    Systemebene), und die Heimat ist dann $HOME. Ein Pfad, den eine Datei oder die Naht benennt, muss lesbar sein.
    Den Leser haelt die Lage dieses Aufrufs (R.Lage.konfig), dieselbe, die die Klassenregel liest."""
    mod, k = LAGE.konfig()
    naht = testnaht()
    heim = (os.environ.get("HOME") or LAGE.heimat()) if naht else LAGE.heimat()
    try:
        pfad, ebene = k.registry(heim, os.environ.get("WB_MODELS_FILE") if naht else None)
    except mod.KonfigUngueltig as exc:
        raise R.Abgelehnt("werkbank.json ungueltig fuer pfade.registry: %s" % exc)
    lenkung = ebene != "vorgabe"
    if not os.path.exists(pfad) and not lenkung:
        return {}
    try:
        data = json.loads(R.text_lesen(pfad, MAX_REGISTRY))   # REGEL R-KL-DATEI: keine FIFO, nichts ueber der Grenze
    except (OSError, ValueError) as exc:
        raise R.Abgelehnt("Registry unlesbar (%s): %s" % (exc, pfad))
    if not isinstance(data, dict):
        raise R.Abgelehnt("Registry ist kein Objekt: %s" % pfad)
    return data


def liste(x):
    """models/providers der Registry als Liste von Objekten. Ein Feld, das weder Objekt noch Liste ist (etwa `models: 5`),
    lehnt ab, statt mit einem Programmfehler zu enden: route --registry endet dann mit Exit 3, route MODELL wie bisher mit
    Exit 2 (gueltige Registries lesen byte-gleich). Fehlt das Feld oder ist es leer, ist die Liste leer."""
    if isinstance(x, dict):
        return [dict(v, id=k) for k, v in x.items() if isinstance(v, dict)]
    if x and not isinstance(x, (list, str)):
        raise R.Abgelehnt("Registry: models und providers muessen ein Objekt oder eine Liste sein (gefunden: %s)"
                          % type(x).__name__)
    return [v for v in (x or []) if isinstance(v, dict)]


def einstellung_ollama():
    """ollamaEndpoint wie wb-state read_setting/ollama_baseurl: dieselbe Datei, leer oder
    unsinnig heisst 'nicht gesetzt'."""
    if testnaht():
        pfad = os.environ.get("AWB_SETTINGS_FILE") or os.path.join(
            os.path.expanduser("~"), ".claude", "workbench", "settings.json")
    else:
        pfad = os.path.join(LAGE.heimat(), ".claude", "workbench", "settings.json")
    try:
        text = R.text_lesen(pfad, R.MAX_RICHTLINIE)   # REGEL R-KL-DATEI
    except (FileNotFoundError, NotADirectoryError):
        return ""
    except (OSError, ValueError) as exc:
        # Da, aber nicht lesbar: Der Endpunkt ist unklar, und ein fremder Endpunkt waere keine lokale Route.
        raise R.Abgelehnt("Einstellungen unlesbar (%s): %s" % (exc, pfad))
    try:
        cfg = json.loads(text)
        roh = cfg.get("ollamaEndpoint", "") if isinstance(cfg, dict) else ""
    except ValueError:
        roh = ""
    wert = roh.strip().rstrip("/") if isinstance(roh, str) else ""
    return wert if wert and OLLAMA_URL.match(wert) else ""


def anbieter_url(prov):
    """Adresse, an die der Anbieter Daten schickt: baseUrl, fuer 'ollama' ollamaEndpoint."""
    url = prov.get("baseUrl") if prov else ""
    if prov and prov.get("id") == "ollama":
        url = einstellung_ollama() or url
    return url if isinstance(url, str) else ""


def loopback_host(host):
    """Nur eine echte IPv4-Adresse in 127.0.0.0/8 in kanonischer Form, ::1 und localhost. Ein Name wie 127.0.0.1.fremd.example
    fragt das DNS und liegt sonstwo; 0177.0.0.1 oder 127.1 liest jede Bibliothek anders. Beides bleibt fern."""
    if host in LOOPBACK:
        return True
    try:
        ip = ipaddress.IPv4Address(host)
    except ValueError:
        return False
    return ip.is_loopback and str(ip) == host


def host_von(url):
    try:
        return (urllib.parse.urlsplit(url).hostname or "").lower()
    except ValueError:
        return ""


def art_des_anbieters(prov):
    if not prov:
        return "unbekannt"
    kind = prov.get("kind") or "unbekannt"
    if kind != "local":
        return kind
    url = anbieter_url(prov)
    if not url:
        return "lokal"
    host = host_von(url)
    return "lokal" if loopback_host(host) else "fern"


def modell(name, harness=None):
    """-> dict(namen, provider, art, host, harness) aus der Registry, sonst aus den Kurznamen."""
    reg = registry()
    namen = [name]
    if ":" in name:
        namen.append(name.split(":", 1)[0])
    treffer = None
    for kand in namen:
        for m in liste(reg.get("models")):
            if kand in (m.get("id"), m.get("alias"), m.get("modelRef")):
                treffer = m
                break
        if treffer:
            break
    provider = ""
    if treffer:
        namen += [treffer.get("id") or "", treffer.get("alias") or "", treffer.get("modelRef") or ""]
        provider = treffer.get("provider") or ""
    else:
        for muster, prov in EINGEBAUTE_ALIASE.items():
            if any(fnmatch.fnmatchcase(n, muster) for n in namen):
                provider = prov
                break
    prov = next((p for p in liste(reg.get("providers")) if p.get("id") == provider), None)
    art = art_des_anbieters(prov)
    if not prov and provider == "claude-subscription":
        art = "subscription"
    harnesses = [h for h in (harness, (treffer or {}).get("harness")) if h]
    return {"name": name, "namen": [n for n in namen if n], "provider": provider or "unbekannt",
            "art": art, "host": host_von(anbieter_url(prov)), "harnesses": harnesses}


def regel_passt(r, m):
    def feld(f, werte):
        return f not in r or any(fnmatch.fnmatchcase(w, r[f]) for w in werte)
    host = "host" not in r or bool(m["host"]) and fnmatch.fnmatchcase(m["host"], r["host"].lower())
    return (feld("modell", m["namen"]) and feld("provider", [m["provider"]])
            and feld("art", [m["art"]]) and feld("harness", m["harnesses"] or [""]) and host)


def erste_regel(routen, m):
    return next((r for r in routen if regel_passt(r, m)), None)


def regel_id(r):
    """Routen-ID einer Regel der Richtlinie (None: keine Regel passt)."""
    return "keine Regel" if r is None else r.get("id") or "ohne-id"


def route(rl, m):
    """-> (maxKlasse, Routen-ID). Die Nutzerrichtlinie kann nur senken."""
    r = erste_regel(rl["basis"].get("routen", []), m)
    if r is None:
        return "NONE", regel_id(None)
    k, rid = r["maxKlasse"], regel_id(r)
    if ("provider" in r and "host" not in r and m["art"] != "lokal"
            and R.ORDER.index(k) > R.ORDER.index("INTERNAL")):
        LAGE.warnung("Route '%s' hebt '%s' nur bis INTERNAL: der Anbietername steht in der Nutzerdatei; "
                "einen Endpunkt ausserhalb dieser Maschine hebt nur eine Regel mit host"
                % (rid, m["name"]))
        k = "INTERNAL"
    n = erste_regel(rl["nutzer"].get("routen", []), m)
    if n is not None and R.ORDER.index(n["maxKlasse"]) < R.ORDER.index(k):
        k = n["maxKlasse"]
    return k, rid


# ── Kunden und Nutzer ─────────────────────────────────────────────────────────

def kunde_erlaubt(rl, kid, rid):
    """-> None (erlaubt) oder der Grund der Ablehnung."""
    kv = rl["basis"].get("kunden", {}).get(kid)
    if kid.startswith("_") or not isinstance(kv, dict):
        return "Kunde '%s' ist in der Richtlinie unbekannt" % kid
    if not any(fnmatch.fnmatchcase(rid, p) for p in kv.get("erlaubteRouten", [])):
        return "Kunde '%s' erlaubt die Route '%s' nicht (%s)" % (
            kid, rid, ", ".join(kv.get("erlaubteRouten", [])) or "keine Route freigegeben")
    nk = rl["nutzer"].get("kunden", {}).get(kid)
    if isinstance(nk, dict) and not any(fnmatch.fnmatchcase(rid, p)
                                        for p in nk.get("erlaubteRouten", [])):
        return "Kunde '%s': die Nutzerrichtlinie erlaubt die Route '%s' nicht" % (kid, rid)
    return None


def nutzer():
    try:
        return pwd.getpwuid(os.geteuid()).pw_name
    except KeyError:
        raise R.Abgelehnt("Kennung %d steht nicht in der Benutzerdatenbank" % os.geteuid())


def gesperrte_harnesses(rl):
    """-> (Profilname, Menge). Ohne Profile in der Richtlinie sperrt nichts."""
    profile = rl["basis"].get("nutzerprofile", {})
    zuordnung = rl["basis"].get("nutzerZuordnung", {})
    gesperrt = set(rl["nutzer"].get("gesperrteHarnesses", []))
    if not profile:
        return None, gesperrt
    name = nutzer()
    pname = name if name in profile else zuordnung.get(name) or zuordnung.get("*")
    if pname not in profile:
        raise R.Abgelehnt("kein Nutzerprofil fuer '%s' (nutzerZuordnung)" % name)
    return pname, gesperrt | set(profile[pname].get("gesperrteHarnesses", []))


def verweigerungen(rl, m, info, erg=None):
    """-> (Gruende, Klasse der Route). erg: die schon gerechnete Route (Klasse, Routen-ID), etwa aus einem Registry-Eintrag;
    ohne sie rechnet route() sie aus dem Modell."""
    out = []
    k, rid = erg if erg else route(rl, m)
    if R.ORDER.index(k) < R.ORDER.index(info["klasse"]):
        out.append("DATENKLASSE: '%s' laeuft ueber die Route '%s' (hoechstens %s), %s %s (%s)."
                   % (m["name"], rid, k, info.get("bezug", "das Projekt ist"), info["klasse"],
                      info["quelle"] or "vorgabe"))
        if rl["quelle"] == R.PRODUKT_QUELLE and m["art"] != "lokal":
            out.append("DATENKLASSE: kein Firmenprofil (Systemrichtlinie %s fehlt); ohne Firmenprofil "
                       "traegt eine Cloud-Route hoechstens PUBLIC." % R.RICHTLINIE_NAME)
    for kid in info["kunden"]:
        grund = kunde_erlaubt(rl, kid, rid)
        if grund:
            out.append("KUNDE: %s." % grund)
    pname, gesperrt = gesperrte_harnesses(rl)
    if gesperrt:
        if not m["harnesses"]:
            out.append("NUTZER: Harness unbekannt, das Profil '%s' sperrt Harnesses."
                       % (pname or "Nutzerrichtlinie"))
        for h in m["harnesses"]:
            if h in gesperrt:
                out.append("NUTZER: Profil '%s' sperrt den Harness '%s'."
                           % (pname or "Nutzerrichtlinie", h))
    return out, k


