# ── route --registry: Route aus dem Registry-Eintrag (Vertrag Tor-Registry) ───────────────────────────────────
KENNUNG_ZEICHEN = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:/+@-]*$")
HOST_ZEICHEN = re.compile(r"^[a-z0-9._:-]+$")
UNSICHER = re.compile(r"[^A-Za-z0-9._:+@/-]")
CGNAT = ipaddress.ip_network("100.64.0.0/10")   # Tailnet-Adressen
LAN_ENDUNGEN = (".local", ".lan", ".home.arpa", ".internal", ".ts.net")


def lan_host(host):
    """Sieht der Host nach dem eigenen Netz aus (privat, Tailnet, link-local, .local, ein Name ohne Punkt)?"""
    try:
        ip = ipaddress.ip_address(host)
    except ValueError:
        return host.endswith(LAN_ENDUNGEN) or "." not in host
    return ip.is_private or ip.is_link_local or (ip.version == 4 and ip in CGNAT)


def sauber(text):
    return UNSICHER.sub("_", text)


def niedrigere(a, b):
    return a if R.ORDER.index(a) <= R.ORDER.index(b) else b


def unbekanntes_modell(namen):
    return {"name": "?", "namen": namen, "provider": "unbekannt", "art": "unbekannt", "host": "", "harnesses": []}


def streng_route(rl, kennung):
    """-> (Klasse, Routen-ID) eines unbekannten Modells: das Strengere aus `route` ohne Namen und `route <kennung>` ohne Eintrag."""
    a, b = route(rl, unbekanntes_modell([])), route(rl, unbekanntes_modell([kennung]))
    return b if R.ORDER.index(b[0]) < R.ORDER.index(a[0]) else a


def streng_klasse(rl, kennung):
    return streng_route(rl, kennung)[0]


def registry_route(rl, reg, e):
    """-> (Klasse, REGEL, Routen-ID) des Eintrags e. Jede Unsicherheit liefert 'unbekannt:<grund>' mit der Klasse eines
    unbekannten Modells. Nie lockerer als `route <kennung>` fuer denselben Eintrag, dessen Klasse deckelt jedes Ergebnis.
    Einzige Ausnahme: ein Host der Betreiberebene (datenklasse.lanEndpunkte) am Einzelplatz ohne Systemrichtlinie.
    Die Routen-ID ist die der Regel, die die Klasse bestimmt (die Kunden-Regel `kunde_erlaubt` prueft sie)."""
    k, regel, betreiber_hebt, rid = registry_route_roh(rl, reg, e)
    if betreiber_hebt:
        return k, regel, rid
    k_kennung, rid_kennung = route(rl, modell(e["id"]))
    if R.ORDER.index(k_kennung) < R.ORDER.index(k):
        return k_kennung, regel, rid_kennung
    return k, regel, rid


def lan_host_ok(host):
    """Kanonische Form eines Hosts im eigenen Netz (kleingeschrieben, ohne Muster), wie host_von() sie liefert."""
    return bool(HOST_ZEICHEN.match(host)) and lan_host(host)


def lan_klasse(rl, m, host, unbekannt):
    """-> (Klasse, REGEL, betreiber_hebt, Routen-ID) fuer einen Endpunkt im eigenen Netz.
    Die Betreiberebene (Schalter datenklasse.lanEndpunkte, Host -> Klasse) ordnet den Host am Einzelplatz OHNE
    Systemrichtlinie ein (hebt); mit Systemrichtlinie nur noch verschaerfend: nie ueber der Klasse, die die host-Regel
    der Systemrichtlinie nennt, und nie ein Host, den sie nicht nennt. Die Nutzerrichtlinie senkt in jedem Fall."""
    betreiber = LAGE.lan_endpunkte(lan_host_ok).get(host)
    r = erste_regel(rl["basis"].get("routen", []), m)
    n = erste_regel(rl["nutzer"].get("routen", []), m)
    if r is None or "host" not in r:
        if betreiber is None or rl["system"]:
            k, regel, hebt, rid = unbekannt("lan-host-ohne-nennung")
            return (niedrigere(k, betreiber) if betreiber is not None else k), regel, hebt, rid
        k = niedrigere(betreiber, n["maxKlasse"]) if n is not None else betreiber
        senkt = n is not None and R.ORDER.index(n["maxKlasse"]) < R.ORDER.index(betreiber)
        return k, "lan:%s:%s" % (host, "nutzer" if senkt else "betreiber"), True, regel_id(r)
    k_echt, rid = route(rl, m)
    senkt = n is not None and R.ORDER.index(n["maxKlasse"]) < R.ORDER.index(r["maxKlasse"])
    if betreiber is not None and R.ORDER.index(betreiber) < R.ORDER.index(k_echt):
        return betreiber, "lan:%s:betreiber" % host, False, rid
    return k_echt, "lan:%s:%s" % (host, "nutzer" if senkt else "system"), False, rid


def registry_route_roh(rl, reg, e):
    """-> (Klasse, REGEL, betreiber_hebt, Routen-ID). betreiber_hebt: die Klasse darf ueber `route <kennung>` liegen (nur lan_klasse)."""
    kennung = e["id"]
    pid = e.get("provider")
    harness = e.get("harness") if isinstance(e.get("harness"), str) and e.get("harness") else ""

    def unbekannt(grund):
        k, rid = streng_route(rl, kennung)
        return k, "unbekannt:" + grund, False, rid

    if doppelt_angelegt(reg, kennung):
        return unbekannt("kennung-doppelt")
    if not isinstance(pid, str) or not pid:
        return unbekannt("anbieter-fehlt")
    prov = next((p for p in liste(reg.get("providers")) if p.get("id") == pid), None)
    schluessel = sauber((harness + "/" if harness else "") + pid)
    m = {"name": kennung, "namen": [kennung, e.get("alias") or "", e.get("modelRef") or ""], "provider": pid,
         "art": "unbekannt", "host": "", "harnesses": [harness] if harness else []}
    m["namen"] = [n for n in m["namen"] if isinstance(n, str) and n]
    if not prov and pid == "claude-subscription":   # eingebaut wie in modell(): kein Eintrag noetig
        m["art"] = "subscription"
        k, rid = route(rl, m)
        return k, schluessel, False, rid
    if not prov:
        return unbekannt("anbieter-unregistriert")
    kind = prov.get("kind")
    if kind == "subscription":
        m["art"] = "subscription"
        k, rid = route(rl, m)
        return k, schluessel, False, rid
    if kind not in ("local", "cloud"):
        return unbekannt("anbieter-art")
    url = anbieter_url(prov).strip()
    m["art"] = art_des_anbieters(prov)
    if not url:
        return unbekannt("keine-adresse")
    host = host_von(url)
    try:
        schema = urllib.parse.urlsplit(url).scheme
    except ValueError:
        schema = ""
    if schema not in ("http", "https") or not HOST_ZEICHEN.match(host):
        return unbekannt("host-nicht-zuordenbar")
    m["host"] = host
    k_echt, rid_echt = route(rl, m)
    if kind == "cloud" and (loopback_host(host) or lan_host(host)):
        # Ein Cloud-Anbieter mit Adresse auf dieser Maschine oder im LAN ist ein Gateway oder Proxy zur Cloud (decision 2026-10-28):
        # REGEL bleibt die Anbieterroute, und weder eine host-Regel der Systemrichtlinie noch datenklasse.lanEndpunkte hebt ihn.
        # Die Klasse rechnet die Richtlinie, als gaebe es keine Adresse (ein Modell ohne Adresse trifft keine host-Regel);
        # im LAN ist sie nie hoeher als bei einem LAN-Host ohne Nennung (Klasse eines unbekannten Modells).
        k_anbieter, rid_anbieter = route(rl, dict(m, host=""))
        if loopback_host(host):
            return k_anbieter, schluessel, False, rid_anbieter
        k_streng, rid_streng = streng_route(rl, kennung)
        if R.ORDER.index(k_streng) < R.ORDER.index(k_anbieter):
            return k_streng, schluessel, False, rid_streng
        return k_anbieter, schluessel, False, rid_anbieter
    if loopback_host(host):
        return k_echt, "lokal:" + schluessel, False, rid_echt
    if lan_host(host):
        return lan_klasse(rl, m, host, unbekannt)
    return k_echt, schluessel, False, rid_echt


def doppelt_angelegt(reg, kennung):
    return sum(1 for m in liste(reg.get("models")) if m.get("id") == kennung) > 1


def registry_einordnung(kennung):
    """Der gemeinsame Weg von `route --registry` und `pruefe --registry`: Richtlinie, Registry, Eintrag, Route. Die Route
    wird genau einmal gerechnet (registry_route). -> (rc, rl, eintrag, Klasse, REGEL, Routen-ID). rc 0: eingeordnet; rc 4
    (Kennung nicht in der Registry) oder 5 (abgeschaltet): Grund auf stderr, die uebrigen Werte sind None. Wirft R.Abgelehnt."""
    rl = LAGE.richtlinie()
    reg = registry()
    treffer = [m for m in liste(reg.get("models")) if m.get("id") == kennung]
    if not treffer:
        print("wb-datenklasse: Kennung '%s' ist nicht in der Registry." % kennung, file=sys.stderr)
        return 4, rl, None, None, None, None
    if treffer[0].get("enabled") is False:
        print("wb-datenklasse: Eintrag '%s' ist abgeschaltet (enabled=false)." % kennung, file=sys.stderr)
        return 5, rl, None, None, None, None
    k, regel, rid = registry_route(rl, reg, treffer[0])
    return 0, rl, treffer[0], k, regel, rid


def cmd_route_registry(argv):
    try:
        vals, _, pos = optionen(argv, ["registry"])
        kennung = vals["registry"]
        if pos or not kennung or not KENNUNG_ZEICHEN.match(kennung):
            raise R.Abgelehnt("route --registry KENNUNG")
    except R.Abgelehnt as exc:
        print("wb-datenklasse: " + str(exc), file=sys.stderr)
        return 2
    try:
        rc, _, _, k, regel, _ = registry_einordnung(kennung)
    except R.Abgelehnt as exc:
        print("wb-datenklasse: " + str(exc), file=sys.stderr)
        return 3
    if rc:
        return rc
    print("%s\t%s\t%s" % (kennung, k, regel))
    return 0


def cmd_route(argv):
    if "--registry" in argv:
        return cmd_route_registry(argv)
    vals, _, pos = optionen(argv, ["harness"])
    if len(pos) != 1:
        raise R.Abgelehnt("route MODELL [--harness H]")
    k, _ = route(LAGE.richtlinie(), modell(pos[0], vals["harness"]))
    print("%s\t%s" % (pos[0], k))
    return 0


# ── pruefe --registry: eine Einheit gegen einen Registry-Eintrag (Vertrag Pruefe-Registry) ───────────────────────
PRUEFE_WERT_OPTIONEN = ("model", "dir", "harness", "klasse", "kunde", "registry")
PRUEFE_REGISTRY_AUFRUF = ("pruefe --registry KENNUNG --klasse K [--kunde ID ...] [--quiet] | "
                          "pruefe --registry KENNUNG --stapel [--quiet] (Zeilen KLASSE<TAB>KUNDEN auf stdin)")


def registry_aufruf(argv):
    """Nennt der Aufruf --registry als Option (nicht als Wert einer anderen)? Dann gilt der Registry-Weg, sonst der bisherige;
    so bleibt jeder Aufruf ohne die Option unveraendert."""
    i = 0
    while i < len(argv):
        if argv[i] == "--registry":
            return True
        i += 2 if argv[i].startswith("--") and argv[i][2:] in PRUEFE_WERT_OPTIONEN else 1
    return False


def einheit_text(kennung, klasse, kunden, regel=None):
    """Kennung, Klasse, Kunden (und Regel) einer Einheit fuer den Grund auf stderr; nie eine baseUrl oder ein Schluessel."""
    text = "Kennung %s, Klasse %s, Kunden %s" % (kennung, sauber(klasse), sauber(",".join(kunden)) or "-")
    return text + (", Regel %s" % regel if regel else "")


def einheit_pruefen(rl, m, erg, klasse, kunden):
    """Eine Einheit (Klasse und Kunden nennt der Aufrufer) gegen die Route erg = (Klasse, Routen-ID) des Eintrags m, mit
    den Regeln von `pruefe --model M --klasse K`: klasse_aus_aufruf (--kunde hebt wie eine kunde:-Zeile, der Schalter ist
    Untergrenze), kunde_erlaubt je Kunde, die Sperren der Nutzerrichtlinie. -> (info, Gruende, Klasse der Route);
    keine Gruende heisst erlaubt. Wirft R.Abgelehnt bei ungueltiger Klasse oder Kunden-ID und bei einem Fehler des Schalters."""
    info = LAGE.klasse_aus_aufruf(klasse, kunden)
    gruende, k = verweigerungen(rl, m, info, erg)
    return info, gruende, k


def stapel_zeilen():
    """Die Zeilen von stdin (ohne den Zeilenumbruch am Ende). Wirft R.Abgelehnt, wenn stdin kein UTF-8 ist."""
    try:
        text = sys.stdin.buffer.read().decode("utf-8")
    except (OSError, ValueError) as exc:
        raise R.Abgelehnt("stdin nicht lesbar (%s)" % type(exc).__name__)
    zeilen = text.split("\n")
    if zeilen and zeilen[-1] == "":
        zeilen.pop()
    return zeilen


def cmd_pruefe_registry(argv):
    try:
        vals, fl, pos = optionen(argv, ["registry", "model", "dir", "harness", "klasse"], ["quiet", "stapel"], ["kunde"])
        kennung = vals["registry"]
        if (pos or not kennung or not KENNUNG_ZEICHEN.match(kennung) or vals["model"] is not None
                or vals["dir"] is not None or vals["harness"] is not None
                or (fl["stapel"] and (vals["klasse"] is not None or vals["kunde"]))
                or (not fl["stapel"] and vals["klasse"] is None)):
            raise R.Abgelehnt(PRUEFE_REGISTRY_AUFRUF)
        zeilen = stapel_zeilen() if fl["stapel"] else None
        if zeilen is not None and not zeilen:
            raise R.Abgelehnt("--stapel: keine Zeile auf stdin")
    except R.Abgelehnt as exc:
        print("wb-datenklasse: falscher Aufruf: " + str(exc), file=sys.stderr)
        return 2
    kunden = vals["kunde"]
    klasse = vals["klasse"]
    try:
        rc, rl, eintrag, k, regel, rid = registry_einordnung(kennung)
    except R.Abgelehnt as exc:
        print("wb-datenklasse: " + str(exc), file=sys.stderr)
        print("wb-datenklasse: Einheit abgelehnt: " + (einheit_text(kennung, klasse, kunden) if zeilen is None
                                                      else "Kennung %s, Stapel" % kennung), file=sys.stderr)
        return 3
    if rc:
        if zeilen is None:
            print("wb-datenklasse: Einheit abgelehnt: " + einheit_text(kennung, klasse, kunden), file=sys.stderr)
        return rc
    harness = eintrag.get("harness") if isinstance(eintrag.get("harness"), str) else ""
    m = {"name": kennung, "art": "lokal" if regel.startswith(("lokal:", "lan:")) else "fern",
         "harnesses": [harness] if harness else []}
    erg = (k, rid)

    def urteil(klasse, kunden, stelle=""):
        """-> True (erlaubt) oder False; die Gruende stehen auf stderr (stelle: Zeilenvorsatz im Stapel)."""
        try:
            info, gruende, bis = einheit_pruefen(rl, m, erg, klasse, kunden)
        except R.Abgelehnt as exc:
            print("wb-datenklasse: %s%s" % (stelle, exc), file=sys.stderr)
            print("wb-datenklasse: %sEinheit abgelehnt: %s (Richtlinie: %s)"
                  % (stelle, einheit_text(kennung, klasse, kunden, regel), rl["quelle"]), file=sys.stderr)
            return False
        if gruende:
            for g in gruende:
                print("wb-datenklasse: %s%s" % (stelle, g), file=sys.stderr)
            print("wb-datenklasse: %sEinheit abgelehnt: %s (Richtlinie: %s)"
                  % (stelle, einheit_text(kennung, info["klasse"], info["kunden"], regel), rl["quelle"]), file=sys.stderr)
            return False
        if not fl["quiet"] and not stelle:
            print("erlaubt: %s (bis %s, Regel %s) fuer Datenklasse %s" % (kennung, bis, regel, info["klasse"]),
                  file=sys.stderr)
        return True

    if zeilen is None:
        return 0 if urteil(klasse, kunden) else 3
    ergebnis, gemerkt = [], {}
    for nr, zeile in enumerate(zeilen, 1):
        spalten = zeile.split("\t")
        if len(spalten) != 2:
            print("wb-datenklasse: Zeile %d: erwartet KLASSE<TAB>KUNDEN (Kunden '-' oder mit Komma getrennt)" % nr,
                  file=sys.stderr)
            ergebnis.append(False)
            continue
        schluessel = (spalten[0], spalten[1])
        if schluessel not in gemerkt:   # gleiche Paare: einmal rechnen, die Gruende stehen bei der ersten Zeile
            gemerkt[schluessel] = urteil(spalten[0], [] if spalten[1] == "-" else spalten[1].split(","), "Zeile %d: " % nr)
        ergebnis.append(gemerkt[schluessel])
    print("\n".join("0" if ok else "3" for ok in ergebnis))
    return 0 if all(ergebnis) else 3


def cmd_pruefe(argv):
    if registry_aufruf(argv):
        return cmd_pruefe_registry(argv)
    vals, fl, pos = optionen(argv, ["model", "dir", "harness", "klasse"], ["quiet"], ["kunde"])
    if (not vals["model"] or pos or (vals["klasse"] is not None and vals["dir"] is not None)
            or (vals["kunde"] and vals["klasse"] is None)):
        raise R.Abgelehnt("pruefe --model M [--dir D | --klasse K [--kunde ID ...]] [--harness H] "
                          "[--quiet]")
    rl = LAGE.richtlinie()
    if vals["klasse"] is not None:
        info = LAGE.klasse_aus_aufruf(vals["klasse"], vals["kunde"])
    else:
        info = klasse_oder_fehler(vals["dir"])
        if "fehler" in info:
            print("wb-datenklasse: " + info["fehler"], file=sys.stderr)
            return 3
    m = modell(vals["model"], vals["harness"])
    gruende, k = verweigerungen(rl, m, info)
    if gruende:
        for g in gruende:
            print("wb-datenklasse: " + g, file=sys.stderr)
        print("wb-datenklasse: Start abgelehnt (Richtlinie: %s)." % rl["quelle"], file=sys.stderr)
        return 3
    if not fl["quiet"]:
        print("erlaubt: %s (bis %s) fuer %s %s" % (
            m["name"], k, "Datenklasse" if "bezug" in info else "Projektklasse", info["klasse"]),
              file=sys.stderr)
    return 0


def main(argv):
    global R, LAGE
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    befehle = {"klasse": cmd_klasse, "klassen": cmd_klassen, "route": cmd_route,
               "pruefe": cmd_pruefe}
    befehl = befehle.get(argv[0])
    try:
        R = regel_laden()
        LAGE = neue_lage()
        if befehl is None:
            raise R.Abgelehnt("unbekannter Befehl '%s' (%s)" % (argv[0], "|".join(befehle)))
        return befehl(argv[1:])
    except RegelFehlt as exc:
        print("wb-datenklasse: " + str(exc), file=sys.stderr)
    except BaseException as exc:   # fail closed: auch ein Programmfehler oder SystemExit aus einem Modul ist eine Ablehnung
        if R is not None and isinstance(exc, R.Abgelehnt):
            print("wb-datenklasse: " + str(exc), file=sys.stderr)
            if isinstance(exc, R.KeinStart):
                return 3
        else:
            print("wb-datenklasse: interner Fehler (%s: %s)" % (type(exc).__name__, exc),
                  file=sys.stderr)
    return 3 if argv[0] == "pruefe" or (argv[0] == "route" and "--registry" in argv) else 2


def neue_lage():
    """R.Lage mit der Testnaht dieses Tors (die drei umschreibbaren Konstanten oben)."""
    return R.Lage(heim=NUTZER_HEIM or None, system_ordner=SYSTEM_ORDNER,
                  system_eigentuemer=SYSTEM_EIGENTUEMER, warnung=warnung)


