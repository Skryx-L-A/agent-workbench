def optionen(argv, werte, schalter=(), listen=()):
    vals = {k: None for k in werte}
    vals.update({k: [] for k in listen})
    fl = {f: False for f in schalter}
    pos = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a.startswith("--") and a[2:] in vals:
            if i + 1 >= len(argv):
                raise R.Abgelehnt("%s braucht einen Wert" % a)
            if a[2:] in listen:
                vals[a[2:]].append(argv[i + 1])
            else:
                vals[a[2:]] = argv[i + 1]
            i += 2
            continue
        if a.startswith("--") and a[2:] in fl:
            fl[a[2:]] = True
        elif a.startswith("-"):
            raise R.Abgelehnt("unbekannte Option %s" % a)
        else:
            pos.append(a)
        i += 1
    return vals, fl, pos


def klasse_oder_fehler(d):
