#!/bin/bash
# claude-worker [--mensch] [--konto gross|klein|auto] <name> <haiku45|sonnet5|opus5|opus48|fable51>[:effort] <dir> <task...>
# Permanent Claude chat agent pane (pi-worker mechanics). Model is REQUIRED.
#
# `--konto gross|klein|auto` (12.11./14.11.2026): das Anthropic-Abo des Workers, als
# CLAUDE_CODE_OAUTH_TOKEN aus dem Schluesselbund (Eintrag je Konto: `wb-konto konten`)
# statt der Browser-Anmeldung dieses Rechners. Vorgabe `auto`: `wb-konto wahl` nimmt
# beim Start das Konto mit der meisten Luft unter seiner Tageslinie; hat keines Luft,
# startet nichts. Ein genanntes Konto schliesst sich mit einem Modell der
# anthropic-api-Spur aus (kein Start, klare Meldung); ohne Schluesselbund-Eintrag
# ebenfalls kein Start -- kein stiller Rueckfall auf die Browser-Anmeldung.
# Gleichwertig: WB_CLAUDE_KONTO=<konto> in der Umgebung.
#
# `--basis <ref>` (27.10.2026, vor dem Namen, beliebig zwischen --mensch/--on): der
# Worktree wb/<name> entsteht auf <ref> statt auf dem HEAD von <dir>, z. B.
#   claude-worker --basis development w1 opus5:high ~/AI/claude-workbench "<auftrag>"
# Fehlt <ref> oder steht ein vorhandener Baum auf anderer Basis, startet KEIN Worker
# (Meldung von wb-worktree, Exit 2). Mit --on oder einer anderen defaultWorkerMachine
# wird --basis laut abgelehnt (Exit 1): wb-ssh-worker kann es nicht weitergeben.
#
# `--mensch` (2026-08-06) hebt den Effort-Deckel fuer diesen einen Start auf. Es
# wird hier nur DURCHGEREICHT — entschieden wird es in pi-worker, wo `wb-mensch`
# die Herkunft des Aufrufs misst. Das Merkmal steht ganz vorne, damit es auch die
# beiden `exec`-Wege unten (andere Maschine, Settings-Vorgabe) unveraendert
# mitnehmen.
#
# Routing (freigegeben 2026-07-25) — pick by TOTAL expected work:
#   haiku45:low    mechanical (rename, config tweak, format, one obvious fix; 200K ctx only)
#   sonnet5:high   short, well-specified coding, few files
#   sonnet5:xhigh  larger but clear spec (cross-file refactor, test suite, doc sweep)
#   opus5:xhigh    long/multi-step, debugging, design decisions, ambiguity
#   opus5:high     independent reviewer pass
#   opus48:xhigh   second opinion / A-B against known-good 4.8 behaviour
#   opus5:xhigh    customer-facing VISUAL deliverables (landing page, customer
#                  presentation, visual asset for a client) — since 2026-07-29 this
#                  replaces fable5 there: higher design-arena website Elo at half the
#                  price. The former fable self-service exception is REVOKED.
#   fable51        (Fable 5.1; ersetzt Fable 5 am 2026-09-02) NEVER without the user's explicit word, for any task. Effort cap
#                  `high` (raised from medium 2026-07-30). Enforced in pi-worker,
#                  which reads the cap from the model registry — not from this comment.
# Effort cap is xhigh everywhere (never `max`). The family aliases
# haiku|sonnet|opus|fable resolve through registry data to the newest enabled
# registered generation; versioned aliases such as opus5/opus48/opus55 stay fixed.
#
# V3: any model REGISTERED in ~/.claude/workbench/models.json can be typed here too
# (`claude-worker w1 gpt-5-codex <dir> <task>`), whatever harness it runs on. The
# routing table above is generated from that registry: `wb-state models table`.
#
#   claude-worker --on <mac|peer> <name> <model>[:effort] <dir> <task...>
# runs the worker on the OTHER machine and mirrors it into the local grid; it is
# called SSH-<name> everywhere (pane, state file, result dir on the target).
# Result: `wb-result SSH-<name>`. Without --on nothing changes.
#
# maxWorkers (SPEC-V2 A) is enforced in pi-worker, not duplicated here: this script
# never creates a pane itself, it only ever execs onward (below, or into
# wb-ssh-worker just above) — so pi-worker's check already covers every path that
# actually spawns something, on whichever machine that turns out to be.
# Befristeter Deckel des Claude-Wochenlimits (decision 2026-10-11: bis Mo 12.10. hoechstens
# 95 %): solange ~/.claude/workbench/limit-deckel.json gilt, startet kein Claude-Worker. Nach
# bis_epoch laeuft die Sperre von selbst aus. Arbeit geht an codex-worker oder pi-worker.
# `env -i` (nur HOME, derselbe Wert) und -I -S: /usr/bin/python3 ist auf macOS der xcrun-Shim
# und folgte sonst DEVELOPER_DIR/SDKROOT/TOOLCHAINS des Aufrufers (Review handyguard2 N1,
# 14.10.2026) -- ein eigenes xcrun haette die Sperre verneint. Die Umgebung des Starts selbst
# bleibt unberuehrt.
if /usr/bin/env -i HOME="$HOME" /usr/bin/python3 -I -S -c 'import json,os,sys,time
d=json.load(open(os.path.expanduser("~/.claude/workbench/limit-deckel.json")))
sys.exit(0 if time.time() < float(d["bis_epoch"]) else 1)' 2>/dev/null; then
  echo "claude-worker: GESPERRT -- befristeter Deckel des Claude-Wochenlimits (limit-deckel.json, decision 10-11); Worker an Codex oder lokal vergeben." >&2
  exit 3
fi
# --basis darf vor, zwischen oder nach --mensch/--on stehen; es wird hier
# herausgezogen, die uebrige Reihenfolge bleibt unberuehrt.
#
# --konto gross|klein|auto (task 12.11., task 14.11.2026):
# ueber WB_CLAUDE_KONTO in der Umgebung durchgereicht -- die Angabe selbst, NIE ein
# Schluessel oder Token. 'export' reicht: pi-worker und wb-harness-run erben die
# Variable ueber jeden weiteren exec, kein eigenes Flag noetig. Ohne --konto gilt eine
# schon gesetzte Angabe der aufrufenden Umgebung, sonst 'auto' (unten).
BASIS=""; BASIS_GESETZT=""; VOR=()
while [ $# -gt 0 ]; do
  case "$1" in
    --basis)   [ -n "${2:-}" ] || { echo "claude-worker: --basis braucht einen Ref." >&2; exit 1; }
               BASIS="$2"; BASIS_GESETZT=1; shift 2 ;;
    --basis=*) BASIS="${1#--basis=}"; BASIS_GESETZT=1; shift
               [ -n "$BASIS" ] || { echo "claude-worker: --basis braucht einen Ref." >&2; exit 1; } ;;
    --konto)   case "${2:-}" in gross|klein|auto) ;; *) echo "claude-worker: --konto kennt nur gross, klein oder auto." >&2; exit 1 ;; esac
               export WB_CLAUDE_KONTO="$2"; unset WB_CLAUDE_KONTO_VORGABE; shift 2 ;;
    --mensch)  VOR+=("$1"); shift ;;
    --on)      [ $# -ge 2 ] || break; VOR+=("$1" "$2"); shift 2 ;;
    *)         break ;;
  esac
done
set -- ${VOR[@]+"${VOR[@]}"} "$@"
# Vorgabe 'auto' (task, 14.11.2026): ohne --konto und ohne geerbte Angabe
# waehlt wb-konto beim Start das Konto mit Luft; die Browser-Anmeldung bleibt aussen vor.
# Unter der Testnaht (WB_TESTUMGEBUNG=1) gilt die Vorgabe nicht (Begruendung in pi-worker).
case "${WB_CLAUDE_KONTO:-}" in
  # Nur am Mac (decision 11-14): die Konto-Token liegen im macOS-Schluesselbund. Auf peer gibt es weder `security`
  # noch wb-konto (bewusst nicht in der Sync-Liste); dort bleibt die eigene Anmeldung des Rechners wie bisher.
  # WB_CLAUDE_KONTO_VORGABE (15.11.2026): markiert, dass 'auto' hier nur die Vorgabe ist und niemand ein Konto genannt hat.
  # Nur dann darf der anthropic-api-Vorzug in pi-worker greifen; jedes ausdrueckliche --konto (auch auto) heisst Abo.
  "")               [ "${WB_TESTUMGEBUNG:-}" = 1 ] || [ "$(uname -s)" != Darwin ] || export WB_CLAUDE_KONTO=auto WB_CLAUDE_KONTO_VORGABE=1 ;;
  gross|klein|auto) ;;
  *) echo "claude-worker: WB_CLAUDE_KONTO='$WB_CLAUDE_KONTO' ist kein Konto (gross|klein|auto). Kein Worker gestartet." >&2; exit 1 ;;
esac
# Ein ausdruecklich genanntes Konto braucht den Schluesselbund-Eintrag DIESER Maschine und
# wird nicht an wb-ssh-worker weitergegeben (task, Nachtrag 3) -- sonst
# liefe der Worker dort still auf der Anmeldung jener Maschine. 'auto' (die Vorgabe) gilt
# dort als "das Konto jener Maschine" und haelt den Start nicht auf.
konto_remote_ablehnen() {
  case "${WB_CLAUDE_KONTO:-}" in gross|klein) ;; *) return 0 ;; esac
  echo "claude-worker: --konto $WB_CLAUDE_KONTO gilt nur fuer einen Worker auf DIESER Maschine — wb-ssh-worker gibt es nicht weiter. Kein Worker gestartet. Ohne --konto starten oder lokal (ohne --on)." >&2
  exit 1
}
basis_remote_ablehnen() {
  [ -n "$BASIS_GESETZT" ] || return 0
  echo "claude-worker: --basis '$BASIS' gilt nur fuer einen Worker auf DIESER Maschine — der Worktree auf $1 entsteht dort, und wb-ssh-worker gibt --basis nicht weiter. Kein Worker gestartet. Ohne --basis starten oder lokal (ohne --on)." >&2
  exit 1
}

MENSCHFLAG=""
if [ "${1:-}" = "--mensch" ]; then MENSCHFLAG="--mensch"; shift; fi

if [ "${1:-}" = "--on" ]; then
  ONMACHINE="${2:?Maschine (mac|peer)}"; shift 2
  case "$(uname -s)" in Darwin) SELF=mac ;; *) SELF=peer ;; esac
  [ "$ONMACHINE" = "$SELF" ] && { echo "claude-worker: --on gilt nur fuer eine ANDERE Maschine — '$ONMACHINE' ist diese hier. Ohne --on starten." >&2; exit 1; }
  basis_remote_ablehnen "$ONMACHINE"
  # --konto klein braucht den Schluesselbund-Eintrag wb-claude-abo-2 DIESER Maschine
  # und wird nicht an wb-ssh-worker weitergegeben (task, Nachtrag 3,
  # 12.11.2026) -- sonst liefe der Worker auf der anderen Maschine still am grossen
  # Konto, ohne dass das irgendwo auffiele. Lieber Abbruch als Verlust der Angabe.
  konto_remote_ablehnen
  # Auf der ANDEREN Maschine wird die Herkunft neu gemessen (die SSH-Sitzung dort
  # ist ein anderer Prozessbaum), deshalb geht das Merkmal hier NICHT mit: es
  # waere dort eine reine Behauptung ohne pruefbaren Ursprung. Wer auf der
  # zweiten Maschine ueber dem Deckel starten will, tut das dort am Terminal.
  [ -n "$MENSCHFLAG" ] && echo "claude-worker: '--mensch' gilt nicht ueber '--on' — die Herkunft ist auf der anderen Maschine nicht mehr pruefbar. Der Deckel greift dort normal." >&2
  exec "$HOME/.local/bin/wb-ssh-worker" "$ONMACHINE" claude "$@"
fi

NAME="${1:?name}"; MODEL="${2:?model (haiku45|sonnet5|opus5|opus48|fable51[:effort]|default)}"; DIR="${3:?dir}"

# defaultWorkerMachine (SPEC-V2 A): applies ONLY when no machine was given explicitly
# (no --on — handled above and already returned) AND the name is not already an SSH
# mirror (an explicit SSH-<name> already says exactly where the work happens). "local"
# (the default) means today's behaviour: fall through to pi-worker unchanged.
case "$NAME" in
  SSH-*) ;;
  *)
    DEFMACH=$("$HOME/.local/bin/wb-state" settings get defaultWorkerMachine 2>/dev/null)
    case "$DEFMACH" in mac|peer) ;; *) DEFMACH=local ;; esac
    if [ "$DEFMACH" != local ]; then
      case "$(uname -s)" in Darwin) SELF=mac ;; *) SELF=peer ;; esac
      # Already on the configured default machine: nothing to redirect.
      [ "$DEFMACH" = "$SELF" ] || { basis_remote_ablehnen "$DEFMACH (defaultWorkerMachine)"; konto_remote_ablehnen; exec "$HOME/.local/bin/wb-ssh-worker" "$DEFMACH" claude "$@"; }
    fi
    ;;
esac

# Worktree-Isolierung (freigegeben 2026-08-04): jeder Worker bekommt seinen eigenen
# git-Arbeitsbaum und seinen eigenen Zweig, damit zwei Worker im selben Repo sich
# nicht mehr gegenseitig in die Dateien laufen. Der Aufruf steht HIER, nach dem
# Maschinen-Routing: ein Worker auf der ANDEREN Maschine hat seinen Worktree dort,
# nicht hier, und beide `exec`-Pfade oben sind schon zurueckgekehrt.
# `wb-worktree ensure` faellt nur fuer einen Ordner ohne Repo auf $DIR zurueck, mit
# einem Hinweis nach stderr. Laesst sich der Worktree nicht bestaetigen, bricht
# ensure laut ab (Exit 2, stdout leer), und der Worker startet nicht — seit
# 22.11.2026 auch ohne --basis. pi-worker bekommt --basis danach nicht mehr, $DIR ist
# dann schon der Worktree.
#
# liegt_in_git_spur ist eine wortgleiche Kopie aus wb-worktree: fehlt das Werkzeug,
# entscheidet dieselbe Regel, ob $DIR in einem Repo liegt. test-worktree-basis.sh
# vergleicht die drei Fassungen Byte fuer Byte; Aenderungen nur in allen dreien.
# liegt_in_git_spur <dir> — gibt es in <dir> oder einem Elternordner ein .git, oder
# erkennt git dort ein Repo? Dann ist <dir> KEIN "Ordner ohne git", und ensure
# darf nicht auf <dir> zurueckfallen, auch wenn git keinen Arbeitsbaum nennt.
liegt_in_git_spur() {
  local d
  if command -v git >/dev/null 2>&1 && git -C "$1" rev-parse --git-dir >/dev/null 2>&1; then
    return 0
  fi
  d="$(cd "$1" 2>/dev/null && pwd -P)" || return 0   # nicht lesbar: nicht bestaetigt, gilt als Repo
  while :; do
    [ -e "$d/.git" ] && return 0
    [ "$d" = / ] && return 1
    d="$(dirname "$d")"
  done
}
if [ -n "$BASIS_GESETZT" ]; then
  [ -x "$HOME/.local/bin/wb-worktree" ] \
    || { echo "claude-worker: --basis '$BASIS' braucht wb-worktree, das fehlt hier. Kein Worker gestartet." >&2; exit 1; }
  WT_RC=0
  WT_DIR="$("$HOME/.local/bin/wb-worktree" ensure "$NAME" "$DIR" --basis "$BASIS")" || WT_RC=$?
  if [ "$WT_RC" -ne 0 ] || [ -z "$WT_DIR" ] || [ ! -d "$WT_DIR" ]; then
    echo "claude-worker: Worktree fuer '$NAME' auf Basis '$BASIS' nicht angelegt (wb-worktree Exit $WT_RC, Meldung darueber). Kein Worker gestartet." >&2
    exit 2
  fi
  DIR="$WT_DIR"
elif [ -x "$HOME/.local/bin/wb-worktree" ]; then
  # Fail closed (22.11.2026): ein Fehler von ensure startet keinen Worker. Bis dahin
  # blieb $DIR stehen, und ein Worker lief im Hauptbaum (Fall vom 22.11.).
  WT_RC=0
  WT_DIR="$("$HOME/.local/bin/wb-worktree" ensure "$NAME" "$DIR")" || WT_RC=$?
  if [ "$WT_RC" -ne 0 ] || [ -z "$WT_DIR" ] || [ ! -d "$WT_DIR" ]; then
    echo "claude-worker: Worktree fuer '$NAME' nicht bestaetigt (wb-worktree Exit $WT_RC, Meldung darueber). Kein Worker gestartet." >&2
    exit 2
  fi
  DIR="$WT_DIR"
elif liegt_in_git_spur "$DIR"; then
  # Fail closed auch ohne Werkzeug (23.11.2026): fehlt wb-worktree, lief der Worker
  # bis dahin still im uebergebenen Verzeichnis, also auch im Hauptbaum eines Repos.
  echo "claude-worker: wb-worktree fehlt ($HOME/.local/bin/wb-worktree nicht vorhanden oder nicht ausfuehrbar), und '$DIR' liegt in einem git-Repo oder ist nicht lesbar. Kein Worker gestartet." >&2
  exit 2
else
  # Ordner ohne Repo: derselbe Rueckfall wie bei ensure, mit Meldung.
  echo "claude-worker: wb-worktree fehlt — '$NAME' laeuft ohne Worktree in $DIR." >&2
fi

# `default` takes workerModel/workerEffort from the settings menu (resolved in
# pi-worker, which owns the model table); it must NOT be prefixed with claude-.
case "$MODEL" in
  default|-) exec "$HOME/.local/bin/pi-worker" ${MENSCHFLAG:+"$MENSCHFLAG"} "$NAME" default "$DIR" "${@:4}" ;;
esac
# V3 (SPEC-V3 A.3): a REGISTRY model is typed exactly as it is registered
# (`claude-worker w1 gpt-5-codex …`) and must NOT be prefixed either — `claude-`
# in front of it would produce an id nobody knows. So only the built-in aliases
# get the prefix; everything else goes through untouched and pi-worker decides in
# order: alias -> registry -> installed Ollama id -> error.
BASE="${MODEL%%:*}"
case "$BASE" in
  haiku45|sonnet5|opus5|opus48|fable5|fable51|haiku|sonnet|opus|fable)
    exec "$HOME/.local/bin/pi-worker" ${MENSCHFLAG:+"$MENSCHFLAG"} "$NAME" "claude-$MODEL" "$DIR" "${@:4}" ;;
esac
exec "$HOME/.local/bin/pi-worker" ${MENSCHFLAG:+"$MENSCHFLAG"} "$NAME" "$MODEL" "$DIR" "${@:4}"
