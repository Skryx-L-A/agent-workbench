    0) [ -n "$wert" ] && export WB_HUB_TOKEN="$wert" ;;
    3) ;;
    *) echo "wb-harness-run: Hub-Token nicht ermittelt (wb-hub Exit $rc) — $HARNESS startet ohne WB_HUB_TOKEN; Hub-Werkzeuge antworten dann 401." >&2 ;;
  esac
}
