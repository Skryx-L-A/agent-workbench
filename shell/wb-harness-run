# und damit des Harness: nie in argv, eine tmux-Option, send-keys oder ein Log.
# Wie jede Umgebungsvariable sieht ihn derselbe Benutzer per `ps eww` (S5-Review).
# Geht es nicht: Start trotzdem, ohne Variable, eine Hinweiszeile.
hub_token_setzen() {
  local hub="$HOME/.local/bin/wb-hub" wert rc
  [ -x "$hub" ] || return 0
  wert="$("$hub" token-sicherstellen --harness "$HARNESS" --wert 2>/dev/null)"; rc=$?
