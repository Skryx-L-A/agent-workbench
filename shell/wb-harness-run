# EIN WRAPPER, DER SICH SELBST FINDET (2026-09-18, auf peer gemessen). Omarchy legt
# fuer jedes ueber `mise` verwaltete Werkzeug einen Wrapper nach ~/.local/bin, und der
# ruft sein Programm UEBER DEN PATH auf ("mise use -g codex; exec mise x codex --
# codex \"$@\""). Weil die Zeile darueber ~/.local/bin nach vorn stellt -- die
# Werkbank-Werkzeuge muessen im Pane erreichbar sein --, findet dieser Wrapper wieder
# SICH SELBST: eine Endlosschleife, in der der Worker nie startet und nur die
# Prozessliste waechst. Nach dem Omarchy-Update am 18.09.2026 (mise 2026.9.1 ->
# 2026.9.9, omarchy 4.0.4, 17:54 laut pacman.log) traf das codex- und
# opencode-Worker auf peer; dieselbe Wrapper-Form liegt dort fuer ein Dutzend
# weiterer Werkzeuge (copilot, crush, gemini, grok, ...), die Falle ist also nicht
# auf zwei Namen beschraenkt.
#
# Der Ausweg zeigt AM NAMEN vorbei, nicht am PATH im Ganzen: fuer genau den Befehl
# DIESES Starts wird ein eigenes Verzeichnis mit EINEM Symlink auf das echte
# Programm vorangestellt. Das mise-Shim-Verzeichnis einfach nach vorn zu haengen
# waere ein zweiter Fehler -- es traegt auf peer auch ein `pi`, `gh` und `python`
# und wuerde die Werkbank-eigenen Werkzeuge gleichen Namens verdecken.
harness_befehl_absichern() {
  local name gefunden echt dir
  # Der Befehl steht in der aufgeloesten Startzeile hinter `exec` ("cd <dir> && exec
  # codex --model ..."). Faellt das Muster aus, bleibt der Harness-Name die
  # Rueckfallebene -- bei jedem heute registrierten Harness sind beide gleich.
  name="$(printf '%s\n' "$CMD" | sed -n 's/.*[[:space:]]exec[[:space:]]\{1,\}\([^[:space:];|&]\{1,\}\).*/\1/p' | head -1)"
  [ -n "$name" ] || name="$HARNESS"
  case "$name" in ""|*/*) return 0 ;; esac   # leer oder schon ein Pfad: nichts zu tun
  gefunden="$(command -v "$name" 2>/dev/null)" || return 0
  [ -f "$gefunden" ] && [ -r "$gefunden" ] || return 0
  grep -qsE '(^|[^[:alnum:]])mise[[:space:]]+(x|exec)[[:space:]]' "$gefunden" || return 0
  command -v mise >/dev/null 2>&1 || return 0
  echt="$(mise which "$name" 2>/dev/null)" || return 0
  [ -n "$echt" ] && [ -x "$echt" ] && [ "$echt" != "$gefunden" ] || return 0
  dir="$HOME/.local/state/wb-harness-bin"
  mkdir -p "$dir" 2>/dev/null || return 0
  ln -sfn "$echt" "$dir/$name" 2>/dev/null || return 0
  PATH="$dir:$PATH"
  echo "wb-harness-run: '$name' in ~/.local/bin ist ein mise-Wrapper, der sich ueber den PATH selbst faende — gestartet wird stattdessen $echt." >&2
}
harness_befehl_absichern

# The first Codex turn must create a thread before `codex queue` can address it.
# Only the one-shot file path is stored in @wb_cmd. Read it as data into a Bash
# variable and expand that variable as one positional
# argument when the resolved command is evaluated. Shell syntax in the prompt is
# never parsed. The private file remains until @wb_thread identifies this pane.
# Zusammen mit --resume-args nur bei codex (09.10.2026): pi-worker startet einen Worker,
# dessen Queue nach einem abgebrochenen Zug pausiert, per `codex resume <thread>` neu und
# uebergibt den Folgeauftrag als Erstauftrag (`codex resume [OPTIONS] [SESSION_ID]
# [PROMPT]`). Die Resume-Flags sind oben schon auf genau `resume <id>` geprueft.
if [ -n "$INITIAL_TASK_FILE" ] && { [ -z "$RESUME_ARGS" ] || [ "$HARNESS" = codex ]; } \
   && [ -e "$INITIAL_TASK_FILE" ]; then
  START_STYLE="$("$HOME/.local/bin/wb-state" harness get "$HARNESS" 2>/dev/null \
    | /usr/bin/python3 -c 'import json,sys
try: print(json.load(sys.stdin).get("initialPrompt", ""))
except Exception: pass')"
  # Stil 'positional' (codex): der Auftrag ist das letzte Argument. Stil 'flag:<option>' (agy:
  # 'flag:-i', belegt an `agy --help`: --prompt-interactive "Run an initial prompt interactively
  # and continue the session"; ohne Wert endet agy mit "flag needs an argument: -i"): der
  # Auftrag folgt der Option. Beide Male bleibt er EIN Argument und wird nie als Shell geparst.
  # Ein Resume mit Erstauftrag (--resume-args) bleibt auf codex beschraenkt.
  [[ "$START_STYLE" =~ ^(positional|flag:--?[A-Za-z][A-Za-z0-9-]*)$ ]] \
    && { [ -z "$RESUME_ARGS" ] || [ "$HARNESS" = codex ]; } \
    && [ -f "$INITIAL_TASK_FILE" ] && [ -r "$INITIAL_TASK_FILE" ] \
    && [ -s "$INITIAL_TASK_FILE" ] || {
      echo "wb-harness-run: Erstauftrag oder Registry-Startfeld (initialPrompt) fuer $HARNESS ungueltig — kein Start." >&2
      exit 1
    }
  MODE="$(stat -c %a "$INITIAL_TASK_FILE" 2>/dev/null || stat -f %Lp "$INITIAL_TASK_FILE" 2>/dev/null)"
  [ "$MODE" = 600 ] || { echo "wb-harness-run: Erstauftrag braucht Mode 0600 — kein Start." >&2; exit 1; }
  WB_INITIAL_PROMPT="$(cat "$INITIAL_TASK_FILE")" || exit 1
  case "$START_STYLE" in
    flag:*) CMD="$CMD ${START_STYLE#flag:} \"\$WB_INITIAL_PROMPT\"" ;;
    *)      CMD="$CMD \"\$WB_INITIAL_PROMPT\"" ;;
  esac
fi

# Der Tokenwert erst HIER, unmittelbar vor dem eval/exec, aus dem Schluesselbund
# gelesen und NUR in diese (gleich ersetzte) Prozessumgebung exportiert: nie in
# argv, nie in CMD selbst, nie in einer Datei, einem Log, einer tmux-Option oder
# dem Pane-Titel. ANTHROPIC_API_KEY wird dabei entfernt, falls dieser Prozess es
# aus seiner eigenen Umgebung geerbt hat -- Claudes Vorrangkette liest es vor dem
# Token und wuerde den Token sonst lautlos uebergehen.
if [ -n "$WB_KONTO_DIENST" ]; then
  unset ANTHROPIC_API_KEY
  WB_KONTO_TOKEN="$(security find-generic-password -s "$WB_KONTO_DIENST" -w 2>/dev/null || true)"
  if [ -z "$WB_KONTO_TOKEN" ]; then
    echo "wb-harness-run: FEHLER -- Schluesselbund-Eintrag '$WB_KONTO_DIENST' (Konto $WB_KONTO) ist jetzt leer oder verschwunden; kein stiller Rueckfall auf die Browser-Anmeldung; kein Start." >&2
    exit 1
  fi
  export CLAUDE_CODE_OAUTH_TOKEN="$WB_KONTO_TOKEN"
  unset WB_KONTO_TOKEN
  # Das tatsaechlich gewaehlte Konto fuer die Statuszeile (Kontofeld in limits.jsonl).
  # Die Angabe WB_CLAUDE_KONTO gilt nur fuer diesen Start (task, 18.11.2026): sie wird hier entfernt,
  # damit Worker und Kindlaeufe, die diese Sitzung startet, wieder selbst waehlen statt das Konto der Mutter zu
  # erben ('auto' in der Variable genuegte dafuer nicht: ein ausdrueckliches gross/klein blieb in der Sitzung stehen).
  export WB_CLAUDE_KONTO_AKTIV="$WB_KONTO"
  unset WB_CLAUDE_KONTO WB_CLAUDE_KONTO_VORGABE
fi

eval "$CMD"
