#!/bin/bash
# wb-harness-run — start a REGISTERED harness inside its tmux pane (SPEC-V3 C).
#
#   wb-harness-run --model <id> --role worker|orchestrator
#                  [--effort <e>] [--dir <d>] [--name <n>] [--resume-args '<flags>']
#                  [--initial-task-file <private-file>]
#
# This is the shim that pi-worker/wb-code put into a pane instead of building a
# command themselves: it asks `wb-state models resolve` for the start line (the
# ONLY place that builds one), turns the secret PLACEHOLDERS into real values in
# its OWN process environment, and execs. It is re-executable, which is what
# @wb_cmd (wb-revive / the pane-died hook) needs.
#
# Why the detour instead of exporting the key before `tmux split-window`: a value
# passed through a tmux option, an -e flag or any argv ends up in the process
# list. Here the key exists only in the environment of the process that needs it —
# never in argv, never in a tmux option, never in a file we write, never logged.
# The lookup order is the contract from SPEC-V3 A.1 and matches wb-state's
# presence check one for one: Keychain -> ~/.secrets-sync/api-keys/<provider>
# (mode 600 enforced) -> environment variable. Change one, change both.
#
# Remote Control (Vorgabe des Nutzers 2026-08-05, orchestrator immer an, worker
# immer aus): not handled here. --role is only forwarded to `wb-state models
# resolve`, which already decides per role (harness id 'claude', see there) --
# adding a second decision in this shim would be exactly the per-call-site
# duplication that made the last rollout miss a start path. In today's actual
# call graph this shim never builds a 'claude' cmd for role=orchestrator (wb-code
# takes the direct path whenever the harness resolves to literal 'claude'); the
# resolver still carries the rule for whichever REGISTERED harness reaches this
# shim as 'claude' next.
set -uo pipefail

MODEL=""; ROLE="worker"; EFFORT=""; DIR=""; NAME=""; RESUME_ARGS=""; INITIAL_TASK_FILE=""
while [ $# -gt 0 ]; do
  case "$1" in
    --model)  MODEL="${2:?model id}"; shift 2 ;;
    --role)   ROLE="${2:?worker|orchestrator}"; ROLLE_AUSDRUECKLICH=1; shift 2 ;;
    --effort) EFFORT="${2:?effort}"; shift 2 ;;
    --dir)    DIR="${2:?dir}"; shift 2 ;;
    --name)   NAME="${2:?name}"; shift 2 ;;
    --resume-args) RESUME_ARGS="${2:?flags}"; shift 2 ;;
    --initial-task-file) INITIAL_TASK_FILE="${2:?file}"; shift 2 ;;
    *) echo "wb-harness-run: unbekannte Option '$1'" >&2; exit 1 ;;
  esac
done
[ -n "$MODEL" ] || { echo "wb-harness-run: --model fehlt" >&2; exit 1; }

# WB_CLAUDE_KONTO=gross|klein|auto (task 12.11.2026, erweitert durch
# task 14.11.2026): das Anthropic-Abo, ueber CLAUDE_CODE_OAUTH_TOKEN aus dem
# Schluesselbund statt der Browser-Anmeldung dieses Rechners. Welcher Eintrag zu welchem
# Konto gehoert und welches Konto 'auto' bekommt, steht allein in wb-konto (aufloesen,
# dienst) -- hier keine eigene Tabelle. Ohne WB_CLAUDE_KONTO bleibt alles wie vorher.
# Ein ausdruecklich genanntes Konto schliesst sich mit der anthropic-api-Spur aus
# (apiKeyHelper/ANTHROPIC_API_KEY schlagen in Claudes Vorrangkette den Token): Abbruch.
# 'auto' ist die Vorgabe jedes Workers und darf einen anthropic-api- oder Nicht-Claude-
# Start deshalb nicht verhindern; dort entfaellt das Konto. Alle Pruefungen VOR jedem
# Seiteneffekt (Rollendatei, Vertrauensspeicher usw.); der Tokenwert selbst wird erst ganz
# am Ende, unmittelbar vor dem eval/exec, gelesen -- fehlt der Eintrag: Abbruch, kein
# stiller Rueckfall auf die Browser-Anmeldung.
WB_KONTO=""; WB_KONTO_DIENST=""
if [ -n "${WB_CLAUDE_KONTO:-}" ]; then
  case "$WB_CLAUDE_KONTO" in
    gross|klein|auto) ;;
    *) echo "wb-harness-run: FEHLER -- WB_CLAUDE_KONTO='$WB_CLAUDE_KONTO' ist kein Konto (gross|klein|auto); kein Start." >&2; exit 1 ;;
  esac
  KONTO_PROVIDER="$("$HOME/.local/bin/wb-state" models get "$MODEL" --field provider 2>/dev/null || true)"
  KONTO_HARNESS="$("$HOME/.local/bin/wb-state" models get "$MODEL" --field harness 2>/dev/null || true)"
  KONTO_WIRKT=1
  if [ "$KONTO_PROVIDER" = anthropic-api ]; then
    if [ "$WB_CLAUDE_KONTO" != auto ]; then
      echo "wb-harness-run: FEHLER -- WB_CLAUDE_KONTO=$WB_CLAUDE_KONTO und ein Modell der Spur anthropic-api ('$MODEL') schliessen sich aus (apiKeyHelper/ANTHROPIC_API_KEY schlagen den Token); kein Start." >&2
      exit 1
    fi
    KONTO_WIRKT=""
  fi
  [ "$WB_CLAUDE_KONTO" = auto ] && [ -n "$KONTO_HARNESS" ] && [ "$KONTO_HARNESS" != claude ] && KONTO_WIRKT=""
  if [ -n "$KONTO_WIRKT" ]; then
    WB_KONTO_BIN="$HOME/.local/bin/wb-konto"
    if [ ! -x "$WB_KONTO_BIN" ]; then
      echo "wb-harness-run: FEHLER -- WB_CLAUDE_KONTO=$WB_CLAUDE_KONTO, aber wb-konto fehlt ($WB_KONTO_BIN); kein stiller Rueckfall auf die Browser-Anmeldung; kein Start." >&2
      exit 1
    fi
    WB_KONTO="$("$WB_KONTO_BIN" aufloesen "$WB_CLAUDE_KONTO")" || {
      echo "wb-harness-run: FEHLER -- keine Kontowahl fuer WB_CLAUDE_KONTO=$WB_CLAUDE_KONTO (Meldung von wb-konto oben); kein Start." >&2
      exit 1
    }
    case "$WB_KONTO" in
      gross|klein) ;;
      *) echo "wb-harness-run: FEHLER -- wb-konto lieferte kein Konto; kein Start." >&2; exit 1 ;;
    esac
    WB_KONTO_DIENST="$("$WB_KONTO_BIN" dienst "$WB_KONTO")" || exit 1
    [ -n "$WB_KONTO_DIENST" ] || { echo "wb-harness-run: FEHLER -- kein Schluesselbund-Dienst fuer Konto $WB_KONTO; kein Start." >&2; exit 1; }
  fi
fi

# Ohne --role gilt "worker". Ein Start ohne ausdrueckliche Rolle ausserhalb des eigenen
# Worker-Arbeitsbaums schriebe den Worker-Rollenblock in die AGENTS.md eines fremden Ordners,
# wo er nach dem Ende des Workers liegen bliebe. Alle Spawner (pi-worker, wb-code) geben --role
# mit, Wiederbelebungen verwenden ihre gespeicherte Startzeile. Ein Direktaufruf muss die Rolle
# nennen, ausser er laeuft im eigenen Arbeitsbaum ~/.pi-workers/worktrees/<name>.
if [ -z "${ROLLE_AUSDRUECKLICH:-}" ]; then
  wb_rolle_wt="$(cd "$HOME/.pi-workers/worktrees" 2>/dev/null && pwd -P)"
  wb_rolle_dir="$(cd "${DIR:-$PWD}" 2>/dev/null && pwd -P)"
  case "$wb_rolle_dir/" in
    "${wb_rolle_wt:-/nie/ein/worktree}"/*/*) ;;
    *) echo "wb-harness-run: --role worker|orchestrator fehlt. Ohne ausdrueckliche Rolle startet nur ein Worker in seinem eigenen Arbeitsbaum (~/.pi-workers/worktrees/<name>); sonst bliebe eine Worker-Rolle in ${wb_rolle_dir:-?}/AGENTS.md liegen." >&2
       exit 1 ;;
  esac
fi

ARGS=(models resolve "$MODEL" --role "$ROLE")
[ -n "$EFFORT" ] && ARGS+=(--effort "$EFFORT")
[ -n "$DIR" ] && ARGS+=(--dir "$DIR")
[ -n "$NAME" ] && ARGS+=(--name "$NAME")
RESOLVED="$("$HOME/.local/bin/wb-state" "${ARGS[@]}")" || {
  echo "wb-harness-run: Start abgebrochen — siehe Fehler oben." >&2
  exit 1
}

# One secret placeholder chain -> the value, or empty. Prints nothing but the
# value itself, and only into the caller's variable.
secret_value() {
  local spec svc path mode var val
  for spec in "$@"; do
    case "$spec" in
      @keychain:*)
        svc="${spec#@keychain:}"
        if command -v security >/dev/null 2>&1; then
          val="$(security find-generic-password -s "$svc" -w 2>/dev/null || true)"
          [ -n "$val" ] && { printf '%s' "$val"; return 0; }
        fi ;;
      @file:*)
        path="${spec#@file:}"
        if [ -e "$path" ]; then
          # GNU zuerst, dann BSD -- dieselbe Reihenfolge wie in context-guard und
          # wb-grid. Bei GNU ist `-f` KEIN Formatschalter, sondern "Dateisystem
          # statt Datei": `stat -f %Lp <datei>` liest '%Lp' als zweiten Dateinamen,
          # gibt fuer die echte Datei einen ganzen Dateisystem-Block auf stdout aus
          # und endet mit 1. Die alte BSD-zuerst-Reihenfolge haengte diesen Block
          # also vor den Mode, der Vergleich unten scheiterte immer, und damit
          # startete auf Linux kein einziges Modell mit hinterlegtem Key.
          # -L: ein Key darf ein Symlink auf einen anderen Key desselben Speichers sein
          # (headroom -> bifrost). Ohne -L meldet stat den Mode des Links selbst (777 bzw.
          # 755), und jeder Start ueber den Link scheiterte an "hat Mode ..., verlangt 600".
          # wb-state und wb-llm folgen dem Link ebenfalls; geprueft wird die Datei, die
          # tatsaechlich gelesen wird.
          mode="$(stat -L -c %a "$path" 2>/dev/null || stat -L -f %Lp "$path" 2>/dev/null || echo 777)"
          case "$mode" in
            600|400) ;;
            *) echo "wb-harness-run: FEHLER — $path hat Mode $mode, verlangt 600. Key nicht gelesen." >&2
               return 1 ;;
          esac
          val="$(head -1 "$path" | tr -d '\r\n')"
          [ -n "$val" ] && { printf '%s' "$val"; return 0; }
        fi ;;
      @env:*)
        var="${spec#@env:}"
        val="$(printenv "$var" 2>/dev/null || true)"
        [ -n "$val" ] && { printf '%s' "$val"; return 0; }
        ;;
    esac
  done
  return 1
}

# apiKeyHelper statt Umgebungsvariable, NUR fuer harness=claude + ANTHROPIC_API_KEY
# (task, 11.11.2026): ein echter claude-Pane (nicht "-p") liest
# ANTHROPIC_API_KEY aus seiner EIGENEN Umgebung als "custom key" und haengt an der
# Rueckfrage "Detected a custom API key in your environment ... Do you want to use
# this API key?" fest -- ein Pane, in das niemand tippt, bleibt dort stehen. Gemessen
# an der installierten CLI (2.1.322, `strings` auf die Binaerdatei): das Gate dieser
# Rueckfrage prueft NUR die Prozessumgebung,
#   function aGn(){let e=i.ANTHROPIC_API_KEY;if(!e||aC()||!Fn())return; ...}
# nie apiKeyHelper. Deshalb wird der Schluessel fuer diesen einen Fall NIE in diesen
# Prozess (und damit nie in claudes eigene Umgebung) exportiert; stattdessen bekommt
# claude ueber --settings einen apiKeyHelper-Pfad, der dieselbe Kette (Keychain ->
# Datei -> Umgebungsvariable) ERNEUT laeuft, wenn claude ihn selbst aufruft -- der
# Wert existiert dann nur innerhalb von DESSEN kurzlebigem Skriptaufruf, nie in argv,
# nie in der Umgebung von wb-harness-run, nie auf der Platte ausser als Kommando.
#
# Ueber --setting-sources/Workspace-Trust: wb-harness-run setzt --setting-sources fuer
# den normalen claude-Worker-Start HEUTE GAR NICHT (geprueft: kein Treffer im ganzen
# Repo ausser `shell/models.default.json:622`, und das ist eine ANDERE, kopflose
# Kurzprobe vor dem Eintrag eines entdeckten Modells, kein Teil dieses Startpfads).
# --settings auf der Befehlszeile laedt als eigene Quelle "flagSettings" (im Binary
# als String belegt), getrennt von "projectSettings"/"localSettings" -- und genau
# diese beiden sind es, die den Workspace-Trust-Riegel ausloesen (gemessen:
# `function TC(){... Za("projectSettings")... Za("localSettings") ...}`, gated durch
# `if(TC()){ if(!Vs()){ FEHLER vor Vertrauensbestaetigung } }`). Ein --settings-Flag
# mit apiKeyHelper oeffnet diesen Riegel also nicht und braucht ihn auch nicht.
#
# Aufraeumen: wb-harness-run endet nie normal (der gebaute Befehl traegt `exec`, der
# diesen Bash-Prozess ERSETZT -- kein Code danach laeuft mehr, kein EXIT-Trap feuert).
# Der 0700-Ordner traegt deshalb beim naechsten Start IRGENDEINES claude-Workers eine
# eigene Faelligkeitspruefung (wb_apikeyhelper_sweep): verschwunden ist der Pane laut
# `tmux list-panes -a`, verschwindet der Ordner mit. Bis dahin liegt dort NIE der
# Schluessel selbst, nur ein Kommando, das ihn holt -- also dieselbe Offenlegung wie
# ein direkter `security`-Aufruf durch denselben Nutzer, keine zusaetzliche.
wb_apikeyhelper_sweep() {
  local base="$1" d pane alive now mtime alter
  [ -d "$base" ] || return 0
  alive="$(tmux list-panes -a -F '#{pane_id}' 2>/dev/null || true)"
  now="$(date +%s)"
  for d in "$base"/*/; do
    [ -d "$d" ] || continue
    # Befund decision 2026-11-12 (Nachtrag task): ein Ordner, der GERADE erst
    # angelegt wurde, darf nie verschwinden, nur weil 'tmux list-panes' die neue
    # Sitzung in diesem Moment noch nicht meldet (Reihenfolge Start/erste
    # Sweep-Pruefung ist nicht garantiert). Zwei Minuten Schonfrist, unabhaengig von
    # der Pane-Lebendpruefung unten.
    mtime="$(stat -f %m "$d" 2>/dev/null || stat -c %Y "$d" 2>/dev/null || echo 0)"
    alter=$((now - mtime))
    [ "$alter" -lt 120 ] && continue
    pane="$(cat "${d}pane_id" 2>/dev/null || true)"
    if [ -z "$pane" ] || ! grep -qxF -- "$pane" <<<"$alive"; then
      rm -rf "$d"
    fi
  done
}

# Baut den Ordner + das Helferskript fuer EINE Schluesselkette (dieselbe
# @keychain:/@file:/@env:-Syntax wie secret_value) und gibt den Pfad des
# AUSFUEHRBAREN Helferskripts (key-helper.sh) auf stdout aus -- das ist der Wert,
# der als apiKeyHelper in die Startzeile muss (Befund decision 2026-11-12, Nachtrag
# task: eine fruehere Fassung gab hier den Pfad einer separaten
# settings.json zurueck, die apiKeyHelper zwar richtig trug, aber selbst NIE in die
# Startzeile einging -- AAPI_WERTE weiter unten baute daraus "apiKeyHelper":
# "<...>/settings.json", also einen Verweis auf eine nicht ausfuehrbare JSON-Datei
# statt auf das Skript. claude meldete das sichtbar als "apiKeyHelper failed: exited
# 126 ... Permission denied", startete aber trotzdem -- vermutlich ueber die
# bestehende /login-Anmeldung dieses Rechners, nicht ueber den Schluessel; der
# hermetische Test prueft deshalb nicht mehr eine separate Datei, sondern denselben
# Wert, der tatsaechlich in der Startzeile steht, siehe dort). Kein Schluesselwert
# beruehrt dabei die Platte.
wb_apikeyhelper_bauen() {
  local base dir helper
  base="${WB_APIKEYHELPER_BASE:-$HOME/.claude/workbench/apikeyhelper-sessions}"
  mkdir -p "$base" 2>/dev/null || return 1
  wb_apikeyhelper_sweep "$base"
  dir="$(mktemp -d "$base/XXXXXXXX")" || return 1
  chmod 700 "$dir"
  helper="$(/usr/bin/python3 - "$dir" "$@" <<'PY'
import os, shlex, sys
dir_, chain = sys.argv[1], sys.argv[2:]
lines = ["#!/bin/sh"]
for spec in chain:
    if spec.startswith("@keychain:"):
        svc = spec[len("@keychain:"):]
        lines.append(
            "v=$(security find-generic-password -s %s -w 2>/dev/null) "
            "&& [ -n \"$v\" ] && { printf %%s \"$v\"; exit 0; }" % shlex.quote(svc))
    elif spec.startswith("@file:"):
        path = spec[len("@file:"):]
        q = shlex.quote(path)
        lines.append(
            "if [ -e %s ]; then "
            "m=$(stat -L -c %%a %s 2>/dev/null || stat -L -f %%Lp %s 2>/dev/null || echo 777); "
            "case \"$m\" in 600|400) v=$(head -1 %s | tr -d '\\r\\n'); "
            "[ -n \"$v\" ] && { printf %%s \"$v\"; exit 0; } ;; esac; fi" % (q, q, q, q))
    elif spec.startswith("@env:"):
        var = spec[len("@env:"):]
        lines.append(
            "v=$(printenv %s 2>/dev/null) && [ -n \"$v\" ] && { printf %%s \"$v\"; exit 0; }"
            % shlex.quote(var))
if len(lines) == 1:
    sys.exit(1)
lines.append("exit 1")
helper = os.path.join(dir_, "key-helper.sh")
with open(helper, "w") as f:
    f.write("\n".join(lines) + "\n")
os.chmod(helper, 0o700)
print(helper)
PY
)" || { rm -rf "$dir"; return 1; }
  [ -n "$helper" ] || { rm -rf "$dir"; return 1; }
  # Befund decision 2026-11-12: 'tmux display-message' ohne -t beantwortet nach der
  # Pane/Fenster-Historie des SERVERS, nicht zwingend nach der Pane, in der DIESER
  # Prozess laeuft -- gemessen stand dort wiederholt die Pane des STARTERS, nicht die
  # des gerade gespawnten Workers. $TMUX_PANE ist dagegen die Umgebungsvariable, die
  # tmux jedem Kindprozess EINER Pane auf genau diese setzt; es gibt keine Abfrage,
  # die daneben zeigen kann.
  AAPI_PANE_ID="${TMUX_PANE:-}"
  [ -n "$AAPI_PANE_ID" ] && printf '%s' "$AAPI_PANE_ID" > "$dir/pane_id"
  printf '%s' "$helper"
}

CMD=""; HARNESS=""; AAPI_HELPER=""
while IFS=$'\t' read -r key rest; do
  case "$key" in
    harness) HARNESS="$rest" ;;
    cmd) CMD="$rest" ;;
    # The resolved model reference, for code inside the harness that starts turns
    # without the CLI flag: the opencode inbox plugin creates the first session over
    # the built-in server, and `--model` never reaches that session (opencode.log
    # 2026-10-01/06: `model=undefined`, then the server default ollama/ornith:9b).
    model) export WB_HARNESS_MODEL="$rest" ;;
    env)
      VAR="${rest%%$'\t'*}"; VALSPEC="${rest#*$'\t'}"
      case "$VALSPEC" in
        @keychain:*|@file:*|@env:*)
          # split the chain on tabs and walk it in order
          IFS=$'\t' read -r -a CHAIN <<<"$VALSPEC"
          if [ "$HARNESS" = claude ] && [ "$VAR" = "ANTHROPIC_API_KEY" ]; then
            # apiKeyHelper statt Export in diesen Prozess -- siehe Kopfkommentar von
            # wb_apikeyhelper_bauen weiter oben. Erst pruefen, ob UEBERHAUPT ein Key
            # vorliegt (derselbe Fehlergang wie beim Export-Weg, vor jedem Dateischreiben),
            # dann sofort wieder vergessen -- der eigentliche, claude-seitige Abruf
            # laeuft spaeter erneut, im Helferskript.
            if SECRET="$(secret_value "${CHAIN[@]}")" && [ -n "$SECRET" ]; then
              unset SECRET
              AAPI_HELPER="$(wb_apikeyhelper_bauen "${CHAIN[@]}")" && [ -n "$AAPI_HELPER" ] || {
                echo "wb-harness-run: FEHLER — konnte keine apiKeyHelper-Sitzungsdatei fuer \$$VAR anlegen; kein Start." >&2
                exit 1; }
            else
              echo "wb-harness-run: FEHLER — kein Key hinterlegt fuer \$$VAR; kein Start ohne Auth." >&2
              exit 1
            fi
          elif SECRET="$(secret_value "${CHAIN[@]}")" && [ -n "$SECRET" ]; then
            # A failing export must not fall through (no `set -e` here): an invalid
            # variable name would otherwise start the CLI WITHOUT its key, and the
            # auth error would only turn up inside the pane.
            export "$VAR=$SECRET" || {
              echo "wb-harness-run: FEHLER — '$VAR' ist kein gueltiger Variablenname; kein Start." >&2
              exit 1; }
            unset SECRET
          else
            echo "wb-harness-run: FEHLER — kein Key hinterlegt fuer \$$VAR; kein Start ohne Auth." >&2
            exit 1
          fi
          # anthropic-api-Guthabenspur (task, 11.11.2026): wb-kontingent
          # kann den Verbrauch eines API-Schluessel-Workers nur messen, wenn es WEISS, welche
          # Sitzung mit welchem Modell in welchem Arbeitsverzeichnis gestartet wurde -- danach
          # liest es die Claude-Code-Transkripte dieses Verzeichnisses (sie tragen `usage` je
          # Zug) und rechnet mit der Preistabelle. Diese Zeile traegt NIE den Schluessel selbst,
          # nur Name/Modell/Verzeichnis/Sitzung, und nur fuer genau DIESE Variable -- jeder
          # andere Provider-Key (etwa Cline Pass) bleibt unberuehrt, UNABHAENGIG davon, ueber
          # welchen der beiden Wege (apiKeyHelper oder Export) der Key diesmal lief. Ein
          # fehlgeschlagenes tmux display-message (kein TMUX, Testlauf) liefert eine leere
          # Sitzungsspalte; das ist kein Fehler, nur eine unbekannte Sitzung (sammelt dann
          # unter "unbekannt").
          if [ "$VAR" = "ANTHROPIC_API_KEY" ]; then
            AAPI_LOG="${WB_ANTHROPIC_API_SESSIONS_LOG:-$HOME/.claude/workbench/anthropic-api-sessions.log}"
            AAPI_SITZUNG="$(tmux display-message -p '#{session_name}' 2>/dev/null || true)"
            mkdir -p "$(dirname "$AAPI_LOG")" 2>/dev/null
            printf '%s\t%s\t%s\t%s\t%s\n' \
              "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$NAME" "${WB_HARNESS_MODEL:-}" "$DIR" "$AAPI_SITZUNG" \
              >> "$AAPI_LOG" 2>/dev/null || true
          fi ;;
        *) export "$VAR=$VALSPEC" || {
             echo "wb-harness-run: FEHLER — '$VAR' ist kein gueltiger Variablenname; kein Start." >&2
             exit 1; } ;;
      esac ;;
  esac
done <<<"$RESOLVED"

[ -n "$CMD" ] || { echo "wb-harness-run: resolve lieferte kein Startkommando." >&2; exit 1; }

# apiKeyHelper in die Startzeile einfuegen (erst JETZT moeglich: 'env'-Zeilen kommen
# in RESOLVED vor der 'cmd'-Zeile, CMD stand beim Bau von AAPI_HELPER oben noch
# nicht fest). Ein claude-Worker traegt fuer role=worker/orchestrator schon ein
# eigenes '--settings {...}' (remoteControlAtStartup/crossSessionInbound,
# shell/wb-state CLAUDE_SETTINGS) -- ein zweites, eigenes '--settings'-Flag daneben
# wuerde (je nach CLI-Vorrang) dieses stillschweigend verdecken statt ergaenzen.
# 'models claude-settings --werte ... --in ...' fuehrt deshalb in DASSELBE JSON
# zusammen, mit derselben, schon getesteten Funktion, die auch role-basierte Werte
# einfuegt (claude_settings_einfuegen) -- keine zweite Kopie der Zusammenfuehrung.
if [ -n "$AAPI_HELPER" ]; then
  AAPI_WERTE="$(/usr/bin/python3 -c 'import json,sys; print(json.dumps({"apiKeyHelper": sys.argv[1]}))' "$AAPI_HELPER")"
  NEUCMD="$("$HOME/.local/bin/wb-state" models claude-settings --werte "$AAPI_WERTE" --in "$CMD")" \
    && [ -n "$NEUCMD" ] || {
      echo "wb-harness-run: FEHLER — konnte apiKeyHelper nicht in die Startzeile einfuegen." >&2
      exit 1; }
  CMD="$NEUCMD"
fi

# An older installed registry may still add `resume --last` on a normal start.
# It is global to CODEX_HOME, so discard it even when no explicit resume was
# requested. A pane-specific id is inserted only after validation below.
if [ "$HARNESS" = codex ]; then
  CMD="$(/usr/bin/python3 - "$CMD" <<'PY'
import re, sys
print(re.sub(r"(?<!\S)resume\s+--last(?=\s|$)", "", sys.argv[1], count=1))
PY
)"
fi

# --resume-args: die Fortsetzen-Flags des Harness, durchgereicht von wb-revive
# (2026-08-06). Bis heute erreichte sie nichts von aussen, weil dieser Shim seine
# innere Befehlszeile selbst baut — und genau das bleibt so. Der Grund dafuer steht
# oben und aendert sich nicht: ein Provider-Key darf nie durch argv, eine tmux-Option
