    *) echo "wb-harness-run: WARNUNG — Codex-Startzeile unbekannter Form; Plugins und Auto-Memory bleiben aktiviert." >&2 ;;
  esac
  [ -n "${WB_MCP_VOLL:-}" ] && echo "wb-harness-run: WB_MCP_VOLL gesetzt — dieser Codex-Worker behaelt Plugins, Browser-MCP und Computer Use." >&2
