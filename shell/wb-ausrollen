        ["--dry-run", "--pruef-ordner", shell] if trocken else [])
    try:
        p = subprocess.run(argv, capture_output=True, text=True, timeout=30, env=env)
    except (OSError, subprocess.SubprocessError) as fehler:
        print("  Skills: wb-werkzeuge skills-anlegen nicht aufrufbar: %s" % fehler, file=sys.stderr)
        return 1
    for zeile in p.stdout.splitlines():
        if zeile.startswith(("ANGELEGT", "WUERDE ANGELEGT")):
            ausgerollt.append((zeile.split(": ", 1)[0].split()[-1], "Skill-Link"))
            print("  %s" % zeile)
