HUB_LABEL = "agent-workbench.wb-hub"
HUB_UNITS = ("wb-hub.socket", "wb-hub.service")


def _hub_plattform():
    """'mac' oder 'linux'. WB_AUSROLLEN_PLATTFORM nur fuer Tests (Sandbox prueft beide Zweige)."""
    roh = os.environ.get("WB_AUSROLLEN_PLATTFORM")
    if roh in ("mac", "linux"):
        return roh
    return "mac" if sys.platform == "darwin" else "linux"


def _hub_befehl(argv, trocken):
    """Fuehrt einen Dienstbefehl aus; im Trockenlauf nur nennen. -> Exit (0 im Trockenlauf)."""
    print("    %s%s" % ("(trocken) " if trocken else "$ ", " ".join(argv)))
    if trocken:
        return 0
    try:
        return subprocess.run(argv, timeout=60).returncode
    except (OSError, subprocess.SubprocessError) as fehler:
        print("    Aufruf scheiterte: %s" % fehler, file=sys.stderr)
        return 1


def _hub_teil(repo, base, lauf_id, trocken, laden, ausgerollt):
    """Hub-Dienst (Spur H2, werkzeug-hub-entwurf 2.4): Einheiten ausliefern, Zustandsordner anlegen und --
    nur mit ausdruecklichem --hub-laden -- laden.

    Mac: die plist rollt der allgemeine Vergleich (install_map *.plist -> ~/Library/LaunchAgents) wie die
    des modell-proxy; hier kommt nur der Zustandsordner dazu, den launchd vor dem Start fuers Log braucht.
    Linux: die Units (shell/systemd/, aus install_map ausgenommen) gehen nach ~/.config/systemd/user.
    Geladen wird NIE ohne --hub-laden. Rueckgabe: Zahl gescheiterter Dienstbefehle."""
    plattform = _hub_plattform()
    shell = os.path.join(repo, "shell")
    zustand = os.path.join(base, ".local", "state", "wb-hub")
    geaendert = False
    fehler = 0
    if plattform == "mac":
        quelle = os.path.join(shell, "agent-workbench.wb-hub.plist")
        ziel = os.path.join(base, "Library", "LaunchAgents", "agent-workbench.wb-hub.plist")
        if not os.path.isfile(quelle):
            return 0
        print("  -- Hub-Dienst (launchd) --")
        bytes_gleich = False
        try:
            with open(quelle, "rb") as q, open(ziel, "rb") as z:
                bytes_gleich = q.read() == z.read()
        except OSError:
            pass
        geaendert = not bytes_gleich
        if not trocken:
            os.makedirs(zustand, mode=0o700, exist_ok=True)
        print("  Zustandsordner %s%s" % (zustand, " (wuerde angelegt)" if trocken and not os.path.isdir(zustand) else ""))
        print("  plist %s: %s" % (ziel, "gleich" if bytes_gleich else
                                  "wird vom allgemeinen Vergleich ausgerollt (oder liegt deaktiviert)"))
    else:
        quellen = [(n, os.path.join(shell, "systemd", n)) for n in HUB_UNITS]
        if not all(os.path.isfile(q) for _, q in quellen):
            return 0
        print("  -- Hub-Dienst (systemd --user) --")
        unitdir = os.path.join(base, ".config", "systemd", "user")
        if not trocken:
            os.makedirs(zustand, mode=0o700, exist_ok=True)
            os.makedirs(unitdir, exist_ok=True)
        for name, q in quellen:
            z = os.path.join(unitdir, name)
            try:
                with open(q, "rb") as qf, open(z, "rb") as zf:
                    if qf.read() == zf.read():
                        print("  %s gleich" % z)
                        continue
            except OSError:
                pass
            if os.path.exists(z):
                _schnappschuss(z, base, lauf_id, trocken)
            _kopieren(q, z, trocken)
            geaendert = True
            ausgerollt.append(("shell/systemd/" + name, "nach %s ausgeliefert" % unitdir))
            print("  shell/systemd/%s %s nach %s" % (name, "wuerde ausgeliefert" if trocken else "ausgeliefert", z))
    if not laden:
        print("  Nicht geladen (Schalter --hub-laden fehlt).")
        return 0
    print("  Laden (--hub-laden):")
    if plattform == "mac":
        domain = "gui/%d" % os.getuid()
        job = "%s/%s" % (domain, HUB_LABEL)
        geladen = False
        if not trocken:
            geladen = subprocess.run(["launchctl", "print", job], capture_output=True).returncode == 0
        if geladen and geaendert:
            fehler += _hub_befehl(["launchctl", "bootout", job], trocken) != 0
            geladen = False
        if not geladen:
            fehler += _hub_befehl(["launchctl", "bootstrap", domain, ziel], trocken) != 0
        else:
            print("    schon geladen, plist unveraendert -- nichts zu tun.")
    else:
        fehler += _hub_befehl(["systemctl", "--user", "daemon-reload"], trocken) != 0
        fehler += _hub_befehl(["systemctl", "--user", "enable", "--now", "wb-hub.socket"], trocken) != 0
        if geaendert:
            fehler += _hub_befehl(["systemctl", "--user", "restart", "wb-hub.socket"], trocken) != 0
    return fehler


FILTER_DIENSTKOPIE = (".local", "share", "wb-geheimnis-filter", "wb-geheimnis-filter")
FILTER_DIENST_FRIST = 240    # Sekunden: bis zu 60 s Warten auf Ruhe, dazu Neustart und Probe


def _filterdienst_teil(repo, base, trocken, ausgerollt):
    """Dienstkopie des Geheimnisfilters gegen den Repo-Stand (siehe FILTER-DIENSTKOPIE oben).
    -> 1 bei gescheitertem Dienstbefehl, sonst 0."""
    quelle = os.path.join(repo, "shell", "wb-geheimnis-filter")
    dienst = os.path.join(repo, "shell", "wb-geheimnis-filter-dienst")
    kopie = os.path.join(base, *FILTER_DIENSTKOPIE)
    if not (os.path.isfile(quelle) and os.path.isfile(dienst)):
        return 0
    print()
    print("  -- Filterdienst (Dienstkopie) --")
    if not os.path.isfile(kopie):
        print("  %s fehlt: Dienst auf dieser Maschine nicht eingerichtet, nichts zu tun "
              "(Einrichten von Hand: shell/wb-geheimnis-filter-dienst installieren)." % kopie)
        return 0
    marke = os.path.join(os.path.dirname(kopie), "neustart-offen")
    gleich = filecmp.cmp(quelle, kopie, shallow=False)
    # Die Routentabelle verlangt der Filter neben sich (08.11.2026): fehlt sie neben der Kopie, ist die Kopie nicht gleich.
    q = os.path.join(repo, "shell", "geheimnis-routen.json")
    neben = os.path.join(os.path.dirname(kopie), "geheimnis-routen.json")
    gleich = gleich and (not os.path.isfile(q) or (os.path.isfile(neben) and filecmp.cmp(q, neben, shallow=False)))
    if gleich and not os.path.exists(marke):
        print("  Dienstkopie gleich dem Repo-Stand.")
        return 0
    argv = ["bash", dienst, "installieren", "--wenn-ruhig"]
    ausgerollt.append(("shell/wb-geheimnis-filter", "Dienstkopie %s" % kopie))
    if gleich:
        print("  Dienstkopie gleich, aber Neustart nicht belegt (Marke %s): ein frueherer Lauf endete vor dem Neustart." % marke)
    else:
        print("  Dienstkopie weicht vom Repo-Stand ab: %s" % kopie)
    print("    %s%s" % ("(trocken) " if trocken else "$ ", " ".join(argv[1:])))
    if trocken:
        return 0
    try:
        p = subprocess.run(argv, capture_output=True, text=True, timeout=FILTER_DIENST_FRIST,
                           env=dict(os.environ, HOME=base))
    except (OSError, subprocess.SubprocessError) as fehler:
        print("  Filterdienst: Aufruf scheiterte: %s" % fehler, file=sys.stderr)
        return 1
    for zeile in p.stdout.splitlines():
        print("    %s" % zeile)
    if p.returncode != 0:
        print("  Filterdienst: installieren Exit %d: %s" % (p.returncode, p.stderr.strip()), file=sys.stderr)
        return 1
    return 0


def _skills_teil(wc, c7, base, trocken, ausgerollt):
