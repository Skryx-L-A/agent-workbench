def _lade_wb_consistency():
    # wb-consistency traegt keine .py-Endung (es ist selbst ein ausfuehrbares
    # Skript, kein Modul) -- `spec_from_file_location` findet dafuer OHNE
    # expliziten Loader keinen passenden und liefert None zurueck (gemessen:
    # "AttributeError: 'NoneType' object has no attribute 'loader'"). Ein
    # SourceFileLoader von Hand umgeht die Endungserkennung.
    pfad = os.path.join(os.path.dirname(os.path.abspath(__file__)), "wb-consistency")
    loader = importlib.machinery.SourceFileLoader("wb_consistency", pfad)
    spec = importlib.util.spec_from_loader("wb_consistency", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


# Heimat fuer den Menschen-Nachweis (18.10.2026, Befund pathklasse-sicher OPEN 2): wb-mensch kommt
# aus der Heimat laut Benutzerdatenbank und laeuft mit HOME=<diese Heimat>, nie aus $HOME. Ein
# umgelenktes HOME mit eigener wb-mensch-Attrappe (exit 0) galt sonst als Mensch. Testnaht: nur
# mit WB_TESTUMGEBUNG=1 gilt das HOME der Umgebung. GRENZE: wer beides setzt, umgeht das; die
# getippte Form sperrt bash-guard (heim-umlenkung).
def _mensch_heim():
    if os.environ.get("WB_TESTUMGEBUNG") == "1" and os.environ.get("HOME"):
        return os.environ["HOME"]
    try:
        import pwd
        return pwd.getpwuid(os.getuid()).pw_dir
    except (ImportError, KeyError):
        return ""


def _wb_mensch_pfad():
    """Woher `wb-mensch` kommt -- die Heimat laut Benutzerdatenbank (_mensch_heim),
    NICHT --base: --base ist die Vorlage fuer wb-consistencys install_map-Templating
    (siehe dortiger Kopfkommentar), kein Umlenkziel fuer Systemwerkzeuge. Ein Test,
    der HIER umlenken will, setzt HOME und WB_TESTUMGEBUNG=1."""
    heim = _mensch_heim()
    p = os.path.join(heim, ".local", "bin", "wb-mensch") if heim else ""
    return p if p and os.access(p, os.X_OK) else None


def _wb_mensch_env():
    return {"HOME": _mensch_heim(),
            "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin",
            "TMPDIR": "/tmp"}


def _test_aufrufer_rolle():
    """Return a runner-declared role only with the private setup proof.

    This is deliberately not a product switch: an environment value by itself
    is ignored, and without a valid proof the live wb-mensch measurement below
    remains authoritative.
    """
    # Nur in der Testumgebung (18.10.2026): der Beleg liegt unter $HOME, und ein umgelenktes
    # HOME mit eigenem 0700-Ordner und Beleg hob sonst den Riegel auf.
    if os.environ.get("WB_TESTUMGEBUNG") != "1":
        return None
    role = os.environ.get("WB_TEST_AUFRUFER_ROLLE")
    raw_path = os.environ.get("WB_TEST_AUFBAU_BELEG")
    raw_home = os.environ.get("HOME")
    if role not in ("agent", "mensch") or not raw_path or not raw_home:
        return None
    if not os.path.isabs(raw_path) or not os.path.isabs(raw_home):
        return None
    try:
        home_real = os.path.realpath(raw_home)
        path_real = os.path.realpath(raw_path)
        if os.path.islink(raw_path) or path_real == home_real \
                or os.path.commonpath((home_real, path_real)) != home_real:
            return None
        home_info = os.stat(home_real)
        if not stat.S_ISDIR(home_info.st_mode) or home_info.st_uid != os.getuid() \
                or stat.S_IMODE(home_info.st_mode) != 0o700:
            return None
        descriptor = os.open(raw_path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
        try:
            info = os.fstat(descriptor)
            if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() \
                    or stat.S_IMODE(info.st_mode) != 0o600 \
                    or info.st_size < 32 or info.st_size > 4096:
                return None
            content = os.read(descriptor, 4097)
        finally:
            os.close(descriptor)
    except (OSError, ValueError):
        return None
    return role if len(content) == info.st_size else None


def _ist_mensch():
    """True = ein Mensch ruft, gemessen von wb-mensch (unforgebar, siehe dessen
    eigener Kopfkommentar). Faellt wb-mensch aus -- Werkzeug fehlt, Absturz,
    Zeitueberschreitung --, ist die Antwort False: die sichere Seite fuer einen
    Riegel ist "kein Mensch bewiesen", nie "im Zweifel durchlassen"."""
    test_role = _test_aufrufer_rolle()
    if test_role is not None:
        return test_role == "mensch"
    pfad = _wb_mensch_pfad()
    if not pfad:
        return False
    try:
        return subprocess.run([pfad, "pruefen"], timeout=10, env=_wb_mensch_env()).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def _wb_mensch_beleg():
    test_role = _test_aufrufer_rolle()
    if test_role is not None:
        return "private Test-Aufbaubeleg-Rolle '%s'" % test_role
    pfad = _wb_mensch_pfad()
    if not pfad:
        return "wb-mensch nicht gefunden"
    try:
        aus = subprocess.run([pfad, "beleg"], capture_output=True, text=True,
                             timeout=10, env=_wb_mensch_env()).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return "kein Beleg"
    teile = aus.split("\t", 1)
    return teile[1] if len(teile) > 1 else (aus or "kein Beleg")


