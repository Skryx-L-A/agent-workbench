            print("  %s" % zeile, file=sys.stderr)
    if p.returncode not in (0, 1) and p.stderr.strip():
        print("  Skills: %s" % p.stderr.strip(), file=sys.stderr)
    return 0 if p.returncode == 0 else 1


def _anweisungen_teil(wc, c7, base, trocken, ausgerollt):
    """Fester Schritt nach Dateien, Skills und Registry (Review task, Fund 1): `wb-instructions sync`
    schreibt den Volltext in die Router-Dateien der Harnesses (systemPrompt.path, pi: ~/.pi/agent/AGENTS.md)
    und verteilt die Werkbank-Skills in die uebrigen skillRoots. Ohne ihn fehlte der Volltext dort bis zu
    einem Handlauf; pi-worker und wb-harness-run pruefen die Router-Datei und fallen dann auf Lesezeile bzw.
    Rollenblock zurueck. Gleich auf Mac und peer (beide rollen mit wb-ausrollen aus). Im Trockenlauf die
    Repo-Fassung mit --dry-run (nichts geschrieben), sonst die installierte. Konflikte (Handaenderung in
    einer erzeugten Datei) ueberschreibt wb-instructions nie; sie faerben den Exit.
    -> 1 bei Fehler, sonst 0."""
    repo_tool = os.path.join(c7["repo_dir"], "shell", "wb-instructions")
    bin_dir = wc._ziel_fuer("shell/wb-instructions", "wb-instructions", c7)
    inst_tool = os.path.join(bin_dir, "wb-instructions") if bin_dir else None
    tool = repo_tool if trocken or not (inst_tool and os.path.isfile(inst_tool)) else inst_tool
    if not os.path.isfile(tool):
        return 0
    print()
    print("  -- Anweisungen der Harnesses (wb-instructions sync%s) --" % (" --dry-run" if trocken else ""))
    if not os.path.isfile(os.path.join(base, ".claude", "CLAUDE.md")):
        print("  Anweisungen: entfaellt, %s/.claude/CLAUDE.md fehlt (keine Quelle)" % base)
        return 0
    env = dict(os.environ, HOME=base)
    env.pop("WB_WERKZEUGE_REGISTRY", None)
    try:
        p = subprocess.run([sys.executable, tool, "sync"] + (["--dry-run"] if trocken else []),
                           capture_output=True, text=True, timeout=120, env=env)
    except (OSError, subprocess.SubprocessError) as fehler:
        print("  Anweisungen: wb-instructions nicht aufrufbar: %s" % fehler, file=sys.stderr)
        return 1
    for zeile in p.stdout.splitlines():
        teile = zeile.split()
        if len(teile) < 3 or teile[0] == "HARNESS/ZIEL" or teile[1] in ("unchanged", "role-injection", "gesperrt"):
            continue
        ausgerollt.append((teile[-1], "wb-instructions sync: %s" % teile[1]))
        print("  %s%s" % ("WUERDE " if trocken else "", zeile))
    if p.returncode != 0:
        print("  Anweisungen: wb-instructions sync Exit %d: %s" % (p.returncode, p.stderr.strip()), file=sys.stderr)
        return 1
    return 0


def _spiegelpruefung(repo, ziel_bin):
    """Ruft nach dem Ausrollen shell/tests/test-belegung-spiegel.sh --nach-ausrollen --ziel-bin <ziel_bin> auf.
    Rueckgabe: None = nichts zu pruefen (Suite oder Quelle fehlt im Arbeitsbaum), sonst (exit, ausgabe).

    Anlass (20.11.2026): Die Suite laesst zwischen Merge und Ausrollen eine fruehere Fassung als BEFUND gelten
    (Ausrollen steht aus). Dieses Werkzeug ist der Schritt, der den Befund beendet; hier gilt darum nur noch
    byte-gleich. Geprueft wird der Spiegel im ZIELHEIM dieses Ausrollens (<base>/.local/bin), nie stets $HOME.
    WB_SPIEGEL_BIN und WB_TESTUMGEBUNG bekommt das Kind nicht: --ziel-bin allein bestimmt den Ort."""
    suite = os.path.join(repo, "shell", "tests", "test-belegung-spiegel.sh")
    if not os.path.isfile(suite) or not os.path.isfile(os.path.join(repo, "shell", "wb-belegung")):
        return None
    env = {k: v for k, v in os.environ.items() if k not in ("WB_SPIEGEL_BIN", "WB_TESTUMGEBUNG")}
    try:
        p = subprocess.run(["/bin/bash", suite, "--nach-ausrollen", "--ziel-bin", ziel_bin],
                           capture_output=True, text=True, timeout=60, env=env)
    except (subprocess.TimeoutExpired, OSError) as exc:
        return (SPIEGELPRUEFUNG_EXIT, "Spiegelpruefung nicht lauffaehig: %s" % exc)
    return (p.returncode, (p.stdout + p.stderr).strip())


