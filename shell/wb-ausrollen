TESTMARKE_ZEILE = "wb-testumgebung: Testheimat, Ausrollen dieses Stands erlaubt"


def _db_heim():
    try:
        import pwd
        return pwd.getpwuid(os.getuid()).pw_dir
    except (ImportError, KeyError):
        return ""


def _echte_heime():
    heime = {os.path.realpath(h) for h in (_db_heim(),) if h}
    if os.environ.get("WB_TESTUMGEBUNG") == "1" and os.environ.get("HOME"):
        heime.add(os.path.realpath(os.environ["HOME"]))
    return heime


def _ueber_ssh():
    """True, wenn ein Vorfahr dieses Prozesses sshd* oder mosh-server ist; im Zweifel True (fail closed)."""
    pid, gesehen = os.getppid(), set()
    try:
        while pid > 1 and pid not in gesehen and len(gesehen) < 64:
            gesehen.add(pid)
            aus = subprocess.run(["ps", "-o", "ppid=,comm=", "-p", str(pid)], capture_output=True,
                                 text=True, timeout=5).stdout.strip().split(None, 1)
            if len(aus) != 2:
                return True
            name = os.path.basename(aus[1].strip())
            if name.startswith("sshd") or name == "mosh-server":
                return True
            pid = int(aus[0])
    except (OSError, ValueError, subprocess.SubprocessError):
        return True
    return False


def _testmarke_gueltig(heim):
    try:
        fd = os.open(os.path.join(heim, TESTMARKE), os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:
        return False
    try:
        info = os.fstat(fd)
        if not (stat.S_ISREG(info.st_mode) and info.st_nlink == 1 and info.st_uid == 0
                and not stat.S_IMODE(info.st_mode) & 0o022):
            return False
        return os.read(fd, 4096).decode("utf-8", "replace").split("\n", 1)[0] == TESTMARKE_ZEILE
    except OSError:
        return False
    finally:
        os.close(fd)


def _quellschutz_grund(repo):
    """None = die Quelle ist der ausgerollte main-Stand; sonst der Grund in einem Satzteil."""
    heim = _db_heim()
    if not heim:
        return "Heimat laut Benutzerdatenbank nicht bestimmbar"
    pi = os.path.realpath(os.path.join(heim, ".pi-workers"))
    for p in (os.path.realpath(os.path.abspath(__file__)), os.path.realpath(repo)):
        if p == pi or p.startswith(pi + os.sep):
            return "%s liegt unter %s (Worker-Worktree)" % (p, pi)
    env = _git_env()

    def git(*args):
        try:
            return subprocess.run(["git", "-C", repo] + list(args), capture_output=True, text=True,
                                  timeout=10, env=env).stdout.strip()
        except (OSError, subprocess.SubprocessError):
            return ""
    gd = git("rev-parse", "--path-format=absolute", "--git-dir")
    if not gd:
        return "Quellbaum %s ist kein git-Baum" % repo
    if gd != git("rev-parse", "--path-format=absolute", "--git-common-dir"):
        return "Quellbaum %s ist ein git-Worktree, nicht der Hauptbaum" % repo
    kopf = git("rev-parse", "-q", "--verify", "HEAD")
    haupt = git("rev-parse", "-q", "--verify", "refs/heads/main")
    if not kopf or kopf != haupt:
        return "HEAD %s in %s ist nicht main (%s), der ausgerollte Stand" % (kopf[:12], repo, haupt[:12])
    return None


def _git_env():
    return {k: v for k, v in os.environ.items()
            if k not in ("GIT_DIR", "GIT_WORK_TREE", "GIT_COMMON_DIR", "GIT_INDEX_FILE")}


def _unsauber_grund(wc, repo, c7, zusatz=()):
    """(c): None = keine uncommittete Aenderung an einem Pfad, der ausgerollt wuerde; sonst der Grund.
    Ausgerollt heisst: ein Fall von wc.kopie_vergleiche (dieselbe Berechnung wie das Ausrollen selbst),
    dazu `zusatz` (repo-relative Pfade, die ein Aufrufer direkt aus dem Repo kopiert). Ungetrackte Dateien
    zaehlen, von .gitignore erfasste nicht. Ist etwas nicht bestimmbar, ist das ein Grund (fail closed)."""
    pfade = set(zusatz)
    if c7:
        try:
            pfade |= {f["rel"] for f in wc.kopie_vergleiche(c7)}
        except Exception as e:  # noqa: BLE001 -- jede Ausnahme heisst hier: nicht bestimmbar
            return "ausgerollte Pfade nicht bestimmbar (%s)" % e
    if not pfade:
        return None
    try:
        p = subprocess.run(["git", "-C", repo, "status", "--porcelain=v1", "-z", "--untracked-files=all",
                            "--no-renames"], capture_output=True, timeout=60, env=_git_env())
    except (OSError, subprocess.SubprocessError):
        p = None
    if p is None or p.returncode != 0:
        return "git status in %s nicht lesbar" % repo
    treffer = sorted({e[3:] for e in p.stdout.decode("utf-8", "surrogateescape").split("\0")
                      if len(e) > 3} & pfade)
    if not treffer:
        return None
    return "uncommittete Aenderung an %d ausgerolltem Pfad(en) in %s: %s%s" % (
        len(treffer), repo, ", ".join(treffer[:5]), " ..." if len(treffer) > 5 else "")


def _quellschutz_lage(wc, repo, base, trocken, c7):
    """None = der Schutz greift nicht (--dry-run, keine echte Heimat, Testmarke) oder die Quelle ist sauber;
    sonst (ziel, grund)."""
    ziel = os.path.realpath(base)
    if trocken or ziel not in _echte_heime() or _testmarke_gueltig(ziel):
        return None
    grund = _quellschutz_grund(repo) or _unsauber_grund(wc, repo, c7)
    return (ziel, grund) if grund else None


def _quellschutz(lage, ueber_ssh):
    """True = abgewiesen (Exit 6), siehe DER QUELLSCHUTZ. Ueber ssh fuer jeden, lokal nur fuer einen Agenten."""
    if lage is None:
        return False
    ziel, grund = lage
    if ueber_ssh:
        print("wb-ausrollen: ABGEWIESEN -- Ausrollen ueber ssh nach %s nur aus dem Hauptbaum auf main: %s."
              % (ziel, grund), file=sys.stderr)
        return True
    if _ist_mensch():
        print("wb-ausrollen: WARNUNG -- Ausrollen in die echte Heimat %s nicht aus dem sauberen Hauptbaum "
              "auf main: %s. Ausgerollt wird trotzdem, weil hier ein Mensch entscheidet -- ein Agent waere "
              "hier abgewiesen worden." % (ziel, grund), file=sys.stderr)
        return False
