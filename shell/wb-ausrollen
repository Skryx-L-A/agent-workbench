                  file=sys.stderr)
            return 1

        c3 = cfg.get("check3_dangling_refs") or {}
        machine_tool_map = c3.get("machine_tool_map", {})
        current_machine = wc.current_machine_id(c3.get("machine_ids_by_os", {}))

        # Missing *.default.json templates are intentionally omitted by
        # kopie_vergleiche: they normally belong to setup, not ~/.local/bin.
        # Two exceptions, each read beside an installed COPY of its tool:
        # wb-state reads models.default.json to retain shipped family bans, and
        # wb-tafel (2026-10-09) reads tafel-plaetze.default.json whenever the live
        # file ~/.claude/workbench/tafel-plaetze.json is missing -- without either
        # it stops with exit 5. The live file itself is never written here.
        # werkzeuge.default.json (2026-10-13) is the source wb-werkzeuge and
        # wb-mcp-start read beside their installed copy; once present, the
        # ordinary copy comparison keeps it current.
        # geheimnis-routen.json (2026-11-08): die eingebauten Routen, ohne die wb-geheimnis-filter nicht startet.
        for vorlage, werkzeug in (("models.default.json", "wb-state"),
                                  ("tafel-plaetze.default.json", "wb-tafel"),
                                  ("werkzeuge.default.json", "wb-werkzeuge"),
                                  ("geheimnis-routen.json", "wb-geheimnis-filter")):
            template = os.path.join(c7["repo_dir"], "shell", vorlage)
            script_dir = wc._ziel_fuer("shell/" + werkzeug, werkzeug, c7)
            if script_dir and os.path.isfile(template):
                installed_template = os.path.join(script_dir, vorlage)
                if not os.path.exists(installed_template):
                    _kopieren(template, installed_template, a.dry_run)
                    ausgerollt.append(("shell/" + vorlage, "Vorlage neben %s installiert" % werkzeug))
                    print("  shell/%s NEU installiert nach %s" % (vorlage, installed_template))

        # wb-geheimnis-filter-dienst wird als Kopie nach ~/.local/bin gelegt,
        # benoetigt beim Aufruf dort aber auch seine launchd-Vorlage neben sich.
        # Die plist gehoert weiterhin zum normalen Installationsziel unter
        # ~/Library/LaunchAgents; diese zweite Kopie ist nur die Eingabequelle
        # fuer den Installer. Anders als *.default.json muss sie bei Aenderungen
        # aktualisiert werden, damit ein kopiertes Werkzeug keinen alten Stand nutzt.
        plist = os.path.join(c7["repo_dir"], "shell", "agent-workbench.geheimnis-filter.plist")
        werkzeug_dir = wc._ziel_fuer("shell/wb-geheimnis-filter-dienst",
                                     "wb-geheimnis-filter-dienst", c7)
        if werkzeug_dir and os.path.isfile(plist):
            installed_plist = os.path.join(werkzeug_dir, "agent-workbench.geheimnis-filter.plist")
            gleicher_inhalt = False
            try:
                with open(plist, "rb") as quelle, open(installed_plist, "rb") as ziel:
                    gleicher_inhalt = quelle.read() == ziel.read()
            except OSError:
                pass
            if not gleicher_inhalt:
                if os.path.exists(installed_plist):
                    _schnappschuss(installed_plist, a.base, lauf_id, a.dry_run)
                _kopieren(plist, installed_plist, a.dry_run)
                ausgerollt.append(("shell/agent-workbench.geheimnis-filter.plist",
                                   "Vorlage neben wb-geheimnis-filter-dienst installiert"))
                print("  shell/agent-workbench.geheimnis-filter.plist NEU installiert nach %s" %
                      installed_plist)

        for fall in wc.kopie_vergleiche(c7, machine_tool_map, current_machine):
            status = fall["status"]
            if fall["rel"] == "shell/wb-belegung" and status != "andere_maschine":
                # Ein Fall "gleich" traegt keinen inst_datei; die Karte schickt shell/ nach <base>/.local/bin.
                spiegel_ziel = (os.path.dirname(fall["inst_datei"]) if fall.get("inst_datei")
                                else os.path.join(a.base, ".local", "bin"))
            if status in ("gleich", "andere_maschine"):
                continue
            if status == "fehlt":
                name = os.path.basename(fall["inst_datei"])
                deakt = None if a.trotz_deaktivierung else _deaktiviert_pfad(name, a.base)
                if deakt:
                    warum = ("liegt unter %s -- bewusst abgeschaltet (LaunchAgents-"
                              "Aufraeumung 2026-08-22), kein Versehen. Zurueckholen: "
                              "diese Datei dort loeschen, oder wb-ausrollen mit "
                              "--trotz-deaktivierung erneut aufrufen." % deakt)
                    deaktiviert.append((fall["rel"], "deaktiviert", warum))
                    print("  %s UEBERSPRUNGEN (bewusst abgeschaltet: %s)" % (fall["rel"], warum))
                    continue
                _kopieren(fall["repo_datei"], fall["inst_datei"], a.dry_run)
                ausgerollt.append((fall["rel"], "neu installiert (lag noch nicht vor)"))
                print("  %s NEU installiert nach %s" % (fall["rel"], fall["inst_datei"]))
                continue
            # status == "verschieden"
            richtung, warum = fall["richtung"], fall["warum"]
            if richtung == "veraltet":
                name = os.path.basename(fall["inst_datei"])
                deakt = None if a.trotz_deaktivierung else _deaktiviert_pfad(name, a.base)
                if deakt:
                    warum = ("liegt unter %s -- bewusst abgeschaltet (LaunchAgents-"
                              "Aufraeumung 2026-08-22), kein Versehen. Zurueckholen: "
                              "diese Datei dort loeschen, oder wb-ausrollen mit "
                              "--trotz-deaktivierung erneut aufrufen." % deakt)
                    deaktiviert.append((fall["rel"], "deaktiviert", warum))
                    print("  %s UEBERSPRUNGEN (bewusst abgeschaltet: %s)" % (fall["rel"], warum))
                    continue
                schnappschuss = _schnappschuss(fall["inst_datei"], a.base, lauf_id, a.dry_run)
                _kopieren(fall["repo_datei"], fall["inst_datei"], a.dry_run)
                ausgerollt.append((fall["rel"], warum))
                print("  %s %sausgerollt (%s) — Schnappschuss: %s"
                      % (fall["rel"], "WUERDE " if a.dry_run else "", warum, schnappschuss))
            elif richtung == "worktree_unpruefbar":
                # NICHT in uebersprungen (2026-08-22): ein Worktree deployt nach
                # ~/.local/bin/~/.claude/hooks ohnehin nie (siehe wb-consistency,
                # ist_worktree()) -- diese Zeile ist sichtbar, zaehlt aber nicht als
                # Fund, sonst waere jeder Lauf aus einem Worker-Worktree dauerhaft
                # "uebersprungen (eigenmaechtig/unklar)", ohne dass irgendetwas zu
                # pruefen waere.
                print("  %s WORKTREE -- Vergleich von hier bedeutungslos: %s" % (fall["rel"], warum))
            else:
                grund = ("traegt eigene, im Repo unbekannte Aenderungen" if richtung == "eigenmaechtig"
                         else "Richtung nicht bestimmbar")
                uebersprungen.append((fall["rel"], richtung, warum))
                print("  %s UEBERSPRUNGEN (%s: %s) — von Hand pruefen." % (fall["rel"], grund, warum))

    # Git-Hook-Symlinks (git_hook_links in der Konfiguration): install_map kopiert nur
    # Dateien, die Hook-Namen unter ~/.claude/git-hooks sind aber Links auf _verteiler.
    # Fehlendes wird angelegt (atomar: Link unter Nebennamen, dann umbenennen); ein
    # vorhandener Nicht-Link oder Link mit anderem Ziel wird nie angefasst, nur gemeldet.
    if c7:
        for fall in wc.git_hook_link_faelle(c7):
            if fall["status"] == "gleich":
                continue
            rel = os.path.relpath(fall["pfad"], a.base)
            if fall["status"] == "falsch":
                uebersprungen.append((rel, "hook-link-falsch",
                                      "kein Symlink auf %s" % fall["ziel"]))
                print("  %s UEBERSPRUNGEN (hook-link-falsch: kein Symlink auf %s) — von Hand pruefen."
                      % (rel, fall["ziel"]))
                continue
            if not a.dry_run:
                tmp = "%s.wbtmp-%d" % (fall["pfad"], os.getpid())
                os.symlink(fall["ziel"], tmp)
                os.replace(tmp, fall["pfad"])
            ausgerollt.append((rel, "Symlink auf %s angelegt" % fall["ziel"]))
            print("  %s NEU verlinkt auf %s" % (rel, fall["ziel"]))

    # Root-eigene Kopien (root_kopien, Anlass 14.10.2026: /usr/local/bin/wb-gast-tor auf
    # peer stand still, waehrend ~/.local/bin den Fix trug). Dieses Werkzeug schreibt sie
    # nie und ruft kein sudo -- es meldet laut, nennt den Befehl und faerbt den Exit-Code.
    if c7:
        for fall in wc.root_kopie_faelle(c7):
            if fall["status"] != "verschieden":
                continue
            uebersprungen.append((fall["ziel"], "root-kopie-veraltet", fall["warum"]))
            zeile = ("  %s UEBERSPRUNGEN (root-kopie-veraltet: %s weicht vom Repo-Stand ab) — "
                     "von Hand: %s" % (fall["rel"], fall["ziel"], wc.root_kopie_befehl(fall)))
            print(zeile)
            print("wb-ausrollen: WARNUNG --" + zeile[1:], file=sys.stderr)

    hub_fehler = skill_fehler = filter_fehler = 0
    if c7:
        hub_fehler = _hub_teil(c7["repo_dir"], a.base, lauf_id, a.dry_run, a.hub_laden, ausgerollt)
        skill_fehler = _skills_teil(wc, c7, a.base, a.dry_run, ausgerollt)
        filter_fehler = _filterdienst_teil(c7["repo_dir"], a.base, a.dry_run, ausgerollt)

    # Konfigurations-Vorlagen fuer fremde Harnesses (crush/nanocoder/cline/
    # forge, siehe check9_harness_konfig in wb-consistency.config.json): dieselbe
    # FEHLT/VERALTET/ABGEWICHEN-Unterscheidung, aber ein ANDERES Werkzeug traegt
    # sie schon (shell/wb-harness-config, eigener Merkposten statt Git-Historie,
    # weil das Ziel oft gar nicht in einem Repo liegt). Aufgerufen wird 'apply'
    # selbst -- nicht seine Kopierlogik hier nachgebaut -- und sein Ergebnis
    # zaehlt in DIESELBE ausgerollt/uebersprungen-Summe, damit ein einziger
    # Bericht entsteht statt zwei getrennter.
    c9 = cfg.get("check9_harness_konfig")
    if c9 and os.path.isfile(c9.get("skript", "")):
        vorher = wc.harness_konfig_befunde(c9, a.base) or []
        offene = [r for r in vorher if r.get("status") != "GLEICH"]
        if offene:
            print()
            print("  -- Konfigurations-Vorlagen fuer fremde Harnesses (wb-harness-config) --")
        if a.dry_run:
            for r in offene:
                status = r.get("status")
                if status in ("FEHLT", "VERALTET"):
                    ausgerollt.append((r.get("target", "?"), r.get("detail", "")))
                    print("  WUERDE %s: %s" % (r.get("target", "?"), r.get("detail", "")))
                else:
                    uebersprungen.append((r.get("target", "?"), status.lower(), r.get("detail", "")))
                    print("  WUERDE UEBERSPRINGEN %s (%s)" % (r.get("target", "?"), r.get("detail", "")))
        elif offene:
            env = dict(os.environ)
            env["HOME"] = a.base
            env["WB_HARNESS_CONFIG_SRC"] = c9.get("quelle_verzeichnis", "")
            try:
                p = subprocess.run([sys.executable, c9["skript"], "apply"],
                                   capture_output=True, text=True, timeout=30, env=env)
                for zeile in p.stdout.splitlines():
                    print("  [wb-harness-config] %s" % zeile)
                if p.stderr.strip():
                    print("  [wb-harness-config] %s" % p.stderr.strip())
            except (subprocess.TimeoutExpired, OSError) as exc:
                print("  wb-harness-config nicht aufrufbar: %s" % exc)
            for r in offene:
                status = r.get("status")
                if status in ("FEHLT", "VERALTET"):
                    ausgerollt.append((r.get("target", "?"), r.get("detail", "")))
                else:
                    uebersprungen.append((r.get("target", "?"), status.lower(), r.get("detail", "")))

    # Fehlende Registry-Daten werden aus der Vorlage ausschliesslich additiv
    # nachgezogen. Der Plan kommt aus wb-consistency: dessen REGISTRY-FEHLT-
    # Hinweis und dieser Schreibweg benutzen dieselbe Berechnung.
    if c7:
        for plan in wc.registry_nachzug_plaene(c7):
            schnappschuss = None
            if not a.dry_run:
                schnappschuss = _schnappschuss(plan["lebend_datei"], a.base, lauf_id, False)
                modus = stat.S_IMODE(os.stat(plan["lebend_datei"]).st_mode)
                atomar_schreiben.schreiben(
                    plan["lebend_datei"],
                    json.dumps(plan["nachzug"], ensure_ascii=False, indent=2) + "\n",
                    modus=modus, dauerhaft=True)
            for pfad_text in plan["ergaenzungen"]:
                ausgerollt.append(("%s.%s" % (plan["name"], pfad_text),
                                   "fehlte in der lebenden Registry"))
                zusatz = " — Schnappschuss: %s" % schnappschuss if schnappschuss else ""
                print("  NEU in Registry: %s%s" % (pfad_text, zusatz))

    # Registry-Abweichungen (registry_vergleiche(), dieselbe Berechnung wie
    # wb-consistencys REGISTRY-ABWEICHUNG-Meldung -- siehe deren Docstring:
    # Sorte E hat KEINE veraltet/eigenmaechtig-Richtung, weil die lebende
    # Registry nachweislich oefter die neuere Seite ist als die Vorlage, nicht
    # umgekehrt. wb-ausrollen kopiert hier deshalb nichts -- jeder Fund landet
    # als Handentscheidung in derselben uebersprungen-Sammlung wie eine
    # eigenmaechtige Kopie oben.
    #
    # Bewusst abweichend (18.10.2026): Ein Feld in registry_ausnahmen ist eine
    # festgehaltene Entscheidung und kein Dauer-Rot. Es zaehlt nur mit Grund in
    # registry_ausnahmen_gruende (Schluessel = derselbe Eintrag wie in
    # registry_ausnahmen); dann steht es als eigene Zeile im Bericht, ohne Exit 1.
    # Ohne Grund bleibt es eine gewoehnliche Abweichung.
    bewusst = []
    if c7:
        registry_funde = wc.registry_vergleiche(c7)
        gruende = c7.get("registry_ausnahmen_gruende") or {}
        offen = {(f["name"], f["liste"], f["eintrag_id"], f["feld"]) for f in registry_funde}
        for fall in wc.registry_vergleiche(dict(c7, registry_ausnahmen=[])):
            if (fall["name"], fall["liste"], fall["eintrag_id"], fall["feld"]) in offen:
                continue
            grund = next((gruende[m] for m in (c7.get("registry_ausnahmen") or [])
                          if gruende.get(m) and wc.registry_ausnahme(
                              {"registry_ausnahmen": [m]}, fall["liste"], fall["eintrag_id"], fall["feld"])),
                         None)
            if grund:
                bewusst.append((fall, grund))
            else:
                registry_funde.append(fall)
        if registry_funde:
            print()
            print("  -- Registry-Abweichungen (Vorlage vs. lebende Registry, von Hand entscheiden) --")
        for fall in registry_funde:
            pfad_text = "%s.%s[%s=%s].%s" % (
                fall["name"], fall["liste"], fall["schluessel"], fall["eintrag_id"], fall["feld"])
            warum = "Vorlage: %s -- lebend: %s" % (
                json.dumps(fall["vorlage_wert"], ensure_ascii=False),
                json.dumps(fall["lebend_wert"], ensure_ascii=False))
            uebersprungen.append((pfad_text, "registry-abweichung", warum))
            print("  %s UEBERSPRUNGEN (registry-abweichung: %s) — von Hand pruefen."
                  % (pfad_text, warum))
        if bewusst:
            print()
            print("  -- Registry bewusst abweichend (registry_ausnahmen mit Grund, kein Fehler) --")
        for fall, grund in bewusst:
            print("  %s.%s[%s=%s].%s BEWUSST ABWEICHEND (%s)" % (
                fall["name"], fall["liste"], fall["schluessel"], fall["eintrag_id"], fall["feld"], grund))

    # Anweisungen erst jetzt: Dateien (wb-instructions, wb-anweisung), Skill-Links und die Registry-
    # Ergaenzungen stehen, und genau daraus erzeugt wb-instructions die Router-Dateien.
    anweisungs_fehler = _anweisungen_teil(wc, c7, a.base, a.dry_run, ausgerollt) if c7 else 0

    # Fremd-Kopien (Sorte D, wb-consistency: fremd_kopien_befunde()) -- installiert,
    # aber nirgends im Repo bekannt. Anlass (2026-08-22): posttooluse-agent-reach-
    # skin.sh und sessionstart-limit-budget.sh lagen beide monatelang nur unter
    # ~/.claude/hooks, ohne dass ein Lauf das je meldete -- der Kopierschleife oben
    # sieht nur Dateien, die im Repo SCHON stehen; eine Datei, die nie aufgenommen
    # wurde, faellt durch kein Raster davon. Reines Melden, kein Kopieren: die
    # Richtung (ins Repo aufnehmen oder verwerfen) ist eine Handentscheidung.
    if c7:
        for fund in wc.fremd_kopien_befunde(c7, a.base):
            if fund.severity != "error":
                continue
            uebersprungen.append((fund.file, "nicht-im-repo", fund.truth))
            print("  %s UEBERSPRUNGEN (nicht-im-repo: %s) — von Hand pruefen."
                  % (fund.file, fund.truth))

    # Hooks, die installiert UND im Repo bekannt sind, aber nirgends in
    # settings.json registriert (Check 12, wb-consistency: check12_hook_
    # registrierung()) -- "ausgerollt" ist hier keine Zusage ueber "aktiv". Anlass:
    # genau diese Verwechslung war der Anlass fuer diesen ganzen Auftrag.
    hook_funde = wc.check12_hook_registrierung(cfg, a.base)
    if hook_funde:
        print()
        print("  -- Hooks installiert, aber nicht in settings.json registriert --")
    for fund in hook_funde:
        uebersprungen.append((fund.file, "nicht-registriert", fund.truth))
        print("  %s UEBERSPRUNGEN (nicht-registriert: %s) — von Hand pruefen."
              % (fund.file, fund.truth))

    # Spiegelpruefung: erst NACH allem Kopieren, nie bei --dry-run (dort ist nichts ausgerollt, die Pruefung
    # meldete den Rueckstand als Fehler, den dieser Lauf gerade beheben soll).
    spiegel = None
    if spiegel_ziel and not a.dry_run:
        spiegel = _spiegelpruefung(repo, spiegel_ziel)
        if spiegel is not None:
            print()
            if spiegel[0] == 0:
                print("wb-ausrollen: Spiegelpruefung bestanden -- wb-belegung in %s ist byte-gleich mit dem Quelltext."
                      % spiegel_ziel)
            else:
                print("wb-ausrollen: SPIEGELPRUEFUNG GESCHEITERT (Exit %d) -- wb-belegung in %s weicht nach dem "
                      "Ausrollen vom Quelltext ab; der Spiegel traegt nicht den ausgerollten Stand."
                      % (spiegel[0], spiegel_ziel), file=sys.stderr)
                for zeile in spiegel[1].splitlines():
                    print("    | %s" % zeile, file=sys.stderr)

    vorsatz = "WUERDE " if a.dry_run else ""
    print()
    print("wb-ausrollen: %s%d ausgerollt, %d uebersprungen (eigenmaechtig/unklar)."
          % (vorsatz, len(ausgerollt), len(uebersprungen)))
    if uebersprungen:
        print("  Von Hand pruefen, dann entweder die installierte Fassung ins Repo "
              "uebernehmen oder die Aenderung dort verwerfen:")
        for rel, richtung, warum in uebersprungen:
            print("    %-40s %-13s %s" % (rel, richtung, warum))
    # Eigene Zeile, eigene Zaehlung, KEIN Exit 1 (Nachbesserung 22.08.2026, siehe
    # Kopfkommentar "deaktiviert"): eine bewusst abgeschaltete plist ist weder
    # eigenmaechtig noch unklar, und der Rat dafuer ("ins Repo uebernehmen oder
    # verwerfen") passt nicht -- es gibt keine installierte Fassung, das ist ja
    # der gewollte Zustand. Der richtige Rat steht schon in der Einzelzeile
    # (Marker loeschen oder --trotz-deaktivierung), hier nur zusammengefasst.
    if deaktiviert:
        print("wb-ausrollen: %s%d uebersprungen (deaktiviert) -- bewusst abgeschaltet, "
              "kein Fehler." % (vorsatz, len(deaktiviert)))
        print("  Gewollt so lassen, oder zurueckholen: Marker-Datei unter "
              "wb-launchagents-deaktiviert loeschen, oder erneut mit "
              "--trotz-deaktivierung aufrufen:")
        for rel, richtung, warum in deaktiviert:
            print("    %-40s %-13s %s" % (rel, richtung, warum))
    if bewusst:
        print("wb-ausrollen: %d Registry-Feld(er) bewusst abweichend -- Entscheidung mit Grund, kein Fehler."
              % len(bewusst))
    if hub_fehler:
        print("wb-ausrollen: %d Hub-Dienstbefehl(e) gescheitert." % hub_fehler, file=sys.stderr)
    if filter_fehler:
        print("wb-ausrollen: Filterdienst nicht erneuert (siehe oben); von Hand: "
              "shell/wb-geheimnis-filter-dienst installieren.", file=sys.stderr)
    if skill_fehler:
        print("wb-ausrollen: Werkbank-Skills nicht vollstaendig angelegt (siehe FEHLER oben).", file=sys.stderr)
    if anweisungs_fehler:
        print("wb-ausrollen: wb-instructions sync nicht sauber (siehe oben); Router-Dateien ohne Volltext "
              "fallen in pi-worker auf die Lesezeile zurueck.", file=sys.stderr)
    if spiegel is not None and spiegel[0] != 0:
        return SPIEGELPRUEFUNG_EXIT
    return 1 if (uebersprungen or hub_fehler or skill_fehler or filter_fehler or anweisungs_fehler) else 0


if __name__ == "__main__":
    sys.exit(main())
