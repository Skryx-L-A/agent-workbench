#!/bin/sh
set -eu
# Fester Interpreter (18.10.2026, Befund devdir-sicher N5): agents_data.py entscheidet ueber
# Antraege, Rechte und Herkunft; ein python3 aus dem PATH des Aufrufers waere ein fremder
# Entscheider. Ohne die xcrun-Variablen, ohne PYTHON*-Variablen und User-site.
unset DEVELOPER_DIR SDKROOT TOOLCHAINS
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# Eine Welt dieser Maschine auf eine Agent-Maschine bringen (agents_weltumzug.py).
if [ "${1:-}" = "umziehen" ]; then
  shift
  exec /usr/bin/python3 -E -s "$SCRIPT_DIR/agents_weltumzug.py" "$@"
fi
# Worktrees und Zweige aufgeloester Agenten entfernen, wenn gemergt (agents_worktree.py); Fernwelten dort selbst.
if [ "${1:-}" = "worktree-aufraeumen" ]; then
  shift
  exec /usr/bin/python3 -E -s "$SCRIPT_DIR/agents_worktree.py" aufraeumen "$@"
fi
# Eine Welt <host>:/pfad liegt verbindlich auf einer anderen Maschine: der ganze Befehl laeuft dort.
for arg in "$@"; do
  case "$arg" in
    [a-z]*:/*)
      if /usr/bin/python3 -E -s "$SCRIPT_DIR/agents_fernweg.py" pruefen welt "$@"; then
        exec /usr/bin/python3 -E -s "$SCRIPT_DIR/agents_fernweg.py" ausfuehren welt "$@"
      fi
      break ;;
  esac
done
if [ "${1:-}" = "antwort" ]; then
  # Nach erfolgreichem Schreiben den Traeger der Welt wecken, falls einer konfiguriert ist.
  status=0
  /usr/bin/python3 -E -s "$SCRIPT_DIR/agents_data.py" welt "$@" || status=$?
  if [ "$status" -eq 0 ]; then
    /usr/bin/python3 -E -s "$SCRIPT_DIR/agents_traeger_wecken.py" welt "$@" || true
  fi
  exit "$status"
fi
exec /usr/bin/python3 -E -s "$SCRIPT_DIR/agents_data.py" welt "$@"
