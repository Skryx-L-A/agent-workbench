class Bestand:
    """Dauerhafte Zaehler seit einem festen Zeitpunkt (Datei zaehler.json im Zustandsordner,
    nur Zahlen). Der Prozess startet bei Zugriff und kann enden; die Summe ueber alle Laeufe
    bleibt. Geschrieben wird nach einer Anfrage hoechstens alle SPEICHERABSTAND Sekunden und
    beim Beenden -- kein eigener Zeitgeber. Ein Absturz verliert hoechstens dieses Fenster."""

    SPEICHERABSTAND = 30.0

    def __init__(self, ordner):
        self.pfad = os.path.join(ordner, 'zaehler.json') if ordner else None
        self._l = threading.Lock()
        self._zuletzt = 0.0
        self.seit = time.strftime('%Y-%m-%dT%H:%M:%S%z')
        self.zaehler, self.latenz = {}, {}
        if not self.pfad:
            return
        os.makedirs(ordner, mode=0o700, exist_ok=True)
        try:
            with open(self.pfad, encoding='utf-8') as f:
                d = json.load(f)
            if isinstance(d.get('seit'), str):
                self.seit = d['seit']
            self.zaehler = {k: v for k, v in (d.get('zaehler') or {}).items()
                            if isinstance(v, (int, float)) and k not in NUR_LAUF}
            for klasse, arten in (d.get('latenz') or {}).items():
                for art, eimer in (arten or {}).items():
                    if isinstance(eimer, list) and len(eimer) == len(EIMER_MS):
                        self.latenz.setdefault(klasse, {})[art] = [int(x) for x in eimer]
        except FileNotFoundError:
            pass
        except Exception:
            # Unlesbar: neu beginnen statt abstuerzen, die alte Datei bleibt daneben liegen.
            try:
                os.replace(self.pfad, self.pfad + '.unlesbar')
            except OSError:
                pass

    def summe(self, z):
        werte, latenz = z.roh()
        zs = dict(self.zaehler)
        for k, v in werte.items():
            if k in NUR_LAUF:
                continue
            zs[k] = max(zs.get(k, 0), v) if k.endswith('_ms_max') else round(zs.get(k, 0) + v, 3)
        ls = {k: {a: list(e) for a, e in v.items()} for k, v in self.latenz.items()}
        for klasse, arten in latenz.items():
            for art, eimer in arten.items():
                ziel = ls.setdefault(klasse, {}).setdefault(art, [0] * len(EIMER_MS))
                for i, c in enumerate(eimer):
                    ziel[i] += c
        return zielhost_begrenzen(zs), ls

    def speichern(self, z, erzwingen=False):
        if not self.pfad:
            return
        jetzt = time.monotonic()
        with self._l:
            if not erzwingen and jetzt - self._zuletzt < self.SPEICHERABSTAND:
                return
            self._zuletzt = jetzt
            zs, ls = self.summe(z)
            tmp = '%s.%d.tmp' % (self.pfad, os.getpid())
            try:
                fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
                with os.fdopen(fd, 'w', encoding='utf-8') as f:
                    json.dump({'seit': self.seit, 'zaehler': zs, 'latenz': ls}, f, sort_keys=True)
                os.replace(tmp, self.pfad)
            except OSError:
                z.plus('zustand_schreibfehler')


SCHLUESSEL_DIENST = 'wb-geheimnis-filter-hmac'
SCHLUESSEL_KONTO = 'platzhalter-v1'


def schluessel_fehler(grund):
    # Niemals Ausnahmetext oder stdout/stderr der Speicherwerkzeuge weitergeben.
    raise SystemExit('wb-geheimnis-filter: Schluesselbund: %s; kein Start (fail-closed). '
                     'Rueckweg: Schluesselbund/Secret Service entsperren und Dienst erneut ansprechen; '
                     'vor Abschalten zuerst alle Harnesses zurueckstellen '
                     '(Claude: ANTHROPIC_BASE_URL und ENABLE_TOOL_SEARCH). '
                     'wb-geheimnis-filter-dienst entfernen prueft die Rueckstellung.' % grund)


def _schluessel_befehl(cmd, eingabe=None):
    try:
        return subprocess.run(cmd, input=eingabe, capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired, UnicodeError):
        schluessel_fehler('Speicherwerkzeug fehlt oder ist nicht erreichbar')


def _security_werkzeug():
    # Eigener Adapter/Attrappe darf ueber PATH oder einen expliziten Pfad kommen.
    tool = shutil.which(os.environ.get('WB_GEHEIMNIS_SECURITY', 'security'))
    if tool is None:
        schluessel_fehler('Speicherwerkzeug fehlt oder ist nicht erreichbar')
    return os.path.realpath(tool)


def _mac_eintrag(keychain):
    """Alter Leseweg fuer Eintraege, die vor dem 03.11.2026 im selben Prozess angelegt wurden: Dialogsperre und
    Zugriff im SELBEN Prozess. Er gelingt nur, solange der Interpreter derselbe ist wie beim Anlegen.

    SecKeychainSetUserInteractionAllowed im Elternprozess sperrt keine Dialoge
    eines security-Kindprozesses. Deshalb ruft _schluessel_lesen security nur, wenn
    die Zugriffsliste es ohne Dialog zulaesst.
    """
    import ctypes
    sec = ctypes.CDLL('/System/Library/Frameworks/Security.framework/Security')
    cf = ctypes.CDLL('/System/Library/Frameworks/CoreFoundation.framework/CoreFoundation')
    pointer = ctypes.c_void_p
    sec.SecKeychainSetUserInteractionAllowed.argtypes = [ctypes.c_bool]
    if sec.SecKeychainSetUserInteractionAllowed(False) != 0:
        schluessel_fehler('Dialogsperre nicht verfuegbar')
    sec.SecKeychainOpen.argtypes = [ctypes.c_char_p, ctypes.POINTER(pointer)]
    sec.SecKeychainFindGenericPassword.argtypes = [pointer, ctypes.c_uint32, ctypes.c_char_p,
        ctypes.c_uint32, ctypes.c_char_p, ctypes.POINTER(ctypes.c_uint32), ctypes.POINTER(pointer), pointer]
    sec.SecKeychainItemFreeContent.argtypes = [pointer, pointer]
    cf.CFRelease.argtypes = [pointer]
    ref = pointer()
    if sec.SecKeychainOpen(os.fsencode(keychain), ctypes.byref(ref)) != 0:
        schluessel_fehler('Keychain nicht erreichbar')
    service, account = SCHLUESSEL_DIENST.encode(), SCHLUESSEL_KONTO.encode()
    try:
        size, data = ctypes.c_uint32(), pointer()
        rc = sec.SecKeychainFindGenericPassword(ref, len(service), service, len(account), account,
                                               ctypes.byref(size), ctypes.byref(data), None)
        value = ''
        if rc == 0:
            try:
                value = ctypes.string_at(data, size.value).decode('ascii')
            except UnicodeError:
                schluessel_fehler('Eintrag hat ein ungueltiges Format; nicht ersetzt')
            finally:
                sec.SecKeychainItemFreeContent(None, data)
        # Gleicher Fehlcode wie security find-generic-password, nur ItemNotFound.
        return subprocess.CompletedProcess([], 44 if rc == -25300 else rc, value, '')
    finally:
        cf.CFRelease(ref)


SECURITY_SYSTEM = '/usr/bin/security'
# Einmaliger Schritt fuer einen Eintrag, den nur ein anderes Programm lesen darf (03.11.2026: Homebrew ersetzte das Python,
# das den Eintrag angelegt hatte). Der Mensch tippt ihn selbst; nie ein Agent, sonst oeffnet er beim Menschen einen Dialog.
SCHRITT_FREIGABE = ('einmalig selbst im Terminal `/usr/bin/security find-generic-password -s %s -a %s -w >/dev/null` '
                    'ausfuehren und "Immer erlauben" mit dem Schluesselbund-Passwort bestaetigen, dann erneut installieren')


def _mac_zugriff_roh(keychain):
    """Zugriffsliste des Eintrags lesen: Dialoge gesperrt, im selben Prozess, OHNE den Wert zu entschluesseln.

    -> None, wenn es den Eintrag nicht gibt; sonst eine Liste (Autorisierungen, App-Pfade oder None fuer jede App,
    Partitionskennungen oder None). Die Daten-Zeiger bleiben NULL: macOS prueft die Zugriffsliste dann nicht.
    """
    import ctypes
    import plistlib
    P = ctypes.c_void_p
    sec = ctypes.CDLL('/System/Library/Frameworks/Security.framework/Security')
    cf = ctypes.CDLL('/System/Library/Frameworks/CoreFoundation.framework/CoreFoundation')
    sec.SecKeychainSetUserInteractionAllowed.argtypes = [ctypes.c_bool]
    if sec.SecKeychainSetUserInteractionAllowed(False) != 0:
        schluessel_fehler('Dialogsperre nicht verfuegbar')
    sec.SecKeychainOpen.argtypes = [ctypes.c_char_p, ctypes.POINTER(P)]
    sec.SecKeychainFindGenericPassword.argtypes = [P, ctypes.c_uint32, ctypes.c_char_p, ctypes.c_uint32,
                                                   ctypes.c_char_p, P, P, ctypes.POINTER(P)]
    sec.SecKeychainItemCopyAccess.argtypes = [P, ctypes.POINTER(P)]
    sec.SecAccessCopyACLList.argtypes = [P, ctypes.POINTER(P)]
    sec.SecACLCopyContents.argtypes = [P, ctypes.POINTER(P), ctypes.POINTER(P), ctypes.POINTER(ctypes.c_uint16)]
    sec.SecACLCopyAuthorizations.argtypes = [P]
    sec.SecACLCopyAuthorizations.restype = P
    sec.SecTrustedApplicationCopyData.argtypes = [P, ctypes.POINTER(P)]
    cf.CFRelease.argtypes = [P]
    cf.CFArrayGetCount.argtypes = [P]
    cf.CFArrayGetCount.restype = ctypes.c_long
    cf.CFArrayGetValueAtIndex.argtypes = [P, ctypes.c_long]
    cf.CFArrayGetValueAtIndex.restype = P
    cf.CFDataGetLength.argtypes = [P]
    cf.CFDataGetLength.restype = ctypes.c_long
    cf.CFDataGetBytePtr.argtypes = [P]
    cf.CFDataGetBytePtr.restype = P
    cf.CFStringGetCString.argtypes = [P, ctypes.c_char_p, ctypes.c_long, ctypes.c_uint32]
    frei = []

    def text(ref):
        b = ctypes.create_string_buffer(8192)
        return b.value.decode('utf-8', 'replace') if ref and cf.CFStringGetCString(ref, b, 8192, 0x08000100) else ''

    def liste(ref):
        return [cf.CFArrayGetValueAtIndex(ref, i) for i in range(cf.CFArrayGetCount(ref))] if ref else []

    ref = P()
    if sec.SecKeychainOpen(os.fsencode(keychain), ctypes.byref(ref)) != 0:
        schluessel_fehler('Keychain nicht erreichbar')
    frei.append(ref)
    try:
        service, account = SCHLUESSEL_DIENST.encode(), SCHLUESSEL_KONTO.encode()
        item = P()
        rc = sec.SecKeychainFindGenericPassword(ref, len(service), service, len(account), account,
                                                None, None, ctypes.byref(item))
        if rc == -25300:
            return None
        if rc != 0 or not item:
            schluessel_fehler('Eintrag nicht lesbar oder Speicher gesperrt/nicht erreichbar')
        frei.append(item)
        zugang, acls = P(), P()
        if sec.SecKeychainItemCopyAccess(item, ctypes.byref(zugang)) != 0:
            schluessel_fehler('Zugriffsliste des Eintrags nicht lesbar')
        frei.append(zugang)
        if sec.SecAccessCopyACLList(zugang, ctypes.byref(acls)) != 0:
            schluessel_fehler('Zugriffsliste des Eintrags nicht lesbar')
        frei.append(acls)
        ergebnis = []
        for acl in liste(acls.value):
            apps, beschreibung, frage = P(), P(), ctypes.c_uint16()
            if sec.SecACLCopyContents(acl, ctypes.byref(apps), ctypes.byref(beschreibung), ctypes.byref(frage)) != 0:
                schluessel_fehler('Zugriffsliste des Eintrags nicht lesbar')
            frei.extend(r for r in (apps, beschreibung) if r)
            rechte = sec.SecACLCopyAuthorizations(acl)
            if rechte:
                frei.append(P(rechte))
            namen = [text(r) for r in liste(rechte)]
            pfade = None
            if apps:
                pfade = []
                for app in liste(apps.value):
                    d = P()
                    if sec.SecTrustedApplicationCopyData(app, ctypes.byref(d)) == 0 and d:
                        frei.append(d)
                        pfade.append(os.fsdecode(ctypes.string_at(cf.CFDataGetBytePtr(d), cf.CFDataGetLength(d)).rstrip(b'\0')))
            partitionen = None
            if 'ACLAuthorizationPartitionID' in namen:
                try:
                    partitionen = list(plistlib.loads(bytes.fromhex(text(beschreibung))).get('Partitions', []))
                except (ValueError, plistlib.InvalidFileException):
                    partitionen = []
            ergebnis.append((namen, pfade, partitionen))
        return ergebnis
    finally:
        for r in reversed(frei):
            cf.CFRelease(r)


def _zugriff_bewerten(acls):
    """-> 'system', wenn /usr/bin/security den Eintrag ohne Dialog entschluesseln darf: Es steht in der Liste fuer
    Decrypt (oder sie erlaubt jede App), und eine Partitionsliste nennt apple-tool:. Sonst 'fremd'."""
    entschluesseln = any('ACLAuthorizationDecrypt' in namen and (pfade is None or SECURITY_SYSTEM in pfade)
                         for namen, pfade, _ in acls)
    partitionen = [p for _, _, teil in acls if teil is not None for p in teil]
    partition_ok = 'apple-tool:' in partitionen or not any(teil is not None for _, _, teil in acls)
    return 'system' if entschluesseln and partition_ok else 'fremd'


def _mac_keychain(keychain):
    """Explizite/default Keychain aufloesen und Sperre ohne Entsperrdialog pruefen."""
    import ctypes
    sec = ctypes.CDLL('/System/Library/Frameworks/Security.framework/Security')
    cf = ctypes.CDLL('/System/Library/Frameworks/CoreFoundation.framework/CoreFoundation')
    sec.SecKeychainSetUserInteractionAllowed.argtypes = [ctypes.c_bool]
    if sec.SecKeychainSetUserInteractionAllowed(False) != 0:
        schluessel_fehler('Dialogsperre nicht verfuegbar')
    sec.SecKeychainOpen.argtypes = [ctypes.c_char_p, ctypes.POINTER(ctypes.c_void_p)]
    sec.SecKeychainCopyDefault.argtypes = [ctypes.POINTER(ctypes.c_void_p)]
    sec.SecKeychainGetStatus.argtypes = [ctypes.c_void_p, ctypes.POINTER(ctypes.c_uint32)]
    sec.SecKeychainGetPath.argtypes = [ctypes.c_void_p, ctypes.POINTER(ctypes.c_uint32), ctypes.c_void_p]
    cf.CFRelease.argtypes = [ctypes.c_void_p]
    ref = ctypes.c_void_p()
    rc = sec.SecKeychainOpen(os.fsencode(keychain), ctypes.byref(ref)) if keychain else sec.SecKeychainCopyDefault(ctypes.byref(ref))
    if rc != 0:
        schluessel_fehler('Keychain nicht erreichbar')
    try:
        status = ctypes.c_uint32()
        if sec.SecKeychainGetStatus(ref, ctypes.byref(status)) != 0 or not status.value & 1:
            schluessel_fehler('Keychain gesperrt/nicht erreichbar (kein Entsperrdialog)')
        laenge = ctypes.c_uint32(4096)
        pfad = ctypes.create_string_buffer(laenge.value)
        if sec.SecKeychainGetPath(ref, ctypes.byref(laenge), pfad) != 0:
            schluessel_fehler('Keychain-Pfad nicht erreichbar')
        return os.fsdecode(pfad.value)
    finally:
        cf.CFRelease(ref)


def _schluessel_lesen(keychain):
    if sys.platform == 'darwin':
        security = _security_werkzeug()
        cmd = [security, 'find-generic-password', '-s', SCHLUESSEL_DIENST,
               '-a', SCHLUESSEL_KONTO, '-w'] + ([keychain] if keychain else [])
        if security == SECURITY_SYSTEM:
            # 03.11.2026: Ein Eintrag, den das ad-hoc-signierte Homebrew-Python anlegt, bindet macOS an dessen cdhash;
            # jedes brew-Update macht ihn unlesbar. Stabil ist nur das Apple-signierte /usr/bin/security. Einen
            # security-Kindprozess kann die Dialogsperre dieses Prozesses nicht erfassen (11.10.), darum entscheidet
            # erst die Zugriffsliste, gelesen ohne Dialog und ohne Entschluesseln: Darf security, liest security;
            # sonst nur der alte Weg im selben Prozess, der allein mit dem anlegenden Interpreter gelingt.
            acls = _mac_zugriff_roh(keychain)
            if acls is None:
                return None
            if _zugriff_bewerten(acls) == 'system':
                r = _schluessel_befehl(cmd)
            else:
                r = _mac_eintrag(keychain)
                if r.returncode != 0:
                    schluessel_fehler('Eintrag ist an ein anderes Programm gebunden (etwa ein ersetztes Homebrew-Python); '
                                      + SCHRITT_FREIGABE % (SCHLUESSEL_DIENST, SCHLUESSEL_KONTO))
        else:
            r = _schluessel_befehl(cmd)
        fehlt = r.returncode == 44  # errSecItemNotFound; andere Fehler NIE als fehlend werten
    else:
        if keychain:
            schluessel_fehler('eine Keychain-Datei ist nur auf macOS zulaessig')
        r = _schluessel_befehl(['secret-tool', 'lookup', 'service', SCHLUESSEL_DIENST,
                               'account', SCHLUESSEL_KONTO])
        # libsecret: kein Treffer = Exit 1 ohne Ausgabe; DBus-/Sperrfehler haben stderr.
        fehlt = r.returncode == 1 and not r.stdout and not r.stderr
    if fehlt:
        return None
    if r.returncode != 0:
        schluessel_fehler('Eintrag nicht lesbar oder Speicher gesperrt/nicht erreichbar')
    wert = r.stdout.rstrip('\n')
    if not re.fullmatch('[0-9a-f]{64}', wert):
        schluessel_fehler('Eintrag hat ein ungueltiges Format; nicht ersetzt')
    return bytes.fromhex(wert)


def schluessel_laden(keychain=None):
    """Einmalig 256 Bit anlegen; kein Dateispeicher fuer den Wert, keine Rotation bei Fehlern.

    Die nicht geheime Sperrdatei serialisiert gleichzeitige Erststarts. Tests
    verwenden eigene security-/secret-tool-Adapter; keine echten Keychains.
    """
    if sys.platform == 'darwin' and _security_werkzeug() == '/usr/bin/security':
        keychain = _mac_keychain(keychain)
    try:
        ordner = os.path.expanduser('~/.local/state/wb-geheimnis-filter')
        os.makedirs(ordner, mode=0o700, exist_ok=True)
        fd = os.open(os.path.join(ordner, 'schluessel.lock'),
                     os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    except OSError:
        schluessel_fehler('Startsperre nicht erreichbar')
    with os.fdopen(fd, 'w') as sperre:
        ende = time.monotonic() + 15
        while True:
            try:
                fcntl.flock(sperre, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= ende:
                    schluessel_fehler('Startsperre belegt (Zeitgrenze)')
                time.sleep(.05)
        wert = _schluessel_lesen(keychain)
        if wert is not None:
            return wert
        neu = secrets.token_hex(32)
        if sys.platform == 'darwin':
            # security liest den Wert ueber stdin, nie als Prozessargument. Kein -U: vorhandene Eintraege werden
            # niemals ueberschrieben. Auch am echten Schluesselbund legt /usr/bin/security an (03.11.2026): Dann
            # steht es mit der Partition apple-tool: in der Zugriffsliste, und ein brew-Update aendert daran nichts.
            # Anlegen in einem entsperrten Schluesselbund fragt nicht; gesperrt hat _mac_keychain vorher abgebrochen.
            import shlex
            cmd = ['add-generic-password', '-s', SCHLUESSEL_DIENST, '-a', SCHLUESSEL_KONTO,
                   '-T', SECURITY_SYSTEM, '-w', neu] + ([keychain] if keychain else [])
            r = _schluessel_befehl([_security_werkzeug(), '-i'], shlex.join(cmd) + '\n')
        else:
            r = _schluessel_befehl(['secret-tool', 'store', '--label=Workbench Geheimnisfilter HMAC',
                                   'service', SCHLUESSEL_DIENST, 'account', SCHLUESSEL_KONTO], neu + '\n')
        if r.returncode != 0:
            schluessel_fehler('Eintrag konnte nicht angelegt werden')
        # security -i kann trotz Befehlsfehler Exit 0 liefern: immer erneut lesen.
        wert = _schluessel_lesen(keychain)
        if wert is None or wert != bytes.fromhex(neu):
            schluessel_fehler('Anlegen nicht bestaetigt; kein zufaelliger Ersatz')
        return wert


class Tabelle:
    """Platzhalter <-> Wert im Speicher; stabil durch den uebergebenen HMAC-Schluessel."""

    def __init__(self, schluessel):
        self._schluessel = schluessel
        self._l = threading.Lock()
        self.zu_wert = {}
        self.werte_nach_laenge = []
        self._werte = set()
        self._eingesetzt = set()    # Werte, die der Rueckweg an den Harness gegeben hat
        self.saubere_namen = set()  # JSON-Schluessel ohne Musterfund; Muster aendern sich nicht
        self.public = geheimnis_inhalt.load_public_values(HOOKS_DIR)

    def platzhalter(self, wert):
        h = hmac.new(self._schluessel, wert.encode('utf-8'), hashlib.sha256).hexdigest()[:HEXLEN]
        p = PRAEFIX + h
        with self._l:
            if p not in self.zu_wert:
                if len(self.zu_wert) >= MAX_TABELLE:
                    alt = next(iter(self.zu_wert))
                    self._eingesetzt.discard(self.zu_wert.pop(alt))
                self.zu_wert[p] = wert
                self._werte = set(self.zu_wert.values())
                self.werte_nach_laenge = sorted(self._werte, key=len, reverse=True)
        return p

    def kennt(self, wert):
        with self._l:
            return wert in self._werte

    def wert(self, p):
        with self._l:
            return self.zu_wert.get(p)

    def bekannte_werte(self):
        with self._l:
            return list(self.werte_nach_laenge)

    def merke_eingesetzt(self, wert):
        with self._l:
            self._eingesetzt.add(wert)

    def eingesetzte_werte(self):
        with self._l:
            return list(self._eingesetzt)


def _privater_block(text, start):
    """Der Musterfund private_key_block ist nur die BEGIN-Zeile; ersetzt wird der ganze
    Block bis zur passenden END-Zeile, sonst bliebe der Schluesselkoerper lesbar. Ohne END-Zeile
    (abgeschnittene Ausgabe) gilt alles bis zum Ende des Felds als Schluessel."""
    m = re.compile(r'-----END [A-Z ]*PRIVATE KEY-----').search(text, start)
    return text[start:m.end()] if m else text[start:]


def _private_bloecke(text, kopf):
    """Alle Bloecke mit der BEGIN-Zeile `kopf`. treffer() nennt die Zeile, nicht die Stelle: Eine
    Suche nach dem ersten Vorkommen liesse den zweiten Schluessel eines Felds stehen."""
    bloecke, pos = [], 0
    while (start := text.find(kopf, pos)) >= 0:
        block = _privater_block(text, start)
        bloecke.append(block)
        pos = start + len(block)
    return bloecke or [kopf]


ERSATZ_ZEICHEN = '\ufffd'
SCHATTEN_ALPHABET = string.ascii_letters + string.digits
EINZELNES_ERSATZZEICHEN = re.compile('[\ud800-\udfff]')


def _schatten(text):
    """Text gleicher Laenge, in dem jedes U+FFFD durch ein Zeichen der Werteklasse des Musters
    ersetzt ist (reihum, damit die Entropie eines Werts nicht sinkt). Die Muster kennen U+FFFD nicht
    und endeten sonst vor dem Zeichen: ein Wert mit einem Ersatzzeichen in der Mitte waere
    gekuerzt und unter der Entropieschwelle (gemessen 31.10., 24 von 300 Zuegen)."""
    n = iter(range(len(text)))
    return re.sub(ERSATZ_ZEICHEN, lambda _m: SCHATTEN_ALPHABET[next(n) % len(SCHATTEN_ALPHABET)], text)


def _treffer(text, tabelle):
    """Muster-Treffer von `text` als (Regel, Wert). Steht U+FFFD im Text, laufen die Muster
    zusaetzlich ueber den Schattentext; der Wert ist dann der Ausschnitt des Originals an jeder Stelle,
    an der der Schattenwert steht, also einschliesslich des Zeichens."""
    for _zeile, regel, wert, _ent in geheimnis_inhalt.treffer(text, True, tabelle.public, True):
        yield regel, wert
    if ERSATZ_ZEICHEN not in text:
        return
    schatten = _schatten(text)
    for _zeile, regel, wert, _ent in geheimnis_inhalt.treffer(schatten, True, tabelle.public, True):
        if regel == 'private_key_block':
            continue    # Die BEGIN-Zeile enthaelt kein Ersatzzeichen; der Fund oben deckt sie ab
        i = schatten.find(wert)
        while i >= 0:
            yield regel, text[i:i + len(wert)]
            i = schatten.find(wert, i + 1)


def muster_funde(text, tabelle, regeln=None):
    """Werte, die die Muster in `text` finden (privater Schluessel als ganzer Block).
    regeln: optionales dict, bekommt je Fund den Regelnamen (fuer Zaehler, nie Werte)."""
    funde = set()
    for regel, wert in _treffer(text, tabelle):
        for w in _private_bloecke(text, wert) if regel == 'private_key_block' else (wert,):
            funde.add(w)
            if regeln is not None:
                regeln[w] = regel
    return funde


def geheimnisse_in(text, tabelle, muster=True):
    """Menge der zu ersetzenden Werte in `text` (Muster plus schon bekannte Werte)."""
    funde = muster_funde(text, tabelle) if muster else set()
    for w in tabelle.bekannte_werte():
        if w in text:
            funde.add(w)
    return funde


def ersetze_text(text, tabelle, z, muster=True):
    if not text or len(text) < 8:
        return text
    funde = geheimnisse_in(text, tabelle, muster)
    if not funde:
        return text
    for w in sorted(funde, key=len, reverse=True):
        if PLATZHALTER_RX.fullmatch(w):
            continue
        n = text.count(w)
        if n:
            text = text.replace(w, tabelle.platzhalter(w))
            z.plus('ersetzt', n)
    return text


def _kopf_passt(b64):
    """Beginnt der Base64-Text mit dem Dateikopf eines Bildes oder PDF? Nur der Anfang wird
    dekodiert, die Pruefung bleibt auch bei grossen Bildern billig."""
    try:
        kopf = binascii.a2b_base64(b64[:24], strict_mode=True)
    except (binascii.Error, ValueError):
        return False
    return (kopf.startswith((b'\x89PNG\r\n\x1a\n', b'\xff\xd8\xff', b'GIF87a', b'GIF89a', b'%PDF-'))
            or (kopf[:4] == b'RIFF' and kopf[8:12] == b'WEBP'))


def _dicts(x):
    if isinstance(x, dict):
        return (x,)
    if isinstance(x, list):
        return [v for v in x if isinstance(v, dict)]
    return ()


def opake_felder(block):
    """Die Felder eines Blocks, die sein `type` opak macht. Gemeinsame Quelle des Hinwegs;
    der Rueckweg leitet RUECK_NIE_TYPEN aus denselben Tabellen ab."""
    t = block.get('type')
    if not isinstance(t, str):
        return ()
    felder = OPAK_IMMER.get(t, ())
    signiert = OPAK_SIGNIERT.get(t)
    if signiert and isinstance(block.get('signature'), str) and block['signature']:
        felder += signiert
    return felder


class Orte:
    """Ergebnis der Ortspruefung einer Anfrage. opak: id(Behaelter) -> Schluessel der Felder, die
    unveraendert bleiben. medien: Base64-Inhalte, die als Text gelten und dekodiert gefiltert
    werden. Die Ids gelten, solange das JSON-Objekt lebt; Filter und Ortspruefung teilen es."""

    def __init__(self):
        self.opak = {}
        self.medien = []

    def _opak(self, behaelter, schluessel):
        self.opak.setdefault(id(behaelter), set()).add(schluessel)

    def felder(self, block, namen):
        for n in namen:
            if isinstance(block.get(n), str):
                self._opak(block, n)

    def medium(self, behaelter, schluessel, media_typ, praefix=''):
        """media_typ None: Das Protokoll nennt keinen Typ (Ollama images), es zaehlt der
        Dateikopf. Alles ausser Bild und PDF gilt als Text: dekodieren, filtern, neu kodieren."""
        wert = behaelter[schluessel]
        if not isinstance(wert, str):
            return
        n = len(praefix)
        if (media_typ is None or (isinstance(media_typ, str) and media_typ.lower() in MEDIEN_OPAK)) \
                and _kopf_passt(wert[n:n + 24]):
            self._opak(behaelter, schluessel)
            return
        try:
            roh = base64.b64decode(wert[n:], validate=True)
        except (binascii.Error, ValueError):
            return    # kein Base64: bleibt eine gewoehnliche Zeichenkette und wird gefiltert
        try:
            text, kodierung = roh.decode('utf-8'), 'utf-8'
        except UnicodeDecodeError:
            try:
                # Ein einzelnes Ersatzzeichen als WTF-8 (ED A0 BD): als Ersatzzeichen lesen, nicht als
                # drei Latin-1-Zeichen, die einen Wert zerschneiden. filtere_json macht U+FFFD daraus.
                text, kodierung = roh.decode('utf-8', 'surrogatepass'), 'utf-8'
            except UnicodeDecodeError:
                text, kodierung = roh.decode('latin-1'), 'latin-1'
        self.medien.append((behaelter, schluessel, praefix, text, kodierung))

    def data_url(self, behaelter, schluessel):
        wert = behaelter[schluessel]
        m = DATA_URL.match(wert) if isinstance(wert, str) else None
        if m:
            self.medium(behaelter, schluessel, m.group(1), wert[:m.end()])


# Anthropic Messages. Oben: direkt in messages[].content[]. Innen: Blocktyp -> Typen, die unter
# seinem `content` stehen duerfen. Ein Block anderswo, etwa in tool_use.input, ist nie opak.
ANTHROPIC_OBEN = {'thinking', 'redacted_thinking', 'compaction'}
ANTHROPIC_MEDIEN = {'image', 'document'}
ANTHROPIC_INNEN = {
    'tool_result': ANTHROPIC_MEDIEN,
    'mcp_tool_result': ANTHROPIC_MEDIEN,
    'web_search_tool_result': {'web_search_result'},
    'web_fetch_tool_result': {'web_fetch_result'},
    'web_fetch_result': {'document'},
    'advisor_tool_result': {'advisor_redacted_result'},
    'code_execution_tool_result': {'encrypted_code_execution_result'},
}


def _anthropic_medium(block, orte):
    quelle = block.get('source')
    if not isinstance(quelle, dict):
        return
    if quelle.get('type') == 'base64' and 'data' in quelle:
        orte.medium(quelle, 'data', quelle.get('media_type') or '')
    elif quelle.get('type') == 'content':
        for innen in _dicts(quelle.get('content')):
            if innen.get('type') == 'image':
                _anthropic_medium(innen, orte)


def _anthropic_innen(block, orte):
    erlaubt = ANTHROPIC_INNEN.get(block.get('type'))
    if not erlaubt:
        return
    for innen in _dicts(block.get('content')):
        t = innen.get('type')
        if t not in erlaubt:
            continue
        if t in ANTHROPIC_MEDIEN:
            _anthropic_medium(innen, orte)
        else:
            orte.felder(innen, opake_felder(innen))
            _anthropic_innen(innen, orte)


def _orte_anthropic(obj, orte):
    for nachricht in _dicts(obj.get('messages')):
        for block in _dicts(nachricht.get('content')):
            t = block.get('type')
            if t in ANTHROPIC_OBEN:
                orte.felder(block, opake_felder(block))
            elif t in ANTHROPIC_MEDIEN:
                _anthropic_medium(block, orte)
            elif t == 'text':
                for zitat in _dicts(block.get('citations')):
                    if zitat.get('type') == 'web_search_result_location':
                        orte.felder(zitat, opake_felder(zitat))
            else:
                _anthropic_innen(block, orte)


def _responses_teil(teil, orte):
    if teil.get('type') == 'input_image' and 'image_url' in teil:
        orte.data_url(teil, 'image_url')
    elif teil.get('type') == 'input_file' and 'file_data' in teil:
        orte.data_url(teil, 'file_data')


def _orte_responses(obj, orte):
    for eintrag in _dicts(obj.get('input')):
        t = eintrag.get('type')
        if t in ('reasoning', 'compaction'):
            orte.felder(eintrag, OPAK_IMMER[t])
        elif t in ('function_call_output', 'custom_tool_call_output'):
            for teil in _dicts(eintrag.get('output')):
                _responses_teil(teil, orte)
        elif t == 'message' or 'role' in eintrag:
            for teil in _dicts(eintrag.get('content')):
                _responses_teil(teil, orte)


def _orte_chat(obj, orte):
    for nachricht in _dicts(obj.get('messages')):
        for teil in _dicts(nachricht.get('content')):
            innen = teil.get(teil.get('type')) if isinstance(teil.get('type'), str) else None
            if not isinstance(innen, dict):
                continue
            if teil['type'] == 'image_url' and 'url' in innen:
                orte.data_url(innen, 'url')
            elif teil['type'] == 'file' and 'file_data' in innen:
                orte.data_url(innen, 'file_data')
        for detail in _dicts(nachricht.get('reasoning_details')):
            if isinstance(detail.get('type'), str) and detail['type'].startswith('reasoning.'):
                orte.felder(detail, opake_felder(detail))


def _gemini_teil(teil, orte):
    if isinstance(teil.get('thoughtSignature'), str) and teil['thoughtSignature']:
        orte.felder(teil, ('thoughtSignature', 'text') if teil.get('thought') is True
                    else ('thoughtSignature',))
    blob = teil.get('inlineData')
    if isinstance(blob, dict) and 'data' in blob:
        orte.medium(blob, 'data', blob.get('mimeType') or '')
    antwort = teil.get('functionResponse')
    if isinstance(antwort, dict):
        for innen in _dicts(antwort.get('parts')):
            _gemini_teil(innen, orte)


def _orte_gemini(obj, orte):
    for inhalt in _dicts(obj.get('contents')):
        for teil in _dicts(inhalt.get('parts')):
            _gemini_teil(teil, orte)


def _ollama_bilder(behaelter, orte):
    bilder = behaelter.get('images')
    if isinstance(bilder, list):
        for i, bild in enumerate(bilder):
            if isinstance(bild, str) and bild.startswith('data:'):
                orte.data_url(bilder, i)
            else:
                orte.medium(bilder, i, None)


def _orte_ollama(obj, orte):
    _ollama_bilder(obj, orte)    # /api/generate
    for nachricht in _dicts(obj.get('messages')):
        _ollama_bilder(nachricht, orte)


PROTOKOLLE = (
    (re.compile(r'/messages(/count_tokens)?/?$'), _orte_anthropic),
    (re.compile(r'/responses(/compact)?/?$'), _orte_responses),
    (re.compile(r'/chat/completions/?$'), _orte_chat),
    (re.compile(r':(streamGenerateContent|generateContent|countTokens)$'), _orte_gemini),
    (re.compile(r'/api/(chat|generate)/?$'), _orte_ollama),
)


def opake_orte(pfad, obj):
    """Ortspruefung des Hinwegs. Der Anfragepfad waehlt das Protokoll; ein anderer Pfad hat
    keine opaken Orte, dort wird alles gefiltert."""
    orte = Orte()
    if isinstance(obj, dict):
        p = pfad.split('?', 1)[0]
        for rx, finde in PROTOKOLLE:
            if rx.search(p):
                finde(obj, orte)
                break
    return orte


def sammle_json(obj, tabelle, z=None, opak={}, namen=None):
    """Erster Durchgang des Hinwegs: die Musterfunde ALLER Zeichenketten anmelden, bevor
    irgendwo ersetzt wird. Sonst haengt es von der Reihenfolge im Koerper ab, ob ein Wert,
    der in einem frueheren Feld ohne Schluesselwort steht (aufgeloester Befehl, Zusammen-
    fassung nach einer Kompaktierung), schon bekannt ist -- nach einem Neustart des Proxys
    ist die Tabelle leer, und genau dann ginge er durch.
    namen: Menge, die alle JSON-Schluessel aufnimmt; sie werden gesammelt geprueft."""
    if isinstance(obj, str):
        if len(obj) < 8:
            return
        regeln = {}
        for w in muster_funde(obj, tabelle, regeln):
            if not PLATZHALTER_RX.fullmatch(w):
                if z is not None and not tabelle.kennt(w):
                    # Je NEU erkanntem Wert der Regelname (Fehlalarme sichtbar machen).
                    z.plus('neu_regel_' + regeln.get(w, '?'))
                tabelle.platzhalter(w)
    elif isinstance(obj, (list, dict)):
        hier = opak.get(id(obj), ())
        if isinstance(obj, list):
            paare = enumerate(obj)
        else:
            paare = obj.items()
            if namen is not None:
                namen.update(obj)
        for k, v in paare:
            if k not in hier:
                sammle_json(v, tabelle, z, opak, namen)


def _opak_pruefen(wert, tabelle, z, eingesetzt):
    """Ein opaker Ort bleibt bytegleich, ausser dort steht ein Wert, den der Rueckweg dem
    Harness gegeben hat. Dann bricht lieber die Signatur, als dass der Wert hinausgeht."""
    for w in eingesetzt:
        if w in wert:
            wert = wert.replace(w, tabelle.platzhalter(w))
            z.plus('opak_eingesetzt_ersetzt')
    return wert


def ersetze_json(obj, tabelle, z, muster=True, opak={}, eingesetzt=(), namen=False):
    """Alle Zeichenketten eines JSON-Objekts filtern (Hinweg). -> (neues Objekt, geaendert).
    namen: JSON-Schluessel ebenfalls ersetzen."""
    if isinstance(obj, str):
        neu = ersetze_text(obj, tabelle, z, muster)
        return neu, neu is not obj and neu != obj
    if isinstance(obj, (list, dict)):
        geaendert = False
        hier = opak.get(id(obj), ())
        for k in (range(len(obj)) if isinstance(obj, list) else list(obj.keys())):
            if k in hier:
                n = _opak_pruefen(obj[k], tabelle, z, eingesetzt)
                g = n != obj[k]
            else:
                n, g = ersetze_json(obj[k], tabelle, z, muster, opak, eingesetzt, namen)
            if g:
                obj[k] = n
                geaendert = True
        if namen and isinstance(obj, dict):
            neu = {ersetze_text(k, tabelle, z, muster): v for k, v in obj.items()}
            if list(neu) != list(obj):
                obj.clear()
                obj.update(neu)
                geaendert = True
        return obj, geaendert
    return obj, False


def ersatzzeichen_ersetzen(obj, opak={}):
    """Vorlauf des Hinwegs: Ein einzelnes UTF-16-Ersatzzeichen (das JSON-Escape \\ud83d allein) ausserhalb
    opaker Orte wird U+FFFD, in Werten wie in JSON-Schluesseln. Es steht dann nicht mehr als Trenner in
    einem Wert, und der Koerper bleibt kodierbar: ein Fund endet nicht mehr in 500. Am opaken Ort
    bleibt es stehen (bytegleich); dort heisst ein Fund weiter 500. -> Anzahl ersetzter Zeichen."""
    n = 0
    hier = opak.get(id(obj), ())
    if isinstance(obj, list):
        paare = enumerate(obj)
    elif isinstance(obj, dict):
        paare = list(obj.items())
    else:
        return 0
    for k, v in paare:
        if k in hier:
            continue
        if isinstance(v, str):
            neu, c = EINZELNES_ERSATZZEICHEN.subn(ERSATZ_ZEICHEN, v)
            if c:
                obj[k] = neu
                n += c
        elif isinstance(v, (list, dict)):
            n += ersatzzeichen_ersetzen(v, opak)
    if isinstance(obj, dict) and any(EINZELNES_ERSATZZEICHEN.search(k) for k in obj if isinstance(k, str)):
        neu = {}
        for k, v in obj.items():
            if isinstance(k, str) and k not in hier:
                k, c = EINZELNES_ERSATZZEICHEN.subn(ERSATZ_ZEICHEN, k)
                n += c
            neu[k] = v
        obj.clear()
        obj.update(neu)
    return n


def filtere_json(obj, orte, tabelle, z):
    """Hinweg fuer einen JSON-Koerper: erst alle Funde anmelden, dann ersetzen. Textmedien
    zuerst, damit ihr neu kodierter Inhalt im Baum steht. -> (neues Objekt, geaendert).
    Einzelne Ersatzzeichen werden vorher zu U+FFFD (ersatzzeichen_ersetzen); sie allein machen
    den Koerper nicht zu `geaendert`: ohne Fund geht er bytegleich weiter."""
    n = ersatzzeichen_ersetzen(obj, orte.opak)
    for i, (b, k, p, text, kod) in enumerate(orte.medien):
        text, c = EINZELNES_ERSATZZEICHEN.subn(ERSATZ_ZEICHEN, text)
        if c:
            orte.medien[i] = (b, k, p, text, kod)
            n += c
    if n:
        z.plus('ersatzzeichen_ersetzt', n)
    namen = set()
    sammle_json(obj, tabelle, z=z, opak=orte.opak, namen=namen)
    for _b, _k, _p, text, _kod in orte.medien:
        sammle_json(text, tabelle, z=z)
    # Werkzeugschemata wiederholen sich je Zug: Nur neue Schluessel laufen durch die Muster.
    neu = namen - tabelle.saubere_namen
    if neu:
        neu_text = '\n'.join(neu)
        sammle_json(neu_text, tabelle, z=z)
        if len(tabelle.saubere_namen) > MAX_SAUBERE_NAMEN:
            tabelle.saubere_namen.clear()
        if not muster_funde(neu_text, tabelle):
            tabelle.saubere_namen.update(neu)
    geaendert = False
    for behaelter, k, praefix, text, kodierung in orte.medien:
        neu = ersetze_text(text, tabelle, z, False)
        if neu != text:
            behaelter[k] = praefix + base64.b64encode(neu.encode(kodierung)).decode('ascii')
            geaendert = True
    obj, g = ersetze_json(obj, tabelle, z, muster=False, opak=orte.opak,
                          eingesetzt=tabelle.eingesetzte_werte(),
                          namen=bool(geheimnisse_in('\n'.join(namen), tabelle, muster=False)))
    return obj, geaendert or g


def _einsetzen(wert, json_text):
    return json.dumps(wert)[1:-1] if json_text else wert


def loese_auf(text, tabelle, z, json_text=False):
    def ersatz(m):
        w = tabelle.wert(m.group(0))
        if w is None:
            z.plus('platzhalter_unbekannt')
            return m.group(0)
        z.plus('aufgeloest')
        tabelle.merke_eingesetzt(w)
        return _einsetzen(w, json_text)
    return PLATZHALTER_RX.sub(ersatz, text)


def _moeglicher_anfang(t):
    """Ist t ein echter Anfang eines Platzhalters (kuerzer als ein ganzer)?"""
    if len(t) >= PLATZHALTER_LEN:
        return False
    if len(t) <= len(PRAEFIX):
        return PRAEFIX.startswith(t)
    return t.startswith(PRAEFIX) and all(c in '0123456789abcdef' for c in t[len(PRAEFIX):])


HOHES_ERSATZZEICHEN = re.compile(r'[\ud800-\udbff]\Z')
ERSATZPAAR = re.compile('([\ud800-\udbff])([\udc00-\udfff])')


def _paare_verbinden(text):
    """Zwei Ersatzzeichen, die erst durch das Aneinanderhaengen zweier Deltas ein Paar bilden, werden das
    eine Zeichen, das sie sind. Einzelne bleiben stehen (der Aufrufer ersetzt sie)."""
    if not ERSATZPAAR.search(text):
        return text
    return ERSATZPAAR.sub(lambda m: chr(0x10000 + ((ord(m.group(1)) - 0xD800) << 10) + (ord(m.group(2)) - 0xDC00)), text)


def _kodierbar(text, z):
    """Rueckweg: Ein einzelnes UTF-16-Ersatzzeichen in einer Antwort wird U+FFFD. Sonst scheitert das
    Kodieren (UnicodeEncodeError), und die Verbindung bricht ab. Zaehler `ersatzzeichen_rueckweg`."""
    if not isinstance(text, str):
        return text
    n = len(EINZELNES_ERSATZZEICHEN.findall(text))
    if not n:
        return text
    z.plus('ersatzzeichen_rueckweg', n)
    return EINZELNES_ERSATZZEICHEN.sub(ERSATZ_ZEICHEN, text)


def zurueckhalten(text):
    """(sofort, zurueck): zurueck ist der laengste Rest am Ende, der Anfang eines
    Platzhalters sein kann -- oder ein hohes Ersatzzeichen, dessen Gegenstueck im naechsten Delta kommen
    kann (zwei Deltas teilen ein Zeichen ausserhalb der BMP)."""
    if HOHES_ERSATZZEICHEN.search(text):
        return text[:-1], text[-1]
    for k in range(min(len(text), PLATZHALTER_LEN - 1), 0, -1):
        if _moeglicher_anfang(text[-k:]):
            return text[:-k], text[-k:]
    return text, ''


def _block_nie(obj, eltern):
    """Ortsregel des Rueckwegs fuer einen ganzen Block; siehe RUECK_NIE_TYPEN."""
    t = obj.get('type')
    if isinstance(t, str) and (t in RUECK_NIE_TYPEN or t.startswith('response.reasoning')):
        return True
    return eltern == 'parts' and obj.get('thought') is True


def _feld_nie(k, eltern):
    """Ortsregel des Rueckwegs fuer Felder ohne eigenen Blocktyp."""
    if eltern == 'parts':
        return k in GEMINI_OPAK
    return k in DENK_FELDER and eltern in ('delta', 'message', None)


def _namen_aufloesen(obj, tabelle, z):
    """Der Hinweg ersetzt auch JSON-Schluessel; schreibt das Modell einen solchen Platzhalter
    in einen Werkzeugaufruf, bekommt das Werkzeug den echten Namen."""
    if any(PRAEFIX in k for k in obj):
        neu = {loese_auf(k, tabelle, z): v for k, v in obj.items()}
        obj.clear()
        obj.update(neu)


def _ist_json_text(pfad, typ):
    letzter = pfad[-1] if pfad else None
    if letzter in JSON_TEXT_FELDER:
        return True
    return letzter == 'delta' and 'arguments' in (typ or '')


class StromAufloeser:
    """Rueckweg fuer gestreamte Antworten. Je Delta-Strom (Feldpfad plus index-artige
    Werte: Anthropic index, OpenAI choices[i]/tool_calls[].index, Responses
    output_index/content_index) wird ein Rest am Ende, der Anfang eines Platzhalters
    sein kann, bis zum naechsten Stueck desselben Stroms zurueckgehalten. Kommt ein
    Ereignis, das diesen Strom nicht fortsetzt (Blockende, anderer Block, Strom-Ende),
    wird der Rest als eigenes Delta-Ereignis nach dem Muster des letzten Stuecks
    ausgegeben -- dann war es kein Platzhalter, und kein Zeichen geht verloren."""

    def __init__(self, tabelle, z):
        self.t = tabelle
        self.z = z
        self.rest = {}    # schluessel -> (zurueckgehalten, vorlage, pfad, ereignisname)

    def _gehe(self, obj, pfad, idx, typ, beruehrt, vorlage, ereignis, nie, eltern=None):
        if isinstance(obj, dict):
            if 'type' in obj and isinstance(obj['type'], str) and not typ:
                typ = obj['type']
            neu_idx = idx
            for k in ('index', 'output_index', 'content_index'):
                if isinstance(obj.get(k), int):
                    neu_idx = neu_idx + ((k, obj[k]),)
            nie_hier = nie or _block_nie(obj, eltern)
            for k in list(obj.keys()):
                obj[k] = self._gehe(obj[k], pfad + (k,), neu_idx, typ, beruehrt, vorlage,
                                    ereignis, nie_hier or _feld_nie(k, eltern), k)
            if not nie_hier:
                _namen_aufloesen(obj, self.t, self.z)
            return obj
        if isinstance(obj, list):
            for i, v in enumerate(obj):
                obj[i] = self._gehe(v, pfad + (i,), idx, typ, beruehrt, vorlage, ereignis, nie, eltern)
            return obj
        if not isinstance(obj, str) or nie:
            return obj
        letzter = pfad[-1] if pfad else None
        json_text = _ist_json_text(pfad, typ)
        # Rueckhalten nur in Delta-Ereignissen: typlose Stuecke (OpenAI Chat, Ollama) oder
        # ein Typ mit "delta" (Anthropic content_block_delta, Responses *.delta). Ein
        # *.done-Ereignis traegt den ganzen Text; ein dort zurueckgehaltener Rest kaeme als
        # zweites done-Ereignis heraus.
        if letzter not in DELTA_FELDER or (typ is not None and 'delta' not in typ):
            return _kodierbar(loese_auf(obj, self.t, self.z, json_text) if PRAEFIX[:3] in obj else obj, self.z)
        schl = (typ, pfad, idx)
        beruehrt.add(schl)
        alt = self.rest.pop(schl, None)
        text = _paare_verbinden((alt[0] if alt else '') + obj)
        sofort, zurueck = zurueckhalten(text)
        if zurueck:
            self.rest[schl] = (zurueck, vorlage, pfad, ereignis)
            self.z.plus('zurueckgehalten')
        return _kodierbar(loese_auf(sofort, self.t, self.z, json_text), self.z)

    def _ausgeben_rest(self, schl):
        zurueck, vorlage, pfad, ereignis = self.rest.pop(schl)
        obj = json.loads(vorlage)
        ziel = obj
        for k in pfad[:-1]:
            ziel = ziel[k]
        ziel[pfad[-1]] = _kodierbar(zurueck, self.z)
        self.z.plus('rest_ausgegeben')
        return ereignis, obj

    def ereignis(self, obj, ereignisname=None):
        """-> Liste von (ereignisname, obj) in Ausgabereihenfolge."""
        vorlage = json.dumps(obj)
        beruehrt = set()
        obj = self._gehe(obj, (), (), None, beruehrt, vorlage, ereignisname, False)
        aus = [self._ausgeben_rest(s) for s in list(self.rest) if s not in beruehrt]
        aus.append((ereignisname, obj))
        return aus

    def ende(self):
        return [self._ausgeben_rest(s) for s in list(self.rest)]


def loese_json_auf(obj, tabelle, z, schluessel=None, nie=False, eltern=None):
    """Rueckweg fuer nicht gestreamte JSON-Antworten."""
    if isinstance(obj, dict):
        nie = nie or _block_nie(obj, eltern)
        for k in list(obj.keys()):
            obj[k] = loese_json_auf(obj[k], tabelle, z, k, nie or _feld_nie(k, eltern), k)
        if not nie:
            _namen_aufloesen(obj, tabelle, z)
        return obj
    if isinstance(obj, list):
        return [loese_json_auf(v, tabelle, z, schluessel, nie, eltern) for v in obj]
    if isinstance(obj, str) and not nie:
        if PRAEFIX[:3] in obj:
            obj = loese_auf(obj, tabelle, z, schluessel in JSON_TEXT_FELDER)
        return _kodierbar(obj, z)
    return obj


def dekomprimiere(body, kodierung):
    k = (kodierung or '').strip().lower()
    if k in ('', 'identity'):
        return body
    if k == 'gzip':
        return gzip.decompress(body)
    if k == 'deflate':
        return zlib.decompress(body)
    if k == 'zstd':
        from compression import zstd
        return zstd.decompress(body)
    raise ValueError('unbekannte Kodierung')


SONDE_DAUER = 1800.0   # eine Sonde gilt 30 Minuten, dann zaehlt nichts mehr


class UngueltigeAnfrage(ValueError):
    pass


def fehlerklasse(exc):
    """Feste Namen, niemals Ausnahmetext, errno-Text, Host oder dynamische Klassen."""
    for typ, name in ((FrueheAntwort, 'fruehantwort'), (socket.gaierror, 'dns'), (ssl.SSLError, 'tls'),
                      ((TimeoutError, socket.timeout), 'zeitlimit'),   # vor 3.10 ist socket.timeout eigen
                      (ConnectionRefusedError, 'abgelehnt'),
                      (BrokenPipeError, 'pipe'), (ConnectionResetError, 'reset'),
                      (http.client.IncompleteRead, 'unvollstaendig'),
                      (http.client.RemoteDisconnected, 'getrennt'),
                      (http.client.HTTPException, 'http'), (UnicodeError, 'unicode'),
                      (ValueError, 'wert'), (TypeError, 'typ'), (KeyError, 'schluessel'),
                      (OSError, 'betriebssystem')):
        if isinstance(exc, typ):
            return name
    return 'sonstig'


# Retry-After (Sekunden) fuer Fehler VOR dem Versand. Claude Code nutzt Werte bis 60 s als Abstand und bricht
# ab 90 s sofort ab (gemessen 02.11.2026, 2.1.316); mehr als 60 waere daher falsch.
WIEDERHOLEN_NACH = 60

# Groesse der Upload-Stuecke (Bytes, ein TLS-Record). Ein Koerper bis zu dieser Groesse geht in einem Stueck wie bisher.
UPLOAD_STUECK = 16384


class FrueheAntwort(Exception):
    """Der Anbieter hat geantwortet, bevor der Upload fertig war; traegt die schon empfangenen Bytes."""
    def __init__(self, vorlauf):
        super().__init__('fruehe Antwort')
        self.vorlauf = vorlauf


class _Vorlauf(io.RawIOBase):
    def __init__(self, vorlauf, sk):
        self._v, self._sk = vorlauf, sk

    def readable(self):
        return True

    def readinto(self, b):
        if self._v:
            n = min(len(b), len(self._v))
            b[:n] = self._v[:n]
            self._v = self._v[n:]
            return n
        return self._sk.recv_into(b)


class _MitVorlauf:
    """Socket-Huelle fuer http.client: makefile liefert zuerst die schon gelesenen Bytes, dann den Socket."""
    def __init__(self, vorlauf, sk):
        self._vorlauf, self._sk = vorlauf, sk

    def makefile(self, mode='rb', *a, **kw):
        return io.BufferedReader(_Vorlauf(self._vorlauf, self._sk))

    def __getattr__(self, name):
        return getattr(self._sk, name)


# Hoechstens so lange (Sekunden) wartet der Filter nach einem Fehler im Upload auf eine schon gesendete
# Antwort des Anbieters (etwa 413), bevor er den Fehler als Netzabbruch wertet.
FRUEHANTWORT_FRIST = 2

# Zustandslose Modell-Aufrufe (POST): Messages, Count-Tokens, Chat-Completions, Responses. Nur diese und GET
# duerfen nach vollstaendiger Uebergabe noch einmal gesendet werden (Keepalive-Erholung).
ZUSTANDSLOS_PFADE = re.compile(r'/(messages(/count_tokens)?|chat/completions|responses)/?$')

def _ruhend_lebt(c):
    """Lebt eine ruhende Upstream-Verbindung noch? Ohne offene Anfrage darf der Socket nichts zu lesen haben:
    Lesbarkeit heisst EOF, close_notify, Reset oder Unerwartetes, also tot. Blockiert nie (select mit 0), liest
    nichts und nutzt bei TLS kein MSG_PEEK. Eine unnoetige neue Verbindung ist der schlimmste Fall."""
    sk = c.sock
    if sk is None:
        return True   # noch nicht verbunden: der Aufbau folgt ohnehin
    try:
        if isinstance(sk, ssl.SSLSocket) and sk.pending():
            return False
        lesbar, _, kaputt = select.select([sk], [], [sk], 0)
        return not lesbar and not kaputt
    except (OSError, ValueError, TypeError):
        return False


# Dauer des TLS-Rueckfalls auf klassischen Schluesselaustausch je Zielhost (Sekunden).
TLS_KLASSISCH_DAUER = 3600


class Proxy:
    def __init__(self, routen, durchreichen=False, beobachte=None, zustand=None, schluessel=None,
                 dns_frist=90.0):
        self.routen = routen
        self.dns_frist = dns_frist
        self.durchreichen = durchreichen
        self.tabelle = Tabelle(schluessel if schluessel is not None else schluessel_laden())
        self.z = Zaehler()
        self.bestand = Bestand(zustand)
        self.start = time.strftime('%Y-%m-%dT%H:%M:%S%z')
        self.beobachte = beobachte.encode('utf-8') if beobachte else None
        self.beobachte_bis = None   # Sonde ueber /_wb/sonde: Ablaufzeit (monotonic)
        self.ctx = ssl.create_default_context()
        # Klassischer Schluesselaustausch fuer Netze, die den grossen Post-Quanten-ClientHello
        # (X25519MLKEM768, etwa 1,8 kB) zuruecksetzen. Gemessen 06.11.2026 an einem Heimnetz: 18 von
        # 30 Handshakes mit ConnectionResetError, mit X25519 30 von 30 heil. Rueckfall je Zielhost
        # fuer TLS_KLASSISCH_DAUER Sekunden, danach wird der Standard wieder versucht.
        # Aeltere Python-/TLS-Fassungen (etwa /usr/bin/python3 mit LibreSSL) kennen weder set_groups noch den
        # Namen X25519 und bieten ohnehin kein Post-Quanten an: dann ist der klassische Kontext der Standard.
        self.ctx_klassisch = ssl.create_default_context()
        try:
            if hasattr(self.ctx_klassisch, 'set_groups'):
                self.ctx_klassisch.set_groups('X25519:P-256:P-384')
            else:
                self.ctx_klassisch.set_ecdh_curve('prime256v1')
        except (ssl.SSLError, ValueError):
            self.ctx_klassisch = self.ctx
        self._klassisch_bis = {}
        self._klassisch_l = threading.Lock()
        self._offen = 0
        self._offen_l = threading.Lock()

    def ctx_fuer(self, host):
        """TLS-Kontext zum Anbieter: Standard, ausser der Host steht im Rueckfall."""
        with self._klassisch_l:
            bis = self._klassisch_bis.get(host)
            if bis is not None and time.monotonic() >= bis:
                del self._klassisch_bis[host]
                bis = None
        return self.ctx_klassisch if bis is not None else self.ctx

    def klassisch_merken(self, host):
        with self._klassisch_l:
            self._klassisch_bis[host] = time.monotonic() + TLS_KLASSISCH_DAUER

    def upstream_ca(self, cafile):
        for ctx in {id(c): c for c in (self.ctx, self.ctx_klassisch)}.values():
            ctx.load_verify_locations(cafile=cafile)

    def offen_plus(self, n):
        """Anfragen in Arbeit (Hinweg bis zum letzten Byte des Rueckwegs; Zaehlerseiten und Leerlauf-
        Verbindungen zaehlen nicht). `wb-geheimnis-filter-dienst installieren --wenn-ruhig` wartet auf 0."""
        with self._offen_l:
            self._offen += n

    def offen(self):
        with self._offen_l:
            return self._offen

    def beobachtet(self):
        """Der zu zaehlende Wert (Testoption oder laufende Sonde), sonst None."""
        if self.beobachte and self.beobachte_bis is not None and time.monotonic() > self.beobachte_bis:
            self.beobachte, self.beobachte_bis = None, None
        return self.beobachte

    def seite(self):
        """Zaehlerseite: seit Prozessstart (flach, wie bisher) plus Latenz, dazu der Dauer-
        bestand seit einem festen Zeitpunkt. Nur Zahlen, keine Inhalte."""
        werte, latenz = self.z.roh()
        aus = dict(werte)
        aus['start'] = self.start
        aus['offen'] = self.offen()
        aus['latenz'] = latenz_bild(latenz)
        if self.bestand.pfad:
            zs, ls = self.bestand.summe(self.z)
            aus['dauerhaft'] = {'seit': self.bestand.seit, 'zaehler': zs, 'latenz': latenz_bild(ls)}
        return aus


def baue_handler(proxy):
    class H(BaseHTTPRequestHandler):
        protocol_version = 'HTTP/1.1'
        server_version = 'wb-geheimnis-filter'

        def log_message(self, *a):   # keine Zugriffsprotokolle: Pfade koennen Inhalte tragen
            pass

        _durch = False   # Proxy-Modus: diese Anfrage unveraendert durchreichen

        def _ohne_filter(self):
            return proxy.durchreichen or self._durch

        def _antwort(self, code, text, kopf=None):
            body = (json.dumps({'error': {'type': 'wb_geheimnis_filter', 'message': text}}) + '\n').encode()
            self.send_response(code)
            self.send_header('Content-Type', 'application/json')
            for k, v in (kopf or {}).items():
                self.send_header(k, v)
            self.send_header('Content-Length', str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def _json(self, code, obj):
            body = json.dumps(obj, sort_keys=True).encode()
            self.send_response(code)
            self.send_header('Content-Type', 'application/json')
            self.send_header('Content-Length', str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def _wb(self):
            """Eigene Seiten unter /_wb/. -> True, wenn beantwortet."""
            pfad = self.path.split('?', 1)[0]
            if pfad == '/_wb/zaehler' and self.command == 'GET':
                self._json(200, proxy.seite())
                return True
            if pfad == '/_wb/sonde':
                # Beleg am laufenden Dienst ohne Mitschnitt: ein zur Laufzeit erzeugter
                # Testwert wird gezaehlt -- vor dem Filter, nach dem Filter (muss 0 bleiben)
                # und auf dem Rueckweg. Der Wert selbst wird nie ausgegeben.
                if self.command == 'POST':
                    wert = self._koerper().strip()
                    if len(wert) < 16:
                        self._antwort(400, 'Sonde: Wert mit mindestens 16 Zeichen erwartet')
                        return True
                    proxy.beobachte, proxy.beobachte_bis = wert, time.monotonic() + SONDE_DAUER
                    with proxy.z._l:
                        for k in NUR_LAUF:
                            proxy.z.werte.pop(k, None)
                elif self.command == 'DELETE':
                    proxy.beobachte, proxy.beobachte_bis = None, None
                elif self.command != 'GET':
                    return False
                w = proxy.z.bild()
                self._json(200, {'aktiv': proxy.beobachtet() is not None,
                                 'vor_filter': w.get('sonde_vor_filter', 0),
                                 'hinweg': w.get('hinweg_wert', 0), 'rueckweg': w.get('rueckweg_wert', 0)})
                return True
            return False

        def _bearbeite(self):
            self._phase = 'anfrage'
            self._antwort_begonnen = False
            self._zielhost = None
            try:
                if self.path.startswith('/_wb/') and self._wb():
                    return
                proxy.offen_plus(1)
                try:
                    self._weiter()
                finally:
                    proxy.offen_plus(-1)
            except Exception as exc:
                if isinstance(exc, UngueltigeAnfrage):
                    proxy.z.plus('anfrage_ungueltig')
                    code, text = 400, 'ungueltige Anfragekoerper-Laenge'
                elif self._phase == 'upstream_lesen' and isinstance(exc, (http.client.HTTPException, OSError)):
                    proxy.z.plus('upstream_stream_fehler')
                    proxy.z.plus('upstream_stream_fehler_' + fehlerklasse(exc))
                    if getattr(self, '_zielhost', None):
                        proxy.z.host_plus('upstream_stream_fehler_' + fehlerklasse(exc), self._zielhost)
                    code, text = 502, 'Anbieterantwort abgebrochen'
                elif isinstance(exc, (BrokenPipeError, ConnectionResetError)):
                    proxy.z.plus('client_abbruch')
                    proxy.z.plus('client_abbruch_' + fehlerklasse(exc))
                    code, text = None, None
                else:
                    proxy.z.plus('fehler_intern')
                    proxy.z.plus('fehler_intern_' + fehlerklasse(exc))
                    code, text = 500, 'interner Fehler im Geheimnisfilter'
                try:
                    # Nach begonnenem Rueckweg niemals eine zweite HTTP-Antwort senden.
                    if code is not None and not self._antwort_begonnen:
                        self._antwort(code, text)
                except Exception:
                    pass
                self.close_connection = True
            finally:
                proxy.bestand.speichern(proxy.z)

        do_GET = do_POST = do_PUT = do_DELETE = do_PATCH = do_HEAD = do_OPTIONS = \
            lambda self: self._bearbeite()

        def _koerper(self):
            if 'chunked' in (self.headers.get('Transfer-Encoding') or '').lower():
                teile = []
                while True:
                    zeile = self.rfile.readline()
                    try:
                        n = int(zeile.split(b';')[0].strip(), 16)
                        if n < 0:
                            raise ValueError()
                    except ValueError:
                        raise UngueltigeAnfrage() from None
                    if n == 0:
                        while self.rfile.readline() not in (b'\r\n', b'\n', b''):
                            pass
                        break
                    teile.append(self.rfile.read(n))
                    self.rfile.readline()
                return b''.join(teile)
            try:
                n = int(self.headers.get('Content-Length') or 0)
                if n < 0:
                    raise ValueError()
            except ValueError:
                raise UngueltigeAnfrage() from None
            return self.rfile.read(n) if n else b''

        def _weiter(self):
            z = proxy.z
            z.plus('anfragen')
            t0 = time.monotonic()
            if (self.headers.get('Upgrade') or '').lower() == 'websocket':
                z.plus('websocket_abgelehnt')
                self._antwort(426, 'WebSocket wird vom Geheimnisfilter nicht gefiltert; bitte HTTP')
                return
            teile = self.path.split('/', 2)
            name = teile[1] if len(teile) > 1 else ''
            ziel = proxy.routen.get(name)
            if not ziel:
                z.plus('route_unbekannt')
                self._antwort(404, 'unbekannte Route')
                return
            rest = '/' + (teile[2] if len(teile) > 2 else '')
            u = urlsplit(ziel)
            self._zielhost = u.hostname
            pfad = (u.path.rstrip('/') + rest) if u.path else rest
            body = self._koerper()
            kodierung = self.headers.get('Content-Encoding')
            self._klasse = groessenklasse(len(body))
            beob = proxy.beobachtet()
            if body and not self._ohne_filter():
                try:
                    roh = dekomprimiere(body, kodierung)
                except Exception:
                    z.plus('abgewiesen_kodierung')
                    self._antwort(502, 'Anfragekoerper nicht pruefbar (Kodierung); fail-closed')
                    return
                self._klasse = groessenklasse(len(roh))
                if beob and beob in roh:
                    z.plus('sonde_vor_filter')
                neu = self._filtern(roh)
                if neu is None:
                    return
                if neu is not roh or kodierung:
                    body, kodierung = neu, None
                else:
                    body = neu
            if beob and beob in body:
                z.plus('hinweg_wert')
            z.zeit('filter_hinweg', time.monotonic() - t0)
            z.latenz_plus(self._klasse, 'filter', time.monotonic() - t0)
            kopf = {k: v for k, v in self.headers.items() if k.lower() not in HOP_BY_HOP
                    and k.lower() != 'content-encoding'}
            if kodierung:
                kopf['Content-Encoding'] = kodierung
            kopf['Host'] = u.netloc
            kopf['Accept-Encoding'] = 'identity'
            kopf['Content-Length'] = str(len(body))
            senden = body if body or self.command in ('POST', 'PUT', 'PATCH') else None
            r = None
            gesendet = False   # klebrig: ein frueherer Versuch kann die Anfrage schon vollstaendig abgeschickt haben
            rueckfall = False  # hoechstens ein TLS-Rueckfall je Anfrage
            upload_neu = False  # hoechstens ein Neuversand nach Abbruch mitten im Upload je Anfrage
            # Nur zustandslose Modell-Aufrufe duerfen nach vollstaendiger Uebergabe noch einmal gesendet werden:
            # ein doppelter Aufruf kostet dort nur Token, der Client bekommt genau eine Antwort (decision 2026-11-07).
            zustandslos = self.command == 'GET' or (
                self.command == 'POST' and ZUSTANDSLOS_PFADE.search(urlsplit(pfad).path) is not None)
            for versuch in (0, 1, 2, 3):
                c = self._verbindung(u, neu=versuch > 0)
                wiederverwendet = getattr(c, '_wb_benutzt', False)
                c._wb_benutzt = True
                im_aufbau = False
                im_upload = False
                try:
                    if c.sock is None:
                        im_aufbau = True
                        self._verbinde_dns(c)
                        im_aufbau = False
                    # Bricht die Verbindung, bevor die ganze Anfrage (Kopf und Body nach Content-Length)
                    # an das Betriebssystem uebergeben ist, kann der Anbieter sie nicht verarbeitet haben:
                    # ein unvollstaendiger Body ist keine Anfrage. Erst danach gilt sie als gesendet.
                    im_upload = True
                    c.request(self.command, pfad, headers=kopf,
                              body=self._stuecke(c, senden) if senden and len(senden) > UPLOAD_STUECK else senden)
                    im_upload = False
                    gesendet = True
                    r = c.getresponse()
                    break
                except Exception as exc:
                    ursache = fehlerklasse(exc)
                    z.plus('upstream_versuch_' + ursache)
                    if im_upload:
                        # Der Anbieter kann schon waehrend des Uploads endgueltig geantwortet haben (etwa 413)
                        # und dann schliessen. Diese Antwort geht unveraendert durch, nie als 503.
                        r = self._fruehe_antwort(c, exc)
                        if r is not None:
                            z.plus('upstream_fruehantwort')
                            z.host_plus('upstream_fruehantwort', u.hostname)
                            break
                    c.close()
                    self._ups.pop((u.scheme, u.netloc), None)
                    if (im_aufbau and not rueckfall and isinstance(exc, (ConnectionResetError, ssl.SSLEOFError))
                            and getattr(c, '_context', None) is proxy.ctx and proxy.ctx_klassisch is not proxy.ctx
                            and u.scheme == 'https'):
                        grund = 'tls'
                    elif im_upload and not upload_neu and not wiederverwendet:
                        grund = 'upload'
                    elif wiederverwendet and versuch == 0:
                        # Bestehende Keepalive-Erholung: genau ein frischer Versuch,
                        # wenn die wiederverwendete Verbindung still geschlossen war.
                        # Dessen DNS darf vor dem Versand separat wiederholt werden.
                        grund = 'keepalive'
                    else:
                        break
                    # Nie neu senden, wenn der Upload bis zum Zeitlimit staute (der Client hat dann laengst selbst
                    # wiederholt), wenn der Client aufgegeben hat, oder wenn eine vollstaendig uebergebene Anfrage
                    # keine zustandslose Modellanfrage ist (Remote Control, Sitzungen, Unbekanntes).
                    if ursache == 'zeitlimit':
                        sperre = 'zeitlimit'
                    elif self._client_weg():
                        sperre = 'client_weg'
                    elif gesendet and not zustandslos:
                        sperre = 'uebergeben'
                    else:
                        sperre = None
                    if sperre:
                        z.plus('neuversand_gesperrt')
                        z.plus('neuversand_gesperrt_' + sperre)
                        z.host_plus('neuversand_gesperrt_' + sperre, u.hostname)
                        break
                    if grund == 'tls':
                        # Reset im TLS-Handshake: die Anfrage ist nie gesendet. Einmal mit klassischem
                        # Schluesselaustausch neu aufbauen und den Host fuer eine Stunde merken.
                        rueckfall = True
                        proxy.klassisch_merken(u.hostname)
                        z.plus('tls_klassisch_rueckfall')
                        z.host_plus('tls_klassisch_rueckfall', u.hostname)
                    elif grund == 'upload':
                        # Abbruch mitten im Upload auf frischer Verbindung (gemessen 06.11.2026: ein Netz
                        # brach 300-KB-Uploads nach 64 KB ab). Genau ein Neuversand auf neuer Verbindung.
                        upload_neu = True
                        z.plus('upload_abbruch_neu')
                        z.host_plus('upload_abbruch_neu', u.hostname)
            if r is None:
                z.plus('upstream_fehler')
                z.plus('upstream_fehler_' + ursache)
                z.host_plus('upstream_fehler_' + ursache, u.hostname)
                if not gesendet:
                    # Namensaufloesung oder Verbindungsaufbau scheiterte: die Anfrage hat den Anbieter nie
                    # erreicht, ein Wiederholen kostet nichts. 503 mit retry-after laesst die Harnesses selbst
                    # wiederholen (gemessen 02.11.2026, docs/NETZAUSFALL.md); der Text bleibt ehrlich.
                    z.plus('upstream_fehler_vor_versand')
                    self._antwort(503, 'Anbieter nicht erreichbar', {'Retry-After': str(WIEDERHOLEN_NACH)})
                else:
                    # Fehler nach dem Versand: der Anbieter kann die Anfrage schon haben, ein Wiederholen
                    # koennte das Modell doppelt aufrufen. Bleibt 502 ohne Wiederholungsangebot.
                    self._antwort(502, 'Anbieter nicht erreichbar')
                return
            z.zeit('bis_erstes_byte', time.monotonic() - t0)
            z.latenz_plus(self._klasse, 'erstes_byte', time.monotonic() - t0)
            self._lesezeit = 0.0
            t1 = time.monotonic()
            try:
                self._rueckweg(r)
                z.latenz_plus(self._klasse, 'rueckweg', max(0.0, time.monotonic() - t1 - self._lesezeit))
            finally:
                if r.will_close or not r.isclosed():
                    c.close()
                    self._ups.pop((u.scheme, u.netloc), None)

        def _client_weg(self):
            """Hat der Client die Verbindung geschlossen oder zurueckgesetzt? Blockiert nie. Lesbare Daten
            (etwa die naechste Anfrage) heissen verbunden; EOF, Fehler oder ein TLS-Alert heissen weg."""
            k = self.connection
            try:
                tls = isinstance(k, ssl.SSLSocket)
                if tls and k.pending():
                    return False
                if not select.select([k], [], [], 0)[0]:
                    return False
                roh = socket.socket.recv(k, 1, socket.MSG_PEEK)   # roher Socket, auch unter TLS
            except (OSError, ValueError):
                return True
            return roh == b'' or (tls and roh[:1] == b'\x15')

        def _stuecke(self, c, body):
            """Grosser Koerper in Stuecken zu einem TLS-Record. Vor jedem Stueck wartet der Filter, bis der Socket
            schreibbar ist, und prueft dabei, ob der Anbieter schon geantwortet hat (etwa 413). Dann endet der
            Upload, und die Antwort wird gelesen. Unter TLS ist sie nach einem Schreibfehler nicht mehr lesbar
            (gemessen 07.11.2026: BrokenPipeError beim Lesen), darum vor dem Fehler pruefen. Kommt bis zum
            Zeitlimit der Verbindung weder Platz noch Antwort, endet der Upload mit TimeoutError (Stau)."""
            sk = c.sock
            mv = memoryview(body)
            frist = sk.gettimeout()
            for i in range(0, len(mv), UPLOAD_STUECK):
                ende = None if frist is None else time.monotonic() + frist
                while True:
                    if isinstance(sk, ssl.SSLSocket) and sk.pending():
                        lesbar, schreibbar = True, False
                    else:
                        rest = None if ende is None else max(0.0, ende - time.monotonic())
                        lesbar, schreibbar, _ = select.select([sk], [sk], [], rest)
                        lesbar, schreibbar = bool(lesbar), bool(schreibbar)
                    if lesbar:
                        vorlauf = self._antwort_liegt(sk)
                        if vorlauf:
                            raise FrueheAntwort(vorlauf)
                    if schreibbar:
                        break
                    if ende is not None and time.monotonic() >= ende:
                        raise TimeoutError('Upload staut')
                yield mv[i:i + UPLOAD_STUECK]

        @staticmethod
        def _antwort_liegt(sk):
            """Nicht blockierend: schon empfangene Antwortbytes des Anbieters, sonst None. Ein TLS-1.3-Sitzungsticket
            macht den Socket lesbar, liefert aber keine Anwendungsdaten (SSLWantReadError) und zaehlt nicht.
            Schliesst der Anbieter ohne Antwort, ist das ein Abbruch im Upload (ConnectionResetError)."""
            alt = sk.gettimeout()
            try:
                sk.settimeout(0)
                daten = sk.recv(65536)
            except (ssl.SSLWantReadError, ssl.SSLWantWriteError, BlockingIOError):
                return None
            finally:
                try:
                    sk.settimeout(alt)
                except OSError:
                    pass
            if not daten:
                raise ConnectionResetError('Anbieter schloss waehrend des Uploads ohne Antwort')
            return daten

        def _fruehe_antwort(self, c, exc):
            """Nach einem Fehler im Upload die schon gesendete Antwort des Anbieters lesen, sonst None.
            FrueheAntwort traegt die ersten Bytes; sonst nur ohne TLS hoechstens FRUEHANTWORT_FRIST Sekunden aus
            dem Empfangspuffer."""
            sk = getattr(c, 'sock', None)
            if not isinstance(sk, socket.socket):
                return None
            try:
                if isinstance(exc, FrueheAntwort):
                    c.sock = _MitVorlauf(exc.vorlauf, sk)
                    r = c.getresponse()
                else:
                    sk.settimeout(FRUEHANTWORT_FRIST)
                    r = c.getresponse()
                    sk.settimeout(c.timeout)
            except Exception:
                return None
            r.will_close = True   # die Anfrage ist unvollstaendig: diese Verbindung nie wiederverwenden
            return r

        def _verbinde_dns(self, c):
            """Nur den Resolver wiederholen, vor TCP/TLS und HTTP-Versand.
            Clients mit kuerzerem Zeitlimit als 90 s koennen vorher abbrechen;
            keine ungefilterten Zwischenantworten. Ein blockierender Systemresolver
            darf im Daemon-Thread auslaufen, sein Ergebnis wird danach verworfen.
            """
            ende = time.monotonic() + proxy.dns_frist

            def aufloesen(host, port):
                fertig = threading.Event()
                ergebnis = []
                def resolver():
                    try:
                        ergebnis.append(socket.getaddrinfo(host, port, 0, socket.SOCK_STREAM))
                    except Exception as exc:
                        ergebnis.append(exc)
                    finally:
                        fertig.set()
                threading.Thread(target=resolver, daemon=True, name='wb-filter-dns').start()
                if not fertig.wait(max(0.0, ende - time.monotonic())):
                    raise socket.gaierror(socket.EAI_AGAIN, 'DNS-Frist abgelaufen')
                if isinstance(ergebnis[0], Exception):
                    raise ergebnis[0]
                return ergebnis[0]

            def verbinden(address, timeout, source_address=None):
                abstand = 0.25
                while True:
                    try:
                        adressen = aufloesen(*address)
                        break
                    except socket.gaierror:
                        rest = ende - time.monotonic()
                        if rest <= abstand:
                            if rest > 0:
                                time.sleep(rest)
                            proxy.z.plus('dns_aufgegeben')
                            proxy.z.host_plus('dns_aufgegeben', address[0])
                            raise
                        proxy.z.plus('upstream_versuch_dns')
                        time.sleep(abstand)
                        if time.monotonic() >= ende:
                            proxy.z.plus('dns_aufgegeben')
                            proxy.z.host_plus('dns_aufgegeben', address[0])
                            raise
                        proxy.z.plus('dns_wiederholt')
                        abstand = min(abstand * 2, 8.0)
                # Wie socket.create_connection: IPv4/IPv6-Adressen probieren, aber
                # niemals erneut aufloesen oder einen TCP/TLS-Fehler wiederholen.
                letzter = OSError('Keine Zieladresse')
                for af, typ, proto, _name, ziel in adressen:
                    sk = None
                    try:
                        sk = socket.socket(af, typ, proto)
                        sk.settimeout(timeout)
                        if source_address:
                            sk.bind(source_address)
                        sk.connect(ziel)
                        return sk
                    except OSError as exc:
                        letzter = exc
                        if sk is not None:
                            sk.close()
                raise letzter

            c._create_connection = verbinden
            c.connect()

        def _verbindung(self, u, neu=False):
            """Upstream-Verbindung je Downstream-Verbindung wiederverwenden: spart je Zug
            den TLS-Handshake zum Anbieter."""
            if not hasattr(self, '_ups'):
                self._ups = {}
            schl = (u.scheme, u.netloc)
            c = None if neu else self._ups.get(schl)
            if c is not None:
                proxy.z.plus('upstream_wiederverwendet')
                if not _ruhend_lebt(c):
                    # Das Ziel hat die ruhende Keepalive-Verbindung still geschlossen (EOF, close_notify, Reset).
                    # Vor dem ersten Byte frisch verbinden; die Anfrage ist dann nie auf einer toten Verbindung
                    # gesendet und braucht keinen Neuversand (decision 2026-11-07).
                    proxy.z.plus('upstream_versuch_ruhend_tot')
                    proxy.z.host_plus('upstream_versuch_ruhend_tot', u.hostname)
                    c.close()
                    c = None
            if c is None:
                if u.scheme == 'https':
                    c = http.client.HTTPSConnection(u.hostname, u.port or 443, timeout=600,
                                                    context=proxy.ctx_fuer(u.hostname))
                else:
                    c = http.client.HTTPConnection(u.hostname, u.port or 80, timeout=600)
                self._ups[schl] = c
            return c

        def finish(self):
            for c in getattr(self, '_ups', {}).values():
                c.close()
            super().finish()

        def _filtern(self, roh):
            z = proxy.z
            try:
                obj = json.loads(roh)
            except Exception:
                obj = None
            if obj is not None:
                obj, geaendert = filtere_json(obj, opake_orte(self.path, obj), proxy.tabelle, z)
                if not geaendert:
                    return roh
                z.plus('anfragen_gefiltert')
                return json.dumps(obj, ensure_ascii=False, separators=(',', ':')).encode('utf-8')
            try:
                text = roh.decode('utf-8')
            except UnicodeDecodeError:
                # Binaer: Muster laufen ueber die lesbare Form; ein Fund laesst sich nicht
                # sicher ersetzen -> abweisen statt durchlassen.
                text = roh.decode('utf-8', errors='replace')
                if geheimnisse_in(text, proxy.tabelle):
                    z.plus('abgewiesen_binaer')
                    self._antwort(502, 'Geheimnis in nicht ersetzbarem Anfragekoerper; fail-closed')
                    return None
                return roh
            neu = ersetze_text(text, proxy.tabelle, z)
            if neu == text:
                return roh
            z.plus('anfragen_gefiltert')
            return neu.encode('utf-8')

        def _rueckweg(self, r):
            z = proxy.z
            art = (r.getheader('Content-Type') or '').lower()
            kodiert = (r.getheader('Content-Encoding') or '').lower() not in ('', 'identity')
            if not art and not kodiert and self.command != 'HEAD':
                # chatgpt.com/backend-api/codex (ChatGPT-Abo) liefert den SSE-Strom ohne
                # Content-Type (gemessen 2026-10-10): am Anfang des Koerpers erkennen.
                try:
                    kopf = r.peek(64)[:64].lstrip()
                except Exception:
                    kopf = b''
                if kopf.startswith((b'event:', b'data:', b':')):
                    art = 'text/event-stream'
                    z.plus('antwort_sse_erkannt')
            strom = 'text/event-stream' in art or 'ndjson' in art
            self._antwort_begonnen = True
            self.send_response(r.status, r.reason)
            for k, v in r.getheaders():
                kl = k.lower()
                if kl in HOP_BY_HOP or kl == 'content-length':
                    continue
                if kl == 'content-encoding' and not self._ohne_filter() and not kodiert:
                    continue
                self.send_header(k, v)
            if self.command == 'HEAD' or r.status in (204, 304):
                self.send_header('Content-Length', '0')
                self.end_headers()
                return
            if self._ohne_filter() or kodiert or not (strom or 'json' in art):
                if kodiert and not self._ohne_filter():
                    z.plus('antwort_kodiert_unaufgeloest')
                self._roh_streamen(r)
                return
            if strom:
                self.send_header('Transfer-Encoding', 'chunked')
                self.end_headers()
                if 'ndjson' in art:
                    self._ndjson(r)
                else:
                    self._sse(r)
                self._chunk(b'')
                return
            daten = self._lies(r)
            try:
                obj = loese_json_auf(json.loads(daten), proxy.tabelle, z)
                daten = json.dumps(obj, ensure_ascii=False).encode('utf-8')
            except Exception:
                pass
            beob = proxy.beobachtet()
            if beob and beob in daten:
                z.plus('rueckweg_wert')
            self.send_header('Content-Length', str(len(daten)))
            self.end_headers()
            self.wfile.write(daten)

        def _chunk(self, b):
            beob = proxy.beobachte
            if beob and b and beob in b:
                proxy.z.plus('rueckweg_wert')
            self.wfile.write(b'%x\r\n%s\r\n' % (len(b), b))
            self.wfile.flush()

        def _lies(self, r, n=None):
            """Vom Anbieter lesen; die Wartezeit zaehlt nicht zur Rueckweg-Latenz."""
            t = time.monotonic()
            self._phase = 'upstream_lesen'
            try:
                return r.read1(n) if n else r.read()
            finally:
                self._lesezeit += time.monotonic() - t
                if sys.exc_info()[0] is None:
                    self._phase = 'antwort'

        def _roh_streamen(self, r):
            self.send_header('Transfer-Encoding', 'chunked')
            self.end_headers()
            while True:
                b = self._lies(r, 65536)
                if not b:
                    break
                self._chunk(b)
            self._chunk(b'')

        def _zeilen(self, r):
            puffer = b''
            while True:
                b = self._lies(r, 65536)
                if not b:
                    break
                puffer += b
                while b'\n' in puffer:
                    zeile, puffer = puffer.split(b'\n', 1)
                    yield zeile + b'\n'
            if puffer:
                yield puffer

        def _sse(self, r):
            sa = StromAufloeser(proxy.tabelle, proxy.z)
            block = []

            def schreibe(ereignisse):
                aus = []
                for name, obj in ereignisse:
                    if name is not None:
                        aus.append(b'event: ' + name.encode() + b'\n')
                    aus.append(b'data: ' + json.dumps(obj, ensure_ascii=False).encode('utf-8') + b'\n\n')
                return b''.join(aus)

            def mit_leerzeile(zeilen):
                # Die Leerzeile nimmt das Zeilenende der Zeilen an (CRLF bleibt CRLF); fehlt das
                # Zeilenende am Stromende, wird es ergaenzt.
                ende = b'\r\n' if zeilen[0].endswith(b'\r\n') else b'\n'
                teil = b''.join(zeilen)
                if not teil.endswith(b'\n'):
                    teil += ende
                return teil + ende

            def blockende():
                name, daten, sonst = None, [], []
                for z in block:
                    s = z.rstrip(b'\r\n')
                    if s.startswith(b'event:'):
                        name = s[6:].strip().decode('utf-8', 'replace')
                    elif s.startswith(b'data:'):
                        daten.append(s[5:][1:] if s[5:6] == b' ' else s[5:])
                    else:
                        sonst.append(z)
                roh = b'\n'.join(daten)
                obj = None
                if daten:
                    try:
                        obj = json.loads(roh)
                    except Exception:
                        obj = None
                if obj is None or sonst:
                    # Kein JSON (z. B. "[DONE]"), Zusatzfelder (id:, retry:) oder nur ein
                    # Kommentar (": heartbeat"): offene Reste zuerst, dann der Block unveraendert
                    # mit seiner Leerzeile, sonst verschmilzt er mit dem naechsten Ereignis.
                    out = schreibe(sa.ende())
                    self._chunk(out + mit_leerzeile(block))
                    return
                self._chunk(schreibe(sa.ereignis(obj, name)))

            for zeile in self._zeilen(r):
                if zeile.strip() == b'':
                    if block:
                        blockende()
                        block = []
                    continue
                block.append(zeile)
            if block:
                blockende()
            rest = sa.ende()
            if rest:
                self._chunk(schreibe(rest))

        def _ndjson(self, r):
            sa = StromAufloeser(proxy.tabelle, proxy.z)
            for zeile in self._zeilen(r):
                s = zeile.strip()
                if not s:
                    continue
                try:
                    obj = json.loads(s)
                except Exception:
                    self._chunk(zeile)
                    continue
                self._chunk(b''.join(json.dumps(o, ensure_ascii=False).encode('utf-8') + b'\n'
                                     for _n, o in sa.ereignis(obj)))
            for _n, o in sa.ende():
                self._chunk(json.dumps(o, ensure_ascii=False).encode('utf-8') + b'\n')

    return H


# ---------------------------------------------------------------------------
# Proxy-Modus (task, decision 10-13.). Claude verweigert Remote Control, sobald
# ANTHROPIC_BASE_URL auf einen lokalen Port zeigt. Stattdessen laeuft Claude mit
# HTTPS_PROXY=http://127.0.0.1:8093 und NODE_EXTRA_CA_CERTS=<zustand>/ca.pem (derselbe
# Port wie die Pfadrouten, mit --connect; abgenommen vom WorkbenchOrchestrator 13.10.):
#   - CONNECT zu einem Host aus MITM_HOSTS (nur api.anthropic.com) wird mit einem
#     Blattzertifikat aus der lokalen CA aufgebrochen; die Anfragen darin laufen durch
#     denselben Handler wie /anthropic/... auf 8093 (gleicher Filter, gleiche Tabelle,
#     gleiche Zaehler) und gehen per TLS mit voller Zertifikatspruefung weiter;
#   - CONNECT zu jedem anderen Host ist ein reiner Tunnel ohne Eingriff.
# Die CA traegt die Namensbeschraenkung permitted DNS:api.anthropic.com: ein Blatt fuer
# einen anderen Namen lehnt jeder pruefende Client ab, selbst wenn der Schluessel
# abhanden kommt. Sie liegt nur im Zustandsordner (0700, Schluessel 0600) und kommt nie
# in einen System-Trust-Store; vertraut wird ihr nur ueber NODE_EXTRA_CA_CERTS.

MITM_HOSTS = {'api.anthropic.com': 'anthropic'}   # Host -> Route (geheimnis-routen.json)
CA_TAGE = 30         # Gueltigkeit einer neuen CA
CA_ERNEUERN_TAGE = 7     # beim Start erneuern, wenn weniger Rest bleibt
BLATT_SEK = 3 * 86400    # Gueltigkeit eines Blattzertifikats
BLATT_ERNEUERN_SEK = 86400   # neues Blatt, wenn weniger Rest bleibt
TUNNEL_PUFFER = 65536
TUNNEL_LEERLAUF = 900    # Sekunden ohne Bytes in beide Richtungen, dann schliessen
# Was im aufgebrochenen Verkehr durch den Filter geht (Messung task 13.10.): die
# Modellanfragen. Alles andere (bootstrap, oauth, event_logging, mcp_servers, der lange
# Remote-Control-Strom .../worker/events/stream) wird unveraendert durchgereicht.
FILTER_PFADE = re.compile(r'^/v1/messages(/count_tokens)?/?$')
# Remote-Control-Spiegel des Sitzungsprotokolls (POST/PUT/PATCH/DELETE unter /v1/code/sessions/,
# u. a. .../worker/events, .../worker): Vorgabe filtern -- decision 10-13Z,
# Fragefunktion: "Platzhalter auf dem Handy". Das Handy (claude.ai) zeigt Platzhalter;
# einen Rueckweg (Aufloesen) gibt es fuer den Spiegel nicht. Schalter --rc-spiegel
# durchreichen schaltet das ab.
# Ueberholt (nicht mehr gueltig): Vorgabe durchreichen -- decision 10-13 frueher:
# "Handy wie Maschine", d. h. das Handy zeigt dasselbe wie das Terminal, der Filter wirkt
# nur auf das, was das Modell bekommt. Durch die Antwort 21:09Z korrigiert.
RC_PFADE = re.compile(r'^/v1/code/sessions/')
DURCH_ZEITLIMIT = 3600   # durchgereichte lange Stroeme (worker/events/stream) halten


def _openssl():
    for p in (os.environ.get('WB_GF_OPENSSL'), '/opt/homebrew/bin/openssl', shutil.which('openssl'),
              '/usr/bin/openssl'):
        if p and os.path.isfile(p) and os.access(p, os.X_OK):
            return p
    raise SystemExit('wb-geheimnis-filter: openssl fehlt (fuer die lokale CA des Proxy-Modus)')


def _ossl(*args):
    p = subprocess.run((_openssl(),) + args, capture_output=True, text=True)
    if p.returncode != 0:
        # Nur die letzte Zeile: openssl gibt keine Schluesselinhalte aus, aber kurz halten.
        raise RuntimeError('openssl %s: %s' % (args[0], (p.stderr.strip().splitlines() or ['?'])[-1]))
    return p.stdout


def _rest_sek(pem):
    """Restlaufzeit eines Zertifikats in Sekunden (negativ: abgelaufen)."""
    aus = _ossl('x509', '-in', pem, '-noout', '-enddate').strip()
    return ssl.cert_time_to_seconds(aus.split('=', 1)[1]) - time.time()


def _privat_schreiben_vorbereiten(ordner):
    os.makedirs(ordner, mode=0o700, exist_ok=True)
    os.chmod(ordner, 0o700)


def _ca_erzeugen(ordner, name, tage, hosts):
    """Neue CA ordner/<name>.key (0600) und <name>.pem mit Namensbeschraenkung."""
    key, pem, cnf = (os.path.join(ordner, name + e) for e in ('.key', '.pem', '.cnf'))
    with open(cnf, 'w') as f:
        f.write('[req]\ndistinguished_name=dn\nprompt=no\nx509_extensions=ext\n'
                '[dn]\nCN=wb-geheimnis-filter lokale CA %s\nO=Werkbank (nur lokal)\n'
                '[ext]\nbasicConstraints=critical,CA:TRUE,pathlen:0\n'
                'keyUsage=critical,keyCertSign,cRLSign\n'
                'subjectKeyIdentifier=hash\nauthorityKeyIdentifier=keyid:always\n'
                'nameConstraints=critical,%s\n'
                % (time.strftime('%Y-%m-%d'), ','.join('permitted;DNS:' + h for h in sorted(hosts))))
    alt = os.umask(0o077)
    try:
        _ossl('ecparam', '-name', 'prime256v1', '-genkey', '-noout', '-out', key + '.neu')
        os.chmod(key + '.neu', 0o600)
        _ossl('req', '-new', '-x509', '-key', key + '.neu', '-days', str(tage), '-sha256',
              '-config', cnf, '-out', pem + '.neu')
    finally:
        os.umask(alt)
        os.unlink(cnf)
    os.chmod(pem + '.neu', 0o644)
    os.replace(key + '.neu', key)
    os.replace(pem + '.neu', pem)


def ca_sicherstellen(ordner, tage=CA_TAGE, erneuern_tage=CA_ERNEUERN_TAGE, hosts=None):
    """CA anlegen oder erneuern; -> Pfad des Buendels ca.pem fuer NODE_EXTRA_CA_CERTS.

    Bei Erneuerung wird die bisherige CA zu ca-alt.*: Claude liest NODE_EXTRA_CA_CERTS nur
    beim Start, laufende Sitzungen kennen also nur die alte CA. Darum signiert der Proxy
    weiter mit der alten, solange sie ein ganzes Blatt ueberdauert (blatt_signierer), und
    ca.pem enthaelt beide (Buendel). Danach faellt ca-alt weg."""
    hosts = set(hosts or MITM_HOSTS)
    _privat_schreiben_vorbereiten(ordner)
    neu = os.path.join(ordner, 'ca-neu.pem')
    alt = os.path.join(ordner, 'ca-alt.pem')
    if not (os.path.isfile(neu) and os.path.isfile(neu[:-4] + '.key')) or _rest_sek(neu) < erneuern_tage * 86400:
        if os.path.isfile(neu) and os.path.isfile(neu[:-4] + '.key') and _rest_sek(neu) > 0:
            os.replace(neu[:-4] + '.key', alt[:-4] + '.key')
            os.replace(neu, alt)
        _ca_erzeugen(ordner, 'ca-neu', tage, hosts)
    if os.path.isfile(alt) and _rest_sek(alt) <= 0:
        for p in (alt, alt[:-4] + '.key'):
            os.unlink(p)
    for p in (neu[:-4] + '.key', alt[:-4] + '.key'):
        if os.path.exists(p):
            os.chmod(p, 0o600)
    buendel = os.path.join(ordner, 'ca.pem')
    teile = [open(p).read() for p in (neu, alt) if os.path.isfile(p)]
    with open(buendel + '.neu', 'w') as f:
        f.write(''.join(teile))
    os.chmod(buendel + '.neu', 0o644)
    os.replace(buendel + '.neu', buendel)
    return buendel


def blatt_signierer(ordner):
    """Die CA, mit der Blaetter entstehen: die alte, solange sie ein Blatt ueberdauert."""
    alt = os.path.join(ordner, 'ca-alt.pem')
    if os.path.isfile(alt) and _rest_sek(alt) > BLATT_SEK + 3600:
        return alt
    return os.path.join(ordner, 'ca-neu.pem')


class Blaetter:
    """Kurzlebige Blattzertifikate je MITM-Host, als Server-SSLContext zwischengespeichert."""

    def __init__(self, ordner, sek=BLATT_SEK, hosts=None):
        self.ordner = ordner
        self.sek = sek
        self.hosts = hosts
        self._l = threading.Lock()
        self._ctx = {}   # host -> (ablauf, ctx)

    def ctx(self, host):
        with self._l:
            ablauf, ctx = self._ctx.get(host, (0, None))
            if ctx is None or ablauf - time.time() < BLATT_ERNEUERN_SEK:
                ablauf, ctx = self._erzeugen(host)
                self._ctx[host] = (ablauf, ctx)
            return ctx

    def _erzeugen(self, host):
        # Der Dienst laeuft unter launchd/systemd beliebig lange: CA-Erneuerung auch hier,
        # nicht nur beim Start (sonst ueberlebte ein Blatt seine CA).
        ca_sicherstellen(self.ordner, hosts=self.hosts)
        ca = blatt_signierer(self.ordner)
        d = os.path.join(self.ordner, 'blatt')
        _privat_schreiben_vorbereiten(d)
        key, csr, pem, cnf = (os.path.join(d, host + e) for e in ('.key', '.csr', '.pem', '.cnf'))
        with open(cnf, 'w') as f:
            f.write('[req]\ndistinguished_name=dn\nprompt=no\n[dn]\nCN=%s\n'
                    '[ext]\nbasicConstraints=critical,CA:FALSE\nkeyUsage=critical,digitalSignature\n'
                    'extendedKeyUsage=serverAuth\nsubjectAltName=DNS:%s\n'
                    'subjectKeyIdentifier=hash\nauthorityKeyIdentifier=keyid\n' % (host, host))
        alt = os.umask(0o077)
        try:
            _ossl('ecparam', '-name', 'prime256v1', '-genkey', '-noout', '-out', key)
            _ossl('req', '-new', '-key', key, '-config', cnf, '-out', csr)
            tage = max(1, int(self.sek // 86400))
            _ossl('x509', '-req', '-in', csr, '-CA', ca, '-CAkey', ca[:-4] + '.key', '-set_serial',
                  str(int.from_bytes(os.urandom(8), 'big')), '-days', str(tage), '-sha256',
                  '-extfile', cnf, '-extensions', 'ext', '-out', pem)
            with open(pem, 'a') as f:   # Kette: Blatt + signierende CA
                f.write(open(ca).read())
            ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
            ctx.minimum_version = ssl.TLSVersion.TLSv1_2
            ctx.set_alpn_protocols(['http/1.1'])
            ctx.load_cert_chain(pem, key)
        finally:
            os.umask(alt)
            for p in (csr, cnf):
                if os.path.exists(p):
                    os.unlink(p)
        return time.time() + _rest_sek(pem), ctx


def _pumpe(a, b, z):
    """Bytes in beide Richtungen unveraendert weiterreichen, bis eine Seite schliesst."""
    # selectors (kqueue/epoll) statt select.select: Deskriptoren ueber 1024 (viele parallele
    # Tunnel aus Bash-Aufrufen) sprengen FD_SETSIZE nicht.
    for s in (a, b):
        s.setblocking(True)
    sel = selectors.DefaultSelector()
    try:
        sel.register(a, selectors.EVENT_READ, b)
        sel.register(b, selectors.EVENT_READ, a)
        while True:
            bereit = sel.select(TUNNEL_LEERLAUF)
            if not bereit:
                z.plus('tunnel_leerlauf')
                return
            for schluessel, _ in bereit:
                daten = schluessel.fileobj.recv(TUNNEL_PUFFER)
                if not daten:
                    return
                schluessel.data.sendall(daten)
    except OSError as exc:
        z.plus('tunnel_abbruch_' + fehlerklasse(exc))
    finally:
        sel.close()


def _struktur(obj, tiefe=0):
    """JSON-Geruest ohne Werte: Schluessel und Typen. Schluessel, die wie Daten aussehen
    (lang oder kein Bezeichner), werden zu <schluessel>."""
    if tiefe > 12:
        return '...'
    if isinstance(obj, dict):
        aus = {}
        for k, v in obj.items():
            name = k if re.fullmatch(r'[A-Za-z_][A-Za-z0-9_.-]{0,39}', k) else '<schluessel>'
            aus[name] = _struktur(v, tiefe + 1)
        return aus
    if isinstance(obj, list):
        teile = []
        for v in obj[:50]:
            st = _struktur(v, tiefe + 1)
            if st not in teile:
                teile.append(st)
        return teile
    return type(obj).__name__


class StrukturProtokoll:
    """Messhilfe fuer den Remote-Control-Spiegel: je Pfadmuster und Geruest eine Zeile
    (JSON) in einer 0600-Datei, nie Werte. Nur mit --struktur-datei."""

    def __init__(self, pfad):
        self.pfad = pfad
        self._l = threading.Lock()
        self._gesehen = set()

    def notiere(self, methode, pfad, roh):
        try:
            obj = json.loads(roh)
        except Exception:
            obj = None
        muster = re.sub(r'/sessions/[^/]+', '/sessions/*', pfad.split('?', 1)[0])
        muster = re.sub(r'/[0-9a-fA-F-]{16,}(?=/|$)', '/*', muster)
        zeile = json.dumps({'methode': methode, 'pfad': muster,
                            'struktur': _struktur(obj) if obj is not None else 'kein JSON'}, sort_keys=True)
        with self._l:
            if zeile in self._gesehen:
                return
            self._gesehen.add(zeile)
            fd = os.open(self.pfad, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
            try:
                os.write(fd, zeile.encode() + b'\n')
            finally:
                os.close(fd)


def _orte_rc(o, orte):
    """Spiegel: Nur Bloecke unter `message.content` sind Protokollbloecke. Werkzeugeingaben
    (`input`) tragen beliebige Daten und bleiben aussen vor."""
    if isinstance(o, dict):
        nachricht = o.get('message')
        if isinstance(nachricht, dict):
            for block in _dicts(nachricht.get('content')):
                orte.felder(block, [f for f in opake_felder(block) if f in RC_OPAK])
        for k, v in o.items():
            if k != 'input':
                _orte_rc(v, orte)
    elif isinstance(o, list):
        for v in o:
            _orte_rc(v, orte)


def baue_proxy_handler(proxy, blaetter, mitm=None, rc_spiegel=True, struktur=None):
    """Handler des Filterports mit CONNECT: Pfadrouten wie baue_handler, dazu HTTPS_PROXY."""
    mitm = dict(MITM_HOSTS if mitm is None else mitm)
    H = baue_handler(proxy)

    class Aufgebrochen(H):
        """Anfragen im aufgebrochenen Tunnel: Pfad bekommt das Routenpraefix, alles
        weitere (Filter, Rueckweg, SSE, Keep-Alive) ist der Handler von 8093. Gefiltert
        werden nur FILTER_PFADE und (Schalter) der Remote-Control-Spiegel; der Rest geht
        unveraendert durch."""
        route = None

        def _bearbeite(self):
            if not self.path.startswith('/'):
                self._antwort(400, 'absolute Ziel-URL im Tunnel nicht erlaubt')
                self.close_connection = True
                return
            pfad = self.path.split('?', 1)[0]
            rc = RC_PFADE.match(pfad) and self.command in ('POST', 'PUT', 'PATCH', 'DELETE')
            self._durch = not (FILTER_PFADE.match(pfad) or (rc and rc_spiegel))
            proxy.z.plus('mitm_durchgereicht' if self._durch else 'mitm_gefiltert')
            self._rc = bool(rc)
            self.path = '/' + self.route + self.path
            super()._bearbeite()

        def do_CONNECT(self):   # kein CONNECT im aufgebrochenen Tunnel
            self._antwort(400, 'CONNECT im Tunnel nicht erlaubt')
            self.close_connection = True

        def _filtern(self, roh):
            if not self._rc:
                return super()._filtern(roh)
            if struktur is not None:
                struktur.notiere(self.command, self.path, roh)
            z = proxy.z
            z.plus('rc_spiegel_gefiltert')
            try:
                obj = json.loads(roh)
            except Exception:
                obj = None
            if obj is None:
                neu = super()._filtern(roh)
            else:
                # Gleiches Geruest, nur Zeichenketten-Werte ersetzt; Content-Length setzt
                # _weiter neu.
                orte = Orte()
                _orte_rc(obj, orte)
                obj, geaendert = filtere_json(obj, orte, proxy.tabelle, z)
                neu = json.dumps(obj, ensure_ascii=False, separators=(',', ':')).encode('utf-8') if geaendert else roh
            if neu is not None and neu is not roh:
                z.plus('rc_spiegel_ersetzt')
            return neu

        def _verbindung(self, u, neu=False):
            c = super()._verbindung(u, neu)
            c.timeout = DURCH_ZEITLIMIT if self._durch else 600
            if c.sock is not None:
                c.sock.settimeout(c.timeout)
            return c

        def _wb(self):   # eigene Seiten nie ueber den Anbieter-Hostnamen
            return False

    class P(H):
        def do_CONNECT(self):
            self.close_connection = True
            ziel = self.path
            host, _, port = ziel.rpartition(':')
            host = host.strip('[]').lower()
            try:
                port = int(port)
            except ValueError:
                self._antwort(400, 'CONNECT host:port erwartet')
                return
            if not host or not 0 < port < 65536:
                self._antwort(400, 'CONNECT host:port erwartet')
                return
            if host in mitm and port == 443:
                self._aufbrechen(host)
            else:
                self._tunnel(host, port)

        def _tunnel(self, host, port):
            proxy.z.plus('tunnel')
            try:
                # Gleiche DNS-Wiederholung wie der Filterweg (Messung task: gaierror
                # beim Telemetrie-CONNECT); TCP-Fehler werden nicht wiederholt.
                c = http.client.HTTPConnection(host, port, timeout=30)
                self._verbinde_dns(c)
                oben = c.sock
            except OSError as exc:
                proxy.z.plus('tunnel_fehler_' + fehlerklasse(exc))
                proxy.z.host_plus('tunnel_fehler_' + fehlerklasse(exc), host)
                self._antwort(502, 'Ziel nicht erreichbar')
                return
            try:
                self.send_response(200, 'Connection Established')
                self.end_headers()
                self.wfile.flush()
                oben.settimeout(None)
                _pumpe(self.connection, oben, proxy.z)
            finally:
                oben.close()

        def _aufbrechen(self, host):
            proxy.z.plus('mitm')
            try:
                ctx = blaetter.ctx(host)
            except Exception as exc:
                proxy.z.plus('mitm_blatt_fehler_' + fehlerklasse(exc))
                self._antwort(502, 'Blattzertifikat nicht erzeugbar; fail-closed')
                return
            self.send_response(200, 'Connection Established')
            self.end_headers()
            self.wfile.flush()
            try:
                tls = ctx.wrap_socket(self.connection, server_side=True)
            except (ssl.SSLError, OSError) as exc:
                # Typisch: Client vertraut der CA nicht (NODE_EXTRA_CA_CERTS fehlt).
                proxy.z.plus('mitm_handshake_fehler')
                proxy.z.plus('mitm_handshake_fehler_' + fehlerklasse(exc))
                return
            Innen = type('Innen', (Aufgebrochen,), {'route': mitm[host]})
            try:
                Innen(tls, self.client_address, self.server)
            finally:
                try:
                    tls.close()
                except OSError:
                    pass

    return P


class Server(ThreadingHTTPServer):
    daemon_threads = True
    allow_reuse_address = False
    # Vorgabe von socketserver ist 5: unter vielen gleichzeitigen CONNECTs (Bash-Aufrufe mit
    # geerbtem HTTPS_PROXY) liefen Verbindungen in Zeitlimits (Lasttest task 13.10.).
    # Gilt fuer selbst gebundene Sockets; launchd/systemd setzen den Backlog ihres Sockets.
    request_queue_size = 1024

    def __init__(self, adresse, handler, sock=None):
        if sock is None:
            super().__init__(adresse, handler)
            return
        # Socket-Aktivierung: launchd bzw. systemd haelt den Lauschsocket; er wird
        # uebernommen, nicht neu gebunden.
        super().__init__(adresse, handler, bind_and_activate=False)
        self.socket.close()
        self.socket = sock
        self.server_address = sock.getsockname()[:2]
        self.server_name, self.server_port = self.server_address

    def handle_error(self, request, client_address):
        """socketserver druckt sonst jede Ausnahme samt Traceback auf stderr (launchd-Log);
        gemessen waren es nur Verbindungsabbrueche, aber ein Ausnahmetext koennte Inhalt
        tragen. Nur zaehlen, nichts ausgeben."""
        z = getattr(self, 'zaehler', None)
        if z is not None:
            z.plus('verbindungsfehler')
            z.plus('verbindungsfehler_' + fehlerklasse(sys.exc_info()[1]))


LAUNCHD_SOCKETNAME = 'filter'


def launchd_sockets(name):
    """Von launchd gehaltene Deskriptoren fuer <name> (launch_activate_socket(3), wie in
    wb-modell-proxy). Rueckgabewert ungleich 0 ist die errno (ESRCH: nicht von launchd
    gestartet, ENOENT: Name fehlt im Sockets-Dict der plist)."""
    import ctypes
    libc = ctypes.CDLL(None, use_errno=True)
    fn = libc.launch_activate_socket
    fn.argtypes = [ctypes.c_char_p, ctypes.POINTER(ctypes.POINTER(ctypes.c_int)),
                   ctypes.POINTER(ctypes.c_size_t)]
    fn.restype = ctypes.c_int
    libc.free.argtypes = [ctypes.c_void_p]
    libc.free.restype = None
    vektor = ctypes.POINTER(ctypes.c_int)()
    anzahl = ctypes.c_size_t(0)
    rc = fn(name.encode('utf-8'), ctypes.byref(vektor), ctypes.byref(anzahl))
    if rc != 0:
        raise OSError(rc, "launch_activate_socket('%s'): %s" % (name, os.strerror(rc)))
    fds = [vektor[i] for i in range(anzahl.value)]
    libc.free(vektor)
    return fds


def aktivierter_socket():
    """Den von systemd (LISTEN_FDS, ab fd 3) oder launchd uebergebenen Lauschsocket holen.
    Nur Loopback wird angenommen: ein falsch eingerichteter Socket auf einer anderen Adresse
    beendet den Dienst, statt Anfragen von aussen zu filtern und weiterzuleiten."""
    fds = []
    if os.environ.get('LISTEN_PID') == str(os.getpid()) and os.environ.get('LISTEN_FDS', '').isdigit():
        fds = list(range(3, 3 + int(os.environ['LISTEN_FDS'])))
    elif sys.platform == 'darwin':
        try:
            fds = launchd_sockets(LAUNCHD_SOCKETNAME)
        except OSError as e:
            sys.exit('wb-geheimnis-filter: --aktiviert, aber kein Socket von launchd (%s)' % e)
    if not fds:
        sys.exit('wb-geheimnis-filter: --aktiviert, aber weder systemd noch launchd uebergab einen Socket')
    socks = [socket.socket(fileno=fd) for fd in fds]
    for sk in socks[1:]:
        sk.close()
    sk = socks[0]
    if sk.getsockname()[0] != '127.0.0.1':
        sys.exit('wb-geheimnis-filter: uebergebener Socket liegt nicht auf 127.0.0.1 -- Abbruch')
    # Unter macOS erben angenommene Verbindungen O_NONBLOCK vom Lauschsocket.
    sk.setblocking(True)
    return sk


def _fd_grenze_anheben(ziel=8192):
    """launchd startet mit 256 offenen Dateien; jeder Tunnel braucht zwei. Weiche Grenze
    bis zur harten anheben (keine Rechte noetig)."""
    import resource
    weich, hart = resource.getrlimit(resource.RLIMIT_NOFILE)
    neu = ziel if hart == resource.RLIM_INFINITY else min(ziel, hart)
    if weich != resource.RLIM_INFINITY and weich < neu:
        try:
            resource.setrlimit(resource.RLIMIT_NOFILE, (neu, hart))
        except (ValueError, OSError):
            pass


