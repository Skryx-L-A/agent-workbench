ROUTEN_NAME_RX = re.compile(r'[A-Za-z0-9_-]+')


class RoutenUngueltig(Exception):
    """Die Routentabelle ist unbrauchbar; der Text ist ein ganzer Satz fuer das Log."""


def _routen_paare(paare):
    """object_pairs_hook: ein doppelter Name waere sonst still der letzte Wert."""
    d = {}
    for k, v in paare:
        if k in d:
            raise RoutenUngueltig("Der Name '%s' steht in der Routentabelle doppelt." % k)
        d[k] = v
    return d


def _ist_loopback(host):
    if host == 'localhost':
        return True
    try:
        return ipaddress.ip_address(host).is_loopback
    except ValueError:
        return False


def routen_pruefen(datei):
    """Die eingebauten Routen aus DATEI lesen und pruefen -> {Name: Ziel}. Die eine Pruefung fuer den Filter und den
    Dienst-Installer. Gueltig: ein Objekt mit genau dem Feld `routen`, darin mindestens eine Route; Name aus
    Buchstaben, Ziffern, _ und -; Ziel eine URL mit Host ohne Zugangsdaten, Abfrage und Fragment, `https://` oder
    `http://` nur zu Loopback (lokale Motoren); jede Route der aufzubrechenden Hosts (MITM_HOSTS) ist vorhanden.
    Sonst RoutenUngueltig mit einem ganzen Satz."""
    try:
        with open(datei, encoding='utf-8') as f:
            roh = json.load(f, object_pairs_hook=_routen_paare)
    except FileNotFoundError:
        raise RoutenUngueltig("Die Routentabelle %s fehlt." % datei) from None
    except RoutenUngueltig:
        raise
    except (OSError, UnicodeDecodeError, ValueError) as exc:
        raise RoutenUngueltig("Die Routentabelle %s ist nicht lesbar oder kein JSON (%s)." % (datei, exc)) from None
    if not isinstance(roh, dict) or not isinstance(roh.get('routen'), dict):
        raise RoutenUngueltig("Die Routentabelle %s braucht ein Objekt mit dem Feld 'routen'." % datei)
    fremd = sorted(set(roh) - {'routen'})
    if fremd:
        raise RoutenUngueltig("Die Routentabelle %s hat unbekannte Felder: %s." % (datei, ', '.join(map(str, fremd))))
    tabelle = roh['routen']
    if not tabelle:
        raise RoutenUngueltig("Die Routentabelle %s hat keine Route." % datei)
    for name, ziel in tabelle.items():
        if not ROUTEN_NAME_RX.fullmatch(name):
            raise RoutenUngueltig("Der Routenname '%s' darf nur Buchstaben, Ziffern, _ und - enthalten." % name)
        if not isinstance(ziel, str) or not ziel or ziel != ziel.strip() or any(c.isspace() or ord(c) < 32 for c in ziel):
            raise RoutenUngueltig("Das Ziel der Route '%s' muss eine URL ohne Leerraum sein." % name)
        try:
            teile = urlsplit(ziel)
            host, _port = teile.hostname, teile.port
        except ValueError:
            raise RoutenUngueltig("Das Ziel der Route '%s' ist keine gueltige URL." % name) from None
        if teile.scheme not in ('http', 'https') or not host:
            raise RoutenUngueltig("Das Ziel der Route '%s' braucht http(s) und einen Host." % name)
        if teile.username is not None or teile.password is not None or teile.query or teile.fragment:
            raise RoutenUngueltig("Das Ziel der Route '%s' darf keine Zugangsdaten, Abfrage oder Fragment tragen." % name)
        if teile.scheme == 'http' and not _ist_loopback(host):
            raise RoutenUngueltig("Das Ziel der Route '%s' nutzt http ausserhalb von Loopback; ein entferntes Ziel braucht https." % name)
    for host, route in MITM_HOSTS.items():
        if route not in tabelle:
            raise RoutenUngueltig("Die Route '%s' fuer den aufzubrechenden Host %s fehlt in der Routentabelle." % (route, host))
    return dict(tabelle)


