# Latenzverteilung (Dienstbetrieb, Auftrag filter-live 2026-10-10): je Groessenklasse der
# Anfrage ein Histogramm mit geometrischen Eimern (Faktor 1.25, 0.1 ms bis 30 min). Median
# und p90 werden als OBERE Eimergrenze gemeldet, also hoechstens 25 % zu hoch, nie zu niedrig.
GROESSENKLASSEN = ((32 * 1024, 'bis_32k'), (256 * 1024, 'bis_256k'), (1024 * 1024, 'bis_1m'),
                   (None, 'ueber_1m'))
EIMER_MS = []
_g = 0.1
while _g < 1800000:
    EIMER_MS.append(round(_g, 3))
    _g *= 1.25
EIMER_MS.append(float('inf'))
# Latenzarten: filter = Hinweg im Proxy (Koerper lesen, pruefen, ersetzen) bis zum Absenden;
# rueckweg = Rechenzeit des Rueckwegs ohne Warten auf den Anbieter; erstes_byte = bis die
# Antwortkoepfe des Anbieters da sind (enthaelt die Modellzeit, nur zur Einordnung).
LATENZARTEN = ('filter', 'rueckweg', 'erstes_byte')


def groessenklasse(n):
    for grenze, name in GROESSENKLASSEN:
        if grenze is None or n <= grenze:
            return name


def _eimer(ms):
    lo, hi = 0, len(EIMER_MS) - 1
    while lo < hi:
        mid = (lo + hi) // 2
        if ms <= EIMER_MS[mid]:
            hi = mid
        else:
            lo = mid + 1
    return lo


def quantil(eimer, q):
    n = sum(eimer)
    if not n:
        return None
    ziel, summe = q * n, 0
    for i, c in enumerate(eimer):
        summe += c
        if summe >= ziel:
            return EIMER_MS[i] if EIMER_MS[i] != float('inf') else None
    return None


def latenz_bild(latenz):
    """{klasse: {art: [eimer]}} -> {klasse: {art: {n, median_ms, p90_ms}}}"""
    aus = {}
    for klasse, arten in sorted(latenz.items()):
        for art, eimer in sorted(arten.items()):
            aus.setdefault(klasse, {})[art] = {'n': sum(eimer), 'median_ms': quantil(eimer, 0.5),
                                               'p90_ms': quantil(eimer, 0.9)}
    return aus


# Fehler je Zielhost (Diagnose, 04.11.2026): welcher Host hinter einem Fehler steht, nur der Hostname, nie Pfad,
# Port oder Inhalt. Schluessel 'zielhost:<fehlerart>@<host>'. Ein CONNECT nennt beliebige Hosts, darum ist die Zahl
# der Hosts begrenzt (ZIELHOST_MAX, der Rest zaehlt unter '(weitere)'), und ein Name, der kein Hostname ist, zaehlt
# unter '(ungueltig)'. So kann ueber den Host weder Inhalt noch eine unbegrenzte Schluesselzahl in den Bestand.
ZIELHOST_PRAEFIX = 'zielhost:'
ZIELHOST_MAX = 64
ZIELHOST_WEITERE = '(weitere)'
ZIELHOST_UNGUELTIG = '(ungueltig)'
ZIELHOST_ZEILE = 15   # so viele Eintraege zeigt die lesbare Ansicht, die meisten Fehler zuerst
_HOST_MUSTER = re.compile(r'(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)*[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?|[0-9a-f:.]{2,45}')


def zielhost_name(host):
    h = (host or '').strip().strip('[]').lower().rstrip('.')
    if not h or len(h) > 253 or not _HOST_MUSTER.fullmatch(h):
        return ZIELHOST_UNGUELTIG
    return h


def zielhost_teile(schluessel):
    """'zielhost:<art>@<host>' -> (art, host), sonst None."""
    if not schluessel.startswith(ZIELHOST_PRAEFIX) or '@' not in schluessel:
        return None
    art, _, host = schluessel[len(ZIELHOST_PRAEFIX):].rpartition('@')
    return art, host


def zielhost_begrenzen(werte):
    """Hoechstens ZIELHOST_MAX Hosts behalten (die mit den meisten Fehlern), den Rest unter '(weitere)' zusammenlegen."""
    je_host = {}
    for k, v in werte.items():
        t = zielhost_teile(k)
        if t and t[1] != ZIELHOST_WEITERE:
            je_host[t[1]] = je_host.get(t[1], 0) + v
    if len(je_host) <= ZIELHOST_MAX:
        return werte
    behalten = set(sorted(je_host, key=lambda h: (-je_host[h], h))[:ZIELHOST_MAX])
    aus = {}
    for k, v in werte.items():
        t = zielhost_teile(k)
        if t and t[1] != ZIELHOST_WEITERE and t[1] not in behalten:
            k = '%s%s@%s' % (ZIELHOST_PRAEFIX, t[0], ZIELHOST_WEITERE)
        aus[k] = aus.get(k, 0) + v
    return aus


class Zaehler:
    def __init__(self):
        self._l = threading.Lock()
        self.werte = {}
        self.latenz = {}
        self._hosts = set()

    def plus(self, name, n=1):
        with self._l:
            self.werte[name] = self.werte.get(name, 0) + n

    def host_plus(self, art, host, n=1):
        """Fehlerart je Zielhost zaehlen; zusaetzlich zum Zaehler <art> selbst, der bleibt wie er ist."""
        h = zielhost_name(host)
        with self._l:
            if h not in self._hosts:
                if len(self._hosts) >= ZIELHOST_MAX:
                    h = ZIELHOST_WEITERE
                else:
                    self._hosts.add(h)
            k = '%s%s@%s' % (ZIELHOST_PRAEFIX, art, h)
            self.werte[k] = self.werte.get(k, 0) + n

    def zeit(self, name, sek):
        with self._l:
            self.werte[name + '_ms_summe'] = round(self.werte.get(name + '_ms_summe', 0) + sek * 1000, 3)
            self.werte[name + '_ms_max'] = round(max(self.werte.get(name + '_ms_max', 0), sek * 1000), 3)

    def latenz_plus(self, klasse, art, sek):
        with self._l:
            eimer = self.latenz.setdefault(klasse, {}).setdefault(art, [0] * len(EIMER_MS))
            eimer[_eimer(sek * 1000)] += 1

    def bild(self):
        with self._l:
            return dict(self.werte)

    def roh(self):
        with self._l:
            return dict(self.werte), {k: {a: list(e) for a, e in v.items()} for k, v in self.latenz.items()}


