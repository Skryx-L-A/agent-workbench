def quelle_lesen(q):
    art, _, rest = q.partition(':')
    if art == 'kc':
        r = subprocess.run(['security', 'find-generic-password', '-s', rest, '-w'],
                           capture_output=True, text=True)
        if r.returncode != 0:
            raise SystemExit('wb-geheimnis-filter: Schluesselbund-Eintrag nicht gefunden: %s' % rest)
        return r.stdout.rstrip('\n')
    if art == 'env':
        v = os.environ.get(rest)
        if v is None:
            raise SystemExit('wb-geheimnis-filter: Umgebungsvariable fehlt: %s' % rest)
        return v
    if art == 'datei':
        with open(os.path.expanduser(rest), encoding='utf-8') as f:
            return f.read().rstrip('\n')
    raise SystemExit('wb-geheimnis-filter: Quelle kc:|env:|datei: erwartet')


PRIVAT_BEGIN = re.compile(rb'-----BEGIN [A-Z ]*PRIVATE KEY-----')
PRIVAT_ENDE = re.compile(rb'-----END [A-Z ]*PRIVATE KEY-----')


def _ausgabe_grenze(puffer, mehrzeilig):
    """Bis zu welchem Byte darf `puffer` hinaus? Nur ganze Zeilen, und nichts ab einer Stelle,
    an der ein mehrzeiliger Wert oder ein privater Block erst in der naechsten Lesung endet."""
    grenze = puffer.rfind(b'\n') + 1
    for w in mehrzeilig:
        for k in range(min(len(w) - 1, len(puffer)), 0, -1):
            if puffer.endswith(w[:k]):
                grenze = min(grenze, len(puffer) - k)
                break
    for m in PRIVAT_BEGIN.finditer(puffer):
        if not PRIVAT_ENDE.search(puffer, m.end()):
            grenze = min(grenze, m.start())
            break
    return grenze


def befehl_mit(argv):
    if '--' not in argv:
        sys.exit('wb-geheimnis-filter mit VAR=QUELLE ... -- BEFEHL ARG...')
    i = argv.index('--')
    zuweisungen, befehl = argv[:i], argv[i + 1:]
    if not befehl:
        sys.exit('wb-geheimnis-filter mit: Befehl fehlt')
    env = dict(os.environ)
    werte = {}
    for zw in zuweisungen:
        var, _, q = zw.partition('=')
        if not re.fullmatch(r'[A-Za-z_][A-Za-z0-9_]*', var or '') or not q:
            sys.exit('wb-geheimnis-filter mit: VAR=QUELLE erwartet')
        werte[var] = env[var] = quelle_lesen(q)
    p = subprocess.Popen(befehl, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    ausgaben = {p.stdout.fileno(): (p.stdout, sys.stdout), p.stderr.fileno(): (p.stderr, sys.stderr)}
    puffer = {fd: b'' for fd in ausgaben}
    mehrzeilig = [w.encode('utf-8') for w in werte.values() if '\n' in w]
    offen = set(ausgaben)
    while offen:
        bereit, _, _ = select.select(list(offen), [], [])
        for fd in bereit:
            b = os.read(fd, 65536)
            if not b:
                offen.discard(fd)
                rest = puffer.pop(fd)
                if rest:
                    ausgaben[fd][1].write(schwaerze(rest.decode('utf-8', 'replace'), werte))
                    ausgaben[fd][1].flush()
                continue
            puffer[fd] += b
            # Ein Wert, der ueber zwei Lesungen reicht, bleibt im Puffer, bis er ganz ist.
            grenze = _ausgabe_grenze(puffer[fd], mehrzeilig)
            if grenze:
                fertig, puffer[fd] = puffer[fd][:grenze], puffer[fd][grenze:]
                ausgaben[fd][1].write(schwaerze(fertig.decode('utf-8', 'replace'), werte))
                ausgaben[fd][1].flush()
    return p.wait()


DIENST_PORT = 8093   # Dienstbetrieb (launchd/systemd), siehe wb-geheimnis-filter-dienst

FEHLERZAEHLER = ('upstream_fehler', 'fehler_intern', 'abgewiesen_kodierung', 'abgewiesen_binaer', 'opak_eingesetzt_ersetzt',
                 'websocket_abgelehnt', 'route_unbekannt', 'platzhalter_unbekannt',
                 'antwort_kodiert_unaufgeloest', 'zustand_schreibfehler', 'verbindungsfehler')


def _lesbar(titel, werte, latenz):
    zeilen = ['%s' % titel,
              '  Anfragen %d, gefiltert %d, Ersetzungen %d, Aufloesungen %d'
              % (werte.get('anfragen', 0), werte.get('anfragen_gefiltert', 0),
                 werte.get('ersetzt', 0), werte.get('aufgeloest', 0))]
    fehler = {k: v for k, v in werte.items() if v and
              (k in FEHLERZAEHLER or k in ('client_abbruch', 'anfrage_ungueltig', 'upstream_stream_fehler',
                                         'dns_wiederholt', 'dns_aufgegeben', 'tls_klassisch_rueckfall',
                                         'upload_abbruch_neu', 'upstream_fruehantwort', 'neuversand_gesperrt') or
               k.startswith(('upstream_fehler_', 'upstream_versuch_', 'upstream_stream_fehler_', 'neuversand_gesperrt_',
                             'fehler_intern_', 'verbindungsfehler_', 'client_abbruch_')))}
    zeilen.append('  Fehler/Abweisungen: %s' % (', '.join('%s %d' % kv for kv in sorted(fehler.items()))
                                                if fehler else 'keine'))
    hosts = sorted(((v, zielhost_teile(k)) for k, v in werte.items() if v and zielhost_teile(k)),
                   key=lambda e: (-e[0], e[1]))
    if hosts:
        teile = ['%s@%s %d' % (t[0], t[1], v) for v, t in hosts[:ZIELHOST_ZEILE]]
        if len(hosts) > ZIELHOST_ZEILE:
            teile.append('(+%d weitere Eintraege)' % (len(hosts) - ZIELHOST_ZEILE))
        zeilen.append('  Fehler je Zielhost: %s' % ', '.join(teile))
    regeln = {k[len('neu_regel_'):]: v for k, v in werte.items() if k.startswith('neu_regel_')}
    if regeln:
        zeilen.append('  neu erkannte Werte je Regel: %s' % ', '.join('%s %d' % kv for kv in sorted(regeln.items())))
    for klasse in [k for _g, k in GROESSENKLASSEN if k in latenz]:
        teile = []
        for art in LATENZARTEN:
            q = latenz[klasse].get(art)
            if q and q['n']:
                teile.append('%s n=%d Median<=%s p90<=%s ms' % (art, q['n'], q['median_ms'], q['p90_ms']))
        zeilen.append('  %-9s %s' % (klasse, '; '.join(teile)))
    return '\n'.join(zeilen)


def befehl_zaehler(a):
    c = http.client.HTTPConnection('127.0.0.1', a.port, timeout=10)
    c.request('GET', '/_wb/zaehler')
    roh = c.getresponse().read().decode()
    if not a.lesbar:
        print(roh)
        return
    d = json.loads(roh)
    print(_lesbar('seit Prozessstart %s:' % d.get('start'), d, d.get('latenz') or {}))
    if d.get('dauerhaft'):
        dd = d['dauerhaft']
        print(_lesbar('seit %s (dauerhaft):' % dd.get('seit'), dd.get('zaehler') or {}, dd.get('latenz') or {}))


